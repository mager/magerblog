---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[]; }
const searchData = Astro.props.posts.map(post => ({ title: post.data.title, slug: post.id }));
---
<dialog class="secret-search" id="secret-search" aria-labelledby="search-title">
  <div class="search-heading">
    <h2 id="search-title">Search articles</h2>
    <button type="button" data-close-search aria-label="Close search">Close <span aria-hidden="true">×</span></button>
  </div>
  <label for="secret-input" class="sr-only">Search article titles</label>
  <input type="search" id="secret-input" class="secret-input" placeholder="Search article titles" autocomplete="off" autofocus aria-describedby="search-status" />
  <p id="search-status" role="status">Type a title to find an article.</p>
  <div class="secret-results" id="secret-results"></div>
</dialog>
<script type="application/json" id="search-data" set:html={JSON.stringify(searchData).replace(/</g, '\\u003c')} />
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#secret-search');
  const input = document.querySelector<HTMLInputElement>('#secret-input');
  const results = document.querySelector<HTMLElement>('#secret-results');
  const status = document.querySelector<HTMLElement>('#search-status');
  const data: { title: string; slug: string }[] = JSON.parse(document.querySelector('#search-data')?.textContent || '[]');
  if (dialog && input && results && status && typeof dialog.showModal === 'function') {
    let returnFocus: HTMLElement | null = null;
    let previousOverflow = '';
    const close = () => dialog.close();
    dialog.querySelector('[data-close-search]')?.addEventListener('click', close);
    dialog.addEventListener('keydown', event => {
      if (event.key === 'Escape') { event.preventDefault(); close(); }
      if (event.key !== 'Tab') return;
      const controls = Array.from(dialog.querySelectorAll<HTMLElement>('button, input, a[href]'));
      const first = controls[0];
      const last = controls[controls.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    });
    dialog.addEventListener('click', event => {
      const bounds = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
      input.value = '';
      results.replaceChildren();
      status.textContent = 'Type a title to find an article.';
      if (returnFocus?.isConnected) returnFocus.focus({ preventScroll: true });
    });
    document.addEventListener('keydown', event => {
      const target = event.target;
      if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.isComposing || dialog.open || document.querySelector('dialog[open]')) return;
      if (target instanceof HTMLElement && (target.isContentEditable || target.closest('input, textarea, select, [role="textbox"]'))) return;
      if (event.key !== '/') return;
      event.preventDefault();
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
      input.focus();
    });
    input.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('en-US');
      const matches = query ? data.filter(post => post.title.toLocaleLowerCase('en-US').includes(query)) : [];
      results.replaceChildren(...matches.slice(0, 5).map(post => {
        const link = document.createElement('a');
        link.className = 'secret-result';
        link.href = `/blog/${post.slug.split('/').map(encodeURIComponent).join('/')}/`;
        link.textContent = post.title;
        return link;
      }));
      status.textContent = !query ? 'Type a title to find an article.' : !matches.length ? 'No articles found. Try another title.' : `Showing ${Math.min(matches.length, 5)} of ${matches.length} matching articles.`;
    });
    input.addEventListener('keydown', event => {
      const first = results.querySelector<HTMLAnchorElement>('a');
      if (event.isComposing) return;
      if (event.key === 'ArrowDown') { event.preventDefault(); first?.focus(); }
      if (event.key === 'Enter' && first) { event.preventDefault(); first.click(); }
    });
    results.addEventListener('keydown', event => {
      const items = Array.from(results.querySelectorAll<HTMLAnchorElement>('a'));
      const index = items.indexOf(document.activeElement as HTMLAnchorElement);
      if (event.key === 'ArrowDown') { event.preventDefault(); items[Math.min(index + 1, items.length - 1)]?.focus(); }
      if (event.key === 'ArrowUp') { event.preventDefault(); (items[index - 1] || input).focus(); }
    });
  }
</script>
<style>
  .secret-search { --search-paper: var(--editor-bg); --search-ink: var(--text-primary); --search-muted: var(--text-secondary); --search-rule: var(--terminal-border); --search-accent: var(--cyan); width: min(700px, calc(100% - 32px)); max-height: calc(100dvh - 48px); margin: 24px auto; padding: clamp(18px, 4vw, 32px); overflow-y: auto; border: 1px solid var(--search-rule); border-radius: 6px; background: var(--search-paper); color: var(--search-ink); }
  :global(.publication) .secret-search { --search-paper: var(--news-paper); --search-ink: var(--news-ink); --search-muted: var(--news-muted); --search-rule: var(--news-rule); --search-accent: var(--news-blue); }
  .secret-search::backdrop { background: oklch(15% .01 260 / .8); }
  .search-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 18px; }
  .search-heading h2 { font: 650 24px/1.2 var(--news-display); color: inherit; margin: 0; }
  .search-heading button { min-height: 44px; padding: 8px 12px; border: 1px solid var(--search-rule); border-radius: 4px; background: transparent; color: inherit; font: 500 14px var(--news-ui); cursor: pointer; }
  .secret-input { width: 100%; min-width: 0; padding: 14px; font: 20px/1.4 var(--news-ui); background: var(--search-paper); color: var(--search-ink); border: 1px solid var(--search-muted); border-radius: 4px; }
  .secret-input::placeholder { color: var(--search-muted); opacity: 1; }
  #search-status { color: var(--search-muted); font: 14px/1.5 var(--news-ui); margin: 16px 0; }
  .secret-results { display: grid; }
  .secret-results :global(a) { display: block; padding: 16px 0; min-height: 44px; border-top: 1px solid var(--search-rule); color: var(--search-ink); font: 600 20px/1.4 var(--news-ui); overflow-wrap: anywhere; }
  .secret-results :global(a:hover) { color: var(--search-accent); }
  .secret-search :focus-visible { outline: 2px solid var(--search-accent); outline-offset: 3px; }
</style>
