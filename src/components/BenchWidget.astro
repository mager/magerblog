---
import { benchResultsDate, loadBenchSummary } from '../lib/bench-summary';

// A dated build snapshot keeps the static page useful without JavaScript.
// The browser refreshes it from the same feed on every visit.
const summary = await loadBenchSummary();
const leader = summary?.leader;
---
<section class="bench-insert" aria-labelledby="bench-heading" data-bench-widget data-bench-state={summary ? 'snapshot' : 'unavailable'}>
  <div class="insert-label"><span>mager-bench</span><span data-bench-status>{summary ? 'saved results' : 'coding benchmark'}</span></div>
  <a href="https://bench.mager.co" class="bench-title"><h2 id="bench-heading">mager-bench</h2></a>
  <p>Opinionated coding tasks, scored by an LLM judge.</p>
  <div class="bench-score" aria-live="polite" aria-atomic="true"><span class="bench-leader" data-bench-average>{leader ? leader.average.toFixed(1) : '…'}</span><span class="bench-sub" data-bench-leader>{leader ? `/ 10 · ${leader.name} leads` : 'Explore the latest scores'}</span></div>
  <p class="bench-meta" data-bench-meta>{summary ? `${summary.model_count} models · ${summary.challenge_count} challenges · Results ${benchResultsDate(summary)}` : 'Latest results on the leaderboard'}</p>
  <div class="bench-tests" aria-label="Benchmark dimensions"><span class="dim-crct">correctness</span><span class="dim-qual">quality</span><span class="dim-docs">docs</span></div>
  <a class="bench-action" href="https://bench.mager.co">Explore the leaderboard <span aria-hidden="true">↗</span></a>
  <a class="bench-method" href="/blog/2026-07-05-mager-bench/">Why I built it</a>
</section>
<script>
import { benchResultsDate, loadBenchSummary } from '../lib/bench-summary';

async function refreshBenchWidget() {
  const widget = document.querySelector<HTMLElement>('[data-bench-widget]');
  if (!widget) return;
  const summary = await loadBenchSummary();
  if (!summary) return; // Keep the dated snapshot and working leaderboard link.

  const average = widget.querySelector<HTMLElement>('[data-bench-average]');
  const leader = widget.querySelector<HTMLElement>('[data-bench-leader]');
  const meta = widget.querySelector<HTMLElement>('[data-bench-meta]');
  const status = widget.querySelector<HTMLElement>('[data-bench-status]');
  if (!average || !leader || !meta || !status) return;

  average.textContent = summary.leader.average.toFixed(1);
  leader.textContent = `/ 10 · ${summary.leader.name} leads`;
  meta.textContent = `${summary.model_count} models · ${summary.challenge_count} challenges · Results ${benchResultsDate(summary)}`;
  status.textContent = 'live results';
  widget.dataset.benchState = 'live';
}

void refreshBenchWidget();
</script>
<style>
.bench-insert { background: #100e09; color: #f2e9d4; padding: 20px; position: relative; border: 1px solid oklch(62% 0.12 75 / 0.45); }
.bench-insert a { color: inherit; }
.bench-insert a:hover { text-decoration: underline; text-underline-offset: 4px; }
.insert-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid oklch(62% 0.12 75 / 0.35); padding-bottom: 12px; font: 500 9px/1.3 var(--news-mono); text-transform: lowercase; letter-spacing: .08em; color: #b8a67a; }
.bench-insert .bench-title:hover { text-decoration: none; }
.bench-insert h2 { font: 700 30px/1 var(--news-mono); letter-spacing: -0.02em; margin: 18px 0 12px; color: #f5b73f; text-shadow: 0 0 14px oklch(72% 0.16 75 / 0.55); }
.bench-insert p { margin: 0; font: 13px/1.55 var(--news-mono); color: #cfc3a5; }
.bench-score { display: flex; align-items: baseline; gap: 10px; margin: 16px 0 4px; }
.bench-leader { font: 700 44px/1 var(--news-mono); color: #f5b73f; text-shadow: 0 0 18px oklch(72% 0.16 75 / 0.5); }
.bench-sub { font: 500 10px/1.5 var(--news-mono); color: #b8a67a; }
.bench-insert .bench-meta { margin-top: 8px; font: 400 9px/1.6 var(--news-mono); color: #b8a67a; }
.bench-tests { display: flex; flex-wrap: wrap; gap: 7px 14px; margin: 14px 0 18px; font: 500 10px/1.5 var(--news-mono); }
.dim-crct { color: #7ee2a8; }
.dim-qual { color: #f08fd6; }
.dim-docs { color: #7cc7ff; }
.bench-tests span::before { content: '· '; color: #b8a67a; }
.bench-action { display: flex; justify-content: space-between; align-items: center; min-height: 44px; border-top: 1px solid oklch(62% 0.12 75 / 0.4); font: 700 11px var(--news-ui); color: #f2e9d4; }
.bench-action:hover { color: #f5b73f; }
.bench-method { display: inline-flex; align-items: center; min-height: 28px; font: 11px var(--news-serif); color: #b8a67a; text-decoration: underline; text-underline-offset: 3px; }
@media(max-width: 700px) {
  .bench-insert { padding: 22px; }
  .bench-insert h2 { font-size: 34px; }
  .bench-leader { font-size: 40px; }
  .bench-insert p { max-width: 32ch; }
}
</style>
