---
import { benchResultsDate, benchResultLabel, loadBenchSummary } from '../lib/bench-summary';
const summary = await loadBenchSummary();
---
<section class="bench-insert" aria-labelledby="bench-heading" data-bench-widget data-bench-state={summary ? 'snapshot' : 'unavailable'}>
  <div class="insert-label"><span data-bench-version>{summary ? `mager-bench ${summary.version}` : 'mager-bench'}</span><span data-bench-status>{summary ? 'saved snapshot' : 'Results unavailable'}</span></div>
  <a href="https://bench.mager.co" class="bench-title"><h2 id="bench-heading">A quick test of useful code.</h2></a>
  <p>JavaScript programs, exact checks, and one attempt at the lowest supported reasoning effort. No model judge.</p>
  <div class="bench-results" data-bench-results aria-live="polite" aria-atomic="true">
    <p>{summary ? benchResultLabel(summary) : 'Open the bench for the current tasks and results.'}</p>
  </div>
  <p class="bench-meta" data-bench-meta>{summary ? `${summary.task_count} tasks · ${summary.total_checks} checks · Checked ${benchResultsDate(summary)}` : 'Every saved attempt is open for inspection.'}</p>
  <p class="bench-caveat">A small sample of JavaScript correctness, not a general model ranking.</p>
  <a class="bench-action" href="https://bench.mager.co">Explore the tasks and runs <span aria-hidden="true">↗</span></a>
  <a class="bench-method" href="https://bench.mager.co/#method">How the benchmark works</a>
</section>
<script>
import { benchResultsDate, benchResultLabel, loadBenchSummary } from '../lib/bench-summary';
async function refreshBenchWidget() {
  const widget = document.querySelector<HTMLElement>('[data-bench-widget]');
  if (!widget) return;
  const summary = await loadBenchSummary();
  if (!summary) return;
  const results = widget.querySelector<HTMLElement>('[data-bench-results]');
  const meta = widget.querySelector<HTMLElement>('[data-bench-meta]');
  const status = widget.querySelector<HTMLElement>('[data-bench-status]');
  const version = widget.querySelector<HTMLElement>('[data-bench-version]');
  if (!results || !meta || !status || !version) return;
  const result = document.createElement('p');
  result.textContent = benchResultLabel(summary);
  results.replaceChildren(result);
  version.textContent = `mager-bench ${summary.version}`;
  meta.textContent = `${summary.task_count} tasks · ${summary.total_checks} checks · Checked ${benchResultsDate(summary)}`;
  status.textContent = 'live data';
  widget.dataset.benchState = 'live';
}
void refreshBenchWidget();
</script>
<style>
.bench-insert { background: oklch(13% .006 270); color: oklch(94% .009 265); padding: 22px; border: 1px solid oklch(31% .017 270); }
.bench-insert a { color: inherit; }
.bench-insert a:hover { text-decoration: underline; text-underline-offset: 4px; }
.insert-label { display: flex; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid oklch(31% .017 270); padding-bottom: 12px; font: 500 9px/1.5 var(--news-mono); color: oklch(71% .022 268); }
.bench-insert .bench-title:hover { text-decoration: none; }
.bench-insert h2 { font: 650 30px/1.1 var(--news-ui); letter-spacing: -.04em; margin: 20px 0 12px; color: oklch(83% .185 153); }
.bench-insert p { margin: 0; font: 14px/1.6 var(--news-serif); color: oklch(80% .014 265); }
.bench-results { margin: 18px 0; }
.bench-insert .bench-meta { font: 9px/1.7 var(--news-mono); color: oklch(71% .022 268); }
.bench-insert .bench-caveat { font-size: 12px; margin-block: 9px 17px; }
.bench-action { display: flex; justify-content: space-between; gap: 12px; align-items: center; min-height: 44px; border-top: 1px solid oklch(31% .017 270); font: 650 11px var(--news-ui); }
.bench-action:hover { color: oklch(83% .185 153); }
.bench-method { display: inline-flex; align-items: center; min-height: 32px; font: 12px var(--news-serif); text-decoration: underline; text-underline-offset: 3px; }
.bench-insert a:focus-visible { outline: 2px solid oklch(83% .185 153); outline-offset: 4px; }
</style>
