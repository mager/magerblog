<button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" data-theme-toggle hidden>
  <span class="theme-symbol" aria-hidden="true">◐</span><span data-theme-label>Dark</span>
</button>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  function syncButtons() {
    const dark = document.documentElement.dataset.theme === 'dark';
    buttons.forEach(button => {
      button.hidden = false;
      button.setAttribute('aria-pressed', String(dark));
      button.querySelector('[data-theme-label]')!.textContent = dark ? 'Light' : 'Dark';
      button.title = dark ? 'Switch to light mode' : 'Switch to dark mode';
    });
  }
  buttons.forEach(button => button.addEventListener('click', () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('mager-theme', theme); } catch { /* The switch still works without storage. */ }
    syncButtons();
  }));
  window.addEventListener('storage', event => {
    if (event.key === 'mager-theme') {
      document.documentElement.dataset.theme = event.newValue === 'dark' ? 'dark' : 'light';
      syncButtons();
    }
  });
  syncButtons();
</script>
<style>
  .theme-toggle { display: inline-flex; align-items: center; justify-content: center; gap: 7px; min-height: 44px; padding: 0 14px; background: transparent; border: 0; color: var(--news-muted); font: 600 11px/1.2 var(--news-ui); cursor: pointer; }
  .theme-toggle[hidden] { display: none; }
  .theme-toggle:hover { color: var(--news-ink); }
  .theme-symbol { font-size: 18px; }
  @media(max-width: 800px) { .theme-toggle { padding: 0 0 0 14px; } }
</style>
