---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;
const d = post.data.updatedDate || post.data.pubDate;
const dateStr = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
const tags = (post.data.tags || []).slice(0, 3);
const dek = post.data.description || tags.join(' / ') || 'field note';
---

<li class={`tech-row-wrap ${isDraft ? 'draft' : ''}`}>
	<a href={`/blog/${post.id}/`} class="tech-row">
		<span class="row-date">{dateStr}</span>
		<span class="row-body">
			<span class="row-title">{displayTitle}</span>
			<span class="row-dek">{dek}</span>
		</span>
		<span class="row-tags">
			{tags.map(tag => <span class="tag">{tag}</span>)}
			<span class="row-arrow" aria-hidden="true">↗</span>
		</span>
	</a>
</li>

<style>
	.tech-row-wrap {
		margin: 0;
		padding: 0;
	}

	.tech-row-wrap.draft {
		opacity: 0.68;
	}

	.tech-row {
		display: grid;
		grid-template-columns: 7.8rem minmax(0, 1fr) minmax(8rem, auto);
		gap: 1.15rem;
		align-items: start;
		padding: 1.05rem 0;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--rule, oklch(69% 0.006 76));
		transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tech-row:hover {
		transform: translateX(3px);
		background: color-mix(in oklch, var(--ink, oklch(18% 0.008 70)) 4%, transparent);
	}

	.row-date,
	.row-dek,
	.tag,
	.row-arrow {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.row-date {
		color: var(--ink-muted, oklch(49% 0.006 70));
		font-size: 0.74rem;
		padding-top: 0.22rem;
		white-space: nowrap;
	}

	.row-body {
		display: grid;
		gap: 0.38rem;
		min-width: 0;
	}

	.row-title {
		font-family: var(--font-ui, 'Space Grotesk', system-ui, sans-serif);
		font-size: clamp(1.05rem, 1.4vw, 1.28rem);
		font-weight: 700;
		line-height: 1.16;
		color: var(--ink, oklch(18% 0.008 70));
	}

	.row-dek {
		display: -webkit-box;
		max-width: 78ch;
		color: var(--ink-soft, oklch(32% 0.007 70));
		font-size: 0.82rem;
		line-height: 1.5;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.row-tags {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.tag {
		border: 1px solid var(--rule-strong, oklch(43% 0.006 70));
		background: color-mix(in oklch, var(--paper-quiet, oklch(86.5% 0.008 76)) 88%, var(--surface, oklch(94% 0.007 76)));
		color: var(--ink-soft, oklch(32% 0.007 70));
		font-size: 0.68rem;
		line-height: 1;
		padding: 0.34rem 0.44rem;
	}

	.row-arrow {
		color: var(--ink, oklch(18% 0.008 70));
		font-size: 0.96rem;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tech-row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 840px) {
		.tech-row {
			grid-template-columns: 1fr;
			gap: 0.7rem;
			padding: 0.95rem 0;
		}

		.row-date,
		.row-body,
		.row-tags {
			grid-column: 1;
		}

		.row-tags {
			justify-content: flex-start;
		}

		.row-arrow {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.tech-row {
			gap: 0.55rem;
		}

		.row-date {
			font-size: 0.68rem;
			white-space: normal;
		}

		.row-dek {
			font-size: 0.76rem;
		}
	}
</style>
