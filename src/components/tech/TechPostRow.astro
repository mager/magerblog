---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;
const d = post.data.updatedDate || post.data.pubDate;
const dateStr = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
const tags = (post.data.tags || []).slice(0, 3);
const dek = post.data.description || tags.join(' / ') || '';
---

<li class={`tech-row-wrap ${isDraft ? 'draft' : ''}`}>
	<a href={`/blog/${post.id}/`} class="tech-row">
		<span class="row-date">{dateStr}</span>
		<span class="row-body">
			<span class="row-title">{displayTitle}</span>
			<span class="row-dek">{dek}</span>
		</span>
		<span class="row-tags">
			{tags.map(tag => (
				<span class="tag">{tag}</span>
			))}
			<span class="row-arrow" aria-hidden="true">→</span>
		</span>
	</a>
</li>

<style>
	/* Light editorial row — inherits tokens from .tech-page, with fallbacks */
	.tech-row-wrap {
		margin: 0;
		padding: 0;
	}

	.tech-row-wrap.draft { opacity: 0.55; }

	.tech-row {
		display: grid;
		grid-template-columns: 7rem minmax(0, 1fr) minmax(8rem, auto);
		gap: 1.1rem;
		align-items: start;
		padding: 1.1rem 0;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--rule, #ddd6cd);
	}

	.row-date {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		font-size: 0.72rem;
		color: var(--ink-light, #8d867d);
		padding-top: 0.4rem;
		white-space: nowrap;
		letter-spacing: 0.01em;
	}

	.row-body {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.row-title {
		font-family: var(--font-display, Georgia, serif);
		font-variation-settings: 'opsz' 36, 'wght' 700;
		font-size: clamp(1.05rem, 1.4vw, 1.25rem);
		line-height: 1.2;
		color: var(--ink, #1f1c17);
	}

	.tech-row:hover .row-title {
		text-decoration: underline;
		text-underline-offset: 3px;
		text-decoration-thickness: 1px;
	}

	.row-dek {
		font-family: var(--font-body, Georgia, serif);
		display: -webkit-box;
		max-width: 75ch;
		font-size: 0.9rem;
		line-height: 1.5;
		color: var(--ink-mid, #6c6760);
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.row-tags {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.38rem;
		flex-wrap: wrap;
		padding-top: 0.4rem;
	}

	.tag {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		border: 1px solid var(--rule, #ddd6cd);
		background: var(--surface, #f5f3f0);
		color: var(--ink-light, #8d867d);
		border-radius: 999px;
		font-size: 0.62rem;
		line-height: 1;
		padding: 0.26rem 0.5rem;
		letter-spacing: 0.03em;
		white-space: nowrap;
	}

	.row-arrow {
		align-self: center;
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
		color: var(--accent, #2f5e9e);
		font-size: 0.9rem;
		opacity: 0;
		transform: translateX(-4px);
		transition:
			opacity 160ms ease,
			transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tech-row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	/* ── Responsive ──────────────────────────────────────────── */
	@media (max-width: 840px) {
		.tech-row {
			grid-template-columns: 1fr;
			gap: 0.5rem;
			padding: 0.95rem 0;
		}

		.row-tags { justify-content: flex-start; padding-top: 0.15rem; }
		.row-arrow { display: none; }
	}

	@media (max-width: 560px) {
		.row-date { font-size: 0.66rem; }
		.row-dek { font-size: 0.85rem; }
	}

	@media (prefers-reduced-motion: reduce) {
		.row-arrow { transition: none; }
	}
</style>
