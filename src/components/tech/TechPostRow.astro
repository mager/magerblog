---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;
const d = post.data.updatedDate || post.data.pubDate;
const dateStr = `${d.getUTCFullYear()}-${String(d.getUTCMonth() + 1).padStart(2, '0')}-${String(d.getUTCDate()).padStart(2, '0')}`;
const tags = (post.data.tags || []).slice(0, 3);
const dek = post.data.description || tags.join(' / ') || 'field note from the build queue';
---

<li class={`tech-row-wrap ${isDraft ? 'draft' : ''}`}>
	<a href={`/blog/${post.id}/`} class="tech-row">
		<span class="row-date">[{dateStr}]</span>
		<span class="row-body">
			<span class="row-title">{displayTitle}</span>
			<span class="row-dek">{dek}</span>
		</span>
		<span class="row-tags">
			{tags.map(tag => <span class="tag">{tag}</span>)}
			<span class="row-arrow" aria-hidden="true">↗</span>
		</span>
	</a>
</li>

<style>
	.tech-row-wrap {
		margin: 0;
		padding: 0;
	}

	.tech-row-wrap.draft {
		opacity: 0.68;
	}

	.tech-row {
		display: grid;
		grid-template-columns: 8.2rem minmax(0, 1fr) minmax(8rem, auto);
		gap: 1.15rem;
		align-items: start;
		padding: 1rem 0;
		color: inherit;
		text-decoration: none;
		border-bottom: 1px solid var(--rule, oklch(82% 0.014 78));
		transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background 180ms cubic-bezier(0.22, 1, 0.36, 1), border-color 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tech-row:hover {
		transform: translateX(4px);
		background: linear-gradient(90deg, color-mix(in oklch, var(--terminal-cyan, oklch(79% 0.09 215)) 7%, transparent), transparent 52%);
		border-color: color-mix(in oklch, var(--terminal-cyan, oklch(79% 0.09 215)) 34%, var(--rule, oklch(82% 0.014 78)));
	}

	.row-date,
	.row-dek,
	.tag,
	.row-arrow {
		font-family: var(--font-mono, 'JetBrains Mono', monospace);
	}

	.row-date {
		color: var(--ink-muted, oklch(48% 0.006 70));
		font-size: 0.74rem;
		padding-top: 0.18rem;
		white-space: nowrap;
	}

	.row-body {
		display: grid;
		gap: 0.32rem;
		min-width: 0;
	}

	.row-title {
		font-family: var(--font-ui, 'Space Grotesk', system-ui, sans-serif);
		font-size: 1.12rem;
		font-weight: 700;
		line-height: 1.18;
		color: var(--ink, oklch(18% 0.008 70));
	}

	.row-dek {
		display: -webkit-box;
		color: var(--ink-soft, oklch(34% 0.007 70));
		font-size: 0.78rem;
		line-height: 1.45;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.row-tags {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.4rem;
		flex-wrap: wrap;
	}

	.tag {
		border: 1px solid var(--rule-strong, oklch(66% 0.03 72));
		background: color-mix(in oklch, var(--paper-quiet, oklch(90% 0.008 78)) 88%, white 12%);
		color: var(--ink-soft, oklch(34% 0.007 70));
		font-size: 0.68rem;
		line-height: 1;
		padding: 0.34rem 0.44rem;
	}

	.row-arrow {
		color: var(--ink, oklch(18% 0.008 70));
		font-size: 0.96rem;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 180ms cubic-bezier(0.22, 1, 0.36, 1), transform 180ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	.tech-row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	@media (max-width: 840px) {
		.tech-row {
			grid-template-columns: 1fr;
			gap: 0.7rem;
			padding: 0.95rem 0;
		}

		.row-date {
			grid-column: 1;
			grid-row: 1;
		}

		.row-body {
			grid-column: 1;
		}

		.row-tags {
			grid-column: 1;
			justify-content: flex-start;
		}

		.row-arrow {
			display: none;
		}
	}

	@media (max-width: 560px) {
		.tech-row {
			grid-template-columns: 1fr;
			gap: 0.55rem;
		}

		.row-date {
			font-size: 0.68rem;
			white-space: normal;
		}

		.row-title {
			font-size: 1rem;
		}

		.row-dek {
			font-size: 0.74rem;
		}
	}
</style>
