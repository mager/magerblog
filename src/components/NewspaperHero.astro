---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	notes?: CollectionEntry<'notes'>[];
}

const { posts, notes = [] } = Astro.props;

// One reverse-chronological stream interleaving long-form posts and short notes
// — the homepage as a personal feed rather than a categorized front page.
type FeedItem =
	| { kind: 'post'; date: Date; entry: CollectionEntry<'blog'> }
	| { kind: 'note'; date: Date; entry: CollectionEntry<'notes'> };

const feed: FeedItem[] = [
	...posts.map((entry): FeedItem => ({ kind: 'post', entry, date: entry.data.updatedDate || entry.data.pubDate })),
	...notes.map((entry): FeedItem => ({ kind: 'note', entry, date: entry.data.pubDate })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Show a recent window on the homepage; the rest lives in the archives.
const FEED_LIMIT = 30;
const visible = feed.slice(0, FEED_LIMIT);
const hasMore = feed.length > FEED_LIMIT;

// Notes show their full (short) body inline in the stream, Simon-style. render()
// is async, so resolve every note's Content component up front.
const noteContent = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();
for (const note of notes) {
	noteContent.set(note.id, (await render(note)).Content);
}

const CATEGORY: Record<string, { label: string; href: string }> = {
	tech: { label: 'Tech', href: '/tech/' },
	food: { label: 'Food', href: '/cooking/' },
	life: { label: 'Life', href: '/life/' },
};

const hostOf = (url: string) => {
	try {
		return new URL(url).host.replace(/^www\./, '');
	} catch {
		return url;
	}
};
---

<div class="home">

	<!-- ── TOPBAR ── -->
	<div class="topbar">
		<nav class="topbar-nav">
			<a href="/tech/">Tech</a>
			<a href="/cooking/">Food</a>
			<a href="/life/">Life</a>
			<a href="/notes/">Notes</a>
			<a href="/about">About</a>
		</nav>
		<div class="topbar-social">
			<a href="https://x.com/mager" target="_blank" class="topbar-social-link" aria-label="Follow @mager on X">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="topbar-social-link" aria-label="mager on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>

	<!-- ── HERO ── -->
	<section class="hero">
		<div class="hero-type">
			<h1 class="hero-name">
				<span class="name-mager"><span class="easter-m">m</span><span class="easter-a">a</span><span class="easter-g">g</span><span class="easter-e">e</span><span class="easter-r">r</span></span><span class="name-co"><span class="easter-dot">.</span><span class="easter-c">c</span><span class="easter-o">o</span></span>
			</h1>
			<div class="hero-meta">
				<p class="hero-tagline">Always learning. Always eating. Chicago.</p>
			</div>
		</div>
	</section>

	<!-- ── THE FEED ── -->
	<section class="feed" aria-label="Latest posts and notes">
		<header class="feed-head">
			<h2 class="feed-title">Latest</h2>
			<div class="feed-links">
				<a href="/notes/">Notes</a>
				<a href="/rss.xml">RSS</a>
			</div>
		</header>

		{visible.map((item) => item.kind === 'post' ? (
			<article class:list={['entry', 'entry--post', `entry--${item.entry.data.category ?? 'tech'}`]}>
				<div class="entry-rail">
					<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
					{item.entry.data.category && CATEGORY[item.entry.data.category] && (
						<a class="entry-kind" href={CATEGORY[item.entry.data.category].href}>{CATEGORY[item.entry.data.category].label}</a>
					)}
				</div>
				<div class="entry-main">
					<div class="entry-text">
						<a class="entry-headline" href={`/blog/${item.entry.id}/`}>
							<h3>{item.entry.data.title}</h3>
						</a>
						{item.entry.data.description && (
							<p class="entry-dek">{item.entry.data.description}</p>
						)}
						<a class="entry-more" href={`/blog/${item.entry.id}/`}>Read post →</a>
					</div>
					{item.entry.data.heroImage && (
						<a class="entry-thumb" href={`/blog/${item.entry.id}/`} tabindex="-1" aria-hidden="true">
							<img src={item.entry.data.heroImage} alt="" loading="lazy" />
						</a>
					)}
				</div>
			</article>
		) : (
			<article class="entry entry--note">
				<div class="entry-rail">
					<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
					<a class="entry-kind entry-kind--note" href="/notes/">Note</a>
				</div>
				<div class="entry-main">
					<div class="entry-text">
						{item.entry.data.title && (
							<a class="entry-headline" href={`/notes/${item.entry.id}/`}><h3>{item.entry.data.title}</h3></a>
						)}
						{item.entry.data.link && (
							<a class="entry-linkout" href={item.entry.data.link} target="_blank" rel="noopener">
								{item.entry.data.linkText ?? hostOf(item.entry.data.link)}
							</a>
						)}
						<div class="entry-note-body">
							{(() => { const C = noteContent.get(item.entry.id)!; return <C />; })()}
						</div>
						{item.entry.data.tags && item.entry.data.tags.length > 0 && (
							<div class="entry-tags">
								{item.entry.data.tags.map((t) => <span class="entry-tag">{t}</span>)}
							</div>
						)}
					</div>
				</div>
			</article>
		))}

		{hasMore && (
			<a class="feed-archive" href="/blog/">
				<span>Browse the full archive</span>
				<span class="feed-archive-arrow" aria-hidden="true">→</span>
			</a>
		)}
	</section>

</div><!-- /home -->

<!-- Cursor glow orb -->
<div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

<script>
	// ── Ink-reveal: split hero name into chars and stagger them ──
	const heroName = document.querySelector('.hero-name') as HTMLElement | null;
	if (heroName) {
		let charIndex = 0;
		const BASE_DELAY_MS = 80; // ms per char

		function wrapChars(node: Node): void {
			if (node.nodeType === Node.TEXT_NODE) {
				const text = node.textContent || '';
				const frag = document.createDocumentFragment();
				for (const ch of text) {
					const span = document.createElement('span');
					span.className = 'char';
					span.style.animationDelay = `${(charIndex++ * BASE_DELAY_MS)}ms`;
					span.textContent = ch;
					frag.appendChild(span);
				}
				node.parentNode?.replaceChild(frag, node);
			} else if (node.nodeType === Node.ELEMENT_NODE) {
				// Walk children in reverse so replacements don't shift indices
				const children = Array.from(node.childNodes);
				for (const child of children) {
					wrapChars(child);
				}
			}
		}

		wrapChars(heroName);
	}

	// ── Cursor glow follows mouse ──
	const glow = document.getElementById('cursor-glow');
	if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let raf: number;
		let mx = -500, my = -500;
		window.addEventListener('mousemove', (e) => {
			mx = e.clientX;
			my = e.clientY;
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				glow.style.left = mx + 'px';
				glow.style.top = my + 'px';
			});
		});
		// Hide when leaving window
		document.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
		document.addEventListener('mouseenter', () => { glow.style.opacity = '1'; });
	} else if (glow) {
		glow.style.display = 'none';
	}

	// ── Hero parallax on scroll (scroll-driven or JS fallback) ──
	const hero = document.querySelector('.hero') as HTMLElement | null;
	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// Use scroll-driven animations if supported
		if (CSS.supports('animation-timeline', 'scroll()')) {
			hero.style.cssText += `
				animation: heroParallax linear both;
				animation-timeline: scroll(root block);
				animation-range: 0px 400px;
			`;
			const style = document.createElement('style');
			style.textContent = `
				@keyframes heroParallax {
					from { transform: translateY(0px); }
					to   { transform: translateY(-40px); }
				}
			`;
			document.head.appendChild(style);
		} else {
			// JS fallback
			const onScroll = () => {
				const y = window.scrollY;
				if (y < 500) {
					hero.style.transform = `translateY(${-y * 0.1}px)`;
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	}
</script>

<style>

/* ══════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════ */
.home {
	--paper:       oklch(98.8% 0.012 112);
	--ink:         oklch(11%   0.015 250);
	--ink-mid:     oklch(42%   0.010 250);
	--ink-light:   oklch(62%   0.008 250);
	--rule:        oklch(89%   0.010 112);
	--rule-dark:   oklch(79%   0.012 112);

	/* Seasonal accents — Summer in Chicago · Lakefront */
	--summer-lake:   oklch(46% 0.13 245);  /* deep Lake Michigan blue */
	--summer-teal:   oklch(58% 0.12 205);  /* shallow water */
	--summer-aqua:   oklch(72% 0.13 210);  /* sun on the water */
	--summer-sun:    oklch(80% 0.13 90);   /* high summer sun */
	--summer-leaf:   oklch(60% 0.15 150);  /* park green */
	--summer-coral:  oklch(62% 0.17 33);   /* sunset over the lake */
	--summer-flame:  oklch(58% 0.18 30);   /* deep sunset */
	--summer-sunset: oklch(66% 0.17 45);   /* warm dusk */
	--trip-accent:   oklch(60% 0.17 33);   /* warm trip memory */

	/* Category accents (identity — stable across seasons) */
	--tech-accent: oklch(45%  0.15  240);  /* lake blue */
	--food-accent: oklch(58%  0.17  33);   /* ripe coral */
	--life-accent: oklch(52%  0.15  150);  /* park green */
	--note-accent: oklch(50%  0.14  290);  /* margin-note violet */

	/* Type */
	--font-display: 'Fraunces', Georgia, serif;
	--font-body:    'Source Serif 4', Georgia, serif;
	--font-mono:    'JetBrains Mono', monospace;
	--font-ui:      'Space Grotesk', sans-serif;

	background: var(--paper);
	color: var(--ink);
	min-height: 100vh;
	position: relative;
	isolation: isolate;
	overflow: hidden;
}

.home::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		repeating-linear-gradient(
			90deg,
			oklch(46% 0.13 245 / 0.028) 0 1px,
			transparent 1px 92px
		),
		repeating-linear-gradient(
			0deg,
			oklch(60% 0.15 150 / 0.032) 0 1px,
			transparent 1px 68px
		);
}

.topbar,
.hero,
.japan,
.zones {
	position: relative;
	z-index: 1;
}


/* ══════════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════════ */
.topbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 1rem 2.5rem;
	border-bottom: 1px solid var(--rule);
}

.topbar-brand {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 12, 'wght' 700;
	font-size: 1rem;
	color: var(--ink);
	text-decoration: none;
	letter-spacing: -0.01em;
}

.topbar-nav {
	display: flex;
	gap: 2rem;
}

.topbar-nav a {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--ink-mid);
	text-decoration: none;
	transition: color 0.15s ease;
}

.topbar-nav a:hover {
	color: var(--ink);
}

.topbar-social {
	display: flex;
	align-items: center;
	gap: 0.25rem;
	padding-left: 1.5rem;
	border-left: 1px solid var(--rule);
}

.topbar-social-link {
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--ink-mid);
	padding: 0.35em;
	border-radius: 4px;
	transition: color 0.15s ease;
}

.topbar-social-link:hover {
	color: var(--ink);
}

/* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
.hero {
	padding: 4rem 2.5rem 3.5rem;
	border-bottom: 1px solid var(--rule-dark);
	overflow: hidden;
	isolation: isolate;
}

.hero::before {
	content: "日本";
	position: absolute;
	top: 1.45rem;
	right: clamp(1.25rem, 4vw, 4rem);
	z-index: 0;
	writing-mode: vertical-rl;
	border: 1px solid oklch(60% 0.17 33 / 0.22);
	color: oklch(60% 0.17 33 / 0.16);
	padding: 0.55rem 0.38rem;
	font-family: var(--font-ui);
	font-size: clamp(2.2rem, 6vw, 5.75rem);
	font-weight: 700;
	letter-spacing: 0.08em;
	line-height: 1;
}

.hero::after {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		linear-gradient(110deg, transparent 0 62%, oklch(72% 0.15 33 / 0.08) 62% 62.35%, transparent 62.35%),
		linear-gradient(110deg, transparent 0 71%, oklch(46% 0.13 245 / 0.08) 71% 71.35%, transparent 71.35%),
		linear-gradient(110deg, transparent 0 78%, oklch(60% 0.15 150 / 0.06) 78% 78.25%, transparent 78.25%);
}

.hero-type {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
	position: relative;
	z-index: 1;
}

.hero-name {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 144, 'wght' 900;
	font-style: italic;
	font-size: clamp(5.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.04em;
	margin: 0;
}

.name-mager {
	color: var(--ink);
}

/* Summer in Chicago · Lakefront: lake → water → sun → park, then a sunset .co */
.easter-m { color: var(--summer-lake); }
.easter-a { color: var(--summer-teal); }
.easter-g { color: var(--summer-aqua); }
.easter-e { color: var(--summer-sun); }
.easter-r { color: var(--summer-leaf); }

.easter-dot { color: var(--summer-coral); }
.easter-c   { color: var(--summer-flame); }
.easter-o   { color: var(--summer-sunset); }

/* Light shimmer: a small brightness pulse after ink-reveal finishes */
@keyframes seasonalShimmer {
	0%, 100% { filter: brightness(1); }
	50%      { filter: brightness(1.16) saturate(1.08); }
}

.name-mager,
.name-co {
	animation: seasonalShimmer 3.5s 1.5s ease-in-out infinite;
}
.name-co { color: inherit; }

.hero-meta {
	padding-bottom: 0.5rem;
	max-width: 280px;
	flex-shrink: 0;
}

.hero-tagline {
	font-family: var(--font-body);
	font-size: 1.05rem;
	font-style: italic;
	color: var(--ink-mid);
	margin: 0 0 0.6rem;
	line-height: 1.4;
}

.hero-postcard {
	display: grid;
	grid-template-columns: auto 1fr;
	align-items: center;
	gap: 0.75rem;
	padding-top: 0.75rem;
	border-top: 1px solid var(--rule);
	max-width: 20rem;
}

.postcard-mark {
	display: inline-grid;
	place-items: center;
	width: 2.55rem;
	height: 2.55rem;
	border: 1px solid oklch(60% 0.17 33 / 0.34);
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-size: 0.95rem;
	font-weight: 700;
	line-height: 1;
	transform: rotate(-3deg);
}

.postcard-copy {
	font-family: var(--font-mono);
	font-size: 0.66rem;
	line-height: 1.45;
	color: var(--ink-light);
	letter-spacing: 0.03em;
}


/* ══════════════════════════════════════════════════
   THE JAPAN TRIP
══════════════════════════════════════════════════ */
.japan {
	display: grid;
	grid-template-columns: minmax(220px, 300px) 1fr;
	gap: clamp(2rem, 4vw, 3.5rem);
	align-items: center;
	padding: clamp(2.5rem, 4vw, 3.5rem) 2.5rem;
	border-bottom: 1px solid var(--rule-dark);
	/* coral sunset (the trip) bleeding into lake blue (home) */
	background:
		radial-gradient(125% 150% at 0% 0%, oklch(62% 0.17 33 / 0.06), transparent 55%),
		radial-gradient(125% 160% at 100% 100%, oklch(46% 0.13 245 / 0.05), transparent 60%);
}

.japan-kicker {
	display: inline-block;
	margin-bottom: 0.65rem;
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-size: 1rem;
	font-weight: 700;
	letter-spacing: 0.08em;
}

.japan-title {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 72, 'wght' 800;
	font-style: italic;
	font-size: clamp(1.85rem, 4vw, 2.85rem);
	line-height: 1.05;
	letter-spacing: -0.03em;
	color: var(--ink);
	margin: 0 0 0.7rem;
	text-wrap: balance;
}

.japan-dek {
	font-family: var(--font-body);
	font-size: 1.02rem;
	font-style: italic;
	line-height: 1.5;
	color: var(--ink-mid);
	margin: 0 0 0.85rem;
	max-width: 34ch;
}

.japan-dates {
	display: block;
	font-family: var(--font-mono);
	font-size: 0.66rem;
	color: var(--ink-light);
	text-transform: uppercase;
	letter-spacing: 0.06em;
}

.japan-kotsu {
	display: flex;
	align-items: center;
	gap: 0.85rem;
	margin-top: 1.2rem;
	padding-top: 1.1rem;
	border-top: 1px solid var(--rule);
	max-width: 30rem;
}

.japan-kotsu-mark {
	flex-shrink: 0;
	display: inline-grid;
	place-items: center;
	width: 2.6rem;
	height: 2.6rem;
	border: 1px solid oklch(60% 0.17 33 / 0.4);
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-size: 0.9rem;
	font-weight: 700;
	line-height: 1;
	transform: rotate(-3deg);
}

.japan-kotsu-copy {
	font-family: var(--font-body);
	font-size: 0.92rem;
	font-style: italic;
	line-height: 1.35;
	color: var(--ink-mid);
	margin: 0 0 0.3rem;
}

.japan-kotsu-links {
	display: flex;
	flex-wrap: wrap;
	gap: 0.25rem 1.1rem;
}

.japan-kotsu-links a {
	font-family: var(--font-mono);
	font-size: 0.72rem;
	letter-spacing: 0.02em;
	color: var(--trip-accent);
	text-decoration: none;
	transition: color 0.15s ease;
}

.japan-kotsu-links a:hover {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}

.japan-cards {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1.5rem;
}

.japan-card {
	display: flex;
	flex-direction: column;
	gap: 0.7rem;
	text-decoration: none;
	color: inherit;
}

.japan-img {
	aspect-ratio: 16 / 10;
	overflow: hidden;
	border-radius: 4px;
	border: 1px solid var(--rule);
}

.japan-img img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
	filter: saturate(0.94);
}

.japan-card:hover .japan-img img {
	transform: scale(1.045);
	filter: saturate(1.06);
}

.japan-img-placeholder {
	width: 100%;
	height: 100%;
	display: grid;
	place-items: center;
	background: oklch(96% 0.018 112);
	border: 1px dashed var(--rule-dark);
}

.japan-card .post-title {
	font-size: 1.2rem;
}

.japan-card:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}

@media (max-width: 820px) {
	.japan {
		grid-template-columns: 1fr;
		gap: 1.75rem;
