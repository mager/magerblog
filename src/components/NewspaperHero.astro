/* ══════════════════════════════════════════════════
   THE FEED — one chronological stream of posts + notes
══════════════════════════════════════════════════ */
.feed {
	max-width: 1080px;
	margin: 0 auto;
	padding: clamp(2rem, 5vw, 3.75rem) clamp(1.25rem, 5vw, 2.5rem) clamp(4rem, 8vw, 6rem);
}

.feed-head {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	padding-bottom: 0.9rem;
	border-bottom: 2px solid var(--ink);
}

.feed-title {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 700;
