/* ══════════════════════════════════════════════════
   PAGE LOAD ANIMATION
══════════════════════════════════════════════════ */
@keyframes fadeUp {
	from { opacity: 0; transform: translateY(12px); }
	to   { opacity: 1; transform: translateY(0); }
}

/* Ink-reveal: letters slide up from a clipping mask, staggered */
@keyframes inkReveal {
	from {
		opacity: 0;
		transform: translateY(0.18em) skewX(-2deg);
		filter: blur(6px);
	}
	to {
		opacity: 1;
		transform: translateY(0) skewX(0deg);
		filter: blur(0px);
	}
}

.hero-name {
	animation: fadeUp 0.6s ease both;
}

/* Each char in .hero-name gets staggered via JS */
.hero-name .char {
	display: inline-block;
	animation: inkReveal 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
	will-change: transform, opacity, filter;
}

.hero-meta {
	animation: fadeUp 0.6s 0.1s ease both;
}

.zone {
	animation: fadeUp 0.6s 0.2s ease both;
}

/* Cursor glow orb — positioned via JS */
.cursor-glow {
	position: fixed;
	width: 320px;
	height: 320px;
	border-radius: 50%;
	background: radial-gradient(circle, oklch(70% 0.14 145 / 0.11) 0%, transparent 70%);
	pointer-events: none;
	z-index: 9999;
	transform: translate(-50%, -50%);
	transition: left 0.12s ease, top 0.12s ease;
	will-change: left, top;
}

/* Hero parallax wrapper */
.hero {
	will-change: transform;
}

@media (prefers-reduced-motion: reduce) {
	.hero-name, .hero-meta, .zone, .hero-name .char, .name-mager, .name-co { animation: none; }
	.cursor-glow { display: none; }
}


