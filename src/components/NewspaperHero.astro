---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: CollectionEntry<'blog'>[];
	notes?: CollectionEntry<'notes'>[];
	seen?: CollectionEntry<'seen'>[];
}

const { posts, notes = [], seen = [] } = Astro.props;

// One reverse-chronological stream interleaving long-form posts, short notes,
// and "seen" photo posts — the homepage as a personal feed rather than a
// categorized front page.
type FeedItem =
	| { kind: 'post'; date: Date; entry: CollectionEntry<'blog'> }
	| { kind: 'note'; date: Date; entry: CollectionEntry<'notes'> }
	| { kind: 'seen'; date: Date; entry: CollectionEntry<'seen'> };

const feed: FeedItem[] = [
	...posts.map((entry): FeedItem => ({ kind: 'post', entry, date: entry.data.updatedDate || entry.data.pubDate })),
	...notes.map((entry): FeedItem => ({ kind: 'note', entry, date: entry.data.pubDate })),
	...seen.map((entry): FeedItem => ({ kind: 'seen', entry, date: entry.data.pubDate })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());

// Show a recent window on the homepage; the rest lives in the archives.
const FEED_LIMIT = 30;
const visible = feed.slice(0, FEED_LIMIT);
const hasMore = feed.length > FEED_LIMIT;

// Notes render as excerpts in the stream: only the first paragraph shows
// (see .entry-note-body--excerpt), with a "Read note →" link to the full note.
// render() is async, so resolve every note's Content component up front.
const noteContent = new Map<string, Awaited<ReturnType<typeof render>>['Content']>();
for (const note of notes) {
	noteContent.set(note.id, (await render(note)).Content);
}

const CATEGORY: Record<string, { label: string; href: string }> = {
	tech: { label: 'Tech', href: '/tech/' },
	food: { label: 'Food', href: '/cooking/' },
	life: { label: 'Life', href: '/life/' },
};

const hostOf = (url: string) => {
	try {
		return new URL(url).host.replace(/^www\./, '');
	} catch {
		return url;
	}
};
---

<div class="home">

	<!-- ── TOPBAR ── -->
	<div class="topbar">
		{feed[0] && (
			<span class="topbar-stamp">
				<span class="stamp-dot" aria-hidden="true"></span>
				Latest edition · <FormattedDate date={feed[0].date} />
			</span>
		)}
		<nav class="topbar-nav" aria-label="Site sections">
			<a href="/tech/" style="--acc: var(--tech-accent);">Tech</a>
			<a href="/cooking/" style="--acc: var(--food-accent);">Food</a>
			<a href="/life/" style="--acc: var(--life-accent);">Life</a>
			<span class="nav-rule" aria-hidden="true"></span>
			<a href="/notes/" style="--acc: var(--note-accent);">Notes</a>
			<a href="/seen/" style="--acc: var(--seen-accent);">Seen</a>
			<a href="/about" style="--acc: var(--ink);">About</a>
			<span class="nav-rule" aria-hidden="true"></span>
			<a href="https://bench.mager.co" target="_blank" rel="noopener" class="topbar-bench">bench<span class="bench-arrow" aria-hidden="true">↗</span></a>
		</nav>
		<div class="topbar-social">
			<a href="https://x.com/mager" target="_blank" class="topbar-social-link" aria-label="Follow @mager on X">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="topbar-social-link" aria-label="mager on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>

	<!-- ── HERO ── -->
	<section class="hero">
		<div class="hero-type">
			<h1 class="hero-name">
				<span class="sr-only">mager.co</span>
				<span class="hero-name-visual" aria-hidden="true"><span class="name-mager"><span class="g1">m</span><span class="g2">a</span><span class="g3">g</span><span class="g4">e</span><span class="g5">r</span></span><span class="name-co"><span class="g6">.</span><span class="g7">c</span><span class="g8">o</span></span></span>
			</h1>
			<div class="hero-meta">
				<p class="hero-tagline">Always learning. Always eating. Chicago.</p>
			</div>
		</div>
	</section>

	<!-- ── THE FEED ── -->
	<section class="feed" aria-label="Latest posts and notes">
		<header class="feed-head">
			<h2 class="feed-title">Latest</h2>
			<div class="feed-links">
				<a href="/notes/">Notes</a>
				<a href="/seen/">Seen</a>
				<a href="/rss.xml">RSS</a>
			</div>
		</header>

		{visible.map((item, index) => {
			if (item.kind === 'post') {
				const isLead = index === 0;
				const categoryKey = item.entry.data.category ?? 'tech';
				const categoryInfo = CATEGORY[categoryKey] ?? CATEGORY.tech;
				const wordCount = item.entry.body ? item.entry.body.trim().split(/\s+/).filter(Boolean).length : 0;
				const readingMinutes = isLead && wordCount > 0 ? Math.max(1, Math.round(wordCount / 200)) : null;
				return (
					<article class:list={['entry', 'entry--post', `entry--${categoryKey}`, { 'entry--lead': isLead }]}>
						{isLead ? (
							<div class="entry-rail entry-rail--lead">
								<span class="entry-lead-badge">The Lead · {categoryInfo.label}</span>
								<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
							</div>
						) : (
							<div class="entry-rail">
								<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
								{item.entry.data.category && CATEGORY[item.entry.data.category] && (
									<a class="entry-kind" href={CATEGORY[item.entry.data.category].href}>{CATEGORY[item.entry.data.category].label}</a>
								)}
							</div>
						)}
						<div class="entry-main">
							<div class="entry-text">
								<a class="entry-headline" href={`/blog/${item.entry.id}/`}>
									<h3>{item.entry.data.title}</h3>
								</a>
								{item.entry.data.description && (
									<p class="entry-dek">{item.entry.data.description}</p>
								)}
								{isLead ? (
									<div class="entry-lead-cta">
										<a class="entry-lead-button" href={`/blog/${item.entry.id}/`}>Read the lead →</a>
										{readingMinutes && <span class="entry-lead-readtime">{readingMinutes} min read</span>}
									</div>
								) : (
									<a class="entry-more" href={`/blog/${item.entry.id}/`}>Read post →</a>
								)}
							</div>
							{item.entry.data.heroImage && (
								<a class="entry-thumb" href={`/blog/${item.entry.id}/`} tabindex="-1" aria-hidden="true">
									<img src={item.entry.data.heroImage} alt="" loading="lazy" />
								</a>
							)}
						</div>
					</article>
				);
			}
			if (item.kind === 'seen') {
				return (
					<article class="entry entry--seen">
						<div class="entry-rail">
							<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
							<a class="entry-kind entry-kind--seen" href="/seen/">Seen</a>
						</div>
						<div class="entry-main">
							<div class="entry-text">
								<a class="entry-headline" href={`/seen/${item.entry.id}/`}>
									<h3>{item.entry.data.title}</h3>
								</a>
								<span class="entry-seen-location">📍 {item.entry.data.location}</span>
								<a class="entry-more" href={`/seen/${item.entry.id}/`}>View photo →</a>
							</div>
							<a class="entry-thumb" href={`/seen/${item.entry.id}/`} tabindex="-1" aria-hidden="true">
								<img src={item.entry.data.photo} alt="" loading="lazy" />
							</a>
						</div>
					</article>
				);
			}
			return (
				<article class="entry entry--note">
					<div class="entry-rail">
						<time class="entry-date" datetime={item.date.toISOString()}><FormattedDate date={item.date} /></time>
						<a class="entry-kind entry-kind--note" href="/notes/">Note</a>
					</div>
					<div class="entry-main">
						<div class="entry-text">
							{item.entry.data.title && (
								<a class="entry-headline" href={`/notes/${item.entry.id}/`}><h3>{item.entry.data.title}</h3></a>
							)}
							{item.entry.data.link && (
								<a class="entry-linkout" href={item.entry.data.link} target="_blank" rel="noopener">
									{item.entry.data.linkText ?? hostOf(item.entry.data.link)}
								</a>
							)}
							<div class="entry-note-body entry-note-body--excerpt">
								{(() => { const C = noteContent.get(item.entry.id)!; return <C />; })()}
							</div>
							<a class="entry-more" href={`/notes/${item.entry.id}/`}>Read note →</a>
						</div>
					</div>
				</article>
			);
		})}

		{hasMore && (
			<a class="feed-archive" href="/blog/">
				<span>Browse the full archive</span>
				<span class="feed-archive-arrow" aria-hidden="true">→</span>
			</a>
		)}
	</section>

</div><!-- /home -->

<!-- Cursor glow orb -->
<div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

<script>
	// ── Ink-reveal: split hero name into chars and stagger them ──
	// Target the visual span only — the sr-only text must stay intact and
	// must not consume stagger delays.
	const heroName = document.querySelector('.hero-name-visual') as HTMLElement | null;
	if (heroName) {
		let charIndex = 0;
		const BASE_DELAY_MS = 80; // ms per char

		function wrapChars(node: Node): void {
			if (node.nodeType === Node.TEXT_NODE) {
				const text = node.textContent || '';
				const frag = document.createDocumentFragment();
				for (const ch of text) {
					const span = document.createElement('span');
					span.className = 'char';
					span.style.animationDelay = `${(charIndex++ * BASE_DELAY_MS)}ms`;
					span.textContent = ch;
					frag.appendChild(span);
				}
				node.parentNode?.replaceChild(frag, node);
			} else if (node.nodeType === Node.ELEMENT_NODE) {
				// Walk children in reverse so replacements don't shift indices
				const children = Array.from(node.childNodes);
				for (const child of children) {
					wrapChars(child);
				}
			}
		}

		wrapChars(heroName);
	}

	// ── Cursor glow follows mouse ──
	const glow = document.getElementById('cursor-glow');
	if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let raf: number;
		let mx = -500, my = -500;
		window.addEventListener('mousemove', (e) => {
			mx = e.clientX;
			my = e.clientY;
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				glow.style.left = mx + 'px';
				glow.style.top = my + 'px';
			});
		});
		// Hide when leaving window
		document.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
		document.addEventListener('mouseenter', () => { glow.style.opacity = '1'; });
	} else if (glow) {
		glow.style.display = 'none';
	}

	// ── Hero parallax on scroll (scroll-driven or JS fallback) ──
	const hero = document.querySelector('.hero') as HTMLElement | null;
	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// Use scroll-driven animations if supported
		if (CSS.supports('animation-timeline', 'scroll()')) {
			hero.style.cssText += `
				animation: heroParallax linear both;
				animation-timeline: scroll(root block);
				animation-range: 0px 400px;
			`;
			const style = document.createElement('style');
			style.textContent = `
				@keyframes heroParallax {
					from { transform: translateY(0px); }
					to   { transform: translateY(-40px); }
				}
			`;
			document.head.appendChild(style);
		} else {
			// JS fallback
			const onScroll = () => {
				const y = window.scrollY;
				if (y < 500) {
					hero.style.transform = `translateY(${-y * 0.1}px)`;
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	}
</script>

<style>

/* ══════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════ */
.home {
	--paper:       oklch(98.8% 0.012 112);
	--ink:         oklch(11%   0.015 250);
	--ink-mid:     oklch(42%   0.010 250);
	--ink-light:   oklch(62%   0.008 250);
	--rule:        oklch(89%   0.010 112);
	--rule-dark:   oklch(79%   0.012 112);

	/* Inline code on the paper surface: dark ink text on a subtle neutral
	   tint. Overrides the dark-surface defaults from global.css so code in
	   note bodies (rendered inline in the feed) is readable, not washed out. */
	--code-bg: oklch(22% 0.012 250 / 0.08);
	--code-fg: oklch(28% 0.020 250);

	/* Wordmark sunrise — the one intentionally loud moment (see DESIGN.md).
	   Coral → gold → bronze, crossing the masthead like a sunrise. */
	--sunrise-start: #f05a36;
	--sunrise-mid:   #c49b00;
	--sunrise-end:   #b07a00;

	/* Category accents (identity — stable across seasons) */
	--tech-accent: oklch(45%  0.15  240);  /* lake blue */
	--food-accent: oklch(58%  0.17  33);   /* ripe coral */
	--life-accent: oklch(52%  0.15  150);  /* park green */
	--note-accent: oklch(50%  0.14  290);  /* margin-note violet */
	--seen-accent: oklch(55%  0.13  210);  /* sky / shutter blue */

	/* Type */
	--font-display: 'Fraunces', Georgia, serif;
	--font-body:    'Source Serif 4', Georgia, serif;
	--font-mono:    'JetBrains Mono', monospace;
	--font-ui:      'Space Grotesk', sans-serif;

	background: var(--paper);
	color: var(--ink);
	min-height: 100vh;
	position: relative;
	isolation: isolate;
	overflow: hidden;
}

.home::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		repeating-linear-gradient(
			90deg,
			oklch(46% 0.13 245 / 0.028) 0 1px,
			transparent 1px 92px
		),
		repeating-linear-gradient(
			0deg,
			oklch(60% 0.15 150 / 0.032) 0 1px,
			transparent 1px 68px
		);
}

.topbar,
.hero {
	position: relative;
	z-index: 1;
}


/* ══════════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════════ */
.topbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 1.5rem;
	padding: 0.9rem 2.5rem;
	border-bottom: 1px solid var(--rule);
}

/* Edition stamp — a quiet newspaper-style dateline derived from the newest
   item in the feed (content date, not build date, so it never lies). */
.topbar-stamp {
	display: inline-flex;
	align-items: center;
	gap: 0.5rem;
	font-family: var(--font-mono);
	font-size: 0.68rem;
	font-weight: 500;
	letter-spacing: 0.07em;
	color: var(--ink-light);
	white-space: nowrap;
}

.stamp-dot {
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: var(--sunrise-start);
	flex-shrink: 0;
}

.topbar-nav {
	display: flex;
	align-items: center;
	gap: 1.5rem;
}

/* Thin rules split the nav into sections: content · indexes · elsewhere */
.nav-rule {
	width: 1px;
	height: 0.9rem;
	background: var(--rule-dark);
}

.topbar-nav a {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--ink-mid);
	text-decoration: none;
	padding-bottom: 2px;
	box-shadow: inset 0 -2px 0 transparent;
	transition: color 0.15s ease, box-shadow 0.15s ease;
}

.topbar-nav a:hover {
	color: var(--acc, var(--ink));
	box-shadow: inset 0 -2px 0 var(--acc, var(--ink));
}

/* Bench is a tool, not a section — monospace, lowercase, arrow out. */
.topbar-nav a.topbar-bench {
	font-family: var(--font-mono);
	font-weight: 500;
	text-transform: none;
	letter-spacing: 0.02em;
	--acc: var(--sunrise-start);
}

.bench-arrow {
	display: inline-block;
	font-size: 0.85em;
	margin-left: 0.25em;
	transition: transform 0.15s ease;
}

.topbar-bench:hover .bench-arrow {
	transform: translate(2px, -2px);
}

.topbar-social {
	display: flex;
	align-items: center;
	gap: 0.25rem;
	padding-left: 1.5rem;
	border-left: 1px solid var(--rule);
}

.topbar-social-link {
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--ink-mid);
	padding: 0.35em;
	border-radius: 4px;
	transition: color 0.15s ease;
}

.topbar-social-link:hover {
	color: var(--ink);
}

/* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
.hero {
	padding: 4rem 2.5rem 3.5rem;
	border-bottom: 1px solid var(--rule-dark);
	overflow: hidden;
	isolation: isolate;
}

.hero::after {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		linear-gradient(110deg, transparent 0 62%, oklch(72% 0.15 33 / 0.08) 62% 62.35%, transparent 62.35%),
		linear-gradient(110deg, transparent 0 71%, oklch(46% 0.13 245 / 0.08) 71% 71.35%, transparent 71.35%),
		linear-gradient(110deg, transparent 0 78%, oklch(60% 0.15 150 / 0.06) 78% 78.25%, transparent 78.25%);
}

.hero-type {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
	position: relative;
	z-index: 1;
}

.hero-name {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 144, 'wght' 900;
	font-style: italic;
	font-size: clamp(5.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.04em;
	margin: 0;
}

/* Sunrise wordmark — the DESIGN.md hero gradient (#f05a36 → #c49b00 →
   #b07a00) sampled per glyph so it survives the char-split animation:
   coral at dawn on the left, bronze gold by the "o". */
.g1 { color: #f05a36; }
.g2 { color: #e36d27; }
.g3 { color: #d77f17; }
.g4 { color: #ca9208; }
.g5 { color: #c19600; }
.g6 { color: #bb8d00; }
.g7 { color: #b68300; }
.g8 { color: #b07a00; }

/* Light shimmer: a small brightness pulse after ink-reveal finishes */
@keyframes seasonalShimmer {
	0%, 100% { filter: brightness(1); }
	50%      { filter: brightness(1.16) saturate(1.08); }
}

.name-mager,
.name-co {
	animation: seasonalShimmer 3.5s 1.5s ease-in-out infinite;
}

.hero-meta {
	padding-bottom: 0.5rem;
	max-width: 280px;
	flex-shrink: 0;
}

.hero-tagline {
	font-family: var(--font-body);
	font-size: 1.05rem;
	font-style: italic;
	color: var(--ink-mid);
	margin: 0;
	line-height: 1.4;
}

/* ══════════════════════════════════════════════════
   THE FEED — one chronological stream of posts + notes
══════════════════════════════════════════════════ */
.feed {
	max-width: 1200px;
	margin: 0 auto;
	padding: clamp(2rem, 5vw, 3.75rem) clamp(1.25rem, 5vw, 2.5rem) clamp(4rem, 8vw, 6rem);
}

.feed-head {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	padding-bottom: 0.9rem;
	border-bottom: 2px solid var(--ink);
}

.feed-title {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.16em;
	color: var(--ink);
	margin: 0;
}

.feed-links {
	display: flex;
	gap: 1.25rem;
	font-family: var(--font-mono);
	font-size: 0.72rem;
}

.feed-links a { color: var(--ink-light); text-decoration: none; transition: color 0.15s ease; }
.feed-links a:hover { color: var(--ink); }

/* ── Entry ── */
.entry {
	--accent: var(--tech-accent);
	display: grid;
	grid-template-columns: 7rem 1fr;
	gap: 0 clamp(1.25rem, 3vw, 2.5rem);
	padding: clamp(1.6rem, 2.8vw, 2.5rem) 0;
	border-top: 1px solid var(--rule);
}

.entry--tech { --accent: var(--tech-accent); }
.entry--food { --accent: var(--food-accent); }
.entry--life { --accent: var(--life-accent); }
.entry--note { --accent: var(--note-accent); }
.entry--seen { --accent: var(--seen-accent); }

