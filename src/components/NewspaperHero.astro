---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
interface Props { posts: CollectionEntry<'blog'>[]; notes?: CollectionEntry<'notes'>[]; seen?: CollectionEntry<'seen'>[]; }
const { posts, notes = [], seen = [] } = Astro.props;
const tech = posts.filter(post => !post.data.category || post.data.category === 'tech');
const food = posts.filter(post => post.data.category === 'food');
const life = posts.filter(post => post.data.category === 'life');
const lead = tech[0];
// The front page's photographic slots use our permanent image store. Legacy
// Google Photos URLs remain untouched in the articles and category archives.
const publicationImage = (url?: string) => !!url && !url.includes('lh3.googleusercontent.com');
const foodFeatures = food.filter(post => publicationImage(post.data.heroImage)).slice(0, 3);
const foodSpread = foodFeatures.length ? foodFeatures : food.slice(0, 3);
const noteExcerpt = (note: CollectionEntry<'notes'>) => {
  const paragraph = (note.body || '').trim().split(/\n\s*\n/)[0] || '';
  const text = paragraph.replace(/!?\[([^\]]+)\]\([^)]+\)/g, '$1').replace(/<[^>]*>/g, '').replace(/[*_`#]/g, '').replace(/\s+/g, ' ').trim();
  const words = text.split(' ');
  return words.slice(0, 32).join(' ') + (words.length > 32 ? '…' : '');
};
const dateOf = (post: CollectionEntry<'blog'>) => post.data.updatedDate || post.data.pubDate;
const minutes = (post: CollectionEntry<'blog'>) => Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 220));
const noteTitle = (note: CollectionEntry<'notes'>) => note.data.title || note.data.linkText || 'From the notebook';
const archive = posts.slice(5).map(post => ({ title: post.data.title, href: `/blog/${post.id}/`, category: post.data.category === 'food' ? 'Food' : post.data.category === 'life' ? 'Life' : 'Tech' }));
const archivePick = archive[Math.floor(archive.length / 2)];
---
<div class="newspaper">
  <nav class="edition-index" aria-label="In this edition">
    <span>Inside this edition</span>
    {tech.length > 0 && <a href="#technology">01 <b>Tech</b></a>}
    {food.length > 0 && <a href="#food">02 <b>Food</b></a>}
    {seen.length > 0 && <a href="#seen">03 <b>Seen</b></a>}
    {life.length > 0 && <a href="#life">04 <b>Life</b></a>}
    <span class="edition-signoff">Made of things worth sharing.</span>
  </nav>

  <div class="front-spread">
    <section class="technology" id="technology" aria-labelledby="tech-heading">
      <div class="section-rule tech-rule"><h2 id="tech-heading">01 / Technology &amp; making things</h2><a href="/tech/">All tech <span aria-hidden="true">↗</span></a></div>
      {lead && <article class="lead-story">
        <div class="story-meta"><span>The lead</span><span><FormattedDate date={dateOf(lead)} /> · {minutes(lead)} min read</span></div>
        <a class="headline-link" href={`/blog/${lead.id}/`}><h2>{lead.data.title}</h2></a>
        <p class="lead-dek">{lead.data.description}</p>
        {lead.data.heroImage && <a class="lead-photo photo-link" href={`/blog/${lead.id}/`} aria-label={`Read ${lead.data.title}`}><img src={lead.data.heroImage} alt="" fetchpriority="high" loading="eager" decoding="async" width="1000" height="560" /><span class="photo-cta">Read the story <span aria-hidden="true">↗</span></span></a>}
        {!lead.data.heroImage && <a class="text-link" href={`/blog/${lead.id}/`}>Read the story <span aria-hidden="true">↗</span></a>}
      </article>}
      <div class="tech-columns">
        {tech.slice(1, 7).map((post, i) => <article>
          <span class="column-number">0{i + 2}</span>
          <a class="headline-link" href={`/blog/${post.id}/`}><h3>{post.data.title}</h3></a>
          <p>{post.data.description}</p>
          <span class="small-date"><FormattedDate date={dateOf(post)} /></span>
        </article>)}
      </div>
    </section>

    <aside class="side-column" aria-label="The notebook and mager-bench">
      <section class="bench-insert" aria-labelledby="bench-heading">
        <div class="insert-label"><span>From the workbench</span><span aria-hidden="true">↗</span></div>
        <a href="https://bench.mager.co" class="bench-title"><h2 id="bench-heading">mager<br /><span>bench.</span></h2></a>
        <p>Same tasks. <br />Different models. <br /><em>See what holds up.</em></p>
        <div class="bench-tests" aria-label="Benchmark dimensions"><span>Correctness</span><span>Code quality</span><span>Documentation</span></div>
        <a class="bench-action" href="https://bench.mager.co">Explore the benchmark <span aria-hidden="true">↗</span></a>
        <a class="bench-method" href="/blog/2026-07-05-mager-bench/">Why I built it</a>
      </section>
      {notes.length > 0 && <section class="notebook" aria-labelledby="notes-heading">
        <div class="section-rule"><h2 id="notes-heading">The notebook</h2><a href="/notes/">All notes ↗</a></div>
        <p class="section-caption">Quick thoughts. Open tabs. Things learned.</p>
        {notes.slice(0, 3).map(note => <article class="note-preview">
          <span class="small-date"><FormattedDate date={note.data.pubDate} /></span>
          <a class="headline-link" href={`/notes/${note.id}/`}><h3>{noteTitle(note)}</h3></a>
          <p class="note-excerpt">{noteExcerpt(note)}</p>
          <a class="text-link" href={`/notes/${note.id}/`}>Read note <span aria-hidden="true">↗</span></a>
        </article>)}
      </section>}
    </aside>
  </div>

  {food.length > 0 && <section class="food-section" id="food" aria-labelledby="food-heading">
    <div class="section-rule food-rule"><h2 id="food-heading">02 / Food &amp; the kitchen</h2><a href="/cooking/">All recipes <span aria-hidden="true">↗</span></a></div>
    <div class="food-heading"><h3>Something good<br />is cooking.</h3><p>Recipes I come back to. <br />Ingredients I get curious about.</p></div>
    <div class="food-spread">
      {foodSpread.map((post, i) => <article class:list={['food-story', { 'food-lead': i === 0 }]}>
        {post.data.heroImage && <a class="food-photo photo-link" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}><img src={post.data.heroImage} alt="" loading="lazy" decoding="async" width="800" height="600" /></a>}
        <div class="story-meta"><span>{i === 0 ? 'Fresh from the kitchen' : 'Recipe'}</span>{post.data.prepTime != null && <span>{post.data.prepTime + (post.data.cookTime || 0)} min</span>}</div>
        <a class="headline-link" href={`/blog/${post.id}/`}><h3>{post.data.title}</h3></a>
        <p>{post.data.description}</p>
      </article>)}
    </div>
  </section>}

  <div class="weekend-spread">
    {seen.length > 0 && <section class="seen-section" id="seen" aria-labelledby="seen-heading">
      <div class="section-rule"><h2 id="seen-heading">03 / Seen</h2><a href="/seen/">The photo journal <span aria-hidden="true">↗</span></a></div>
      <div class="seen-intro"><h3>A little evidence<br />of being here.</h3><span class="frame-mark" aria-hidden="true">⌖</span></div>
      <div class="photo-strip" tabindex="0" role="region" aria-label="Recent photographs, scroll for more">
        {seen.slice(0, 4).map((photo, i) => <figure>
          <a class="seen-photo photo-link" href={`/seen/${photo.id}/`}><img src={photo.data.photo} alt={photo.data.alt || photo.data.title} loading="lazy" decoding="async" width="600" height="700" /></a>
          <figcaption><span class="frame-number">[{String(i + 1).padStart(2, '0')}]</span><div><a href={`/seen/${photo.id}/`}>{photo.data.title}</a><span>{photo.data.location}</span></div></figcaption>
        </figure>)}
      </div>
    </section>}
    {life.length > 0 && <section class="life-section" id="life" aria-labelledby="life-heading">
      <div class="section-rule"><h2 id="life-heading">04 / Life</h2><a href="/life/">All life ↗</a></div>
      <h3 class="life-title">Away from<br /><em>the keyboard.</em></h3>
      {life.slice(0, 2).map((post, i) => <article>
        {i === 0 && publicationImage(post.data.heroImage) && <a class="life-photo photo-link" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}><img src={post.data.heroImage} alt="" loading="lazy" decoding="async" width="600" height="400" /></a>}
        <a class="headline-link" href={`/blog/${post.id}/`}><h3>{post.data.title}</h3></a>
        <p>{post.data.description}</p>
        <span class="small-date"><FormattedDate date={dateOf(post)} /></span>
      </article>)}
    </section>}
  </div>

  {archivePick && <section class="back-page" aria-labelledby="back-page-heading" data-archive={JSON.stringify(archive)}>
    <div class="back-label"><span class="small-date">One more before you go</span><h2 id="back-page-heading">The back page.</h2></div>
    <div class="archive-pick" aria-live="polite" aria-atomic="true"><span class="small-date" data-pick-category>{archivePick.category} / From the archives</span><a href={archivePick.href} data-pick-link>{archivePick.title}</a></div>
    <button type="button" class="shuffle-button" hidden>Another story <span aria-hidden="true">⤨</span></button>
  </section>}
</div>
<script>
// Retain the story link and caption if a remote image later becomes unavailable.
document.querySelectorAll<HTMLImageElement>('.newspaper .photo-link img').forEach(img => {
  const recover = () => {
    const frame = img.closest<HTMLElement>('.photo-link');
    if (!frame) return;
    img.hidden = true;
    frame.classList.add('photo-unavailable');
    const label = document.createElement('span');
    label.className = 'photo-fallback';
    label.textContent = img.alt || frame.getAttribute('aria-label') || 'View the story';
    frame.append(label);
  };
  if (img.complete && img.naturalWidth === 0) recover();
  else img.addEventListener('error', recover, { once: true });
});
const backPage = document.querySelector<HTMLElement>('[data-archive]');
if (backPage) {
  const stories: { title: string; href: string; category: string }[] = JSON.parse(backPage.dataset.archive || '[]');
  const button = backPage.querySelector<HTMLButtonElement>('button');
  const link = backPage.querySelector<HTMLAnchorElement>('[data-pick-link]');
  const category = backPage.querySelector<HTMLElement>('[data-pick-category]');
  if (button && link && category && stories.length > 1) {
    button.hidden = false;
    button.addEventListener('click', () => {
      const alternatives = stories.filter(story => story.href !== link.getAttribute('href'));
      const story = alternatives[Math.floor(Math.random() * alternatives.length)];
      link.href = story.href;
      link.textContent = story.title;
      category.textContent = `${story.category} / From the archives`;
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        link.animate([{opacity: .25, transform: 'translateY(5px)'}, {opacity: 1, transform: 'translateY(0)'}], {duration: 280, easing: 'cubic-bezier(.22,1,.36,1)'});
      }
    });
  }
}
</script>
<style>
.newspaper { max-width: 1288px; padding: 0 24px 48px; margin: auto; font-family: var(--news-serif); }
.newspaper :is(h2,h3,p) { margin: 0; }
.newspaper :is(h2,h3) { color: inherit; font-family: var(--news-serif); }
.newspaper a { color: inherit; }
.newspaper a:hover { text-decoration: underline; text-underline-offset: 4px; }
.newspaper section { scroll-margin-top: 24px; min-width: 0; }
.edition-index { display: flex; align-items: center; gap: 25px; padding: 15px 0 22px; font: 10px/1.5 var(--news-mono); }
.edition-index > span:first-child { text-transform: uppercase; color: var(--news-muted); font-size: 9px; letter-spacing: .04em; }
.edition-index a { display: flex; align-items: center; gap: 7px; min-height: 30px; }
.edition-index a:hover { color: var(--news-blue); }
.edition-signoff { margin-left: auto; font: italic 14px var(--news-serif); }
.front-spread { display: grid; grid-template-columns: minmax(0, 2.55fr) minmax(250px, 1fr); gap: 32px; }
.section-rule { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 11px 0; border-top: 2px solid currentColor; border-bottom: 1px solid var(--news-rule); }
.section-rule h2, .section-rule a { font: 700 10px/1.5 var(--news-ui); text-transform: uppercase; letter-spacing: .08em; }
.section-rule a { white-space: nowrap; font-size: 10px; letter-spacing: 0; text-transform: none; }
.tech-rule { color: var(--news-blue); }
.story-meta { display: flex; align-items: center; justify-content: space-between; gap: 10px; font: 500 10px/1.5 var(--news-mono); color: var(--news-muted); margin: 18px 0 12px; }
.story-meta > span:first-child { color: var(--news-blue); text-transform: uppercase; letter-spacing: .08em; }
.lead-story .headline-link h2 { font-weight: 750; font-size: clamp(36px, 4.7vw, 62px); line-height: 1.02; letter-spacing: -.045em; text-wrap: balance; }
.headline-link:hover { text-decoration-thickness: 1px; }
.technology .headline-link:hover { color: var(--news-blue); }
.lead-story .lead-dek { font-size: 18px; line-height: 1.5; margin: 16px 0 21px; max-width: 67ch; color: var(--news-muted); }
.photo-link { display: block; overflow: hidden; position: relative; }
.photo-link img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0; transition: transform 600ms var(--news-ease); }
.photo-link img[hidden] { display: none; }
.photo-link.photo-unavailable { background: var(--news-ink); color: var(--news-paper); }
.photo-link :global(.photo-fallback) { display: block; padding: 24px; max-width: 30ch; font: 500 18px/1.4 var(--news-serif); }
.photo-link:hover img { transform: scale(1.025); }
.lead-photo { aspect-ratio: 16/8.4; background: var(--news-ink); }
.photo-cta { position: absolute; bottom: 14px; right: 14px; display: flex; gap: 24px; align-items: center; padding: 12px 15px; background: var(--news-paper); color: var(--news-ink); font: 700 11px var(--news-ui); }
.tech-columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--news-rule); }
.tech-columns article:not(:nth-child(3n + 1)) { padding-left: 20px; border-left: 1px solid var(--news-rule); }
.tech-columns article:nth-child(n + 4) { border-top: 1px solid var(--news-rule); padding-top: 18px; }
.column-number { font: 500 11px var(--news-mono); color: var(--news-blue); }
.tech-columns h3 { font-size: 22px; line-height: 1.13; margin-top: 8px; letter-spacing: -.025em; }
.tech-columns p { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; margin: 12px 0; font-size: 14px; line-height: 1.5; color: var(--news-muted); }
.small-date { font: 400 10px/1.5 var(--news-mono); color: var(--news-muted); }
.side-column { min-width: 0; border-left: 1px solid var(--news-rule); padding-left: 28px; }
.bench-insert { background: var(--news-yellow); color: var(--news-ink); padding: 20px; position: relative; }
.insert-label { display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid color-mix(in oklch, var(--news-ink) 30%, transparent); padding-bottom: 12px; font: 700 9px/1.3 var(--news-mono); text-transform: uppercase; letter-spacing: .05em; }
.insert-label > span:last-child { font-size: 20px; }
.bench-insert .bench-title:hover { text-decoration: none; }
.bench-insert h2 { font: 800 clamp(44px, 4.7vw, 62px)/.85 var(--news-ui); letter-spacing: -.065em; margin: 22px 0 18px; }
.bench-insert h2 span { color: var(--news-blue); }
.bench-insert p { font: 18px/1.35 var(--news-serif); }
.bench-tests { display: flex; flex-wrap: wrap; gap: 7px 10px; margin: 19px 0; font: 9px/1.5 var(--news-mono); }
.bench-tests span::before { content: '↳ '; }
.bench-action { display: flex; justify-content: space-between; align-items: center; min-height: 44px; border-top: 1px solid var(--news-ink); font: 700 11px var(--news-ui); }
.bench-method { display: inline-flex; align-items: center; min-height: 28px; font: 11px var(--news-serif); text-decoration: underline; text-underline-offset: 3px; }
.notebook { margin-top: 30px; }
.notebook .section-caption { font: italic 13px/1.5 var(--news-serif); margin-top: 10px; color: var(--news-muted); }
.note-preview { padding: 17px 0; border-bottom: 1px solid var(--news-rule); }
.note-preview h3 { font-size: 20px; line-height: 1.15; margin-top: 7px; }
.note-excerpt { font-size: 13px; line-height: 1.5; color: var(--news-muted); margin: 10px 0; }
.text-link { display: inline-flex; align-items: center; min-height: 32px; font: 700 10px var(--news-ui); gap: 12px; }
.food-section { background: oklch(94% 0.026 55); margin: 46px -24px 0; padding: 25px 24px 30px; color: var(--news-red); }
.food-rule { border-bottom-color: color-mix(in oklch, var(--news-red) 30%, transparent); }
.food-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; padding: 24px 0; }
.food-heading h3 { font: 750 clamp(36px, 4.5vw, 58px)/.99 var(--news-display); letter-spacing: -.04em; }
.food-heading p { font-size: 15px; line-height: 1.5; }
.food-spread { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 25px; }
.food-photo { aspect-ratio: 4/3; }
.food-lead .food-photo { aspect-ratio: 1.87; }
.food-story { color: var(--news-ink); }
.food-story .story-meta > span:first-child { color: var(--news-red); font-size: 9px; }
.food-story h3 { font-size: 27px; line-height: 1.05; letter-spacing: -.025em; }
.food-lead h3 { font-size: 35px; }
.food-story p { margin-top: 10px; font-size: 14px; line-height: 1.5; color: var(--news-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.food-story a:hover { color: var(--news-red); }
.weekend-spread { display: grid; grid-template-columns: minmax(0, 2.55fr) minmax(250px, 1fr); gap: 32px; margin-top: 44px; }
.seen-section, .life-section { color: var(--news-green); }
.seen-intro { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 22px 0; }
.seen-intro h3 { font-size: clamp(32px, 3.3vw, 43px); line-height: 1.05; letter-spacing: -.03em; }
.frame-mark { font: 60px/1 var(--news-serif); }
.photo-strip { display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 15px; scrollbar-color: var(--news-green) var(--news-paper); scrollbar-width: thin; }
.photo-strip figure { margin: 0; flex: 0 0 44%; min-width: 0; scroll-snap-align: start; }
.seen-photo { aspect-ratio: 6/7; }
.photo-strip figcaption { display: flex; gap: 10px; padding-top: 12px; color: var(--news-ink); }
.frame-number { font: 10px/1.8 var(--news-mono); color: var(--news-green); }
.photo-strip figcaption a { font: 600 15px/1.2 var(--news-serif); }
.photo-strip figcaption div > span { display: block; margin-top: 6px; font: 10px/1.5 var(--news-mono); color: var(--news-muted); }
.life-section { padding-left: 28px; border-left: 1px solid var(--news-rule); }
.life-section .life-title { font: 600 32px/1.08 var(--news-serif); letter-spacing: -.03em; margin: 24px 0; }
.life-section article { color: var(--news-ink); padding-bottom: 20px; }
.life-section article + article { border-top: 1px solid var(--news-rule); padding-top: 18px; }
.life-photo { aspect-ratio: 3/2; margin-bottom: 15px; }
.life-section article h3 { font-size: 23px; line-height: 1.15; }
.life-section article p { font-size: 14px; line-height: 1.5; margin: 10px 0; color: var(--news-muted); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.back-page { display: grid; grid-template-columns: 1fr 1.6fr auto; gap: 30px; align-items: center; margin-top: 40px; padding: 25px 0; border-block: 1px solid var(--news-ink); }
.back-label h2 { font: 700 32px/1.1 var(--news-display); letter-spacing: -.04em; margin-top: 6px; }
.archive-pick a { display: block; font: 600 20px/1.25 var(--news-serif); margin-top: 7px; }
.shuffle-button { background: transparent; border: 1px solid var(--news-ink); padding: 12px 15px; min-height: 44px; font: 600 11px var(--news-ui); color: var(--news-ink); cursor: pointer; }
.shuffle-button:hover { background: var(--news-yellow); }
.shuffle-button span { margin-left: 14px; font-size: 18px; }
@media(max-width: 980px) {
  .front-spread, .weekend-spread { grid-template-columns: minmax(0, 1.9fr) minmax(230px, 1fr); gap: 24px; }
  .side-column, .life-section { padding-left: 22px; }
  .tech-columns { grid-template-columns: 1fr; gap: 16px; }
  .tech-columns article:not(:nth-child(3n + 1)) { padding-left: 0; border-left: 0; }
  .tech-columns article + article { padding: 16px 0 0; border-left: 0; border-top: 1px solid var(--news-rule); }
  .tech-columns h3 { font-size: 24px; }
  .tech-columns p { -webkit-line-clamp: 2; }
  .edition-signoff { display: none; }
}
@media(max-width: 700px) {
  .newspaper { padding: 0 18px 30px; }
  .edition-index { gap: 16px; flex-wrap: wrap; padding: 12px 0 18px; }
  .edition-index > span:first-child { flex-basis: 100%; }
  .edition-index a { min-height: 30px; }
  .front-spread, .weekend-spread { grid-template-columns: minmax(0, 1fr); gap: 30px; }
  .side-column, .life-section { border-left: 0; padding-left: 0; }
  .lead-story .headline-link h2 { font-size: clamp(36px, 8vw, 52px); }
  .lead-story .lead-dek { font-size: 17px; }
  .story-meta { font-size: 9px; flex-wrap: wrap; }
  .tech-columns { grid-template-columns: 1fr; }
  .tech-columns p { -webkit-line-clamp: 2; }
  .bench-insert { padding: 22px; }
  .bench-insert h2 { font-size: 64px; }
  .bench-insert h2 br { display: initial; }
  .bench-insert p br { display: none; }
  .bench-insert p br::after { content: " "; }
  .bench-insert p { max-width: 30ch; }
  .notebook { margin-top: 28px; }
  .note-preview h3 { font-size: 23px; }
  .note-excerpt { font-size: 15px; }
  .food-section { margin: 30px -18px 0; padding: 22px 18px 28px; }
  .food-heading { align-items: start; flex-direction: column; gap: 15px; }
  .food-heading h3 { font-size: 44px; }
  .food-heading p br { display: none; }
  .food-spread { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 25px 18px; }
  .food-lead { grid-column: 1/-1; }
  .food-lead .food-photo { aspect-ratio: 1.5; }
  .food-story h3 { font-size: 23px; }
  .food-lead h3 { font-size: 32px; }
  .food-story:not(.food-lead) p { display: none; }
  .food-story .story-meta { gap: 5px; font-size: 9px; }
  .photo-strip figure { flex-basis: 76%; }
  .weekend-spread { margin-top: 30px; }
  .back-page { grid-template-columns: 1fr; gap: 20px; }
