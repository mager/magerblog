	color: var(--ink-light);
	text-decoration: none;
	transition: color 0.2s ease;
}
.entry-more:hover { color: var(--accent); }

/* ── Post thumbnail ── */
.entry-thumb {
	flex: 0 0 clamp(92px, 11vw, 148px);
	display: block;
	border-radius: 8px;
	overflow: hidden;
	border: 1px solid var(--rule);
