/* ── Entry ── */
.entry {
	--accent: var(--tech-accent);
	display: grid;
	grid-template-columns: 7rem 1fr;
	gap: 0 clamp(1.25rem, 3vw, 2.5rem);
	padding: clamp(1.6rem, 2.8vw, 2.5rem) 0;
	border-top: 1px solid var(--rule);
}

.entry--tech { --accent: var(--tech-accent); }
.entry--food { --accent: var(--food-accent); }
.entry--life { --accent: var(--life-accent); }
.entry--note { --accent: var(--note-accent); }

/* ── Dateline rail ── */
.entry-rail {
	display: flex;
	flex-direction: column;
	gap: 0.5rem;
	padding-top: 0.4rem;
}

.entry-date {
	display: flex;
	align-items: center;
	gap: 0.5rem;
	font-family: var(--font-mono);
	font-size: 0.7rem;
	letter-spacing: 0.04em;
	text-transform: uppercase;
	color: var(--ink-light);
	white-space: nowrap;
}

/* Accent node dot — colors the stream by entry type at a glance. */
.entry-date::before {
	content: '';
	width: 8px;
	height: 8px;
	border-radius: 50%;
	background: var(--accent);
	box-shadow: 0 0 0 3px color-mix(in oklch, var(--accent) 16%, transparent);
	flex: none;
}

