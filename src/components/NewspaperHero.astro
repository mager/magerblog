---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	codePosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
}

const { codePosts, lifePosts, recipePosts } = Astro.props;

// Get more code posts for the dense section (6-8)
const topCode = codePosts.slice(0, 7);
// Food gets medium treatment (4)
const topFood = recipePosts.slice(0, 4);
// Life is rare — feature the most recent prominently
const topLife = lifePosts.slice(0, 2);

// Current date in newspaper format
const today = new Date();
const dateString = today.toLocaleDateString('en-US', {
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric'
});

// Helper to format reading time estimate
const readingTime = (text: string = '') => Math.max(1, Math.ceil(text.split(' ').length / 200));
---

<div class="newspaper">
	<!-- ══════════════════════ MASTHEAD ══════════════════════ -->
	<header class="masthead">
		<div class="masthead-inner">
			<div class="masthead-top">
				<div class="edition">Chicago Edition</div>
				<div class="tagline">Always learning. Always eating.</div>
				<div class="weather">{dateString}</div>
			</div>
			<h1 class="masthead-title">
				<span class="title-line">The</span>
				<span class="title-main">mager.co</span>
				<span class="title-line">Chronicle</span>
			</h1>
			<nav class="masthead-nav" aria-label="Sections">
				<a href="/code/" class="nav-link nav-code">Technology</a>
				<span class="nav-divider">|</span>
				<a href="/cooking/" class="nav-link nav-food">Dining</a>
				<span class="nav-divider">|</span>
				<a href="/life/" class="nav-link nav-life">Life & Arts</a>
				<span class="nav-divider">|</span>
				<a href="/about" class="nav-link nav-about">About</a>
			</nav>
		</div>
	</header>

	<!-- ══════════════════════ MAIN CONTENT ══════════════════════ -->
	<main class="front-page">
		<!-- CODE SECTION — Dense, technical, newspaper column feel -->
		<section class="section section-code">
			<div class="section-header">
				<h2 class="section-title">Technology</h2>
				<a href="/code/" class="section-more">View All →</a>
			</div>
			<div class="code-grid">
				{topCode.map((post, i) => (
					<a href={`/blog/${post.id}/`} class:list={['code-item', { 'code-feature': i === 0 }]}>
						<div class="code-meta">
							<span class="code-date"><FormattedDate date={post.data.pubDate} /></span>
							{post.data.updatedDate && (
								<span class="code-updated">Updated</span>
							)}
						</div>
						<h3 class="code-headline">{post.data.title}</h3>
						{post.data.description && (
							<p class="code-lede">{post.data.description}</p>
						)}
					</a>
				))}
			</div>
		</section>

		<!-- DIVIDER -->
		<div class="section-divider thick"></div>

		<!-- MIDDLE ROW: FOOD + LIFE -->
		<div class="middle-row">
			<!-- FOOD SECTION -->
			<section class="section section-food">
				<div class="section-header">
					<h2 class="section-title">Dining</h2>
					<a href="/cooking/" class="section-more">Archive →</a>
				</div>
				<div class="food-grid">
					{topFood.map(post => (
						<a href={`/blog/${post.id}/`} class="food-card">
							{post.data.heroImage && (
								<div class="food-image">
									<img src={post.data.heroImage} alt="" loading="lazy" />
								</div>
							)}
							<div class="food-content">
								<h3 class="food-headline">{post.data.title}</h3>
								<p class="food-lede">{post.data.description}</p>
								<span class="food-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					))}
				</div>
			</section>

			<!-- LIFE SECTION — Rare, beautiful, featured -->
			<section class="section section-life">
				<div class="section-header">
					<h2 class="section-title">Life & Arts</h2>
					<a href="/life/" class="section-more">All Stories →</a>
				</div>
				{topLife.length > 0 ? (
					<div class="life-feature">
						{topLife.map(post => (
							<a href={`/blog/${post.id}/`} class="life-card">
								{post.data.heroImage && (
									<div class="life-image">
										<img src={post.data.heroImage} alt="" loading="lazy" />
									</div>
								)}
								<div class="life-content">
									<span class="life-label">Featured</span>
									<h3 class="life-headline">{post.data.title}</h3>
									<p class="life-lede">{post.data.description}</p>
									<span class="life-date"><FormattedDate date={post.data.pubDate} /></span>
								</div>
							</a>
						))}
					</div>
				) : (
					<div class="life-empty">
						<p class="empty-text">Stories from life, coming soon.</p>
					</div>
				)}
			</section>
		</div>
	</main>

	<!-- ══════════════════════ FOOTER ══════════════════════ -->
	<footer class="newspaper-footer">
		<div class="footer-inner">
			<p class="footer-tagline">Published from Chicago, IL</p>
			<div class="footer-links">
				<a href="/rss.xml">RSS</a>
				<a href="https://x.com/mager">@mager</a>
				<a href="https://github.com/mager">GitHub</a>
			</div>
		</div>
	</footer>
</div>

<style>
/* ═══════════════════════════════════════════════════════════════
   NEWSPAPER AESTHETIC — Dense, editorial, tactile
   ═══════════════════════════════════════════════════════════════ */

.newspaper {
	--ink: #0a0a0a;
	--ink-light: #333;
	--ink-muted: #666;
	--paper: #faf8f5;
	--paper-warm: #f5f2ed;
	--rule: #d4d0c8;
	--rule-light: #e8e4dc;
	--accent-code: #1a1a2e;
	--accent-food: #8b4513;
	--accent-life: #2d5016;

	background: var(--paper);
	color: var(--ink);
	font-family: 'Source Serif 4', Georgia, serif;
	min-height: 100vh;
}

/* ═══ MASTHEAD ═══ */
.masthead {
	border-bottom: 3px double var(--ink);
	padding: 1.5rem 0 1rem;
	background: var(--paper);
}

.masthead-inner {
	max-width: 1200px;
	margin: 0 auto;
	padding: 0 2rem;
	text-align: center;
}

.masthead-top {
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.7rem;
	text-transform: uppercase;
	letter-spacing: 0.08em;
	color: var(--ink-muted);
	border-bottom: 1px solid var(--rule);
	padding-bottom: 0.5rem;
	margin-bottom: 1rem;
}

.edition { font-weight: 600; }
.tagline { font-style: italic; }
.weather { font-weight: 500; }

.masthead-title {
	margin: 0.75rem 0 1rem;
	display: flex;
	flex-direction: column;
	align-items: center;
	gap: 0.25rem;
}

.title-line {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.85rem;
	font-weight: 400;
	letter-spacing: 0.3em;
	text-transform: uppercase;
	color: var(--ink-muted);
}

.title-main {
	font-family: 'Playfair Display', 'Times New Roman', serif;
	font-size: clamp(2.5rem, 8vw, 4.5rem);
	font-weight: 900;
	letter-spacing: -0.02em;
	line-height: 1;
	color: var(--ink);
}

.masthead-nav {
	display: flex;
	justify-content: center;
	align-items: center;
	gap: 0.5rem;
	padding-top: 1rem;
	border-top: 1px solid var(--rule);
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.75rem;
	text-transform: uppercase;
	letter-spacing: 0.1em;
}

.nav-link {
	color: var(--ink-light);
	text-decoration: none;
	padding: 0.35rem 0.75rem;
	transition: color 0.2s ease;
	position: relative;
}

.nav-link::after {
	content: '';
	position: absolute;
	bottom: 0;
	left: 50%;
	width: 0;
	height: 1px;
	background: var(--ink);
	transition: all 0.2s ease;
	transform: translateX(-50%);
}

.nav-link:hover {
	color: var(--ink);
}

.nav-link:hover::after {
	width: 80%;
}

.nav-divider {
	color: var(--rule);
	font-weight: 300;
}

/* ═══ FRONT PAGE ═══ */
.front-page {
	max-width: 1200px;
	margin: 0 auto;
	padding: 2rem;
}

/* ═══ SECTIONS ═══ */
.section {
	margin-bottom: 2rem;
}

.section-header {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	border-bottom: 2px solid var(--ink);
	padding-bottom: 0.5rem;
	margin-bottom: 1.5rem;
}

.section-title {
	font-family: 'Playfair Display', serif;
	font-size: 1.4rem;
	font-weight: 800;
	margin: 0;
	letter-spacing: -0.01em;
}

.section-more {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.7rem;
	color: var(--ink-muted);
	text-decoration: none;
	transition: color 0.2s ease;
}

.section-more:hover {
	color: var(--ink);
}

.section-divider {
	height: 1px;
	background: var(--rule);
	margin: 2rem 0;
}

.section-divider.thick {
	height: 2px;
	background: var(--ink);
}

/* ═══ CODE SECTION — Dense column layout ═══ */
.code-grid {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	gap: 0;
	border: 1px solid var(--rule);
}

.code-item {
	padding: 1.25rem;
	border-right: 1px solid var(--rule-light);
	border-bottom: 1px solid var(--rule-light);
	text-decoration: none;
	color: inherit;
	transition: background 0.2s ease;
}

.code-item:hover {
	background: var(--paper-warm);
}

.code-item:nth-child(4n) {
	border-right: none;
}

.code-feature {
	grid-column: span 2;
	grid-row: span 2;
	border-right: 1px solid var(--rule);
	border-bottom: 1px solid var(--rule);
}

.code-feature .code-headline {
	font-size: 1.35rem;
}

.code-feature .code-lede {
	display: block;
	font-size: 0.95rem;
}

.code-meta {
	display: flex;
	gap: 0.5rem;
	align-items: center;
	margin-bottom: 0.5rem;
}

.code-date {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.65rem;
	color: var(--ink-muted);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}

.code-updated {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.6rem;
	color: var(--accent-code);
	background: var(--rule-light);
	padding: 0.15rem 0.4rem;
	border-radius: 2px;
}

.code-headline {
	font-family: 'Playfair Display', serif;
	font-size: 1.05rem;
	font-weight: 700;
	line-height: 1.25;
	margin: 0 0 0.5rem;
	color: var(--ink);
}

.code-lede {
	font-family: 'Source Serif 4', serif;
	font-size: 0.85rem;
	line-height: 1.5;
	color: var(--ink-muted);
	margin: 0;
	display: none;
}

.code-item:hover .code-headline {
	text-decoration: underline;
	text-underline-offset: 2px;
}

/* ═══ MIDDLE ROW ═══ */
.middle-row {
	display: grid;
	grid-template-columns: 1.5fr 1fr;
	gap: 2.5rem;
}

/* ═══ FOOD SECTION ═══ */
.food-grid {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1.5rem;
}

.food-card {
	display: flex;
	flex-direction: column;
	gap: 0.75rem;
	text-decoration: none;
	color: inherit;
}

.food-image {
	aspect-ratio: 16 / 10;
	overflow: hidden;
	border-radius: 2px;
}

.food-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.4s ease;
}

.food-card:hover .food-image img {
	transform: scale(1.03);
}

.food-content {
	display: flex;
	flex-direction: column;
	gap: 0.35rem;
}

.food-headline {
	font-family: 'Playfair Display', serif;
	font-size: 1.1rem;
	font-weight: 700;
	line-height: 1.25;
	margin: 0;
	color: var(--ink);
}

.food-lede {
	font-size: 0.85rem;
	line-height: 1.5;
	color: var(--ink-muted);
	margin: 0;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

.food-date {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.65rem;
	color: var(--ink-muted);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}

.food-card:hover .food-headline {
	text-decoration: underline;
	text-underline-offset: 2px;
}

/* ═══ LIFE SECTION — Beautiful, rare, featured ═══ */
.section-life .section-title {
	color: var(--accent-life);
}

.life-feature {
	display: flex;
	flex-direction: column;
	gap: 1.5rem;
}

.life-card {
	display: block;
	text-decoration: none;
	color: inherit;
	border: 1px solid var(--rule);
	padding: 1.5rem;
	background: linear-gradient(to bottom, var(--paper), var(--paper-warm));
	transition: box-shadow 0.3s ease, transform 0.3s ease;
}

.life-card:hover {
	box-shadow: 0 8px 32px rgba(0,0,0,0.08);
	transform: translateY(-2px);
}

.life-image {
	aspect-ratio: 21 / 9;
	overflow: hidden;
	margin: -1.5rem -1.5rem 1.25rem;
	border-bottom: 1px solid var(--rule);
}

.life-image img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	filter: saturate(0.9) contrast(1.05);
	transition: filter 0.4s ease;
}

.life-card:hover .life-image img {
	filter: saturate(1) contrast(1.1);
}

.life-label {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.65rem;
	text-transform: uppercase;
	letter-spacing: 0.15em;
	color: var(--accent-life);
	margin-bottom: 0.5rem;
	display: block;
}

.life-headline {
	font-family: 'Playfair Display', serif;
	font-size: 1.4rem;
	font-weight: 800;
	line-height: 1.2;
	margin: 0 0 0.75rem;
	color: var(--ink);
}

.life-lede {
	font-size: 0.95rem;
	line-height: 1.6;
	color: var(--ink-light);
	margin: 0 0 1rem;
}

.life-date {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.7rem;
	color: var(--ink-muted);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}

.life-empty {
	padding: 3rem 1.5rem;
	text-align: center;
	border: 1px dashed var(--rule);
	background: var(--paper-warm);
}

.empty-text {
	font-style: italic;
	color: var(--ink-muted);
	margin: 0;
}

/* ═══ FOOTER ═══ */
.newspaper-footer {
	border-top: 1px solid var(--ink);
	padding: 1.5rem 0;
	margin-top: 2rem;
}

.footer-inner {
	max-width: 1200px;
	margin: 0 auto;
	padding: 0 2rem;
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.7rem;
	color: var(--ink-muted);
}

.footer-tagline {
	margin: 0;
	font-style: italic;
}

.footer-links {
	display: flex;
	gap: 1.5rem;
}

.footer-links a {
	color: var(--ink-muted);
	text-decoration: none;
	transition: color 0.2s ease;
}

.footer-links a:hover {
	color: var(--ink);
	text-decoration: underline;
}

/* ═══ RESPONSIVE ═══ */
@media (max-width: 1000px) {
	.code-grid {
		grid-template-columns: repeat(3, 1fr);
	}
	
	.code-feature {
		grid-column: span 2;
		grid-row: span 2;
	}
	
	.code-item:nth-child(4n) {
		border-right: 1px solid var(--rule-light);
	}
	
	.code-item:nth-child(3n) {
		border-right: none;
	}
}

@media (max-width: 900px) {
	.middle-row {
		grid-template-columns: 1fr;
		gap: 2rem;
	}
	
	.food-grid {
		grid-template-columns: repeat(2, 1fr);
	}
}

@media (max-width: 700px) {
	.front-page {
		padding: 1.5rem 1rem;
	}
	
	.masthead-inner {
		padding: 0 1rem;
	}
	
	.masthead-top {
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.65rem;
	}
	
	.masthead-nav {
		flex-wrap: wrap;
		gap: 0.25rem;
		font-size: 0.7rem;
	}
	
	.nav-divider {
		display: none;
	}
	
	.code-grid {
		grid-template-columns: 1fr;
	}
	
	.code-feature {
		grid-column: span 1;
		grid-row: span 1;
	}
	
	.code-item {
		border-right: none;
		border-bottom: 1px solid var(--rule-light);
		padding: 1rem 0;
	}
	
	.code-item:last-child {
		border-bottom: none;
	}
	
	.code-feature .code-lede {
		display: none;
	}
	
	.food-grid {
		grid-template-columns: 1fr;
	}
	
	.life-card {
		padding: 1rem;
	}
	
	.life-image {
		margin: -1rem -1rem 1rem;
	}
	
	.life-headline {
		font-size: 1.2rem;
	}
	
	.footer-inner {
		flex-direction: column;
		gap: 0.75rem;
		text-align: center;
	}
}
</style>
