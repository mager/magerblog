---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	techPosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
}

const { techPosts, lifePosts, recipePosts } = Astro.props;

const topTech = techPosts.slice(0, 10);
const topFood = recipePosts.slice(0, 4);
const topLife = lifePosts.slice(0, 2);
---

<div class="home">

	<!-- ── TOPBAR ── -->
	<div class="topbar">
		<nav class="topbar-nav">
			<a href="/tech/">Tech</a>
			<a href="/cooking/">Food</a>
			<a href="/life/">Life</a>
			<a href="/about">About</a>
		</nav>
		<div class="topbar-social">
			<a href="https://x.com/mager" target="_blank" class="topbar-social-link" aria-label="Follow @mager on X">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="topbar-social-link" aria-label="mager on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>

	<div class="travel-bar" aria-label="Current travel note">
		<span class="travel-kicker" lang="ja">日本滞在</span>
		<span class="travel-copy">Japan dispatch, May 6-May 30. Small tools, better meals, sharper noticing.</span>
		<a href="/blog/2026-03-21-kotsu-the-knack-of-japanese/" class="travel-feature">
			<span class="travel-feature-label">Featured note</span>
			<span class="travel-feature-title">Kotsu: The Knack of Japanese →</span>
		</a>
	</div>

	<!-- ── HERO ── -->
	<section class="hero">
		<div class="hero-type">
			<h1 class="hero-name">
				<span class="name-mager">
					<span class="easter-m">m</span><span class="easter-a">a</span><span class="easter-g">g</span><span class="easter-e">e</span><span class="easter-r">r</span>
				</span><span class="name-co">.co</span>
			</h1>
			<div class="hero-meta">
				<p class="hero-tagline">Always learning. Always eating. Chicago, currently Japan.</p>
				<div class="hero-postcard">
					<span class="postcard-mark" lang="ja">こつ</span>
					<span class="postcard-copy">the knack inside tools, trains, kitchens, and kanji.</span>
				</div>
			</div>
		</div>
	</section>

	<!-- ── ZONES ── -->
	<div class="zones">

		<!-- TECH -->
		<section class="zone zone--tech">
			<header class="zone-head">
				<span class="zone-label">Technology</span>
				<a href="/tech/" class="zone-more">All posts →</a>
			</header>
			<ol class="post-list">
				{topTech.map((post, i) => (
					<li>
						<a href={`/blog/${post.id}/`} class:list={['post-item', { 'post-item--lead': i === 0 }]}>
							<span class="post-num">{String(i + 1).padStart(2, '0')}</span>
							<div class="post-body">
								<h3 class="post-title">{post.data.title}</h3>
								{i === 0 && post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								{i === 0 && post.data.title.toLowerCase().includes('kotsu') && (
									<span class="post-note" lang="ja">こつ field note</span>
								)}
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					</li>
				))}
			</ol>
		</section>

		<!-- FOOD -->
		<section class="zone zone--food">
			<header class="zone-head">
				<span class="zone-label">Dining</span>
				<a href="/cooking/" class="zone-more">Archive →</a>
			</header>
			<div class="food-stack">
				{topFood.map((post, i) => (
					<a href={`/blog/${post.id}/`} class="food-item">
						<div class="food-img">
							{post.data.heroImage ? (
								<img src={post.data.heroImage} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
							) : (
								<div class="food-img-placeholder">
									<span class="placeholder-emoji">🍽</span>
									<span class="placeholder-title">{post.data.title}</span>
								</div>
							)}
						</div>
						<div class="food-text">
							<h3 class="post-title">{post.data.title}</h3>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- LIFE -->
		<section class="zone zone--life">
			<header class="zone-head">
				<span class="zone-label">Life</span>
				<a href="/life/" class="zone-more">Stories →</a>
			</header>
			{topLife.length > 0 ? (
				<div class="life-stack">
					{topLife.map(post => (
						<a href={`/blog/${post.id}/`} class="life-item">
							<div class="life-img">
								{post.data.heroImage ? (
									<img src={post.data.heroImage} alt="" loading="lazy" />
								) : (
									<div class="life-img-placeholder">
										<span class="placeholder-emoji">✦</span>
										<span class="placeholder-title">{post.data.title}</span>
									</div>
								)}
							</div>
							<h3 class="post-title">{post.data.title}</h3>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					))}
				</div>
			) : (
				<p class="empty">Stories from life, coming soon.</p>
			)}
		</section>

	</div><!-- /zones -->

</div><!-- /home -->

<!-- Cursor glow orb -->
<div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

<script>
	// ── Ink-reveal: split hero name into chars and stagger them ──
	const heroName = document.querySelector('.hero-name') as HTMLElement | null;
	if (heroName) {
		let charIndex = 0;
		const BASE_DELAY_MS = 80; // ms per char

		function wrapChars(node: Node): void {
			if (node.nodeType === Node.TEXT_NODE) {
				const text = node.textContent || '';
				const frag = document.createDocumentFragment();
				for (const ch of text) {
					const span = document.createElement('span');
					span.className = 'char';
					span.style.animationDelay = `${(charIndex++ * BASE_DELAY_MS)}ms`;
					span.textContent = ch;
					frag.appendChild(span);
				}
				node.parentNode?.replaceChild(frag, node);
			} else if (node.nodeType === Node.ELEMENT_NODE) {
				// Walk children in reverse so replacements don't shift indices
				const children = Array.from(node.childNodes);
				for (const child of children) {
					wrapChars(child);
				}
			}
		}

		wrapChars(heroName);
	}

	// ── Cursor glow follows mouse ──
	const glow = document.getElementById('cursor-glow');
	if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let raf: number;
		let mx = -500, my = -500;
		window.addEventListener('mousemove', (e) => {
			mx = e.clientX;
			my = e.clientY;
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				glow.style.left = mx + 'px';
				glow.style.top = my + 'px';
			});
		});
		// Hide when leaving window
		document.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
		document.addEventListener('mouseenter', () => { glow.style.opacity = '1'; });
	} else if (glow) {
		glow.style.display = 'none';
	}

	// ── Hero parallax on scroll (scroll-driven or JS fallback) ──
	const hero = document.querySelector('.hero') as HTMLElement | null;
	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// Use scroll-driven animations if supported
		if (CSS.supports('animation-timeline', 'scroll()')) {
			hero.style.cssText += `
				animation: heroParallax linear both;
				animation-timeline: scroll(root block);
				animation-range: 0px 400px;
			`;
			const style = document.createElement('style');
			style.textContent = `
				@keyframes heroParallax {
					from { transform: translateY(0px); }
					to   { transform: translateY(-40px); }
				}
			`;
			document.head.appendChild(style);
		} else {
			// JS fallback
			const onScroll = () => {
				const y = window.scrollY;
				if (y < 500) {
					hero.style.transform = `translateY(${-y * 0.1}px)`;
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	}
</script>

<style>

/* ══════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════ */
.home {
	--paper:       oklch(98.8% 0.012 112);
	--ink:         oklch(11%   0.015 250);
	--ink-mid:     oklch(42%   0.010 250);
	--ink-light:   oklch(62%   0.008 250);
	--rule:        oklch(89%   0.010 112);
	--rule-dark:   oklch(79%   0.012 112);

	/* Seasonal accents */
	--spring-coral: oklch(66% 0.18 28);
	--spring-sakura: oklch(77% 0.12 354);
	--spring-sun: oklch(86% 0.15 96);
	--spring-leaf: oklch(62% 0.16 145);
	--spring-sky: oklch(64% 0.14 225);
	--spring-iris: oklch(57% 0.14 285);
	--trip-accent: oklch(56% 0.18 18);

	/* Category accents */
	--tech-accent: oklch(45%  0.15  235);  /* clear sky blue */
	--food-accent: oklch(58%  0.17  31);   /* ripe coral */
	--life-accent: oklch(50%  0.14  145);  /* new leaf */

	/* Type */
	--font-display: 'Fraunces', Georgia, serif;
	--font-body:    'Source Serif 4', Georgia, serif;
	--font-mono:    'JetBrains Mono', monospace;
	--font-ui:      'Space Grotesk', sans-serif;

	background: var(--paper);
	color: var(--ink);
	min-height: 100vh;
	position: relative;
	isolation: isolate;
	overflow: hidden;
}

.home::before {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		repeating-linear-gradient(
			90deg,
			oklch(64% 0.14 225 / 0.026) 0 1px,
			transparent 1px 92px
		),
		repeating-linear-gradient(
			0deg,
			oklch(62% 0.16 145 / 0.032) 0 1px,
			transparent 1px 68px
		);
}

.topbar,
.travel-bar,
.hero,
.zones {
	position: relative;
	z-index: 1;
}


/* ══════════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════════ */
.topbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 1rem 2.5rem;
	border-bottom: 1px solid var(--rule);
}

.topbar-brand {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 12, 'wght' 700;
	font-size: 1rem;
	color: var(--ink);
	text-decoration: none;
	letter-spacing: -0.01em;
}

.topbar-nav {
	display: flex;
	gap: 2rem;
}

.topbar-nav a {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--ink-mid);
	text-decoration: none;
	transition: color 0.15s ease;
}

.topbar-nav a:hover {
	color: var(--ink);
}

.topbar-social {
	display: flex;
	align-items: center;
	gap: 0.25rem;
	padding-left: 1.5rem;
	border-left: 1px solid var(--rule);
}

.topbar-social-link {
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--ink-mid);
	padding: 0.35em;
	border-radius: 4px;
	transition: color 0.15s ease;
}

.topbar-social-link:hover {
	color: var(--ink);
}

.travel-bar {
	display: flex;
	align-items: center;
	gap: 0.85rem;
	padding: 0.65rem 2.5rem;
	border-bottom: 1px solid var(--rule);
	background:
		linear-gradient(90deg, oklch(94% 0.055 354 / 0.72), transparent 54%),
		linear-gradient(120deg, oklch(95% 0.045 145 / 0.42), transparent 70%),
		oklch(98.6% 0.014 112 / 0.9);
	font-family: var(--font-mono);
	font-size: 0.68rem;
	color: var(--ink-mid);
	letter-spacing: 0.04em;
}

.travel-kicker {
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-weight: 700;
	letter-spacing: 0.14em;
	white-space: nowrap;
}

.travel-copy {
	min-width: 0;
}

.travel-feature {
	display: inline-flex;
	align-items: baseline;
	gap: 0.48rem;
	margin-left: auto;
	color: var(--ink-light);
	text-decoration: none;
	white-space: nowrap;
	transition: color 0.15s ease;
}

.travel-feature:hover {
	color: var(--trip-accent);
}

.travel-feature-label {
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-size: 0.58rem;
	font-weight: 700;
	letter-spacing: 0.12em;
	text-transform: uppercase;
}

.travel-feature-title {
	color: var(--ink-mid);
	font-family: var(--font-body);
	font-size: 0.78rem;
	font-style: italic;
	letter-spacing: 0;
}

.travel-feature:hover .travel-feature-title {
	color: var(--trip-accent);
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}


/* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
.hero {
	padding: 4rem 2.5rem 3.5rem;
	border-bottom: 1px solid var(--rule-dark);
	overflow: hidden;
	isolation: isolate;
}

.hero::before {
	content: "日本";
	position: absolute;
	top: 1.45rem;
	right: clamp(1.25rem, 4vw, 4rem);
	z-index: 0;
	writing-mode: vertical-rl;
	border: 1px solid oklch(56% 0.18 18 / 0.22);
	color: oklch(56% 0.18 18 / 0.16);
	padding: 0.55rem 0.38rem;
	font-family: var(--font-ui);
	font-size: clamp(2.2rem, 6vw, 5.75rem);
	font-weight: 700;
	letter-spacing: 0.08em;
	line-height: 1;
}

.hero::after {
	content: "";
	position: absolute;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	background:
		linear-gradient(110deg, transparent 0 62%, oklch(77% 0.12 354 / 0.08) 62% 62.35%, transparent 62.35%),
		linear-gradient(110deg, transparent 0 71%, oklch(64% 0.14 225 / 0.07) 71% 71.35%, transparent 71.35%),
		linear-gradient(110deg, transparent 0 78%, oklch(62% 0.16 145 / 0.06) 78% 78.25%, transparent 78.25%);
}

.hero-type {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
	position: relative;
	z-index: 1;
}

.hero-name {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 144, 'wght' 900;
	font-style: italic;
	font-size: clamp(5.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.04em;
	margin: 0;
}

.name-mager {
	color: var(--ink);
}

/* Late spring into summer: bloom, sun, leaf, clear water */
.easter-m { color: var(--spring-coral); }
.easter-a { color: var(--spring-sakura); }
.easter-g { color: var(--spring-sun); }
.easter-e { color: var(--spring-leaf); }
.easter-r { color: var(--spring-sky); }

.name-co {
	color: var(--spring-iris);
}

/* Light shimmer: a small brightness pulse after ink-reveal finishes */
@keyframes seasonalShimmer {
	0%, 100% { filter: brightness(1); }
	50%      { filter: brightness(1.16) saturate(1.08); }
}

.name-mager,
.name-co {
	animation: seasonalShimmer 3.5s 1.5s ease-in-out infinite;
}

.hero-meta {
	padding-bottom: 0.5rem;
	max-width: 280px;
	flex-shrink: 0;
}

.hero-tagline {
	font-family: var(--font-body);
	font-size: 1.05rem;
	font-style: italic;
	color: var(--ink-mid);
	margin: 0 0 0.6rem;
	line-height: 1.4;
}

.hero-postcard {
	display: grid;
	grid-template-columns: auto 1fr;
	align-items: center;
	gap: 0.75rem;
	padding-top: 0.75rem;
	border-top: 1px solid var(--rule);
	max-width: 20rem;
}

.postcard-mark {
	display: inline-grid;
	place-items: center;
	width: 2.55rem;
	height: 2.55rem;
	border: 1px solid oklch(56% 0.18 18 / 0.34);
	color: var(--trip-accent);
	font-family: var(--font-ui);
	font-size: 0.95rem;
	font-weight: 700;
	line-height: 1;
	transform: rotate(-3deg);
}

.postcard-copy {
	font-family: var(--font-mono);
	font-size: 0.66rem;
	line-height: 1.45;
	color: var(--ink-light);
	letter-spacing: 0.03em;
}


/* ══════════════════════════════════════════════════
   ZONE GRID
══════════════════════════════════════════════════ */
.zones {
	display: grid;
	grid-template-columns: 1fr 340px 260px;
	grid-template-rows: auto;
	min-height: 0;
}

.zone {
	padding: 2rem 2.5rem;
	border-right: 1px solid var(--rule);
}

.zone:last-child {
	border-right: none;
}


/* ── Zone header ── */
.zone-head {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	margin-bottom: 1.75rem;
	padding-bottom: 0.6rem;
	border-bottom: 2px solid currentColor;
}

.zone--tech .zone-head { border-color: var(--tech-accent); color: var(--tech-accent); }
.zone--food .zone-head { border-color: var(--food-accent); color: var(--food-accent); }
.zone--life .zone-head { border-color: var(--life-accent); color: var(--life-accent); }

.zone-label {
	font-family: var(--font-ui);
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.12em;
}

.zone-more {
	font-family: var(--font-mono);
	font-size: 0.68rem;
	color: var(--ink-light);
	text-decoration: none;
	transition: color 0.15s ease;
}

.zone-more:hover {
	color: var(--ink);
}


/* ══════════════════════════════════════════════════
   SHARED POST ATOMS
══════════════════════════════════════════════════ */
.post-title {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 36, 'wght' 700;
	font-size: 1.15rem;
	line-height: 1.2;
	margin: 0 0 0.35rem;
	color: var(--ink);
}

.post-desc {
	font-family: var(--font-body);
	font-size: 0.88rem;
	line-height: 1.55;
	color: var(--ink-mid);
	margin: 0 0 0.4rem;
}

.post-date {
	font-family: var(--font-mono);
	font-size: 0.65rem;
	color: var(--ink-light);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}

.post-note {
	display: inline-block;
	margin: 0.1rem 0 0.55rem;
	padding: 0.24rem 0.42rem;
	border: 1px solid oklch(56% 0.18 18 / 0.24);
	background: oklch(96.5% 0.03 354 / 0.64);
	color: var(--trip-accent);
	font-family: var(--font-mono);
	font-size: 0.62rem;
	line-height: 1;
	letter-spacing: 0.04em;
}


/* ══════════════════════════════════════════════════
   TECH ZONE
══════════════════════════════════════════════════ */
.post-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.post-list li {
	border-bottom: 1px solid var(--rule);
}

.post-list li:last-child {
	border-bottom: none;
}

.post-item {
	display: flex;
	gap: 1rem;
	padding: 1rem 0;
	text-decoration: none;
	color: inherit;
	transition: background 0.15s ease;
	border-radius: 4px;
}

.post-item--lead {
	padding: 1.25rem 0;
}

.post-item--lead .post-title {
	font-size: 1.75rem;
	font-variation-settings: 'opsz' 72, 'wght' 800;
	line-height: 1.15;
	margin-bottom: 0.5rem;
}

.post-item--lead .post-desc {
	display: block;
}

.post-item:not(.post-item--lead) .post-desc {
	display: none;
}

.post-num {
