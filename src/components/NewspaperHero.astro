---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	codePosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
}

const { codePosts, lifePosts, recipePosts } = Astro.props;

const topCode = codePosts.slice(0, 7);
const topFood = recipePosts.slice(0, 4);
const topLife = lifePosts.slice(0, 2);

const totalPosts = codePosts.length + recipePosts.length + lifePosts.length;
---

<div class="home">

	<!-- ── TOPBAR ── -->
	<div class="topbar">
		<a href="/" class="topbar-brand">mager.co</a>
		<nav class="topbar-nav">
			<a href="/code/">Code</a>
			<a href="/cooking/">Food</a>
			<a href="/life/">Life</a>
			<a href="/about">About</a>
		</nav>
	</div>

	<!-- ── HERO ── -->
	<section class="hero">
		<div class="hero-type">
			<h1 class="hero-name">
				<span class="name-mager">mager</span><span class="name-co">.co</span>
			</h1>
			<div class="hero-meta">
				<p class="hero-tagline">Always learning. Always eating. Chicago.</p>
				<p class="hero-stats">
					<span>{codePosts.length} posts</span>
					<span class="dot">·</span>
					<span>{recipePosts.length} recipes</span>
					<span class="dot">·</span>
					<span>{lifePosts.length} stories</span>
				</p>
			</div>
		</div>
	</section>

	<!-- ── ZONES ── -->
	<div class="zones">

		<!-- CODE -->
		<section class="zone zone--code">
			<header class="zone-head">
				<span class="zone-label">Technology</span>
				<a href="/code/" class="zone-more">All posts →</a>
			</header>
			<ol class="post-list">
				{topCode.map((post, i) => (
					<li>
						<a href={`/blog/${post.id}/`} class:list={['post-item', { 'post-item--lead': i === 0 }]}>
							<span class="post-num">{String(i + 1).padStart(2, '0')}</span>
							<div class="post-body">
								<h3 class="post-title">{post.data.title}</h3>
								{i === 0 && post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					</li>
				))}
			</ol>
		</section>

		<!-- FOOD -->
		<section class="zone zone--food">
			<header class="zone-head">
				<span class="zone-label">Dining</span>
				<a href="/cooking/" class="zone-more">Archive →</a>
			</header>
			<div class="food-stack">
				{topFood.map((post, i) => (
					<a href={`/blog/${post.id}/`} class="food-item">
						{post.data.heroImage && (
							<div class="food-img">
								<img src={post.data.heroImage} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
							</div>
						)}
						<div class="food-text">
							<h3 class="post-title">{post.data.title}</h3>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- LIFE -->
		<section class="zone zone--life">
			<header class="zone-head">
				<span class="zone-label">Life</span>
				<a href="/life/" class="zone-more">Stories →</a>
			</header>
			{topLife.length > 0 ? (
				<div class="life-stack">
					{topLife.map(post => (
						<a href={`/blog/${post.id}/`} class="life-item">
							{post.data.heroImage && (
								<div class="life-img">
									<img src={post.data.heroImage} alt="" loading="lazy" />
								</div>
							)}
							<h3 class="post-title">{post.data.title}</h3>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					))}
				</div>
			) : (
				<p class="empty">Stories from life, coming soon.</p>
			)}
		</section>

	</div><!-- /zones -->

</div><!-- /home -->

<style>

/* ══════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════ */
.home {
	--paper:       oklch(98.5% 0.008 80);
	--ink:         oklch(11%   0.015 250);
	--ink-mid:     oklch(42%   0.010 250);
	--ink-light:   oklch(62%   0.008 250);
	--rule:        oklch(88%   0.006 80);
	--rule-dark:   oklch(78%   0.008 80);

	/* Category accents */
	--code-accent: oklch(29%  0.18  260);  /* deep indigo */
	--food-accent: oklch(50%  0.14  38);   /* terracotta  */
	--life-accent: oklch(40%  0.12  148);  /* forest      */

	/* Type */
	--font-display: 'Fraunces', Georgia, serif;
	--font-body:    'Source Serif 4', Georgia, serif;
	--font-mono:    'JetBrains Mono', monospace;
	--font-ui:      'Space Grotesk', sans-serif;

	background: var(--paper);
	color: var(--ink);
	min-height: 100vh;
}


/* ══════════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════════ */
.topbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 1rem 2.5rem;
	border-bottom: 1px solid var(--rule);
}

.topbar-brand {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 12, 'wght' 700;
	font-size: 1rem;
	color: var(--ink);
	text-decoration: none;
	letter-spacing: -0.01em;
}

.topbar-nav {
	display: flex;
	gap: 2rem;
}

.topbar-nav a {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--ink-mid);
	text-decoration: none;
	transition: color 0.15s ease;
}

.topbar-nav a:hover {
	color: var(--ink);
}


/* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
.hero {
	padding: 4rem 2.5rem 3.5rem;
	border-bottom: 1px solid var(--rule-dark);
}

.hero-type {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
}

.hero-name {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 144, 'wght' 900;
	font-style: italic;
	font-size: clamp(5.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.04em;
	margin: 0;
}

.name-mager {
	color: var(--ink);
}

.name-co {
	color: var(--food-accent);
}

.hero-meta {
	padding-bottom: 0.5rem;
	max-width: 280px;
	flex-shrink: 0;
}

.hero-tagline {
	font-family: var(--font-body);
	font-size: 1.05rem;
	font-style: italic;
	color: var(--ink-mid);
	margin: 0 0 0.6rem;
	line-height: 1.4;
}

.hero-stats {
	font-family: var(--font-mono);
	font-size: 0.7rem;
	color: var(--ink-light);
	margin: 0;
	display: flex;
	align-items: center;
	gap: 0.5rem;
	flex-wrap: wrap;
}

.hero-stats .dot {
	color: var(--rule-dark);
}


/* ══════════════════════════════════════════════════
   ZONE GRID
══════════════════════════════════════════════════ */
.zones {
	display: grid;
	grid-template-columns: 1fr 340px 260px;
	grid-template-rows: auto;
	min-height: 0;
}

.zone {
	padding: 2rem 2.5rem;
	border-right: 1px solid var(--rule);
}

.zone:last-child {
	border-right: none;
}


/* ── Zone header ── */
.zone-head {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	margin-bottom: 1.75rem;
	padding-bottom: 0.6rem;
	border-bottom: 2px solid currentColor;
}

.zone--code .zone-head { border-color: var(--code-accent); color: var(--code-accent); }
.zone--food .zone-head { border-color: var(--food-accent); color: var(--food-accent); }
.zone--life .zone-head { border-color: var(--life-accent); color: var(--life-accent); }

.zone-label {
	font-family: var(--font-ui);
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.12em;
}

.zone-more {
	font-family: var(--font-mono);
	font-size: 0.68rem;
	color: var(--ink-light);
	text-decoration: none;
	transition: color 0.15s ease;
}

.zone-more:hover {
	color: var(--ink);
}


/* ══════════════════════════════════════════════════
   SHARED POST ATOMS
══════════════════════════════════════════════════ */
.post-title {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 36, 'wght' 700;
	font-size: 1rem;
	line-height: 1.25;
	margin: 0 0 0.35rem;
	color: var(--ink);
}

.post-desc {
	font-family: var(--font-body);
	font-size: 0.88rem;
	line-height: 1.55;
	color: var(--ink-mid);
	margin: 0 0 0.4rem;
}

.post-date {
	font-family: var(--font-mono);
	font-size: 0.65rem;
	color: var(--ink-light);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}


/* ══════════════════════════════════════════════════
   CODE ZONE
══════════════════════════════════════════════════ */
.post-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.post-list li {
	border-bottom: 1px solid var(--rule);
}

.post-list li:last-child {
	border-bottom: none;
}

.post-item {
	display: flex;
	gap: 1rem;
	padding: 1rem 0;
	text-decoration: none;
	color: inherit;
	transition: background 0.15s ease;
	border-radius: 4px;
}

.post-item--lead {
	padding: 1.25rem 0;
}

.post-item--lead .post-title {
	font-size: 1.3rem;
	font-variation-settings: 'opsz' 72, 'wght' 800;
	line-height: 1.2;
	margin-bottom: 0.5rem;
}

.post-item--lead .post-desc {
	display: block;
}

.post-item:not(.post-item--lead) .post-desc {
	display: none;
}

.post-num {
	font-family: var(--font-mono);
	font-size: 0.65rem;
	color: var(--code-accent);
	opacity: 0.5;
	padding-top: 0.2rem;
	flex-shrink: 0;
	min-width: 1.6rem;
	line-height: 1.4;
}

.post-body {
	flex: 1;
	min-width: 0;
}

.post-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}


/* ══════════════════════════════════════════════════
   FOOD ZONE
══════════════════════════════════════════════════ */
.food-stack {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.food-item {
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
	text-decoration: none;
	color: inherit;
	padding-bottom: 1.25rem;
	margin-bottom: 1.25rem;
	border-bottom: 1px solid var(--rule);
}

.food-item:last-child {
	border-bottom: none;
	margin-bottom: 0;
	padding-bottom: 0;
}

.food-img {
	aspect-ratio: 16 / 9;
	overflow: hidden;
	border-radius: 3px;
}

.food-img img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
	filter: saturate(0.92);
}

.food-item:hover .food-img img {
	transform: scale(1.04);
	filter: saturate(1.05);
}

.food-text {
	display: flex;
	flex-direction: column;
	gap: 0.3rem;
}

.food-text .post-title {
	font-size: 0.95rem;
}

.food-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}


/* ══════════════════════════════════════════════════
   LIFE ZONE
══════════════════════════════════════════════════ */
.life-stack {
	display: flex;
	flex-direction: column;
	gap: 2rem;
}

.life-item {
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
	text-decoration: none;
	color: inherit;
}

.life-img {
	aspect-ratio: 4 / 3;
	overflow: hidden;
	border-radius: 3px;
}

.life-img img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
	filter: saturate(0.85) contrast(1.05);
}

.life-item:hover .life-img img {
	transform: scale(1.04);
	filter: saturate(1) contrast(1);
}

.life-item .post-title {
	font-variation-settings: 'opsz' 72, 'wght' 800;
	font-size: 1.05rem;
	line-height: 1.2;
}

.life-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}

.empty {
	font-family: var(--font-body);
	font-style: italic;
	color: var(--ink-light);
	font-size: 0.9rem;
}


/* ══════════════════════════════════════════════════
   PAGE LOAD ANIMATION
══════════════════════════════════════════════════ */
@keyframes fadeUp {
	from { opacity: 0; transform: translateY(12px); }
	to   { opacity: 1; transform: translateY(0); }
}

.hero-name {
	animation: fadeUp 0.6s ease both;
}

.hero-meta {
	animation: fadeUp 0.6s 0.1s ease both;
}

.zone {
	animation: fadeUp 0.6s 0.2s ease both;
}

@media (prefers-reduced-motion: reduce) {
	.hero-name, .hero-meta, .zone { animation: none; }
}


/* ══════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════ */
@media (max-width: 1100px) {
	.zones {
		grid-template-columns: 1fr 300px;
	}

	.zone--life {
		grid-column: 1 / -1;
		border-right: none;
		border-top: 1px solid var(--rule);

		/* horizontal layout for life on tablet */
		display: grid;
		grid-template-columns: auto 1fr 1fr;
		align-items: start;
		gap: 0 2.5rem;
	}

	.zone--life .zone-head {
		grid-column: 1 / -1;
	}

	.life-stack {
		grid-column: 2 / -1;
		flex-direction: row;
		gap: 2rem;
	}

	.life-item {
		flex: 1;
	}
}

@media (max-width: 800px) {
	.topbar {
		padding: 0.85rem 1.25rem;
	}

	.hero {
		padding: 2.5rem 1.25rem 2rem;
	}

	.hero-type {
		flex-direction: column;
		align-items: flex-start;
		gap: 1.25rem;
	}

	.hero-meta {
		max-width: 100%;
	}

	.zones {
		grid-template-columns: 1fr;
	}

	.zone {
		border-right: none;
		border-bottom: 1px solid var(--rule);
		padding: 1.75rem 1.25rem;
	}

	.zone:last-child {
		border-bottom: none;
	}

	.zone--life {
		display: block;
	}

	.life-stack {
		flex-direction: column;
	}

	.food-stack {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.food-item {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}
}

@media (max-width: 520px) {
	.topbar-nav {
		gap: 1.25rem;
	}

	.food-stack {
		grid-template-columns: 1fr;
	}
}

</style>
