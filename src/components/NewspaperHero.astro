---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	codePosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
}

const { codePosts, lifePosts, recipePosts } = Astro.props;

const topCode = codePosts.slice(0, 7);
const topFood = recipePosts.slice(0, 4);
const topLife = lifePosts.slice(0, 2);

const totalPosts = codePosts.length + recipePosts.length + lifePosts.length;
---

<div class="home">

	<!-- ── TOPBAR ── -->
	<div class="topbar">
		<a href="/" class="topbar-brand">mager.co</a>
		<nav class="topbar-nav">
			<a href="/code/">Code</a>
			<a href="/cooking/">Food</a>
			<a href="/life/">Life</a>
			<a href="/about">About</a>
		</nav>
		<div class="topbar-social">
			<a href="https://x.com/mager" target="_blank" class="topbar-social-link" aria-label="Follow @mager on X">
				<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="topbar-social-link" aria-label="mager on GitHub">
				<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
					<path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
				</svg>
			</a>
		</div>
	</div>

	<!-- ── HERO ── -->
	<section class="hero">
		<div class="hero-type">
			<h1 class="hero-name">
				<span class="name-mager">mager</span><span class="name-co">.co</span>
			</h1>
			<div class="hero-meta">
				<p class="hero-tagline">Always learning. Always eating. Chicago.</p>
				<p class="hero-stats">
					<span>{codePosts.length} posts</span>
					<span class="dot">·</span>
					<span>{recipePosts.length} recipes</span>
					<span class="dot">·</span>
					<span>{lifePosts.length} stories</span>
				</p>
			</div>
		</div>
	</section>

	<!-- ── ZONES ── -->
	<div class="zones">

		<!-- CODE -->
		<section class="zone zone--code">
			<header class="zone-head">
				<span class="zone-label">Technology</span>
				<a href="/code/" class="zone-more">All posts →</a>
			</header>
			<ol class="post-list">
				{topCode.map((post, i) => (
					<li>
						<a href={`/blog/${post.id}/`} class:list={['post-item', { 'post-item--lead': i === 0 }]}>
							<span class="post-num">{String(i + 1).padStart(2, '0')}</span>
							<div class="post-body">
								<h3 class="post-title">{post.data.title}</h3>
								{i === 0 && post.data.description && (
									<p class="post-desc">{post.data.description}</p>
								)}
								<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
							</div>
						</a>
					</li>
				))}
			</ol>
		</section>

		<!-- FOOD -->
		<section class="zone zone--food">
			<header class="zone-head">
				<span class="zone-label">Dining</span>
				<a href="/cooking/" class="zone-more">Archive →</a>
			</header>
			<div class="food-stack">
				{topFood.map((post, i) => (
					<a href={`/blog/${post.id}/`} class="food-item">
						<div class="food-img">
							{post.data.heroImage ? (
								<img src={post.data.heroImage} alt="" loading={i === 0 ? 'eager' : 'lazy'} />
							) : (
								<div class="food-img-placeholder">
									<span class="placeholder-emoji">🍽</span>
									<span class="placeholder-title">{post.data.title}</span>
								</div>
							)}
						</div>
						<div class="food-text">
							<h3 class="post-title">{post.data.title}</h3>
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- LIFE -->
		<section class="zone zone--life">
			<header class="zone-head">
				<span class="zone-label">Life</span>
				<a href="/life/" class="zone-more">Stories →</a>
			</header>
			{topLife.length > 0 ? (
				<div class="life-stack">
					{topLife.map(post => (
						<a href={`/blog/${post.id}/`} class="life-item">
							<div class="life-img">
								{post.data.heroImage ? (
									<img src={post.data.heroImage} alt="" loading="lazy" />
								) : (
									<div class="life-img-placeholder">
										<span class="placeholder-emoji">✦</span>
										<span class="placeholder-title">{post.data.title}</span>
									</div>
								)}
							</div>
							<h3 class="post-title">{post.data.title}</h3>
							{post.data.description && (
								<p class="post-desc">{post.data.description}</p>
							)}
							<span class="post-date"><FormattedDate date={post.data.pubDate} /></span>
						</a>
					))}
				</div>
			) : (
				<p class="empty">Stories from life, coming soon.</p>
			)}
		</section>

	</div><!-- /zones -->

</div><!-- /home -->

<!-- Cursor glow orb -->
<div class="cursor-glow" id="cursor-glow" aria-hidden="true"></div>

<script>
	// ── Ink-reveal: split hero name into chars and stagger them ──
	const heroName = document.querySelector('.hero-name') as HTMLElement | null;
	if (heroName) {
		const text = heroName.innerHTML;
		// Split while preserving <span> tags
		const parser = new DOMParser();
		const doc = parser.parseFromString(text, 'text/html');
		let charIndex = 0;
		const BASE_DELAY_MS = 80; // ms per char

		function wrapChars(node: Node): string {
			if (node.nodeType === Node.TEXT_NODE) {
				return (node.textContent || '').split('').map(ch => {
					const delay = (charIndex++ * BASE_DELAY_MS).toFixed(0);
					return `<span class="char" style="animation-delay:${delay}ms">${ch}</span>`;
				}).join('');
			}
			if (node.nodeType === Node.ELEMENT_NODE) {
				const el = node as Element;
				const inner = Array.from(el.childNodes).map(wrapChars).join('');
				return `<${el.tagName.toLowerCase()} class="${el.getAttribute('class') || ''}">${inner}</${el.tagName.toLowerCase()}>`;
			}
			return '';
		}

		heroName.innerHTML = Array.from(doc.body.childNodes).map(wrapChars).join('');
	}

	// ── Cursor glow follows mouse ──
	const glow = document.getElementById('cursor-glow');
	if (glow && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let raf: number;
		let mx = -500, my = -500;
		window.addEventListener('mousemove', (e) => {
			mx = e.clientX;
			my = e.clientY;
			cancelAnimationFrame(raf);
			raf = requestAnimationFrame(() => {
				glow.style.left = mx + 'px';
				glow.style.top = my + 'px';
			});
		});
		// Hide when leaving window
		document.addEventListener('mouseleave', () => { glow.style.opacity = '0'; });
		document.addEventListener('mouseenter', () => { glow.style.opacity = '1'; });
	} else if (glow) {
		glow.style.display = 'none';
	}

	// ── Hero parallax on scroll (scroll-driven or JS fallback) ──
	const hero = document.querySelector('.hero') as HTMLElement | null;
	if (hero && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		// Use scroll-driven animations if supported
		if (CSS.supports('animation-timeline', 'scroll()')) {
			hero.style.cssText += `
				animation: heroParallax linear both;
				animation-timeline: scroll(root block);
				animation-range: 0px 400px;
			`;
			const style = document.createElement('style');
			style.textContent = `
				@keyframes heroParallax {
					from { transform: translateY(0px); }
					to   { transform: translateY(-40px); }
				}
			`;
			document.head.appendChild(style);
		} else {
			// JS fallback
			const onScroll = () => {
				const y = window.scrollY;
				if (y < 500) {
					hero.style.transform = `translateY(${-y * 0.1}px)`;
				}
			};
			window.addEventListener('scroll', onScroll, { passive: true });
		}
	}
</script>

<style>

/* ══════════════════════════════════════════════════
   TOKENS
══════════════════════════════════════════════════ */
.home {
	--paper:       oklch(98.5% 0.008 80);
	--ink:         oklch(11%   0.015 250);
	--ink-mid:     oklch(42%   0.010 250);
	--ink-light:   oklch(62%   0.008 250);
	--rule:        oklch(88%   0.006 80);
	--rule-dark:   oklch(78%   0.008 80);

	/* Category accents */
	--code-accent: oklch(29%  0.18  260);  /* deep indigo */
	--food-accent: oklch(50%  0.14  38);   /* terracotta  */
	--life-accent: oklch(40%  0.12  148);  /* forest      */

	/* Type */
	--font-display: 'Fraunces', Georgia, serif;
	--font-body:    'Source Serif 4', Georgia, serif;
	--font-mono:    'JetBrains Mono', monospace;
	--font-ui:      'Space Grotesk', sans-serif;

	background: var(--paper);
	color: var(--ink);
	min-height: 100vh;
}


/* ══════════════════════════════════════════════════
   TOPBAR
══════════════════════════════════════════════════ */
.topbar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 1rem 2.5rem;
	border-bottom: 1px solid var(--rule);
}

.topbar-brand {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 12, 'wght' 700;
	font-size: 1rem;
	color: var(--ink);
	text-decoration: none;
	letter-spacing: -0.01em;
}

.topbar-nav {
	display: flex;
	gap: 2rem;
}

.topbar-nav a {
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--ink-mid);
	text-decoration: none;
	transition: color 0.15s ease;
}

.topbar-nav a:hover {
	color: var(--ink);
}

.topbar-social {
	display: flex;
	align-items: center;
	gap: 0.25rem;
	padding-left: 1.5rem;
	border-left: 1px solid var(--rule);
}

.topbar-social-link {
	display: flex;
	align-items: center;
	justify-content: center;
	color: var(--ink-mid);
	padding: 0.35em;
	border-radius: 4px;
	transition: color 0.15s ease;
}

.topbar-social-link:hover {
	color: var(--ink);
}


/* ══════════════════════════════════════════════════
   HERO
══════════════════════════════════════════════════ */
.hero {
	padding: 4rem 2.5rem 3.5rem;
	border-bottom: 1px solid var(--rule-dark);
}

.hero-type {
	display: flex;
	align-items: flex-end;
	justify-content: space-between;
	gap: 2rem;
	flex-wrap: wrap;
}

.hero-name {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 144, 'wght' 900;
	font-style: italic;
	font-size: clamp(5.5rem, 16vw, 14rem);
	line-height: 0.88;
	letter-spacing: -0.04em;
	margin: 0;
}

.name-mager {
	color: var(--ink);
}

.name-co {
	color: var(--food-accent);
}

.hero-meta {
	padding-bottom: 0.5rem;
	max-width: 280px;
	flex-shrink: 0;
}

.hero-tagline {
	font-family: var(--font-body);
	font-size: 1.05rem;
	font-style: italic;
	color: var(--ink-mid);
	margin: 0 0 0.6rem;
	line-height: 1.4;
}

.hero-stats {
	font-family: var(--font-mono);
	font-size: 0.7rem;
	color: var(--ink-light);
	margin: 0;
	display: flex;
	align-items: center;
	gap: 0.5rem;
	flex-wrap: wrap;
}

.hero-stats .dot {
	color: var(--rule-dark);
}


/* ══════════════════════════════════════════════════
   ZONE GRID
══════════════════════════════════════════════════ */
.zones {
	display: grid;
	grid-template-columns: 1fr 340px 260px;
	grid-template-rows: auto;
	min-height: 0;
}

.zone {
	padding: 2rem 2.5rem;
	border-right: 1px solid var(--rule);
}

.zone:last-child {
	border-right: none;
}


/* ── Zone header ── */
.zone-head {
	display: flex;
	justify-content: space-between;
	align-items: baseline;
	margin-bottom: 1.75rem;
	padding-bottom: 0.6rem;
	border-bottom: 2px solid currentColor;
}

.zone--code .zone-head { border-color: var(--code-accent); color: var(--code-accent); }
.zone--food .zone-head { border-color: var(--food-accent); color: var(--food-accent); }
.zone--life .zone-head { border-color: var(--life-accent); color: var(--life-accent); }

.zone-label {
	font-family: var(--font-ui);
	font-size: 0.72rem;
	font-weight: 700;
	text-transform: uppercase;
	letter-spacing: 0.12em;
}

.zone-more {
	font-family: var(--font-mono);
	font-size: 0.68rem;
	color: var(--ink-light);
	text-decoration: none;
	transition: color 0.15s ease;
}

.zone-more:hover {
	color: var(--ink);
}


/* ══════════════════════════════════════════════════
   SHARED POST ATOMS
══════════════════════════════════════════════════ */
.post-title {
	font-family: var(--font-display);
	font-variation-settings: 'opsz' 36, 'wght' 700;
	font-size: 1rem;
	line-height: 1.25;
	margin: 0 0 0.35rem;
	color: var(--ink);
}

.post-desc {
	font-family: var(--font-body);
	font-size: 0.88rem;
	line-height: 1.55;
	color: var(--ink-mid);
	margin: 0 0 0.4rem;
}

.post-date {
	font-family: var(--font-mono);
	font-size: 0.65rem;
	color: var(--ink-light);
	text-transform: uppercase;
	letter-spacing: 0.05em;
}


/* ══════════════════════════════════════════════════
   CODE ZONE
══════════════════════════════════════════════════ */
.post-list {
	list-style: none;
	padding: 0;
	margin: 0;
	display: flex;
	flex-direction: column;
}

.post-list li {
	border-bottom: 1px solid var(--rule);
}

.post-list li:last-child {
	border-bottom: none;
}

.post-item {
	display: flex;
	gap: 1rem;
	padding: 1rem 0;
	text-decoration: none;
	color: inherit;
	transition: background 0.15s ease;
	border-radius: 4px;
}

.post-item--lead {
	padding: 1.25rem 0;
}

.post-item--lead .post-title {
	font-size: 1.3rem;
	font-variation-settings: 'opsz' 72, 'wght' 800;
	line-height: 1.2;
	margin-bottom: 0.5rem;
}

.post-item--lead .post-desc {
	display: block;
}

.post-item:not(.post-item--lead) .post-desc {
	display: none;
}

.post-num {
	font-family: var(--font-mono);
	font-size: 0.65rem;
	color: var(--code-accent);
	opacity: 0.5;
	padding-top: 0.2rem;
	flex-shrink: 0;
	min-width: 1.6rem;
	line-height: 1.4;
}

.post-body {
	flex: 1;
	min-width: 0;
}

.post-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}


/* ══════════════════════════════════════════════════
   IMAGE PLACEHOLDERS (no hero image)
══════════════════════════════════════════════════ */
.food-img-placeholder,
.life-img-placeholder {
	width: 100%;
	height: 100%;
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	gap: 0.5rem;
	background: oklch(95% 0.012 50);
	border: 1px dashed var(--rule-dark);
}

.placeholder-emoji {
	font-size: 1.5rem;
	opacity: 0.4;
}

.placeholder-title {
	font-family: var(--font-body);
	font-size: 0.72rem;
	font-style: italic;
	color: var(--ink-light);
	text-align: center;
	padding: 0 0.75rem;
	line-height: 1.3;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
}

/* ══════════════════════════════════════════════════
   FOOD ZONE
══════════════════════════════════════════════════ */
.food-stack {
	display: flex;
	flex-direction: column;
	gap: 0;
}

.food-item {
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
	text-decoration: none;
	color: inherit;
	padding-bottom: 1.25rem;
	margin-bottom: 1.25rem;
	border-bottom: 1px solid var(--rule);
}

.food-item:last-child {
	border-bottom: none;
	margin-bottom: 0;
	padding-bottom: 0;
}

.food-img {
	aspect-ratio: 16 / 9;
	overflow: hidden;
	border-radius: 3px;
}

.food-img img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
	filter: saturate(0.92);
}

.food-item:hover .food-img img {
	transform: scale(1.04);
	filter: saturate(1.05);
}

.food-text {
	display: flex;
	flex-direction: column;
	gap: 0.3rem;
}

.food-text .post-title {
	font-size: 0.95rem;
}

.food-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}


/* ══════════════════════════════════════════════════
   LIFE ZONE
══════════════════════════════════════════════════ */
.life-stack {
	display: flex;
	flex-direction: column;
	gap: 2rem;
}

.life-item {
	display: flex;
	flex-direction: column;
	gap: 0.65rem;
	text-decoration: none;
	color: inherit;
}

.life-img {
	aspect-ratio: 4 / 3;
	overflow: hidden;
	border-radius: 3px;
}

.life-img img {
	width: 100%;
	height: 100%;
	object-fit: cover;
	transition: transform 0.5s ease;
	filter: saturate(0.85) contrast(1.05);
}

.life-item:hover .life-img img {
	transform: scale(1.04);
	filter: saturate(1) contrast(1);
}

.life-item .post-title {
	font-variation-settings: 'opsz' 72, 'wght' 800;
	font-size: 1.05rem;
	line-height: 1.2;
}

.life-item:hover .post-title {
	text-decoration: underline;
	text-underline-offset: 3px;
	text-decoration-thickness: 1px;
}

.empty {
	font-family: var(--font-body);
	font-style: italic;
	color: var(--ink-light);
	font-size: 0.9rem;
}


/* ══════════════════════════════════════════════════
   PAGE LOAD ANIMATION
══════════════════════════════════════════════════ */
@keyframes fadeUp {
	from { opacity: 0; transform: translateY(12px); }
	to   { opacity: 1; transform: translateY(0); }
}

/* Ink-reveal: letters slide up from a clipping mask, staggered */
@keyframes inkReveal {
	from {
		opacity: 0;
		transform: translateY(0.18em) skewX(-2deg);
		filter: blur(6px);
	}
	to {
		opacity: 1;
		transform: translateY(0) skewX(0deg);
		filter: blur(0px);
	}
}

.hero-name {
	animation: fadeUp 0.6s ease both;
}

/* Each char in .hero-name gets staggered via JS */
.hero-name .char {
	display: inline-block;
	animation: inkReveal 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
	will-change: transform, opacity, filter;
}

.hero-meta {
	animation: fadeUp 0.6s 0.1s ease both;
}

.zone {
	animation: fadeUp 0.6s 0.2s ease both;
}

/* Cursor glow orb — positioned via JS */
.cursor-glow {
	position: fixed;
	width: 320px;
	height: 320px;
	border-radius: 50%;
	background: radial-gradient(circle, oklch(65% 0.16 38 / 0.12) 0%, transparent 70%);
	pointer-events: none;
	z-index: 9999;
	transform: translate(-50%, -50%);
	transition: left 0.12s ease, top 0.12s ease;
	will-change: left, top;
}

/* Hero parallax wrapper */
.hero {
	will-change: transform;
}

@media (prefers-reduced-motion: reduce) {
	.hero-name, .hero-meta, .zone, .hero-name .char { animation: none; }
	.cursor-glow { display: none; }
}


/* ══════════════════════════════════════════════════
   RESPONSIVE
══════════════════════════════════════════════════ */
@media (max-width: 1100px) {
	.zones {
		grid-template-columns: 1fr 300px;
	}

	.zone--life {
		grid-column: 1 / -1;
		border-right: none;
		border-top: 1px solid var(--rule);

