}
.entry-thumb:hover img { transform: scale(1.045); filter: saturate(1.08) brightness(1.02); }

/* ── Note entries: tinted marginalia, a distinct voice in the stream ── */
.entry--note .entry-main {
	background: color-mix(in oklch, var(--note-accent) 6%, var(--paper));
	border: 1px solid color-mix(in oklch, var(--note-accent) 16%, var(--rule));
	border-radius: 12px;
	padding: clamp(1.1rem, 2vw, 1.5rem) clamp(1.25rem, 2.4vw, 1.75rem);
}

.entry-linkout {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	font-family: var(--font-mono);
	font-size: 0.85rem;
	color: var(--accent);
	text-decoration: none;
	margin-bottom: 0.6rem;
	word-break: break-word;
}
.entry-linkout::before { content: '→'; opacity: 0.7; transition: transform 0.2s ease; }
.entry-linkout:hover { text-decoration: underline; }
.entry-linkout:hover::before { transform: translateX(3px); }

.entry-note-body { font-family: var(--font-body); color: var(--ink); line-height: 1.62; }
.entry-note-body :global(p) { margin: 0 0 0.8rem; max-width: 64ch; }
.entry-note-body :global(p:last-child) { margin-bottom: 0; }
.entry-note-body :global(ul) { margin: 0 0 0.8rem; padding-left: 1.1rem; }
.entry-note-body :global(li) { margin: 0.2rem 0; max-width: 62ch; }
.entry-note-body :global(strong) { font-weight: 700; color: var(--ink); }
.entry-note-body :global(pre) {
	background: var(--paper);
	border: 1px solid var(--rule);
	border-radius: 8px;
	padding: 0.9rem 1rem;
	overflow-x: auto;
	font-size: 0.82rem;
}
.entry-note-body :global(code) { font-family: var(--font-mono); }
.entry-note-body :global(a) { color: var(--accent); }

.entry-tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.9rem; }
.entry-tag { font-family: var(--font-mono); font-size: 0.68rem; color: var(--ink-light); }
.entry-tag::before { content: '#'; opacity: 0.55; }

/* ── Archive link: closes the stream ── */
.feed-archive {
	display: inline-flex;
	align-items: center;
	gap: 0.6rem;
	margin-top: clamp(2rem, 4vw, 3rem);
	padding: 0.85rem 1.4rem;
	border: 1px solid var(--ink);
	border-radius: 999px;
	font-family: var(--font-ui);
	font-size: 0.8rem;
	font-weight: 600;
	letter-spacing: 0.02em;
	color: var(--ink);
	text-decoration: none;
	transition: background 0.2s ease, color 0.2s ease;
}
.feed-archive:hover { background: var(--ink); color: var(--paper); }
.feed-archive-arrow { transition: transform 0.2s ease; }
.feed-archive:hover .feed-archive-arrow { transform: translateX(4px); }

/* ── Delight: staggered ink-rise on load, echoing the masthead reveal ── */
@keyframes feed-rise {
	from { opacity: 0; transform: translateY(16px); }
	to   { opacity: 1; transform: none; }
}
.feed-head,
.entry { animation: feed-rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
.feed-head { animation-delay: 0.02s; }
.entry:nth-child(2) { animation-delay: 0.10s; }
.entry:nth-child(3) { animation-delay: 0.17s; }
.entry:nth-child(4) { animation-delay: 0.24s; }
.entry:nth-child(5) { animation-delay: 0.30s; }
.entry:nth-child(6) { animation-delay: 0.36s; }
.entry:nth-child(7) { animation-delay: 0.41s; }
.entry:nth-child(n + 8) { animation-delay: 0.45s; }

@media (prefers-reduced-motion: reduce) {
