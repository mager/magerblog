---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const { title, description, heroImage, tags } = post.data;
---

<a
  href={`/blog/${post.id}/`}
  class={`life-card ${featured ? 'featured' : ''}`}
  style={`animation-delay: ${index * 0.08}s`}
>
  <div class="card-image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="card-placeholder">
        <span class="placeholder-icon">&#x1F306;</span>
      </div>
    )}
    <div class="card-image-overlay"></div>
    <div class="card-scanline"></div>
  </div>

  <div class="card-content">
    <div class="card-meta">
      <span class="card-date">
        <FormattedDate date={post.data.pubDate} />
      </span>
      {tags && tags.length > 0 && (
        <span class="card-tag">{tags[0]}</span>
      )}
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>

    <div class="card-footer">
      <span class="card-read-more">
        <span class="read-arrow">&#x2192;</span> Read more
      </span>
    </div>
  </div>
</a>

<style>
  .life-card {
    display: flex;
    flex-direction: column;
    background: var(--lf-bg-card);
    border-radius: 12px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid var(--lf-border);
    position: relative;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: var(--lf-shadow);
    animation: lf-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .life-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--lf-green), var(--lf-accent), var(--lf-green-bright));
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }

  .life-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--lf-shadow-lg), 0 0 30px rgba(63, 185, 80, 0.08);
    border-color: var(--lf-border-green);
  }

  .life-card:hover::before {
    opacity: 1;
  }

  .life-card.featured {
    grid-column: 1 / -1;
  }

  /* ── Image ── */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .life-card.featured .card-image {
    aspect-ratio: 21 / 9;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
    border-radius: 0;
    filter: saturate(0.9) brightness(0.95);
  }

  .life-card:hover .card-image img {
    transform: scale(1.06);
    filter: saturate(1.1) brightness(1.05);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--lf-overlay-end) 0%,
      rgba(6, 13, 6, 0.2) 40%,
      transparent 70%
    );
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .card-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(63, 185, 80, 0.02) 2px,
      rgba(63, 185, 80, 0.02) 4px
    );
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .life-card:hover .card-scanline {
    opacity: 1;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--lf-bg-surface) 0%, var(--lf-bg) 100%);
  }

  .placeholder-icon {
    font-size: 3rem;
    opacity: 0.3;
    filter: grayscale(0.5);
  }

  /* ── Content ── */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .card-date {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.7rem;
    color: var(--lf-text-muted);
    letter-spacing: 0.04em;
  }

  .card-tag {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lf-green);
    background: var(--lf-badge-bg);
    border: 1px solid var(--lf-badge-border);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
  }

  .card-title {
    font-family: 'Space Grotesk', -apple-system, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--lf-text);
    margin: 0;
    letter-spacing: -0.02em;
    transition: color 0.3s ease;
  }

  .life-card.featured .card-title {
    font-size: 2rem;
  }

  .life-card:hover .card-title {
    color: var(--lf-green-bright);
  }

  .card-description {
    font-family: 'JetBrains Mono', -apple-system, sans-serif;
    font-size: 0.85rem;
    color: var(--lf-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .life-card.featured .card-description {
    -webkit-line-clamp: 3;
    font-size: 0.95rem;
  }

  /* ── Footer ── */
  .card-footer {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: 0.75rem;
  }

  .card-read-more {
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--lf-text-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.3s ease;
  }

  .read-arrow {
    transition: transform 0.3s ease;
    display: inline-block;
  }

  .life-card:hover .card-read-more {
    color: var(--lf-green);
  }

  .life-card:hover .read-arrow {
    transform: translateX(4px);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .card-content {
      padding: 1.25rem;
    }

    .card-title {
      font-size: 1.15rem;
    }

    .life-card.featured .card-title {
      font-size: 1.5rem;
    }

    .life-card.featured .card-image {
      aspect-ratio: 16 / 10;
    }

    .card-description {
      font-size: 0.8rem;
      -webkit-line-clamp: 2;
    }
  }
</style>
