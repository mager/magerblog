---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const { title, description, heroImage, tags } = post.data;
---

<a
  href={`/blog/${post.id}/`}
  class={`life-card ${featured ? 'featured' : ''}`}
  style={`animation-delay: ${index * 0.08}s`}
>
  <div class="card-image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="card-placeholder">
        <span class="placeholder-icon">❦</span>
      </div>
    )}
    <div class="card-image-overlay"></div>
    <div class="card-image-motes"></div>
    <div class="card-stamp">field note</div>
  </div>

  <div class="card-content">
    <div class="card-meta">
      <span class="card-date">
        <FormattedDate date={post.data.pubDate} />
      </span>
      {tags && tags.length > 0 && (
        <span class="card-tag">{tags[0]}</span>
      )}
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>

    <div class="card-footer">
      <span class="card-read-more">
        Follow the trail <span class="read-arrow">↗</span>
      </span>
    </div>
  </div>
</a>

<style>
  .life-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.7), rgba(244, 235, 222, 0.92)),
      linear-gradient(135deg, rgba(94, 118, 80, 0.04), rgba(160, 108, 71, 0.06));
    border-radius: 1.7rem;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid rgba(94, 118, 80, 0.14);
    position: relative;
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.55s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.3s ease;
    box-shadow: var(--lf-shadow-card);
    animation: lf-fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    backdrop-filter: blur(12px);
    isolation: isolate;
  }

  .life-card::before,
  .life-card::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .life-card::before {
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(160, 108, 71, 0.24), rgba(94, 118, 80, 0.1), rgba(255,255,255,0.45));
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0.75;
    z-index: 3;
  }

  .life-card::after {
    width: 7rem;
    height: 7rem;
    right: -2rem;
    bottom: -2.2rem;
    border-radius: 58% 42% 65% 35%;
    border: 1px solid rgba(94, 118, 80, 0.12);
    opacity: 0.8;
    transform: rotate(18deg);
  }

  .life-card:hover {
    transform: translateY(-10px) rotate(-0.35deg);
    box-shadow: var(--lf-shadow-lg);
    border-color: rgba(94, 118, 80, 0.25);
  }

  .life-card.featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
  }

  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background:
      radial-gradient(circle at 24% 22%, rgba(255,255,255,0.26), transparent 20%),
      linear-gradient(135deg, rgba(93, 116, 76, 0.16), rgba(154, 106, 71, 0.18));
  }

  .life-card.featured .card-image {
    aspect-ratio: auto;
    min-height: 100%;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1), filter 0.6s ease;
    border-radius: 0;
    filter: saturate(0.94) sepia(0.14) contrast(0.97);
  }

  .life-card:hover .card-image img {
    transform: scale(1.06);
    filter: saturate(1.04) sepia(0.08) contrast(1.01);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(26, 30, 21, 0.45) 0%, rgba(26, 30, 21, 0.12) 38%, rgba(255,255,255,0.03) 100%),
      linear-gradient(to right, rgba(255,255,255,0.06), transparent 24%);
    pointer-events: none;
  }

  .card-image-motes {
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 22%, rgba(255,255,255,0.3) 0 1px, transparent 2px),
      radial-gradient(circle at 74% 28%, rgba(255,255,255,0.22) 0 1px, transparent 2px),
      radial-gradient(circle at 48% 76%, rgba(255,255,255,0.18) 0 1px, transparent 2px),
      radial-gradient(circle at 82% 72%, rgba(255,255,255,0.16) 0 1px, transparent 2px);
    opacity: 0.8;
    mix-blend-mode: screen;
    animation: lf-drift 10s ease-in-out infinite;
    pointer-events: none;
  }

  .card-stamp {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.42rem 0.78rem;
    border-radius: 999px;
    background: rgba(246, 240, 230, 0.82);
    border: 1px solid rgba(94, 118, 80, 0.16);
    color: var(--lf-green-bright);
    font-family: 'Azeret Mono', monospace;
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    box-shadow: 0 10px 22px rgba(57, 46, 32, 0.08);
    z-index: 2;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background:
      radial-gradient(circle at 30% 30%, rgba(255,255,255,0.36), transparent 20%),
      linear-gradient(135deg, rgba(87, 112, 72, 0.24), rgba(154, 106, 71, 0.18));
  }

  .placeholder-icon {
    font-size: 3.4rem;
    color: rgba(47, 74, 45, 0.48);
    animation: lf-float 6s ease-in-out infinite;
  }

  .card-content {
    padding: 1.45rem 1.45rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.76rem;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .life-card.featured .card-content {
    padding: 2rem 1.9rem 2rem;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }

  .card-date,
  .card-tag {
    font-family: 'Azeret Mono', monospace;
    font-size: 0.62rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .card-date {
    color: var(--lf-text-muted);
  }

  .card-tag {
    color: var(--lf-green-bright);
    background: rgba(94, 118, 80, 0.08);
    border: 1px solid rgba(94, 118, 80, 0.12);
    padding: 0.28rem 0.58rem;
    border-radius: 999px;
  }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    line-height: 0.98;
    color: var(--lf-text);
    margin: 0;
    letter-spacing: -0.045em;
    transition: color 0.25s ease;
    text-wrap: balance;
  }

  .life-card:not(.featured) .card-title {
    font-size: 1.62rem;
  }

  .life-card:hover .card-title {
    color: var(--lf-green-bright);
  }

  .card-description {
    font-size: 0.98rem;
    color: var(--lf-text-secondary);
    line-height: 1.72;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .life-card.featured .card-description {
    max-width: 34rem;
    font-size: 1.08rem;
    -webkit-line-clamp: 4;
  }

  .card-footer {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: 0.72rem;
  }

  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--lf-accent);
    font-family: 'Azeret Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .read-arrow {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .life-card:hover .read-arrow {
    transform: translate(3px, -3px);
  }

  @media (max-width: 900px) {
    .life-card.featured {
      grid-template-columns: 1fr;
    }

    .life-card.featured .card-image {
      aspect-ratio: 16 / 10;
      min-height: auto;
    }
  }

  @media (max-width: 720px) {
    .card-content,
    .life-card.featured .card-content {
      padding: 1.15rem 1.15rem 1.2rem;
    }

    .card-title,
    .life-card:not(.featured) .card-title {
      font-size: 1.46rem;
    }

    .life-card.featured .card-title {
      font-size: 1.82rem;
    }

    .card-description,
    .life-card.featured .card-description {
      font-size: 0.94rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
