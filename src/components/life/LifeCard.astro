---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const { title, description, heroImage, tags } = post.data;
---

<a
  href={`/blog/${post.id}/`}
  class={`life-card ${featured ? 'featured' : ''}`}
  style={`animation-delay: ${index * 0.07}s`}
>
  <div class="card-image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="card-placeholder">
        <span class="placeholder-icon">🌊</span>
      </div>
    )}
    <div class="card-stamp">▶ read</div>
  </div>

  <div class="card-content">
    <div class="card-meta">
      <span class="card-date">
        <FormattedDate date={post.data.pubDate} />
      </span>
      {tags && tags.length > 0 && (
        <span class="card-tag">{tags[0]}</span>
      )}
    </div>

    <h3 class="card-title">{title}</h3>
    <p class="card-description">{description}</p>

    <div class="card-footer">
      <span class="card-read-more">
        ▶ explore
      </span>
    </div>
  </div>
</a>

<style>
  /* ── Card base ───────────────────────────────── */
  .life-card {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    background: #FFFFFF;
    border-radius: 0;
    border: 2px solid var(--lf-pixel);
    box-shadow: var(--lf-shadow-card);
    text-decoration: none !important;
    color: inherit;
    position: relative;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
    animation: lf-fadeUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .life-card:hover {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 var(--lf-pixel);
  }

  .life-card.featured {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
  }

  /* ── Card image ──────────────────────────────── */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: linear-gradient(135deg, var(--lf-sky) 0%, var(--lf-teal) 100%);
    border-bottom: 2px solid var(--lf-pixel);
  }

  .life-card.featured .card-image {
    aspect-ratio: auto;
    min-height: 100%;
    border-bottom: none;
    border-right: 2px solid var(--lf-pixel);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 0;
    display: block;
  }

  .life-card:hover .card-image img {
    transform: scale(1.05);
  }

  .card-stamp {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    padding: 0.38rem 0.72rem;
    background: var(--lf-coral);
    border: 2px solid var(--lf-pixel);
    box-shadow: 2px 2px 0 var(--lf-pixel);
    color: #FFFFFF;
    font-family: 'Azeret Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    z-index: 2;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--lf-sky) 0%, #7DD3FC 100%);
  }

  .placeholder-icon {
    font-size: 3rem;
    animation: lf-float 5s ease-in-out infinite;
  }

  /* ── Card content ────────────────────────────── */
  .card-content {
    padding: 1.4rem 1.4rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    flex: 1;
  }

  .life-card.featured .card-content {
    padding: 2rem 1.9rem;
    justify-content: center;
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
  }

  .card-date {
    font-family: 'Azeret Mono', monospace;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lf-text-muted);
  }

  .card-tag {
    font-family: 'Azeret Mono', monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lf-white);
    background: var(--lf-teal);
    border: 1px solid var(--lf-pixel);
    padding: 0.24rem 0.52rem;
  }

  .card-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 0.98;
    color: var(--lf-text);
    margin: 0;
    letter-spacing: -0.045em;
    transition: color 0.15s ease;
    text-wrap: balance;
  }

  .life-card:not(.featured) .card-title {
    font-size: 1.58rem;
  }

  .life-card:hover .card-title {
    color: var(--lf-coral-dark);
  }

  .card-description {
    font-size: 0.97rem;
    color: var(--lf-text-secondary);
    line-height: 1.7;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .life-card.featured .card-description {
    max-width: 34rem;
    font-size: 1.06rem;
    -webkit-line-clamp: 4;
  }

  .card-footer {
    display: flex;
    align-items: center;
    margin-top: auto;
    padding-top: 0.65rem;
    border-top: 1px solid rgba(12, 35, 64, 0.1);
  }

  .card-read-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--lf-coral);
    font-family: 'Azeret Mono', monospace;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.15s ease, letter-spacing 0.15s ease;
  }

  .life-card:hover .card-read-more {
    color: var(--lf-coral-dark);
    letter-spacing: 0.22em;
  }

  /* ── Responsive ──────────────────────────────── */
  @media (max-width: 900px) {
    .life-card.featured {
      grid-template-columns: 1fr;
    }
    .life-card.featured .card-image {
      aspect-ratio: 16 / 10;
      min-height: auto;
      border-right: none;
      border-bottom: 2px solid var(--lf-pixel);
    }
  }

  @media (max-width: 720px) {
    .card-content,
    .life-card.featured .card-content {
      padding: 1.1rem 1.15rem 1.2rem;
    }
    .card-title,
    .life-card:not(.featured) .card-title {
      font-size: 1.42rem;
    }
    .life-card.featured .card-title {
      font-size: 1.78rem;
    }
    .card-description,
    .life-card.featured .card-description {
      font-size: 0.93rem;
      -webkit-line-clamp: 3;
    }
  }
</style>
