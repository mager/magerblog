---
import type { FeedEntry } from '../lib/feed';
import { entryHref, entryTitle } from '../lib/feed';
import { entryCategory, entryDate, entryDescription, entryImage, feedDate } from '../lib/feed-display';
import { contentMeta } from '../lib/content-meta';
import PostRow from './PostRow.astro';
interface Props {
  entries: FeedEntry[];
  presentation?: 'list' | 'life' | 'notes';
  heading?: string;
  filters?: [string, string][];
  filterBy?: 'category' | 'subcategory';
  featured?: boolean;
  videos?: boolean;
  searchLabel?: string;
}
const { entries, presentation = 'list', heading = 'All posts', filters = [], filterBy = 'category', featured = false, videos = false, searchLabel = 'Search all posts' } = Astro.props;
const lead = featured ? entries[0] : undefined;
const notes = presentation === 'notes';
const listHeading = notes ? (lead ? 'Earlier notes' : 'All notes') : heading;
const itemName = notes ? 'note' : 'post';
const remaining = entries.length - (lead ? 1 : 0);
const leads = featured ? [...new Set([lead, ...filters.map(([value]) => entries.find(entry =>
  value === 'all' || (filterBy === 'subcategory'
    ? entry.collection === 'blog' && entry.data.subcategory === value
    : entryCategory(entry) === value)
))].filter((entry): entry is FeedEntry => !!entry))] : [];
---
<section class:list={["simple-posts", { "life-posts": presentation === "life", "notes-posts": notes }]} data-simple-list data-filter-by={filterBy} data-item-name={notes ? itemName : undefined} aria-labelledby="simple-posts-heading">
  <slot name="intro" />
  <div class="simple-controls" hidden>
    {filters.length > 0 && <div class="simple-filters" role="group" aria-label="Filter posts">{filters.map(([value, label]) => <button type="button" data-simple-filter={value} aria-pressed={value === 'all' ? 'true' : 'false'} aria-controls="simple-list">{label}</button>)}</div>}
    <div class="simple-search" role="search">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
      <input id="simple-query" type="search" aria-label={searchLabel} placeholder={`${searchLabel}…`} autocomplete="off" maxlength="200" />
      <button type="button" data-simple-clear hidden>Clear</button>
    </div>
    <div class="simple-search-status"><p data-simple-status role="status" aria-live="polite" aria-atomic="true"></p><button type="button" data-simple-retry hidden>Try again</button></div>
  </div>
  {leads.map(item => { const leadImage = entryImage(item); const date = feedDate(item.data); const updated = 'updatedDate' in item.data && !!item.data.updatedDate; return <article class="simple-feature" data-simple-feature data-href={entryHref(item)} hidden={item !== lead}>
    <div class="simple-feature-copy">
      <h2><a href={item.collection === 'links' ? item.data.url : entryHref(item)}>{entryTitle(item)}</a></h2>
      <p>{entryDescription(item)}</p>
      <div class="simple-feature-meta"><time datetime={date.toISOString()}>{updated && 'Updated '}{entryDate(date)}</time><span>{contentMeta(item)}</span></div>
    </div>
    {leadImage && <a class="simple-feature-image" href={entryHref(item)} aria-label={`Read ${entryTitle(item)}`}><img src={leadImage} alt="" width="240" height="160" loading={item === lead ? 'eager' : 'lazy'} decoding="async" /></a>}
  </article>; })}
  <div class="simple-list-heading"><h2 id="simple-posts-heading" data-default-heading={listHeading}>{listHeading}</h2><p data-simple-count>{remaining} {itemName}{remaining === 1 ? '' : 's'}</p></div>
  <ul id="simple-list" class="simple-list">{entries.map((entry, index) => <PostRow expanded={presentation === "life" && index > 0 && index < 5} notePreview={notes} entry={entry} featured={lead === entry} videos={videos} />)}</ul>
  <p class="simple-empty" data-simple-empty hidden>No {itemName}s match. Try another search{filters.length > 0 ? ' or choose All.' : '.'}</p>
  <button class="simple-more" type="button" data-simple-more hidden>Show more {itemName}s</button>
  {entries.length === 0 && <p>No {itemName}s yet.</p>}
</section>
<script>
  import '../scripts/simple-home';
</script>
