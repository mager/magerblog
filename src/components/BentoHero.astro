---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	codePosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
}

const { codePosts, lifePosts, recipePosts } = Astro.props;

const top3Code   = codePosts.slice(0, 3);
const top3Life   = lifePosts.slice(0, 3);
const top3Recipe = recipePosts.slice(0, 3);

// Cycling words — pull keyword or smart extract from title
function getKeyword(post: CollectionEntry<'blog'>): string {
	if (post.data.keyword) return post.data.keyword;
	const title = post.data.title;
	const cleaned = title
		.replace(/^(Building an?|My|The|How to|A Guide to|Visit to)\s+/i, '')
		.replace(/,.*$/, '')
		.replace(/\s+(with|using|in|on|for|from|and).*$/i, '');
	return cleaned.split(' ').slice(0, 2).join(' ').toLowerCase();
}

const codeKeywords   = codePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'indigo' }));
const lifeKeywords   = lifePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'teal' }));
const recipeKeywords = recipePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'amber' }));

const categories = [
	{
		key: 'code',
		label: 'Code',
		href: '/code/',
		color: 'indigo',
		posts: top3Code,
	},
	{
		key: 'life',
		label: 'Life',
		href: '/life/',
		color: 'teal',
		posts: top3Life,
	},
	{
		key: 'food',
		label: 'Recipes',
		href: '/recipes/',
		color: 'amber',
		posts: top3Recipe,
	},
] as const;
---

<div class="homepage">
	<!-- ══════════════════════ ABSTRACT BG ══════════════════════ -->
	<div class="abstract-bg" aria-hidden="true">
		<svg class="blob blob-1" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
					<stop offset="0%" style="stop-color: #e8dff5; stop-opacity: 0.6" />
					<stop offset="100%" style="stop-color: #fce4ec; stop-opacity: 0.4" />
				</linearGradient>
			</defs>
			<path d="M300,520 C420,520 520,420 520,300 C520,180 420,80 300,80 C180,80 80,180 80,300 C80,420 180,520 300,520" fill="url(#grad1)" />
		</svg>
		<svg class="blob blob-2" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="grad2" x1="0%" y1="100%" x2="100%" y2="0%">
					<stop offset="0%" style="stop-color: #d5f5e3; stop-opacity: 0.5" />
					<stop offset="100%" style="stop-color: #e0f2fe; stop-opacity: 0.3" />
				</linearGradient>
			</defs>
			<path d="M300,520 C420,520 520,420 520,300 C520,180 420,80 300,80 C180,80 80,180 80,300 C80,420 180,520 300,520" fill="url(#grad2)" />
		</svg>
		<svg class="blob blob-3" viewBox="0 0 600 600" xmlns="http://www.w3.org/2000/svg">
			<defs>
				<linearGradient id="grad3" x1="100%" y1="0%" x2="0%" y2="100%">
					<stop offset="0%" style="stop-color: #fff3e0; stop-opacity: 0.5" />
					<stop offset="100%" style="stop-color: #fce4ec; stop-opacity: 0.3" />
				</linearGradient>
			</defs>
			<path d="M300,520 C420,520 520,420 520,300 C520,180 420,80 300,80 C180,80 80,180 80,300 C80,420 180,520 300,520" fill="url(#grad3)" />
		</svg>
		<canvas id="mesh-canvas" aria-hidden="true"></canvas>
	</div>

	<!-- ══════════════════════ GRAIN ══════════════════════ -->
	<div class="grain" aria-hidden="true"></div>

	<!-- ══════════════════════ HERO ══════════════════════ -->
	<section class="hero">
		<div class="hero-inner">
			<p class="hero-eyebrow">Always learning. Always eating. Chicago.</p>
			<h1 class="hero-headline">
				From <a href="#" class="word-cycle word-indigo" id="word-one">AI recommendations</a><br />
				to <a href="#" class="word-cycle word-teal" id="word-two">Sicily</a><br />
				to <a href="#" class="word-cycle word-amber" id="word-three">green curry</a>.
			</h1>
			<div class="hero-dots" id="hero-dots" aria-hidden="true"></div>
			<nav class="hero-nav" aria-label="Categories">
				<a href="/code/"    class="hero-pill pill-indigo">Code</a>
				<a href="/life/"    class="hero-pill pill-teal">Life</a>
				<a href="/recipes/" class="hero-pill pill-amber">Recipes</a>
			</nav>
		</div>
		<!-- Decorative line art -->
		<svg class="hero-line-art" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
			<circle cx="200" cy="200" r="120" fill="none" stroke="rgba(99,102,241,0.12)" stroke-width="1" />
			<circle cx="200" cy="200" r="80" fill="none" stroke="rgba(20,184,166,0.1)" stroke-width="1" />
			<circle cx="200" cy="200" r="160" fill="none" stroke="rgba(245,158,11,0.08)" stroke-width="1" stroke-dasharray="8 6" />
			<line x1="80" y1="200" x2="320" y2="200" stroke="rgba(99,102,241,0.06)" stroke-width="0.5" />
			<line x1="200" y1="40" x2="200" y2="360" stroke="rgba(20,184,166,0.06)" stroke-width="0.5" />
		</svg>
	</section>

	<!-- ══════════════════════ CATEGORIES ══════════════════════ -->
	<div class="sections-wrap">
		{categories.map(cat => (
			<section class={`cat-section cat-${cat.color}`}>
				<div class="cat-inner">
					<div class="cat-header">
						<div class="cat-title-row">
							<div class={`cat-accent-bar bar-${cat.color}`}></div>
							<h2 class="cat-name">{cat.label}</h2>
						</div>
						<a href={cat.href} class={`cat-view-all link-${cat.color}`}>
							View all →
						</a>
					</div>

					<div class="posts-grid">
						{cat.posts.map(post => (
							<a href={`/blog/${post.id}/`} class={`post-card card-${cat.color}`}>
								<div class="card-img-wrap">
									{post.data.heroImage
										? <img src={post.data.heroImage} alt="" loading="lazy" class="card-img" />
										: <div class={`card-img-placeholder ph-${cat.color}`}>
												<div class="ph-pattern"></div>
											</div>
									}
								</div>
								<div class="card-body">
									<div class="card-meta">
										<span class={`card-tag tag-${cat.color}`}>{cat.label}</span>
										<time class="card-date"><FormattedDate date={post.data.pubDate} /></time>
									</div>
									<h3 class="card-title">{post.data.title}</h3>
									{post.data.description && (
										<p class="card-desc">{post.data.description}</p>
									)}
								</div>
							</a>
						))}
					</div>
				</div>
			</section>
		))}
	</div>
</div>

<script define:vars={{ codeKeywords, lifeKeywords, recipeKeywords }}>
	// ── Mesh gradient canvas ────────────────────────────────
	(function() {
		const canvas = document.getElementById('mesh-canvas');
		if (!canvas) return;
		const ctx = canvas.getContext('2d');
		let W, H;

		function resize() {
			W = canvas.width = window.innerWidth;
			H = canvas.height = window.innerHeight;
		}

		// Floating gradient orbs
		const orbs = [
			{ x: 0.2, y: 0.3, r: 300, color: [232, 223, 245], speed: 0.0003, phase: 0 },
			{ x: 0.7, y: 0.2, r: 250, color: [213, 245, 227], speed: 0.0004, phase: 2 },
			{ x: 0.5, y: 0.7, r: 280, color: [255, 243, 224], speed: 0.00035, phase: 4 },
			{ x: 0.3, y: 0.8, r: 200, color: [224, 242, 254], speed: 0.00025, phase: 1 },
			{ x: 0.8, y: 0.6, r: 220, color: [252, 228, 236], speed: 0.00045, phase: 3 },
		];

		let time = 0;
		function draw() {
			ctx.clearRect(0, 0, W, H);
			time++;

			for (const orb of orbs) {
				const cx = (orb.x + Math.sin(time * orb.speed + orb.phase) * 0.08) * W;
				const cy = (orb.y + Math.cos(time * orb.speed * 0.7 + orb.phase) * 0.06) * H;
				const [r, g, b] = orb.color;

				const grad = ctx.createRadialGradient(cx, cy, 0, cx, cy, orb.r);
				grad.addColorStop(0, `rgba(${r},${g},${b},0.35)`);
				grad.addColorStop(0.5, `rgba(${r},${g},${b},0.15)`);
				grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
				ctx.fillStyle = grad;
				ctx.beginPath();
				ctx.arc(cx, cy, orb.r, 0, Math.PI * 2);
				ctx.fill();
			}

			requestAnimationFrame(draw);
		}

		resize();
		window.addEventListener('resize', resize);
		draw();
	})();

	// ── Word cycling ───────────────────────────────────────
	const triplets = [];
	codeKeywords.forEach((code, i) => {
		const life   = lifeKeywords[i % lifeKeywords.length];
		const recipe = recipeKeywords[i % recipeKeywords.length];
		triplets.push({
			one:   { word: code.word,   slug: code.slug,   color: 'indigo' },
			two:   { word: life.word,   slug: life.slug,   color: 'teal'  },
			three: { word: recipe.word, slug: recipe.slug, color: 'amber' },
		});
	});
	recipeKeywords.forEach((recipe, i) => {
		const code = codeKeywords[i % codeKeywords.length];
		const life = lifeKeywords[i % lifeKeywords.length];
		triplets.push({
			one:   { word: recipe.word, slug: recipe.slug, color: 'amber' },
			two:   { word: code.word,   slug: code.slug,   color: 'indigo' },
			three: { word: life.word,   slug: life.slug,   color: 'teal'  },
		});
	});
	lifeKeywords.forEach((life, i) => {
		const recipe = recipeKeywords[i % recipeKeywords.length];
		const code   = codeKeywords[i % codeKeywords.length];
		triplets.push({
			one:   { word: life.word,   slug: life.slug,   color: 'teal'  },
			two:   { word: recipe.word, slug: recipe.slug, color: 'amber' },
			three: { word: code.word,   slug: code.slug,   color: 'indigo' },
		});
	});

	let idx = 0;
	let paused = false;
	const w1 = document.getElementById('word-one');
	const w2 = document.getElementById('word-two');
	const w3 = document.getElementById('word-three');
	const dotsEl = document.getElementById('hero-dots');

	function buildDots() {
		if (!dotsEl || !triplets.length) return;
		dotsEl.innerHTML = '';
		triplets.forEach((t, i) => {
			const dot = document.createElement('button');
			dot.className = 'dot';
			dot.setAttribute('aria-label', `Slide ${i + 1}`);
			dot.dataset.color = t.one.color;
			dot.addEventListener('click', () => {
				if (i !== idx) { idx = i; applyTriplet(triplets[idx]); updateDots(); }
			});
			dotsEl.appendChild(dot);
		});
		updateDots();
	}

	function updateDots() {
		if (!dotsEl) return;
		const dots = dotsEl.querySelectorAll('.dot');
		dots.forEach((dot, i) => {
			dot.classList.toggle('active', i === idx);
			dot.dataset.color = triplets[i].one.color;
		});
	}

	function applyTriplet(t) {
		const setWord = (el, d) => {
			if (!el) return;
			el.textContent = d.word;
			el.href = `/blog/${d.slug}/`;
			el.className = `word-cycle word-${d.color}`;
		};
		setWord(w1, t.one);
		setWord(w2, t.two);
		setWord(w3, t.three);
	}

	function cycle() {
		if (paused) return;
		[w1, w2, w3].forEach(w => w?.classList.add('fade-out'));
		setTimeout(() => {
			idx = (idx + 1) % triplets.length;
			applyTriplet(triplets[idx]);
			updateDots();
			[w1, w2, w3].forEach(w => w?.classList.remove('fade-out'));
		}, 380);
	}

	[w1, w2, w3].forEach(w => {
		w?.addEventListener('mouseenter', () => { paused = true; });
		w?.addEventListener('mouseleave', () => { paused = false; });
	});

	if (triplets.length) {
		applyTriplet(triplets[0]);
		buildDots();
		setInterval(cycle, 6000);
	}
</script>

<style>
/* ─── Page shell ──────────────────────────────────────────── */
.homepage {
	background: #faf8f5;
	min-height: 100vh;
	overflow-x: hidden;
	position: relative;
	color: #1a1a2e;
}

/* ─── Grain texture ───────────────────────────────────────── */
.grain {
	position: fixed;
	inset: 0;
	pointer-events: none;
	z-index: 50;
	opacity: 0.03;
	background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
	background-repeat: repeat;
	background-size: 256px;
}

/* ─── Abstract background ─────────────────────────────────── */
.abstract-bg {
	position: fixed;
	inset: 0;
	z-index: 0;
	pointer-events: none;
	overflow: hidden;
}

#mesh-canvas {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	opacity: 0.7;
}

.blob {
	position: absolute;
	width: 500px;
	height: 500px;
	filter: blur(80px);
	opacity: 0.5;
	animation: float 20s ease-in-out infinite;
}
.blob-1 {
	top: -10%;
	left: -5%;
	animation-delay: 0s;
}
.blob-2 {
	top: 20%;
	right: -10%;
	animation-delay: -7s;
}
.blob-3 {
	bottom: -5%;
	left: 30%;
	animation-delay: -14s;
}

@keyframes float {
	0%, 100% { transform: translate(0, 0) scale(1) rotate(0deg); }
	25% { transform: translate(30px, -20px) scale(1.05) rotate(3deg); }
	50% { transform: translate(-20px, 15px) scale(0.95) rotate(-2deg); }
	75% { transform: translate(15px, 25px) scale(1.02) rotate(1deg); }
}

/* ─── Hero ────────────────────────────────────────────────── */
.hero {
	position: relative;
	z-index: 1;
	min-height: 80vh;
	display: flex;
	align-items: center;
	justify-content: center;
	padding: 6rem 2rem 4rem;
}

.hero-inner {
	max-width: 800px;
	text-align: center;
}

.hero-eyebrow {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.85rem;
	font-weight: 500;
	letter-spacing: 0.08em;
	color: #6b7280;
	margin: 0 0 1.5rem;
	text-transform: uppercase;
}

.hero-headline {
	font-family: 'Space Grotesk', sans-serif;
	font-weight: 700;
	font-size: clamp(2.8rem, 7vw, 5.5rem);
	line-height: 1.1;
	letter-spacing: -0.02em;
	color: #111111;
	margin: 0 0 2rem;
}

/* ─── Cycling words ───────────────────────────────────────── */
.word-cycle {
	display: inline;
	text-decoration: none;
	transition: opacity 0.4s ease, transform 0.4s ease, filter 0.4s ease;
	cursor: pointer;
	position: relative;
}
.word-cycle::after {
	content: '';
	position: absolute;
	bottom: 2px;
	left: 0;
	width: 100%;
	height: 6px;
	border-radius: 3px;
	opacity: 0.3;
	transform: scaleX(0);
	transform-origin: right;
	transition: transform 0.3s ease;
}
.word-cycle:hover::after {
	transform: scaleX(1);
	transform-origin: left;
}
.word-cycle.fade-out {
	opacity: 0;
	transform: translateY(-8px);
	filter: blur(4px);
}

@keyframes wordSlideIn {
	from { opacity: 0; transform: translateY(8px); filter: blur(4px); }
	to   { opacity: 1; transform: translateY(0);   filter: blur(0); }
}
.word-cycle:not(.fade-out) {
	animation: wordSlideIn 0.45s cubic-bezier(0.22, 1, 0.36, 1);
}

/* Word colors — rich and warm on light bg */
.word-indigo {
	color: #6366f1;
}
.word-indigo::after {
	background: #c7d2fe;
}
.word-teal {
	color: #0d9488;
}
.word-teal::after {
	background: #99f6e4;
}
.word-amber {
	color: #d97706;
}
.word-amber::after {
	background: #fde68a;
}

/* ─── Dots ────────────────────────────────────────────────── */
.hero-dots {
	display: flex;
	gap: 6px;
	justify-content: center;
	margin-bottom: 2rem;
}
.dot {
	width: 6px;
	height: 6px;
	border-radius: 50%;
	border: none;
	background: rgba(26, 26, 46, 0.15);
	cursor: pointer;
	padding: 0;
	transition: all 0.3s ease;
}
.dot.active {
	width: 20px;
	border-radius: 3px;
}
.dot[data-color="indigo"].active { background: #6366f1; }
.dot[data-color="teal"].active   { background: #14b8a6; }
.dot[data-color="amber"].active  { background: #f59e0b; }

/* ─── Hero nav pills ─────────────────────────────────────── */
.hero-nav {
	display: flex;
	gap: 0.75rem;
	justify-content: center;
	flex-wrap: wrap;
}
.hero-pill {
	display: inline-flex;
	align-items: center;
	padding: 0.5rem 1.4rem;
	font-family: 'Space Grotesk', sans-serif;
	font-size: 0.9rem;
	font-weight: 600;
	border-radius: 999px;
	text-decoration: none;
	border: 1.5px solid;
	transition: all 0.25s ease;
	backdrop-filter: blur(8px);
}
.pill-indigo {
	color: #6366f1;
	border-color: rgba(99, 102, 241, 0.3);
	background: rgba(99, 102, 241, 0.06);
}
.pill-indigo:hover {
	background: rgba(99, 102, 241, 0.12);
	border-color: rgba(99, 102, 241, 0.5);
	transform: translateY(-2px);
	box-shadow: 0 4px 16px rgba(99, 102, 241, 0.15);
}
.pill-teal {
	color: #0d9488;
	border-color: rgba(20, 184, 166, 0.3);
	background: rgba(20, 184, 166, 0.06);
}
.pill-teal:hover {
	background: rgba(20, 184, 166, 0.12);
	border-color: rgba(20, 184, 166, 0.5);
	transform: translateY(-2px);
	box-shadow: 0 4px 16px rgba(20, 184, 166, 0.15);
}
.pill-amber {
	color: #d97706;
	border-color: rgba(245, 158, 11, 0.3);
	background: rgba(245, 158, 11, 0.06);
}
.pill-amber:hover {
	background: rgba(245, 158, 11, 0.12);
	border-color: rgba(245, 158, 11, 0.5);
	transform: translateY(-2px);
	box-shadow: 0 4px 16px rgba(245, 158, 11, 0.15);
}

/* ─── Hero line art ───────────────────────────────────────── */
.hero-line-art {
	position: absolute;
	right: 5%;
	top: 50%;
	transform: translateY(-50%);
	width: 320px;
	height: 320px;
	opacity: 0.6;
	animation: spin-slow 60s linear infinite;
	pointer-events: none;
}

@keyframes spin-slow {
	from { transform: translateY(-50%) rotate(0deg); }
	to   { transform: translateY(-50%) rotate(360deg); }
}

/* ─── Category sections ───────────────────────────────────── */
.sections-wrap {
	position: relative;
	z-index: 1;
	width: 100%;
	padding-bottom: 4rem;
}

.cat-section {
	width: 100%;
	padding: 3rem 0;
}

.cat-inner {
	max-width: 1200px;
	margin: 0 auto;
	padding: 0 2rem;
}

.cat-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 1.75rem;
}

.cat-title-row {
	display: flex;
	align-items: center;
	gap: 0.75rem;
}

.cat-accent-bar {
	width: 4px;
	height: 28px;
	border-radius: 2px;
}
.bar-indigo { background: #6366f1; }
.bar-teal   { background: #14b8a6; }
.bar-amber  { background: #f59e0b; }

.cat-name {
	font-family: 'Space Grotesk', sans-serif;
	font-size: 1.5rem;
	font-weight: 700;
	color: #1a1a2e;
	margin: 0;
	letter-spacing: -0.01em;
}

.cat-view-all {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.8rem;
	font-weight: 500;
	text-decoration: none;
	transition: all 0.2s ease;
}
.link-indigo { color: #6366f1; }
.link-indigo:hover { color: #4f46e5; }
.link-teal { color: #0d9488; }
.link-teal:hover { color: #0f766e; }
.link-amber { color: #d97706; }
.link-amber:hover { color: #b45309; }

/* ─── Section dividers ────────────────────────────────────── */
.cat-section + .cat-section {
	border-top: 1px solid rgba(26, 26, 46, 0.06);
}

/* ─── Post cards ──────────────────────────────────────────── */
.posts-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.5rem;
}

.post-card {
	position: relative;
	background: rgba(255, 255, 255, 0.7);
	border: 1px solid rgba(26, 26, 46, 0.06);
	border-radius: 16px;
	overflow: hidden;
	text-decoration: none;
	color: inherit;
	transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1),
				box-shadow 0.35s ease,
				border-color 0.35s ease;
	display: flex;
	flex-direction: column;
	backdrop-filter: blur(10px);
}

.post-card:hover {
	transform: translateY(-4px);
}

.card-indigo:hover {
	box-shadow: 0 16px 48px -8px rgba(99, 102, 241, 0.12),
				0 2px 8px rgba(0, 0, 0, 0.04);
