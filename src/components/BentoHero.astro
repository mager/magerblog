---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	codePosts: CollectionEntry<'blog'>[];
	lifePosts: CollectionEntry<'blog'>[];
	recipePosts: CollectionEntry<'blog'>[];
	// Legacy props kept for compat but unused
	featuredCode?: CollectionEntry<'blog'>;
	featuredLife?: CollectionEntry<'blog'>;
	featuredRecipe?: CollectionEntry<'blog'>;
}

const { codePosts, lifePosts, recipePosts } = Astro.props;

const top3Code   = codePosts.slice(0, 3);
const top3Life   = lifePosts.slice(0, 3);
const top3Recipe = recipePosts.slice(0, 3);

// Cycling words — pull keyword or smart extract from title
function getKeyword(post: CollectionEntry<'blog'>): string {
	if (post.data.keyword) return post.data.keyword;
	const title = post.data.title;
	const cleaned = title
		.replace(/^(Building an?|My|The|How to|A Guide to|Visit to)\s+/i, '')
		.replace(/,.*$/, '')
		.replace(/\s+(with|using|in|on|for|from|and).*$/i, '');
	return cleaned.split(' ').slice(0, 2).join(' ').toLowerCase();
}

const codeKeywords   = codePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'purple' }));
const lifeKeywords   = lifePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'green' }));
const recipeKeywords = recipePosts.slice(0, 3).map(p => ({ word: getKeyword(p), slug: p.id, color: 'orange' }));

const categories = [
	{
		key: 'code',
		label: 'Code',
		href: '/code/',
		icon: '◈',
		color: 'purple',
		posts: top3Code,
		placeholderGrad: 'linear-gradient(135deg, #1e1033 0%, #2d1b4e 50%, #0f0a1e 100%)',
	},
	{
		key: 'life',
		label: 'Life',
		href: '/life/',
		icon: '◉',
		color: 'green',
		posts: top3Life,
		placeholderGrad: 'linear-gradient(135deg, #0a1f15 0%, #143d24 50%, #050f0a 100%)',
	},
	{
		key: 'food',
		label: 'Recipes',
		href: '/recipes/',
		icon: '◎',
		color: 'orange',
		posts: top3Recipe,
		placeholderGrad: 'linear-gradient(135deg, #1f1108 0%, #3d2211 50%, #0f0804 100%)',
	},
] as const;
---

<div class="cosmos-page">
	<!-- ══════════════════════ HERO ══════════════════════ -->
	<section class="hero">
		<canvas id="starfield" aria-hidden="true"></canvas>

		<!-- Nebula blobs -->
		<div class="nebula nebula-purple" aria-hidden="true"></div>
		<div class="nebula nebula-teal"   aria-hidden="true"></div>
		<div class="nebula nebula-blue"   aria-hidden="true"></div>

		<!-- Planet + ring -->
		<div class="planet-wrap" aria-hidden="true">
			<div class="orbital-ring"></div>
			<div class="planet">
				<div class="planet-shimmer"></div>
			</div>
			<div class="planet-glow"></div>
		</div>

		<!-- Hero content -->
		<div class="hero-content">
			<h1 class="hero-headline headline-display">
				From <a href="#" class="word-cycle word-one" id="word-one">AI recommendations</a><br />
				to <a href="#" class="word-cycle word-two" id="word-two">Sicily</a><br />
				to <a href="#" class="word-cycle word-three" id="word-three">green curry</a>.
			</h1>
			<p class="hero-sub">Always learning. Always eating. Chicago.</p>
			<nav class="hero-cats" aria-label="Categories">
				<a href="/code/"    class="hero-cat cat-purple">✦ Code</a>
				<a href="/life/"    class="hero-cat cat-green" >✦ Life</a>
				<a href="/recipes/" class="hero-cat cat-orange">✦ Recipes</a>
			</nav>
		</div>

		<!-- Geometric wireframe icosahedron -->
		<canvas id="geo-shape" aria-hidden="true"></canvas>
	</section>

	<!-- ══════════════════════ CATEGORIES ══════════════════════ -->
	<div class="categories-wrap">
		{categories.map(cat => (
			<section class={`cat-section cat-${cat.color}`}>
				<!-- Full-bleed separator line -->
				<div class="cat-orbit-line" aria-hidden="true"></div>

				<!-- Content constrained to readable width -->
				<div class="cat-inner">
					<div class="cat-header">
						<div class="cat-header-left">
							<span class="cat-icon" aria-hidden="true">{cat.icon}</span>
							<h2 class="cat-name">{cat.label}</h2>
						</div>
						<a href={cat.href} class="cat-view-all">
							View all <span aria-hidden="true">→</span>
						</a>
					</div>

					<div class="posts-grid">
						{cat.posts.map(post => (
							<a href={`/blog/${post.id}/`} class="post-card">
								<div class="card-img-wrap">
									{post.data.heroImage
										? <img src={post.data.heroImage} alt="" loading="lazy" class="card-img" />
										: <div class="card-img-placeholder" style={`background: ${cat.placeholderGrad}`}></div>
									}
									<div class="card-img-overlay"></div>
								</div>
								<div class="card-body">
									<div class="card-meta">
										<span class={`card-badge badge-${cat.color}`}>{cat.label}</span>
										<span class="card-date"><FormattedDate date={post.data.pubDate} /></span>
									</div>
									<h3 class="card-title">{post.data.title}</h3>
									{post.data.description && (
										<p class="card-desc">{post.data.description}</p>
									)}
								</div>
								<div class={`card-glow glow-${cat.color}`}></div>
							</a>
						))}
					</div>
				</div>
			</section>
		))}
	</div>
</div>

<script define:vars={{ codeKeywords, lifeKeywords, recipeKeywords }}>
	// ── Starfield ──────────────────────────────────────────────
	const canvas = document.getElementById('starfield');
	if (canvas) {
		const ctx = canvas.getContext('2d');
		let stars = [];
		let W, H;

		function resize() {
			W = canvas.width  = canvas.offsetWidth;
			H = canvas.height = canvas.offsetHeight;
		}

		function initStars() {
			stars = [];
			const count = Math.floor((W * H) / 4000);
			for (let i = 0; i < count; i++) {
				stars.push({
					x: Math.random() * W,
					y: Math.random() * H,
					r: Math.random() * 1.4 + 0.2,
					a: Math.random(),
					da: (Math.random() - 0.5) * 0.006,
					vx: (Math.random() - 0.5) * 0.08,
					vy: (Math.random() - 0.5) * 0.04,
				});
			}
		}

		function drawStars() {
			ctx.clearRect(0, 0, W, H);
			for (const s of stars) {
				s.a += s.da;
				if (s.a > 1 || s.a < 0) s.da = -s.da;
				s.x += s.vx;
				s.y += s.vy;
				if (s.x < 0) s.x = W;
				if (s.x > W) s.x = 0;
				if (s.y < 0) s.y = H;
				if (s.y > H) s.y = 0;

				ctx.beginPath();
				ctx.arc(s.x, s.y, s.r, 0, Math.PI * 2);
				ctx.fillStyle = `rgba(255, 255, 255, ${Math.max(0, Math.min(1, s.a))})`;
				ctx.fill();
			}
			requestAnimationFrame(drawStars);
		}

		const ro = new ResizeObserver(() => { resize(); initStars(); });
		ro.observe(canvas);
		resize();
		initStars();
		drawStars();
	}

	// ── Rotating wireframe icosahedron ────────────────────────
	const geoCanvas = document.getElementById('geo-shape');
	if (geoCanvas) {
		const gc = geoCanvas.getContext('2d');
		const DPR = window.devicePixelRatio || 1;
		const SIZE = 160;
		geoCanvas.width  = SIZE * DPR;
		geoCanvas.height = SIZE * DPR;
		gc.scale(DPR, DPR);

		// Golden ratio icosahedron vertices (normalized)
		const t = (1 + Math.sqrt(5)) / 2;
		const norm = 1 / Math.sqrt(1 + t * t);
		const rawVerts = [
			[-1,  t,  0], [ 1,  t,  0], [-1, -t,  0], [ 1, -t,  0],
			[ 0, -1,  t], [ 0,  1,  t], [ 0, -1, -t], [ 0,  1, -t],
			[ t,  0, -1], [ t,  0,  1], [-t,  0, -1], [-t,  0,  1],
		].map(([x,y,z]) => [x*norm, y*norm, z*norm]);

		const edges = [
			[0,1],[0,5],[0,7],[0,10],[0,11],
			[1,5],[1,7],[1,8],[1,9],
			[2,3],[2,4],[2,6],[2,10],[2,11],
			[3,4],[3,6],[3,8],[3,9],
			[4,5],[4,9],[4,11],
			[5,9],[5,11],
			[6,7],[6,8],[6,10],
			[7,8],[7,10],
			[8,9],[10,11],
		];

		let angleY = 0, angleX = 0.3;

		function rotateY([x,y,z], a) {
			return [x*Math.cos(a)+z*Math.sin(a), y, -x*Math.sin(a)+z*Math.cos(a)];
		}
		function rotateX([x,y,z], a) {
			return [x, y*Math.cos(a)-z*Math.sin(a), y*Math.sin(a)+z*Math.cos(a)];
		}
		function project([x,y,z]) {
			const fov = 3;
			const scale = SIZE / 2 * (fov / (fov + z + 1.5));
			return [SIZE/2 + x*scale, SIZE/2 - y*scale];
		}

		function drawGeo() {
			gc.clearRect(0, 0, SIZE, SIZE);
			angleY += 0.006;
			angleX += 0.002;

			const verts = rawVerts.map(v => {
				let r = rotateY(v, angleY);
				r = rotateX(r, angleX);
				return r;
			});

			for (const [i, j] of edges) {
				const [ax, ay] = project(verts[i]);
				const [bx, by] = project(verts[j]);

				// Depth-based alpha
				const avgZ = (verts[i][2] + verts[j][2]) / 2;
				const alpha = Math.max(0.08, Math.min(0.7, (avgZ + 1.5) / 3));

				gc.beginPath();
				gc.moveTo(ax, ay);
				gc.lineTo(bx, by);
				gc.strokeStyle = `rgba(168, 130, 255, ${alpha})`;
				gc.lineWidth = 0.8;
				gc.stroke();
			}

			// Draw vertices as tiny dots
			for (const v of verts) {
				const [px, py] = project(v);
				const alpha = Math.max(0.1, Math.min(0.9, (v[2] + 1.5) / 3));
				gc.beginPath();
				gc.arc(px, py, 1.5, 0, Math.PI * 2);
				gc.fillStyle = `rgba(200, 180, 255, ${alpha})`;
				gc.fill();
			}

			requestAnimationFrame(drawGeo);
		}
		drawGeo();
	}

	// ── Word cycling ───────────────────────────────────────────
	const triplets = [];
	codeKeywords.forEach((code, i) => {
		const life   = lifeKeywords[i % lifeKeywords.length];
		const recipe = recipeKeywords[i % recipeKeywords.length];
		triplets.push({
			one:   { word: code.word,   slug: code.slug,   color: 'purple' },
			two:   { word: life.word,   slug: life.slug,   color: 'green'  },
			three: { word: recipe.word, slug: recipe.slug, color: 'orange' },
		});
	});
	recipeKeywords.forEach((recipe, i) => {
		const code = codeKeywords[i % codeKeywords.length];
		const life  = lifeKeywords[i % lifeKeywords.length];
		triplets.push({
			one:   { word: recipe.word, slug: recipe.slug, color: 'orange' },
			two:   { word: code.word,   slug: code.slug,   color: 'purple' },
			three: { word: life.word,   slug: life.slug,   color: 'green'  },
		});
	});
	lifeKeywords.forEach((life, i) => {
		const recipe = recipeKeywords[i % recipeKeywords.length];
		const code   = codeKeywords[i % codeKeywords.length];
		triplets.push({
			one:   { word: life.word,   slug: life.slug,   color: 'green'  },
			two:   { word: recipe.word, slug: recipe.slug, color: 'orange' },
			three: { word: code.word,   slug: code.slug,   color: 'purple' },
		});
	});

	let idx = 0;
	const w1 = document.getElementById('word-one');
	const w2 = document.getElementById('word-two');
	const w3 = document.getElementById('word-three');

	function applyTriplet(t) {
		const setWord = (el, d) => {
			if (!el) return;
			el.textContent = d.word;
			el.href = `/blog/${d.slug}/`;
			el.className = `word-cycle word-${el.id.split('-')[1]} text-glow-${d.color}`;
		};
		setWord(w1, t.one);
		setWord(w2, t.two);
		setWord(w3, t.three);
	}

	function cycle() {
		[w1, w2, w3].forEach(w => w?.classList.add('fade-out'));
		setTimeout(() => {
			idx = (idx + 1) % triplets.length;
			applyTriplet(triplets[idx]);
			[w1, w2, w3].forEach(w => w?.classList.remove('fade-out'));
		}, 400);
	}

	if (triplets.length) {
		applyTriplet(triplets[0]);
		setInterval(cycle, 10000);
	}
</script>

<style>
/* ─── Page shell ──────────────────────────────────────────────────── */
.cosmos-page {
	background: #030712;
	min-height: 100vh;
	overflow-x: hidden;
}

/* ─── Hero ────────────────────────────────────────────────────────── */
.hero {
	position: relative;
	min-height: 88vh;
	display: flex;
	align-items: center;
	overflow: hidden;
}

#starfield {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	z-index: 0;
}

/* Nebula blobs */
.nebula {
	position: absolute;
	border-radius: 50%;
	filter: blur(80px);
	pointer-events: none;
	z-index: 1;
}
.nebula-purple {
	width: 600px; height: 600px;
	background: radial-gradient(circle, rgba(88,28,135,0.45) 0%, transparent 70%);
	top: -100px; left: -100px;
}
.nebula-teal {
	width: 500px; height: 500px;
	background: radial-gradient(circle, rgba(14,116,144,0.3) 0%, transparent 70%);
	bottom: -80px; left: 30%;
}
.nebula-blue {
	width: 450px; height: 450px;
	background: radial-gradient(circle, rgba(30,58,138,0.4) 0%, transparent 70%);
	top: 10%; right: 15%;
}

/* Planet */
.planet-wrap {
	position: absolute;
	right: 6%;
	top: 50%;
	transform: translateY(-50%);
	width: 320px; height: 320px;
	z-index: 2;
}
.planet {
	position: absolute;
	inset: 0;
	border-radius: 50%;
	background: radial-gradient(circle at 38% 38%,
		rgba(200,220,255,0.9) 0%,
		rgba(100,140,220,0.85) 20%,
		rgba(40,70,160,0.9) 45%,
		rgba(18,30,80,0.95) 68%,
		rgba(5,8,25,1) 100%
	);
	box-shadow:
		0 0 0 1px rgba(100,140,255,0.15),
		0 0 40px 8px rgba(80,120,255,0.25),
		0 0 100px 30px rgba(50,80,200,0.15);
}
.planet-shimmer {
	position: absolute;
	inset: 8%;
	border-radius: 50%;
	background: radial-gradient(circle at 30% 30%,
		rgba(255,255,255,0.12) 0%,
		transparent 60%
	);
}
.planet-glow {
	position: absolute;
	inset: -30px;
	border-radius: 50%;
	background: radial-gradient(circle,
		rgba(80,120,255,0.08) 0%,
		transparent 70%
	);
	animation: planet-pulse 6s ease-in-out infinite;
}
@keyframes planet-pulse {
	0%, 100% { opacity: 1; transform: scale(1); }
	50%       { opacity: 0.7; transform: scale(1.05); }
}

/* Orbital ring */
.orbital-ring {
	position: absolute;
	width: 110%;
	height: 55%;
	left: -5%;
	top: 22%;
	border-radius: 50%;
	border: 1px solid rgba(160,190,255,0.25);
	transform: rotateX(72deg);
	box-shadow:
		0 0 8px rgba(160,190,255,0.15),
		inset 0 0 8px rgba(160,190,255,0.08);
}

/* Hero content */
.hero-content {
	position: relative;
	z-index: 3;
	padding: 3rem 2rem 3rem 4rem;
	max-width: 680px;
}

.hero-headline {
	font-size: clamp(2.4rem, 6vw, 4.8rem);
	line-height: 1.2;
	margin-bottom: 1.25rem;
	overflow-wrap: break-word;
	word-break: break-word;
}

/* Cycling words */
.word-cycle {
	display: inline;
	text-decoration: none;
	transition: opacity 0.4s ease, transform 0.4s ease;
	cursor: pointer;
	position: relative;
}
.word-cycle::after {
	content: '';
	position: absolute;
	bottom: 0; left: 0;
	width: 100%; height: 2px;
	background: currentColor;
	transform: scaleX(0);
	transform-origin: right;
	transition: transform 0.3s ease;
	opacity: 0.5;
}
.word-cycle:hover::after { transform: scaleX(1); transform-origin: left; }
.word-cycle.fade-out { opacity: 0; transform: translateY(-8px); }

.text-glow-purple { color: #a855f7; text-shadow: 0 0 40px rgba(168,85,247,0.55); }
.text-glow-green  { color: #10b981; text-shadow: 0 0 40px rgba(16,185,129,0.55); }
.text-glow-orange { color: #f59e0b; text-shadow: 0 0 40px rgba(245,158,11,0.55); }

.hero-sub {
	font-family: 'JetBrains Mono', monospace;
	font-size: 1rem;
	color: rgba(140,160,200,0.85);
	margin: 0 0 2rem;
}

.hero-cats {
	display: flex;
	gap: 0.75rem;
	flex-wrap: wrap;
}
.hero-cat {
	display: inline-flex;
	align-items: center;
	gap: 0.4rem;
	padding: 0.45rem 1.1rem;
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.82rem;
	font-weight: 600;
	letter-spacing: 0.06em;
	border-radius: 999px;
	text-decoration: none;
	border: 1px solid;
	transition: all 0.25s ease;
	backdrop-filter: blur(8px);
}
.cat-purple {
	color: #c084fc;
	border-color: rgba(168,85,247,0.4);
	background: rgba(88,28,135,0.2);
}
.cat-purple:hover {
	background: rgba(168,85,247,0.25);
	box-shadow: 0 0 20px rgba(168,85,247,0.3);
	transform: translateY(-2px);
}
.cat-green {
	color: #34d399;
	border-color: rgba(16,185,129,0.4);
	background: rgba(6,78,59,0.2);
}
.cat-green:hover {
	background: rgba(16,185,129,0.25);
	box-shadow: 0 0 20px rgba(16,185,129,0.3);
	transform: translateY(-2px);
}
.cat-orange {
	color: #fbbf24;
	border-color: rgba(245,158,11,0.4);
	background: rgba(120,53,15,0.2);
}
.cat-orange:hover {
	background: rgba(245,158,11,0.25);
	box-shadow: 0 0 20px rgba(245,158,11,0.3);
	transform: translateY(-2px);
}

/* ─── Geo shape canvas ────────────────────────────────────────────── */
#geo-shape {
	position: absolute;
	bottom: 2.5rem;
	left: 3.5rem;
	width: 160px;
	height: 160px;
	z-index: 3;
	opacity: 0.6;
}

/* ─── Category sections ───────────────────────────────────────────── */
.categories-wrap {
	/* Full-bleed — no max-width here */
	width: 100%;
	padding-bottom: 5rem;
}

.cat-section {
	/* Each section is full viewport width */
	width: 100%;
	margin-bottom: 0;
	padding: 2.5rem 0;
}

/* Inner content wrapper with max-width */
.cat-inner {
	max-width: 1300px;
	margin: 0 auto;
	padding: 0 2rem;
}

/* Full-bleed orbit-line separator */
.cat-orbit-line {
	width: 100%;
	height: 1px;
	margin-bottom: 2.5rem;
	position: relative;
	overflow: visible;
}
.cat-orbit-line::before {
	content: '';
	position: absolute;
	inset: 0;
	background: linear-gradient(to right, transparent 0%, var(--cat-accent-color) 30%, var(--cat-accent-color) 70%, transparent 100%);
	opacity: 0.3;
}
.cat-orbit-line::after {
	content: '◦';
	position: absolute;
	left: 50%;
	top: 50%;
	transform: translate(-50%, -50%);
	color: var(--cat-accent-color);
	opacity: 0.55;
	font-size: 1rem;
	line-height: 1;
	background: #030712;
	padding: 0 0.5rem;
}

.cat-purple { --cat-accent-color: #a855f7; }
.cat-green  { --cat-accent-color: #10b981; }
.cat-orange { --cat-accent-color: #f59e0b; }

/* Category header */
.cat-header {
	display: flex;
	align-items: center;
	justify-content: space-between;
	margin-bottom: 1.5rem;
}
.cat-header-left {
	display: flex;
	align-items: center;
	gap: 0.75rem;
}
.cat-icon {
	font-size: 1.4rem;
	color: var(--cat-accent-color);
	line-height: 1;
	filter: drop-shadow(0 0 8px var(--cat-accent-color));
}
.cat-name {
	font-family: 'Space Grotesk', sans-serif;
	font-size: 1.6rem;
	font-weight: 700;
	color: #e2e8f0;
	margin: 0;
	letter-spacing: -0.01em;
}
.cat-view-all {
	font-family: 'JetBrains Mono', monospace;
	font-size: 0.8rem;
	color: var(--cat-accent-color);
	text-decoration: none;
	opacity: 0.75;
	transition: opacity 0.2s ease;
	display: flex;
	align-items: center;
	gap: 0.3rem;
}
.cat-view-all:hover { opacity: 1; }

/* Post cards grid */
.posts-grid {
	display: grid;
	grid-template-columns: repeat(3, 1fr);
	gap: 1.25rem;
}

/* Post card */
.post-card {
	position: relative;
	background: rgba(15,23,42,0.8);
	border: 1px solid rgba(255,255,255,0.07);
	border-radius: 14px;
	overflow: hidden;
	text-decoration: none;
	color: inherit;
	transition: transform 0.35s cubic-bezier(0.4,0,0.2,1), box-shadow 0.35s ease, border-color 0.35s ease;
	display: flex;
	flex-direction: column;
}

