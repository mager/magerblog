<canvas class="masthead-shader" data-masthead-shader aria-hidden="true"></canvas>

<style>
  .masthead-shader { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; pointer-events: none; opacity: .07; filter: saturate(.5); mask-image: linear-gradient(transparent, #000 20%, #000 75%, transparent); }
  :global([data-theme="dark"]) .masthead-shader { opacity: .12; }
  @media print { .masthead-shader { display: none; } }
</style>

<script>
  import { startMastheadShader } from '../scripts/masthead-shader';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-masthead-shader]');
  if (canvas) startMastheadShader(canvas);
</script>
