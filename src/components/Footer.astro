---
interface Props {
	homepage?: boolean;
}

const { homepage = false } = Astro.props;
const today = new Date();
---

<footer class:list={[{ "footer-light": homepage }]}>
	<div class="footer-content">
		<div class="footer-brand">
			<span class="brand-text">mager.co</span>
		</div>

		<p class="copyright">
			&copy; {today.getFullYear()}
		</p>

		<div class="footer-links">
			<a href="/code" class="footer-link">Code</a>
			<span class="separator">·</span>
			<a href="/life" class="footer-link">Life</a>
			<span class="separator">·</span>
			<a href="/cooking" class="footer-link">Cooking</a>
		</div>

		<div class="social-links">
			<a href="https://x.com/mager" target="_blank" class="social-link">
				<span class="sr-only">Follow @mager on X</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="social-link">
				<span class="sr-only">Go to mager's GitHub page</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>

		<p class="built-line">
			Built with <a href="https://claude.ai/code" target="_blank" class="built-link">Claude</a> and <a href="https://x.com/magerbot" target="_blank" class="built-link">@magerbot</a>
		</p>
	</div>
</footer>

<style>
	/* ─── Dark default (blog posts) ───────────────────────── */
	footer {
		padding: 2rem 2rem 2.5rem;
		background: var(--terminal-bg-dark, #010409);
		color: var(--text-primary, #e6edf3);
		text-align: center;
		border-top: 1px solid var(--terminal-border, #30363d);
		position: relative;

		--ft-brand: var(--text-primary, #e6edf3);
		--ft-text: var(--text-secondary, #8b949e);
		--ft-muted: var(--text-muted, #484f58);
		--ft-link: var(--status-purple, #a371f7);
		--ft-link-hover: var(--status-cyan, #58a6ff);
		--ft-separator: var(--terminal-border, #30363d);
		--ft-social-bg: rgba(48, 54, 61, 0.3);
		--ft-social-hover-bg: rgba(163, 113, 247, 0.1);
	}

	/* ─── Light mode for homepage ─────────────────────────── */
	.footer-light {
		background: #f5f3f0;
		border-top: 1px solid rgba(26, 26, 46, 0.06);

		--ft-brand: #1a1a2e;
		--ft-text: #6b7280;
		--ft-muted: #9ca3af;
		--ft-link: #6366f1;
		--ft-link-hover: #0d9488;
		--ft-separator: rgba(26, 26, 46, 0.1);
		--ft-social-bg: rgba(26, 26, 46, 0.04);
		--ft-social-hover-bg: rgba(99, 102, 241, 0.08);
	}

	.footer-content {
		position: relative;
		z-index: 1;
		max-width: 800px;
		margin: 0 auto;
	}

	.footer-brand {
		margin-bottom: 0.35rem;
	}

	.brand-text {
		font-family: 'Syne', sans-serif;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--ft-brand);
		letter-spacing: -0.02em;
	}

	.copyright {
		font-size: 0.8rem;
		color: var(--ft-muted);
		margin: 0 0 0.75rem;
		font-family: 'JetBrains Mono', monospace;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.85rem;
		font-weight: 500;
	}

	.footer-link {
		color: var(--ft-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-link:hover {
		color: var(--ft-link);
	}

	.separator {
		color: var(--ft-separator);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		margin-bottom: 0.75rem;
	}

	.social-link {
		text-decoration: none;
		color: var(--ft-muted);
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.5rem;
		border-radius: 8px;
		background: var(--ft-social-bg);
		border: 1px solid transparent;
	}
	.social-link:hover {
		color: var(--ft-link);
		background: var(--ft-social-hover-bg);
		border-color: var(--ft-link);
		transform: translateY(-2px);
	}

	.built-line {
		font-size: 0.75rem;
		color: var(--ft-muted);
		font-family: 'JetBrains Mono', monospace;
		margin: 0;
	}

	.built-link {
		color: var(--ft-link);
		text-decoration: none;
		transition: color 0.2s ease;
		border-bottom: 1px solid transparent;
	}
	.built-link:hover {
		color: var(--ft-link-hover);
		border-bottom-color: var(--ft-link-hover);
	}

	@media (max-width: 720px) {
		footer {
			padding: 1.5rem 1rem 2rem;
		}
	}
</style>
