---
interface Props {
	homepage?: boolean;
}

const { homepage = false } = Astro.props;
const today = new Date();
---

<footer class:list={[{ "footer-light": homepage }]}>
	<div class="footer-content">
		<div class="sites-section">
			<p class="sites-label">Also building</p>
			<div class="sites-grid">
				<a href="https://loooom.xyz" target="_blank" rel="noopener" class="site-card">
					<span class="site-name">Loooom</span>
					<span class="site-desc">Claude Code plugin marketplace + ME.md</span>
				</a>
				<a href="https://prxps.xyz" target="_blank" rel="noopener" class="site-card">
					<span class="site-name">prxps</span>
					<span class="site-desc">AI-powered sports predictions</span>
				</a>
				<a href="https://kotsu.org" target="_blank" rel="noopener" class="site-card">
					<span class="site-name">kotsu</span>
					<span class="site-desc" lang="ja">漢字を学ぶ</span>
				</a>
			</div>
		</div>

		<div class="footer-meta">
			<div class="footer-branding">
				<span class="brand-text">mager.co</span>
				<p class="copyright">&copy; {today.getFullYear()}</p>
			</div>

			<div class="footer-nav-social">
				<div class="footer-links">
					<a href="/" class="footer-link">Home</a>
					<a href="/tech" class="footer-link">Tech</a>
					<a href="/life" class="footer-link">Life</a>
					<a href="/cooking" class="footer-link">Cooking</a>
				</div>

				<div class="social-links">
					<a href="https://x.com/mager" target="_blank" rel="noopener" class="social-link">
						<span class="sr-only">Follow @mager on X</span>
						<svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
							<path
								fill="currentColor"
								d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
							></path>
						</svg>
					</a>
				</div>
			</div>
		</div>

		<p class="built-line">
			Built with <a href="https://claude.ai/code" target="_blank" rel="noopener" class="built-link">Claude</a> and <a href="https://x.com/magerbot" target="_blank" rel="noopener" class="built-link">@magerbot</a>
		</p>
	</div>
</footer>

<style>
	/* ─── Dark default (blog posts) ───────────────────────── */
	footer {
		padding: 2rem 2rem 2.5rem;
		background: var(--terminal-bg-dark, #010409);
		color: var(--text-primary, #e6edf3);
		text-align: center;
		border-top: 1px solid var(--terminal-border, #30363d);
		position: relative;

		--ft-brand: var(--text-primary, #e6edf3);
		--ft-text: var(--text-secondary, #8b949e);
		--ft-muted: var(--text-muted, #484f58);
		--ft-link: var(--status-purple, #a371f7);
		--ft-link-hover: var(--status-cyan, #58a6ff);
		--ft-separator: var(--terminal-border, #30363d);
		--ft-social-bg: rgba(48, 54, 61, 0.3);
		--ft-social-hover-bg: rgba(163, 113, 247, 0.1);
	}

	/* ─── Light mode for homepage ─────────────────────────── */
	.footer-light {
		background: #f5f3f0;
		border-top: 1px solid rgba(26, 26, 46, 0.06);

		--ft-brand: #1a1a2e;
		--ft-text: #6b7280;
		--ft-muted: #9ca3af;
		--ft-link: #6366f1;
		--ft-link-hover: #0d9488;
		--ft-separator: rgba(26, 26, 46, 0.1);
		--ft-social-bg: rgba(26, 26, 46, 0.04);
		--ft-social-hover-bg: rgba(99, 102, 241, 0.08);
	}

	.footer-content {
		position: relative;
		z-index: 1;
		max-width: 880px;
		margin: 0 auto;
	}

	.footer-meta {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1.5rem;
		margin-bottom: 0.85rem;
		text-align: left;
	}

	.footer-branding {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.footer-nav-social {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.brand-text {
		font-family: 'Syne', sans-serif;
		font-weight: 800;
		font-size: 1.2rem;
		color: var(--ft-brand);
		letter-spacing: -0.02em;
	}

	.copyright {
		font-size: 0.76rem;
		color: var(--ft-muted);
		margin: 0;
		font-family: 'JetBrains Mono', monospace;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.82rem;
		font-weight: 500;
		flex-wrap: wrap;
	}

	.footer-link {
		color: var(--ft-text);
		text-decoration: none;
		transition: color 0.2s ease;
	}
	.footer-link:hover {
		color: var(--ft-link);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 0.5rem;
	}

	.social-link {
		text-decoration: none;
		color: var(--ft-muted);
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.45rem;
		border-radius: 999px;
		background: var(--ft-social-bg);
		border: 1px solid transparent;
	}
	.social-link:hover {
		color: var(--ft-link);
		background: var(--ft-social-hover-bg);
		border-color: var(--ft-link);
		transform: translateY(-2px);
	}

	.built-line {
		font-size: 0.72rem;
		color: var(--ft-muted);
		font-family: 'JetBrains Mono', monospace;
		margin: 0;
	}

	.built-link {
		color: var(--ft-link);
		text-decoration: none;
		transition: color 0.2s ease;
		border-bottom: 1px solid transparent;
	}
	.built-link:hover {
		color: var(--ft-link-hover);
		border-bottom-color: var(--ft-link-hover);
	}

	/* ─── Sites section ─────────────────────────────── */
	.sites-section {
		margin-bottom: 1.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid var(--ft-separator);
	}

	.sites-label {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ft-muted);
		margin: 0 0 1rem;
	}

	.sites-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 0.75rem;
	}

	.site-card {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.9rem;
		border-radius: 10px;
		border: 1px solid var(--ft-separator);
		background: var(--ft-social-bg);
		text-decoration: none;
		transition: all 0.2s ease;
		text-align: left;
	}

	.site-card:hover {
		border-color: var(--ft-link);
		background: var(--ft-social-hover-bg);
		transform: translateY(-2px);
	}

	.site-name {
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--ft-brand);
	}

	.site-desc {
		font-family: 'Atkinson Hyperlegible', sans-serif;
		font-size: 0.72rem;
		color: var(--ft-text);
		line-height: 1.4;
	}

	@media (max-width: 720px) {
		.footer-meta {
			flex-direction: column;
			align-items: flex-start;
			text-align: left;
		}

		.footer-nav-social {
			justify-content: flex-start;
		}

		.sites-grid {
			grid-template-columns: 1fr;
		}

		.site-card {
			padding: 0.875rem;
		}
	}

	@media (max-width: 720px) {
		footer {
			padding: 1.5rem 1rem 2rem;
		}
	}
</style>
