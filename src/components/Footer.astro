---
import '../styles/newspaper.css';
interface Props { homepage?: boolean; }
const { homepage = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['site-footer', { 'on-paper': homepage }]}>
  <div class="footer-shell">
    <a class="footer-home" href="/">mager.co <span>© {year}</span></a>
    <nav aria-label="Footer navigation">
      <a href="/blog/">Archive</a><a href="https://bench.mager.co">Bench ↗</a><a href="https://github.com/mager">GitHub ↗</a><a href="https://x.com/mager">X ↗</a><a href="/about/">About</a><a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>
<style>
  .site-footer { --footer-bg: #0d1117; --footer-ink: #edece8; --footer-muted: #a4a5aa; --footer-rule: #292929; padding: 0 24px; background: var(--footer-bg); color: var(--footer-ink); }
  .on-paper { --footer-bg: var(--news-paper); --footer-ink: var(--news-ink); --footer-muted: var(--news-muted); --footer-rule: var(--news-rule); }
  .footer-shell { display: flex; justify-content: space-between; align-items: center; gap: 16px 36px; max-width: 1136px; margin: auto; border-top: 1px solid var(--footer-rule); padding: 24px 0 32px; }
  .footer-home { display: inline-flex; align-items: baseline; gap: 16px; color: var(--footer-ink); font: 650 17px/1.4 var(--news-display); white-space: nowrap; }
  .footer-home span { color: var(--footer-muted); font: 10px/1.5 var(--news-mono); }
  nav { display: flex; flex-wrap: wrap; gap: 8px 24px; }
  nav a { display: inline-flex; align-items: center; min-height: 44px; color: var(--footer-muted); font: 500 11px/1.5 var(--news-ui); }
  a:hover { color: var(--footer-ink); text-decoration: underline; text-underline-offset: 4px; }
  @media(max-width: 640px) { .site-footer { padding: 0 18px; } .footer-shell { flex-direction: column; align-items: flex-start; gap: 8px; } nav { gap: 8px 22px; } }
</style>
