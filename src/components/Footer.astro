---
import '../styles/newspaper.css';
import ChicagoFlag from './ChicagoFlag.astro';
interface Props { homepage?: boolean; }
const { homepage = false } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={['site-footer', { 'on-paper': homepage }]}>
  <div class="footer-shell">
    <p class="footer-credit"><ChicagoFlag /><span>Built with agents in Chicago<span class="footer-copyright"> · © {year}</span></span></p>
    <a class="footer-rss" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
  </div>
</footer>
<style>
  :global(body:has(.site-footer)) { padding-bottom: calc(var(--site-footer-height, 49px) + 16px); }
  .site-footer { --footer-bg: #0d1117; --footer-ink: #edece8; --footer-muted: #a4a5aa; --footer-rule: #292929; position: fixed; inset: auto 0 0; z-index: 20; padding: 0 24px env(safe-area-inset-bottom, 0px); border-top: 1px solid var(--footer-rule); background: var(--footer-bg); color: var(--footer-muted); }
  .on-paper { --footer-bg: var(--news-paper); --footer-ink: var(--news-ink); --footer-muted: var(--news-muted); --footer-rule: var(--news-rule); }
  .footer-shell { display: flex; justify-content: space-between; align-items: center; gap: 16px; max-width: 1320px; min-height: 48px; margin: auto; }
  .footer-credit { display: flex; align-items: center; gap: 10px; margin: 0; font: 400 11px/1.5 var(--news-ui); }
  .footer-rss { display: inline-flex; align-items: center; gap: 4px; min-height: 44px; color: var(--footer-muted); font: 500 11px/1.5 var(--news-ui); }
  .footer-rss:hover { color: var(--footer-ink); text-decoration: underline; text-underline-offset: 4px; }
  .footer-rss:focus-visible { outline: 2px solid var(--footer-ink); outline-offset: 3px; }
  @media(max-width: 640px) { .site-footer { padding-inline: 18px; } .footer-copyright { display: none; } }
  @media print { .site-footer { display: none; } :global(body:has(.site-footer)) { padding-bottom: 0; } }
</style>
<script>
  const footer = document.querySelector<HTMLElement>('.site-footer');
  if (footer) {
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-footer-height', `${footer.getBoundingClientRect().height}px`);
    }).observe(footer);
  }
</script>
