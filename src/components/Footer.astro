---
const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-brand">
			<span class="bracket">&lt;</span>
			<span class="brand-text">mager.co</span>
			<span class="bracket"> /&gt;</span>
		</div>

		<p class="copyright">
			<span class="comment">//</span> &copy; {today.getFullYear()}
		</p>

		<div class="footer-links">
			<a href="/code" class="footer-link">$ Code</a>
			<span class="separator">|</span>
			<a href="/life" class="footer-link">~ Life</a>
			<span class="separator">|</span>
			<a href="/cooking" class="footer-link"># Cooking</a>
		</div>

		<div class="social-links">
			<a href="https://x.com/mager" target="_blank" class="social-link">
				<span class="sr-only">Follow @mager on X</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/mager" target="_blank" class="social-link">
				<span class="sr-only">Go to mager's GitHub page</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>

		<p class="built-line">
			Built with <a href="https://claude.ai/code" target="_blank" class="claude-link" title="Claude Code">Claude</a> and <a href="https://x.com/magerbot" target="_blank" class="claude-link">@magerbot</a>
		</p>
	</div>
</footer>

<style>
	footer {
		padding: 1.5rem 2rem 2rem;
		background: var(--terminal-bg-dark);
		color: var(--text-primary);
		text-align: center;
		border-top: 1px solid var(--terminal-border);
		position: relative;
		overflow: hidden;
	}

	/* Subtle glow effect */
	footer::before {
		content: '';
		position: absolute;
		top: -150px;
		right: -100px;
		width: 400px;
		height: 400px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(163, 113, 247, 0.06) 0%,
			transparent 60%
		);
		pointer-events: none;
	}

	footer::after {
		content: '';
		position: absolute;
		bottom: -100px;
		left: -100px;
		width: 300px;
		height: 300px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			rgba(88, 166, 255, 0.04) 0%,
			transparent 60%
		);
		pointer-events: none;
	}

	.footer-content {
		position: relative;
		z-index: 1;
		max-width: 800px;
		margin: 0 auto;
	}

	.footer-brand {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 1.25rem;
		font-weight: 700;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}

	.footer-brand .bracket {
		color: var(--status-purple);
		opacity: 0.8;
	}

	.footer-brand .brand-text {
		background: linear-gradient(
			135deg,
			var(--status-cyan) 0%,
			var(--status-purple) 100%
		);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
	}

	.copyright {
		font-size: 0.8rem;
		color: var(--text-muted);
		margin: 0.25rem 0 0.75rem;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
	}

	.copyright .comment {
		color: var(--text-muted);
		opacity: 0.6;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.85rem;
	}

	.footer-link {
		color: var(--text-secondary);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.footer-link:hover {
		color: var(--status-cyan);
	}

	.separator {
		color: var(--terminal-border);
	}

	.social-links {
		display: flex;
		justify-content: center;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.social-link {
		text-decoration: none;
		color: var(--text-muted);
		transition: all 0.2s ease;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.6rem;
		border-radius: 8px;
		background: rgba(48, 54, 61, 0.3);
		border: 1px solid transparent;
	}

	.social-link:hover {
		color: var(--status-purple);
		background: rgba(163, 113, 247, 0.1);
		border-color: var(--status-purple);
		transform: translateY(-2px);
	}

	.built-line {
		font-size: 0.75rem;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		margin: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
	}

	.claude-link {
		color: var(--status-purple);
		text-decoration: none;
		transition: all 0.2s ease;
		border-bottom: 1px solid transparent;
	}

	.claude-link:hover {
		color: var(--status-cyan);
		border-bottom-color: var(--status-cyan);
	}

	@media (max-width: 720px) {
		footer {
			padding: 1.25rem 1rem 1.5rem;
		}

		.footer-brand {
			font-size: 1.1rem;
		}

		.footer-links {
			flex-wrap: wrap;
			gap: 0.5rem 1rem;
		}
	}
</style>
