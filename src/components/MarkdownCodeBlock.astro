---
type Props = {
	code: string;
	label?: string;
};

const { code, label } = Astro.props;
const normalizedCode = code.trimEnd();
---

<pre
	data-language="markdown"
	data-label={label}
	aria-label={label ? `${label} Markdown source` : 'Markdown source'}
>
	<code class="language-markdown">{normalizedCode}</code>
</pre>
