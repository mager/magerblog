---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
	index?: number;
}

const { post, index = 0 } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
const monthNames = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
const monthShort = monthNames[d.getMonth()];
const dayStr = String(d.getDate()).padStart(2, '0');
const yearStr = String(d.getFullYear());
const tags = (post.data.tags || []).slice(0, 3);
const idxStr = String(index + 1).padStart(2, '0');
const dek = tags.length > 0 ? tags.join(' • ') : 'ai • systems • shipping notes';
---

<a href={`/blog/${post.id}/`} class={`code-row ${isDraft ? 'draft' : ''}`}>
	<span class="row-index">{idxStr}</span>
	<span class="row-date">{dateStr}</span>
	<span class="row-body">
		<span class="row-title">{displayTitle}</span>
		<span class="row-dek">{dek}</span>
	</span>
	<span class="row-tags">
		{tags.map(tag => <span class="tag">{tag}</span>)}
		<span class="row-arrow" aria-hidden="true">↗</span>
	</span>

	<span class="mobile-card" aria-hidden="true">
		<span class="mc-topline">
			<span class="mc-idx">{idxStr}</span>
			<span class="mc-date">{monthShort} {dayStr}, {yearStr}</span>
		</span>
		<span class="mc-title">{displayTitle}</span>
		<span class="mc-dek">{dek}</span>
	</span>
</a>

<style>
	.code-row {
		display: grid;
		grid-template-columns: 3.4rem 8rem minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: start;
		padding: 1rem 0.2rem;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid rgba(9, 17, 26, 0.1);
		transition: transform 0.18s ease, background 0.18s ease, border-color 0.18s ease;
	}

	.code-row:hover {
		transform: translateX(4px);
		background: rgba(9, 17, 26, 0.03);
		border-color: rgba(9, 17, 26, 0.2);
	}

	.code-row.draft {
		opacity: 0.7;
	}

	.row-index,
	.row-date,
	.row-dek,
	.tag,
	.row-arrow,
	.mc-topline,
	.mc-dek {
		font-family: 'IBM Plex Mono', monospace;
	}

	.row-index {
		font-size: 0.8rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: rgba(9, 17, 26, 0.42);
		padding-top: 0.25rem;
	}

	.row-date {
		font-size: 0.76rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: rgba(9, 17, 26, 0.55);
		padding-top: 0.25rem;
	}

	.row-body {
		display: grid;
		gap: 0.3rem;
		min-width: 0;
	}

	.row-title {
		font-family: 'IBM Plex Sans Condensed', sans-serif;
		font-size: clamp(1.2rem, 2vw, 1.7rem);
		line-height: 0.98;
		letter-spacing: -0.04em;
		text-transform: uppercase;
		color: #09111a;
	}

	.row-dek {
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.11em;
		color: rgba(9, 17, 26, 0.56);
		line-height: 1.45;
	}

	.row-tags {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
		justify-content: flex-end;
		padding-top: 0.2rem;
	}

	.tag {
		font-size: 0.66rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.35rem 0.5rem;
		border: 1px solid rgba(9, 17, 26, 0.12);
		background: rgba(9, 17, 26, 0.04);
		color: rgba(9, 17, 26, 0.68);
	}

	.row-arrow {
		font-size: 1rem;
		color: #0d6a4d;
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity 0.18s ease, transform 0.18s ease;
	}

	.code-row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.mobile-card {
		display: none;
	}

	@media (max-width: 720px) {
		.code-row {
			display: block;
			padding: 0;
			transform: none;
			background: transparent;
		}

		.row-index,
		.row-date,
		.row-body,
		.row-tags {
			display: none;
		}

		.mobile-card {
			display: grid;
			gap: 0.45rem;
			padding: 1rem 0;
		}

		.mc-topline {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			font-size: 0.68rem;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: rgba(9, 17, 26, 0.52);
		}

		.mc-idx {
			color: #0d6a4d;
			font-weight: 700;
		}

		.mc-title {
			font-family: 'IBM Plex Sans Condensed', sans-serif;
			font-size: 1.5rem;
			line-height: 0.98;
			letter-spacing: -0.04em;
			text-transform: uppercase;
			color: #09111a;
		}

		.mc-dek {
			font-size: 0.68rem;
			letter-spacing: 0.11em;
			text-transform: uppercase;
			line-height: 1.5;
			color: rgba(9, 17, 26, 0.58);
		}
	}
</style>
