---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;

// Format date as YYYY-MM-DD
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

// Max 2 tags shown
const tags = (post.data.tags || []).slice(0, 2);
---

<a href={`/blog/${post.id}/`} class={`code-row ${isDraft ? 'draft' : ''}`}>
	<span class="row-date">{dateStr}</span>
	<span class="row-title">{displayTitle}</span>
	<span class="row-tags">
		{tags.map(tag => <span class="tag">{tag}</span>)}
	</span>
</a>

<style>
	.code-row {
		display: grid;
		grid-template-columns: 10rem 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding: 0.85rem 1rem;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		transition: background 0.15s ease;
		border-radius: 4px;
	}

	.code-row:hover {
		background: rgba(163, 113, 247, 0.06);
	}

	.code-row:hover .row-title {
		color: var(--cyan);
	}

	.code-row.draft {
		opacity: 0.6;
	}

	.row-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.78rem;
		color: var(--text-muted);
		white-space: nowrap;
		letter-spacing: 0.03em;
	}

	.row-title {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--text-primary);
		transition: color 0.15s ease;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.row-tags {
		display: flex;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--purple-bright, #c084fc);
		padding: 0.2rem 0.45rem;
		border: 1px solid rgba(163, 113, 247, 0.3);
		border-radius: 3px;
		background: rgba(163, 113, 247, 0.07);
		white-space: nowrap;
	}

	@media (max-width: 720px) {
		.code-row {
			grid-template-columns: 1fr;
			gap: 0.4rem;
			padding: 1rem 0.75rem;
		}

		.row-tags {
			display: none;
		}

		.row-date {
			font-size: 0.72rem;
		}

		.row-title {
			font-size: 0.9rem;
			white-space: normal;
		}
	}
</style>
