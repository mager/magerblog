---
import type { CollectionEntry } from 'astro:content';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

const isDraft = !!post.data.draft;
const displayTitle = isDraft ? `[DRAFT] ${post.data.title}` : post.data.title;

// Format date as YYYY-MM-DD
const d = post.data.pubDate;
const dateStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

// Max 2 tags shown
const tags = (post.data.tags || []).slice(0, 2);
---

<a href={`/blog/${post.id}/`} class={`code-row ${isDraft ? 'draft' : ''}`}>
	<span class="row-date">{dateStr}</span>
	<span class="row-title">
		<span class="comment-prefix" aria-hidden="true">//</span>
		{displayTitle}
	</span>
	<span class="row-tags">
		{tags.map(tag => <span class="tag">{tag}</span>)}
		<span class="row-arrow" aria-hidden="true">→</span>
	</span>
</a>

<style>
	.code-row {
		display: grid;
		grid-template-columns: 9rem 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding: 0.95rem 1.25rem;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid rgba(255, 255, 255, 0.04);
		transition: background 0.18s ease, border-left-color 0.18s ease;
		border-left: 2px solid transparent;
		position: relative;
	}

	.code-row:hover {
		background: rgba(163, 113, 247, 0.07);
		border-left-color: var(--purple-bright, #BC8CFF);
	}

	/* Subtle glow behind the left border on hover */
	.code-row::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 2px;
		background: var(--purple-bright, #BC8CFF);
		box-shadow: 0 0 10px 2px rgba(188, 140, 255, 0.6);
		opacity: 0;
		transition: opacity 0.18s ease;
	}

	.code-row:hover::before {
		opacity: 1;
	}

	.code-row.draft {
		opacity: 0.6;
	}

	/* ── DATE ─────────────────────────────────────── */
	.row-date {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		color: var(--text-muted);
		white-space: nowrap;
		letter-spacing: 0.03em;
		transition: color 0.18s ease;
	}

	.code-row:hover .row-date {
		color: var(--text-secondary);
	}

	/* ── TITLE ────────────────────────────────────── */
	.row-title {
		font-family: 'Space Grotesk', -apple-system, sans-serif;
		font-size: clamp(0.9rem, 2vw, 1.05rem);
		font-weight: 600;
		color: var(--text-primary);
		transition: color 0.18s ease;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.comment-prefix {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.75rem;
		font-weight: 400;
		color: var(--text-muted);
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity 0.18s ease, transform 0.18s ease, color 0.18s ease;
		flex-shrink: 0;
	}

	.code-row:hover .comment-prefix {
		opacity: 1;
		transform: translateX(0);
		color: var(--purple-bright, #BC8CFF);
	}

	.code-row:hover .row-title {
		color: #fff;
	}

	/* ── TAGS + ARROW ─────────────────────────────── */
	.row-tags {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
	}

	.tag {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.62rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--purple-bright, #BC8CFF);
		padding: 0.2rem 0.45rem;
		border: 1px solid rgba(163, 113, 247, 0.3);
		border-radius: 3px;
		background: rgba(163, 113, 247, 0.07);
		white-space: nowrap;
		transition: background 0.18s ease, border-color 0.18s ease;
	}

	.code-row:hover .tag {
		background: rgba(163, 113, 247, 0.15);
		border-color: rgba(163, 113, 247, 0.5);
	}

	.row-arrow {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.8rem;
		color: var(--purple-bright, #BC8CFF);
		opacity: 0;
		transform: translateX(-6px);
		transition: opacity 0.18s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.code-row:hover .row-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	/* ── MOBILE ───────────────────────────────────── */
	@media (max-width: 720px) {
		.code-row {
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			gap: 0.3rem 0.75rem;
			padding: 1rem 1rem 1rem 1.25rem;
		}

		.row-date {
			grid-column: 1;
			grid-row: 2;
			font-size: 0.7rem;
		}

		.row-title {
			grid-column: 1;
			grid-row: 1;
			font-size: 0.95rem;
			white-space: normal;
			overflow: visible;
			text-overflow: clip;
		}

		.row-tags {
			grid-column: 2;
			grid-row: 1 / 3;
			flex-direction: column;
			align-items: flex-end;
			justify-content: center;
			gap: 0.3rem;
		}

		/* Keep tags visible on mobile, hide arrow */
		.row-arrow {
			display: none;
		}

		.comment-prefix {
			display: none;
		}
	}
</style>
