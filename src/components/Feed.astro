---
import type { FeedEntry } from '../lib/feed';
import FeedItem from './FeedItem.astro';
interface Props { entries: FeedEntry[]; filters?: boolean; compact?: boolean; pageSize?: number; headingLevel?: 'h1' | 'h2'; }
const { entries, filters = false, compact = false, pageSize = compact ? 8 : 15, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
const kinds = [ ['all', 'Everything'], ['blog', 'Articles'], ['notes', 'Notes'], ['seen', 'Seen'], ['links', 'Links'], ['artifacts', 'Artifacts'] ];
---
<div class:list={['feed', { compact }]} data-feed data-page-size={pageSize}>
  {filters && <div class="feed-heading">
    <Heading id="feed-heading">Latest</Heading>
    <label class="feed-filter" hidden><span class="sr-only">Filter feed</span>
      <select data-feed-filter aria-label="Filter feed">{kinds.map(([kind, label]) => <option value={kind}>{label}</option>)}</select>
    </label>
  </div>}
  <div class="feed-entries">
    {entries.map((entry, index) => <FeedItem entry={entry} {compact} lead={compact && index === 0} />)}
  </div>
  <div class="feed-end">
    <p data-feed-count role="status">{entries.length ? `${entries.length} entries · newest first` : 'No entries yet.'}</p>
    <button type="button" data-load-more hidden>Load older entries <span aria-hidden="true">↓</span></button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-feed]').forEach(feed => {
    const entries = Array.from(feed.querySelectorAll<HTMLElement>('.feed-entry'));
    const filter = feed.querySelector<HTMLSelectElement>('[data-feed-filter]');
    const more = feed.querySelector<HTMLButtonElement>('[data-load-more]')!;
    const count = feed.querySelector<HTMLElement>('[data-feed-count]')!;
    const filterBar = feed.querySelector<HTMLElement>('.feed-filter');
    const pageSize = Number(feed.dataset.pageSize) || 15;
    let limit = pageSize;
    let kind = 'all';
    const matching = () => entries.filter(entry => kind === 'all' || entry.dataset.kind === kind);
    function update() {
      const selected = matching();
      const visible = new Set(selected.slice(0, limit));
      entries.forEach(entry => { entry.hidden = !visible.has(entry); entry.classList.toggle('feed-lead', entry === selected[0]); });
      more.hidden = selected.length <= limit;
      count.textContent = selected.length ? `${Math.min(limit, selected.length)} of ${selected.length} entries · newest first` : 'No entries yet.';
    }
    filter?.addEventListener('change', () => {
      kind = filter.value;
      limit = pageSize;
      update();
    });
    more.addEventListener('click', () => {
      const next = matching()[limit];
      limit += pageSize;
      update();
      next?.focus({ preventScroll: true });
    });
    update();
    if (filterBar) filterBar.hidden = false;
  });
</script>
<style>
  .feed-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 24px; padding: 24px 0 12px; border-bottom: 1px solid var(--news-rule); }
  .feed-heading :is(h1, h2) { font: 600 14px/1.4 var(--news-ui); letter-spacing: 0; margin: 0; }
  .feed-filter select { max-width: 100%; min-height: 44px; padding: 8px 24px 8px 8px; border: 0; background: transparent; color: var(--news-muted); font: 500 12px/1.4 var(--news-ui); cursor: pointer; }
  .feed-filter option { background: var(--news-paper); color: var(--news-ink); }
  .feed-filter[hidden], button[hidden] { display: none; }
  button { font: 600 12px/1.4 var(--news-ui); cursor: pointer; border: 0; border-radius: 4px; }
  .feed-end { padding: 30px 0 40px; text-align: center; }
  .feed-end p { font: 10px/1.6 var(--news-mono); color: var(--news-muted); margin: 0 0 14px; }
  .feed-end button { padding: 12px 0; min-height: 48px; background: transparent; color: var(--news-blue); border-bottom: 1px solid var(--news-rule); border-radius: 0; }
  .feed-end button:hover { border-color: var(--news-blue); }
</style>
