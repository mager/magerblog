---
import type { FeedEntry } from '../lib/feed';
import FeedItem from './FeedItem.astro';
interface Props { entries: FeedEntry[]; filters?: boolean; }
const { entries, filters = false } = Astro.props;
const kinds = [ ['all', 'Everything'], ['blog', 'Articles'], ['notes', 'Notes'], ['seen', 'Seen'], ['links', 'Links'] ];
---
<div class="feed" data-feed>
  {filters && <div class="feed-filters" aria-label="Filter feed" role="group" hidden>
    {kinds.map(([kind, label]) => <button type="button" data-filter={kind} aria-pressed={kind === 'all'}>{label}</button>)}
  </div>}
  <div class="feed-entries">
    {entries.map(entry => <FeedItem entry={entry} />)}
  </div>
  <div class="feed-end">
    <p data-feed-count role="status">{entries.length ? `${entries.length} entries · newest first` : 'No entries yet.'}</p>
    <button type="button" data-load-more hidden>Load older entries <span aria-hidden="true">↓</span></button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-feed]').forEach(feed => {
    const entries = Array.from(feed.querySelectorAll<HTMLElement>('.feed-entry'));
    const filters = Array.from(feed.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const more = feed.querySelector<HTMLButtonElement>('[data-load-more]')!;
    const count = feed.querySelector<HTMLElement>('[data-feed-count]')!;
    const filterBar = feed.querySelector<HTMLElement>('.feed-filters');
    const pageSize = 15;
    let limit = pageSize;
    let kind = 'all';
    const matching = () => entries.filter(entry => kind === 'all' || entry.dataset.kind === kind);
    function update() {
      const selected = matching();
      const visible = new Set(selected.slice(0, limit));
      entries.forEach(entry => { entry.hidden = !visible.has(entry); });
      filters.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.filter === kind)));
      more.hidden = selected.length <= limit;
      count.textContent = selected.length ? `${Math.min(limit, selected.length)} of ${selected.length} entries · newest first` : 'No entries yet.';
    }
    filters.forEach(button => button.addEventListener('click', () => {
      kind = button.dataset.filter || 'all';
      limit = pageSize;
      update();
    }));
    more.addEventListener('click', () => {
      const next = matching()[limit];
      limit += pageSize;
      update();
      next?.focus({ preventScroll: true });
    });
    update();
    if (filterBar) filterBar.hidden = false;
  });
</script>
<style>
  .feed-filters { display: flex; flex-wrap: wrap; gap: 4px; padding: 8px 0; border-bottom: 1px solid var(--news-rule); }
  .feed-filters[hidden], button[hidden] { display: none; }
  button { font: 600 12px/1.4 var(--news-ui); cursor: pointer; border: 0; border-radius: 4px; }
  .feed-filters button { padding: 11px 16px; min-height: 44px; color: var(--news-muted); background: transparent; }
  .feed-filters button[aria-pressed="true"] { background: var(--news-ink); color: var(--news-paper); }
  .feed-filters button:hover:not([aria-pressed="true"]) { background: var(--news-rule); color: var(--news-ink); }
  .feed-end { padding: 30px 0 40px; text-align: center; }
  .feed-end p { font: 10px/1.6 var(--news-mono); color: var(--news-muted); margin: 0 0 14px; }
  .feed-end button { padding: 14px 24px; min-height: 48px; background: var(--news-ink); color: var(--news-paper); }
  .feed-end button:hover { background: var(--news-blue); }
  @media(max-width: 540px) { .feed-filters button { padding-inline: 11px; font-size: 11px; } }
</style>
