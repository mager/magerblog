---
import { type FeedEntry, entryHref, entryTitle } from '../../lib/feed';
import { editionDescription, editionImage, editionLabel } from '../../lib/edition';
interface Props { entry: FeedEntry; variant?: 'lead' | 'brief' | 'story' | 'photo' | 'document'; image?: boolean; eager?: boolean; }
const { entry, variant = 'story', image: showImage = false, eager = false } = Astro.props;
const image = showImage && editionImage(entry);
const href = entryHref(entry);
const title = entryTitle(entry);
const description = editionDescription(entry);
---
<article class:list={['edition-story', `story-${variant}`]} data-edition-entry={`${entry.collection}/${entry.id}`} data-media={entry.collection === 'seen' ? entry.data.mediaType : undefined}>
  {image && <a class="story-image" href={href} aria-label={`Read ${title}`}><img src={image} alt={entry.collection === 'seen' ? entry.data.alt || title : ''} width="900" height="600" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" /></a>}
  <div class="story-copy">
    {variant !== 'brief' && <span class="story-kind">{editionLabel(entry)}</span>}
    <h3><a href={href}>{title}</a></h3>
    {variant === 'document' && <p class="story-filename">{entry.id.split('/').pop()}.md</p>}
    {description && variant !== 'photo' && <p class="story-description">{description}</p>}
  </div>
</article>
