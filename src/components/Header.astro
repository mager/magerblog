---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav>
		<a href="/" class="logo" aria-label="mager.co home">
			<span class="logo-name">mager</span><span class="logo-tld">.co</span>
		</a>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/code" style="--accent: var(--cyan);">Code</HeaderLink>
				<HeaderLink href="/life" style="--accent: var(--accent-green);">Life</HeaderLink>
				<HeaderLink href="/cooking" style="--accent: var(--orange);">Cooking</HeaderLink>
				<HeaderLink href="/about" style="--accent: var(--text-primary);">About</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://x.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Follow @mager on X</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Go to mager's GitHub page</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(13, 17, 23, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(48, 54, 61, 0.4);
	}

	nav {
		display: flex;
		align-items: center;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2rem;
		height: 56px;
	}

	/* ── Logo ── */
	.logo {
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		flex-shrink: 0;
		transition: opacity 0.2s ease;
	}

	.logo:hover {
		opacity: 0.8;
	}

	.logo-name {
		font-family: 'Syne', sans-serif;
		font-weight: 800;
		font-size: 1.4rem;
		color: var(--text-primary);
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.logo-tld {
		font-family: 'Syne', sans-serif;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--cyan);
		letter-spacing: -0.01em;
		line-height: 1;
	}

	/* ── Right side ── */
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-left: auto;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	/* ── Nav links ── */
	:global(.internal-links) a {
		padding: 0.3em 0.7em;
		color: var(--text-secondary);
		text-decoration: none;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
		position: relative;
	}

	:global(.internal-links) a:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.05);
	}

	:global(.internal-links) a.active {
		color: var(--accent, var(--text-primary));
		background: color-mix(in srgb, var(--accent, var(--text-primary)) 10%, transparent);
	}

	/* ── Social links ── */
	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding-left: 1.25rem;
		border-left: 1px solid rgba(48, 54, 61, 0.5);
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		padding: 0.4em;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
	}

	.social-link:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.06);
	}

	.social-links svg {
		width: 18px;
		height: 18px;
		display: block;
	}

	/* ── Mobile: bottom nav ── */
	@media (max-width: 720px) {
		.site-header {
			position: fixed;
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			background: rgba(13, 17, 23, 0.97);
			backdrop-filter: blur(16px);
			-webkit-backdrop-filter: blur(16px);
			border-top: 1px solid rgba(48, 54, 61, 0.5);
			border-bottom: none;
		}

		nav {
			height: auto;
			padding: 0.4rem 0.5rem calc(0.4rem + env(safe-area-inset-bottom, 0));
			justify-content: space-around;
		}

		.logo {
			display: none;
		}

		.nav-right {
			width: 100%;
			margin-left: 0;
			gap: 0;
			justify-content: space-around;
		}

		.internal-links {
			width: 100%;
			justify-content: space-around;
			gap: 0;
		}

		.social-links {
			display: none;
		}

		:global(.internal-links) a {
			display: flex;
			flex-direction: column;
			align-items: center;
			min-width: 64px;
			min-height: 48px;
			padding: 8px 12px;
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			border-radius: 8px;
		}
	}

	@media (max-width: 720px) {
		:global(body) {
			padding-bottom: calc(64px + env(safe-area-inset-bottom, 0));
		}
	}
</style>
