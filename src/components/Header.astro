---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header class="site-header">
	<nav>
		<h2>
			<a href="/" class="logo">
				<span class="bracket">&lt;</span>
				<span class="brand">{SITE_TITLE}</span>
				<span class="bracket"> /&gt;</span>
			</a>
		</h2>
		<div class="nav-right">
			<div class="internal-links">
				<HeaderLink href="/code" style="--accent: var(--cyan);">
					<span class="nav-icon">$</span> Code
				</HeaderLink>
				<HeaderLink href="/life" style="--accent: var(--accent-green);">
					<span class="nav-icon">~</span> Life
				</HeaderLink>
				<HeaderLink href="/cooking" style="--accent: var(--orange);">
					<span class="nav-icon">#</span> Cooking
				</HeaderLink>
				<HeaderLink href="/about" style="--accent: var(--text-primary);">
					<span class="nav-icon">?</span> About
				</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://x.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Follow @mager on X</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Go to mager's GitHub page</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0;
		background: var(--editor-bg);
		border-bottom: 1px solid rgba(48, 54, 61, 0.6);
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		line-height: 1.4;
	}

	h2 {
		margin: 0;
		padding: 0;
		font-size: 1.35em;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-weight: 800;
		letter-spacing: -0.04em;
	}

	.logo {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		position: relative;
		transition: color 0.2s ease;
		padding: 0.25rem 0;
	}

	.logo .bracket {
		color: var(--text-muted);
		font-size: 1.1em;
		font-weight: 700;
		transition: color 0.2s ease;
	}

	.logo .brand {
		color: var(--text-primary);
		transition: color 0.2s ease;
	}

	.logo:hover .brand {
		color: var(--cyan);
	}

	.logo:hover .bracket {
		color: var(--text-secondary);
	}

	nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		max-width: 1400px;
		margin: 0 auto;
		padding: 1rem 2rem;
	}

	/* --- Nav links --- */
	nav a {
		padding: 0 0.75em;
		color: var(--text-secondary);
		text-decoration: none;
		font-weight: 600;
		transition: color 0.2s ease;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.9em;
		position: relative;
	}

	nav a:hover {
		color: var(--text-primary);
		text-decoration: none;
	}

	/* Category-colored active state — each link sets --accent */
	nav a.active {
		color: var(--accent, var(--text-primary));
		text-shadow:
			0 0 12px color-mix(in srgb, var(--accent, var(--text-primary)) 50%, transparent),
			0 0 30px color-mix(in srgb, var(--accent, var(--text-primary)) 20%, transparent);
	}

	nav a.active .nav-icon {
		color: var(--accent, var(--text-primary));
	}

	.nav-icon {
		color: var(--text-muted);
		margin-right: 0.25rem;
		font-weight: 700;
		transition: color 0.2s ease;
	}

	/* Hover lifts the icon into the link's accent color */
	nav a:hover .nav-icon {
		color: var(--accent, var(--text-secondary));
	}

	/* Underline indicator that slides in on hover/active */
	:global(.internal-links) a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0.75em;
		right: 0.75em;
		height: 1px;
		background: var(--accent, var(--text-primary));
		opacity: 0;
		transform: scaleX(0);
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	:global(.internal-links) a:hover::after {
		opacity: 0.4;
		transform: scaleX(1);
	}

	:global(.internal-links) a.active::after {
		opacity: 0.7;
		transform: scaleX(1);
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-left: auto;
		flex-wrap: wrap;
	}

	.internal-links {
		display: flex;
		gap: 0.25rem;
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding-left: 1rem;
		border-left: 1px solid rgba(48, 54, 61, 0.6);
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--text-muted);
		transition: color 0.2s ease;
		padding: 0.4em;
		border-radius: 6px;
		background: transparent;
	}

	.social-link:hover {
		color: var(--text-primary);
	}

	.social-link::after {
		display: none;
	}

	.social-links svg {
		width: 20px;
		height: 20px;
	}

	/* ---- Mobile: Bottom Navigation ---- */
	@media (max-width: 720px) {
		.site-header {
			position: fixed;
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			background: var(--editor-bg);
			border-bottom: none;
			border-top: 1px solid rgba(48, 54, 61, 0.6);
			padding-bottom: env(safe-area-inset-bottom, 0);
		}

		nav {
			padding: 0.5rem 0.75rem;
			flex-direction: row;
			gap: 0;
			align-items: center;
			justify-content: space-around;
		}

		h2 {
			display: none;
		}

		.nav-right {
			width: 100%;
			margin-left: 0;
			justify-content: space-around;
			padding: 0;
		}

		.internal-links {
			width: 100%;
			justify-content: space-around;
			gap: 0;
		}

		.social-links {
			display: none;
		}

		/* Mobile nav items — stacked icon + label, big touch targets */
		nav a {
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			min-width: 64px;
			min-height: 52px;
			padding: 8px 12px;
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.05em;
			border-radius: 8px;
			transition: color 0.2s ease, background 0.2s ease;
		}

		nav a:hover,
		nav a:active {
			background: rgba(255, 255, 255, 0.06);
		}

		nav a.active {
			color: var(--accent, var(--text-primary));
			background: color-mix(in srgb, var(--accent, var(--text-primary)) 12%, transparent);
			text-shadow: none;
		}

		/* Hide underline indicators on mobile */
		:global(.internal-links) a::after {
			display: none;
		}

		.nav-icon {
			display: block;
			font-size: 1.25rem;
			margin-right: 0;
			margin-bottom: 2px;
			color: var(--text-muted);
		}

		nav a.active .nav-icon {
			color: var(--accent, var(--text-primary));
		}
	}

	@media (max-width: 720px) {
		:global(body) {
			padding-bottom: calc(70px + env(safe-area-inset-bottom, 0));
		}
	}
</style>
