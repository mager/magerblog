---
import '../styles/newspaper.css';
import ThemeToggle from './ThemeToggle.astro';
interface Props { homepage?: boolean; masthead?: boolean; editionDate?: Date; activeSection?: string; themeToggle?: boolean; }
const { homepage = false, activeSection, themeToggle = false } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { name: 'Tech', href: '/tech/' },
  { name: 'Cooking', href: '/cooking/' },
  { name: 'Life', href: '/life/' },
  { name: 'Artifacts', href: '/artifacts/' },
];
const moreSections = [
  { name: 'Notes', href: '/notes/' },
  { name: 'Seen', href: '/seen/' },
  { name: 'Links', href: '/links/' },
  { name: 'About', href: '/about/' },
  { name: 'Subscribe via RSS', href: '/rss.xml' },
];
const active = (href: string) => activeSection === href || path.replace(/\/$/, '') === href.replace(/\/$/, '') || path.startsWith(href);
---
<header class:list={['site-header', { 'on-paper': homepage }]}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="mager.co home">mager<span>.</span>co</a>
    <nav class="header-sections" aria-label="Main navigation">
      {sections.map(section => <a class:list={{ active: active(section.href) }} href={section.href} aria-current={path.replace(/\/$/, '') === section.href.replace(/\/$/, '') ? 'page' : undefined}>{section.name}</a>)}
      <details class="header-more">
        <summary class:list={{ active: moreSections.some(section => active(section.href)) }}>More <span aria-hidden="true">⌄</span></summary>
        <div class="more-links">
          {moreSections.map(section => <a href={section.href} aria-current={path.replace(/\/$/, '') === section.href.replace(/\/$/, '') ? 'page' : undefined}>{section.name}</a>)}
        </div>
      </details>
    </nav>
    <div class="header-tools">
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</header>
<style>
  :global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
  :global(.skip-link:focus) { transform: translateY(0); }
  .site-header { --header-bg: #0d1117; --header-ink: #edece8; --header-muted: #a4a5aa; --header-rule: #292929; background: var(--header-bg); color: var(--header-ink); padding: 0 24px; }
  .on-paper { --header-bg: var(--news-paper); --header-ink: var(--news-ink); --header-muted: var(--news-muted); --header-rule: var(--news-rule); }
  .header-shell { display: flex; align-items: center; gap: clamp(24px, 4vw, 56px); max-width: 1136px; margin: auto; min-height: 88px; border-bottom: 1px solid var(--header-rule); }
  .wordmark { color: var(--header-ink); font: 800 32px/1 var(--news-display); letter-spacing: -.07em; white-space: nowrap; }
  .wordmark span { color: var(--news-red); }
  .wordmark:hover { color: var(--header-ink); opacity: .8; }
  .header-sections { display: flex; gap: clamp(12px, 1.8vw, 24px); align-items: center; }
  .header-sections > a, .header-more summary { display: inline-flex; align-items: center; position: relative; min-height: 44px; color: var(--header-muted); font: 500 13px/1.4 var(--news-ui); }
  .header-sections > a:hover, .header-sections > a.active, .header-more summary:hover, .header-more summary.active { color: var(--header-ink); }
  .header-sections > a.active::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 2px; background: currentColor; }
  .header-tools { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .header-tools :global(.theme-toggle) { padding: 0; }
  .header-more { position: relative; }
  .header-more summary { gap: 6px; cursor: pointer; list-style: none; }
  .header-more summary::-webkit-details-marker { display: none; }
  .header-more summary span { font-size: 14px; }
  .more-links { position: absolute; top: calc(100% + 4px); right: 0; z-index: 100; width: 190px; padding: 8px; border: 1px solid var(--header-rule); border-radius: 6px; background: var(--header-bg); box-shadow: 0 8px 24px rgb(0 0 0 / 8%); }
  .more-links a { display: flex; align-items: center; min-height: 44px; padding: 8px 12px; color: var(--header-muted); font: 500 13px/1.4 var(--news-ui); border-radius: 3px; }
  .more-links a:hover, .more-links a[aria-current="page"] { color: var(--header-ink); background: color-mix(in oklch, var(--header-ink) 7%, var(--header-bg)); }
  .site-header :focus-visible { outline: 2px solid var(--header-ink); outline-offset: 3px; }
  @media(max-width: 760px) {
    .header-shell { flex-wrap: wrap; gap: 0 16px; padding-top: 14px; }
    .wordmark { font-size: 30px; }
    .header-tools { min-height: 44px; }
    .header-sections { order: 3; justify-content: space-between; flex-basis: 100%; flex-wrap: wrap; gap: 10px; padding: 6px 0 8px; }
  }
  @media(max-width: 540px) {
    .site-header { padding: 0 18px; }
    .header-tools { gap: 16px; }
    .header-sections > a, .header-more summary { font-size: 12px; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.header-more').forEach(menu => {
    document.addEventListener('click', event => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('keydown', event => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
        event.stopPropagation();
      }
    });
  });
</script>
