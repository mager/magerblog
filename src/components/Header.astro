---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	breadcrumb?: {
		show: boolean;
		path?: string;
		tag?: string;
	};
}

const { breadcrumb } = Astro.props;
const showBreadcrumb = breadcrumb?.show ?? false;
---

<header>
	<nav>
		<h2>
			<a href="/" class="logo">
				<span class="bracket">&lt;</span>
				<span class="brand">{SITE_TITLE}</span>
				<span class="bracket">/&gt;</span>
			</a>
		</h2>
		<div class="nav-right">
			{showBreadcrumb ? (
				<div class="breadcrumb">
					<span class="prompt">~$</span>
					<a href="/" class="breadcrumb-link">cd ~</a>
					{breadcrumb?.tag && (
						<>
							<span class="breadcrumb-separator">&&</span>
							<span class="breadcrumb-current">cd {breadcrumb.tag}</span>
						</>
					)}
				</div>
			) : (
				<div class="internal-links">
					<HeaderLink href="/code">💻 Code</HeaderLink>
					<HeaderLink href="/life">🌆 Life</HeaderLink>
					<HeaderLink href="/recipes">🍳 Recipes</HeaderLink>
					<HeaderLink href="/about">About</HeaderLink>
				</div>
			)}
			<div class="social-links">
			<a href="https://x.com/mager" target="_blank">
				<span class="sr-only">Follow @mager on X</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="28" height="28"
					><path
						fill="currentColor"
						d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
					></path></svg
				>
			</a>
			<a href="https://github.com/mager" target="_blank">
				<span class="sr-only">Go to mager's GitHub pager</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0;
		background: var(--editor-bg-dark);
		box-shadow: var(--box-shadow);
		border-bottom: 2px solid var(--text-muted);
	}

	.breadcrumb {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		flex-wrap: wrap;
	}

	.breadcrumb-link {
		color: var(--cyan);
		text-decoration: none;
		transition: color 0.2s ease;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
	}

	.breadcrumb-link:hover {
		color: var(--purple);
	}

	.breadcrumb-link .prompt {
		color: var(--accent-green);
		font-weight: 700;
	}

	.breadcrumb-separator {
		color: var(--text-muted);
		margin: 0 0.25rem;
	}

	.breadcrumb-current {
		color: var(--text-primary);
		font-weight: 600;
	}
	h2 {
		margin: 0;
		padding: 0.4em 0 0;
		font-size: 1.5em;
		font-family: 'JetBrains Mono', monospace;
		font-weight: 900;
		letter-spacing: -0.04em;
	}

	.logo {
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		position: relative;
		transition: all 0.3s ease;
	}

	.logo .bracket {
		color: var(--purple);
		font-size: 1.2em;
		font-weight: 700;
		transition: all 0.3s ease;
	}

	.logo .brand {
		color: var(--text-primary);
		text-shadow:
			0 0 30px rgba(167, 139, 250, 0.5),
			0 0 60px rgba(167, 139, 250, 0.2),
			0 2px 10px rgba(0, 0, 0, 0.8);
		transition: all 0.3s ease;
		background: linear-gradient(135deg, var(--cyan) 0%, var(--purple) 50%, var(--text-primary) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		position: relative;
	}

	.logo .brand::after {
		content: attr(data-text);
		position: absolute;
		left: 0;
		top: 0;
		z-index: -1;
		background: linear-gradient(135deg, var(--cyan), var(--purple));
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		filter: blur(10px);
		opacity: 0.5;
	}

	.logo:hover .brand {
		text-shadow:
			0 0 40px rgba(167, 139, 250, 0.8),
			0 0 80px rgba(167, 139, 250, 0.4),
			0 2px 15px rgba(0, 0, 0, 1);
		background: linear-gradient(135deg, var(--purple) 0%, var(--cyan) 50%, var(--purple) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
		background-clip: text;
		animation: glow-pulse 2s ease-in-out infinite;
	}

	@keyframes glow-pulse {
		0%, 100% {
			filter: brightness(1);
		}
		50% {
			filter: brightness(1.3);
		}
	}

	.logo:hover .bracket {
		color: var(--cyan);
		transform: scale(1.1);
	}

	nav {
		display: flex;
		align-items: flex-end;
		gap: 1.25rem;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2em;
	}
	nav a {
		padding: 0.75em 0.8em 0;
		color: var(--text-primary);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 700;
		transition: all 0.2s ease;
		font-family: 'JetBrains Mono', monospace;
		font-size: 1em;
	}
	nav a:hover {
		color: var(--cyan);
		border-bottom-color: var(--cyan);
	}
	nav a.active {
		text-decoration: none;
		color: var(--purple);
		border-bottom-color: var(--purple);
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-left: auto;
		flex-wrap: wrap;
	}

	.internal-links {
		display: flex;
		gap: 0.4rem;
	}

	.social-links,
	.social-links a {
		display: flex;
		gap: 0.6rem;
	}
	.social-links a {
		color: var(--text-secondary);
		transition: color 0.2s ease;
		padding: 0.75em 0.4em 0;
	}
	.social-links a:hover {
		color: var(--purple);
	}
	@media (max-width: 720px) {
		nav {
			padding: 0 1em;
			flex-direction: column;
			gap: 0;
			align-items: center;
		}
		h2 {
			width: 100%;
			text-align: center;
			padding: 0.75em 0;
			border-bottom: 1px solid var(--text-muted);
		}
		.nav-right {
			width: 100%;
			margin-left: 0;
			justify-content: center;
			padding: 0.5em 0;
		}
		.internal-links {
			justify-content: center;
			flex-wrap: wrap;
		}
		.breadcrumb {
			justify-content: center;
			font-size: 0.75rem;
		}
		.social-links {
			display: none;
		}
	}
</style>
