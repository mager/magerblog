---
import '../styles/newspaper.css';
import ThemeToggle from './ThemeToggle.astro';
interface Props { homepage?: boolean; activeSection?: string; themeToggle?: boolean; revealWordmark?: boolean; }
const { homepage = false, activeSection, themeToggle = homepage, revealWordmark = false } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { name: 'Tech', href: '/tech/' },
  { name: 'Cooking', href: '/cooking/' },
  { name: 'Life', href: '/life/' },
  { name: 'Notes', href: '/notes/' },
  { name: 'Seen', href: '/seen/' },
  { name: 'Links', href: '/links/' },
  { name: 'Artifacts', href: '/artifacts/' },
];
const active = (href: string) => activeSection === href || path.replace(/\/$/, '') === href.replace(/\/$/, '') || path.startsWith(href);
---
<header class:list={['site-header', { 'on-paper': homepage }]} data-reveal-wordmark={revealWordmark || undefined} data-wordmark-visible={revealWordmark ? 'false' : undefined}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="mager.co home" inert={revealWordmark}>mager<span>.</span>co</a>
    <nav class="header-sections" aria-label="Main navigation">
      {sections.map(section => <a class:list={{ active: active(section.href) }} href={section.href} aria-current={path.replace(/\/$/, '') === section.href.replace(/\/$/, '') ? 'page' : undefined}>{section.name}</a>)}

    </nav>
    <div class="header-tools">
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</header>
<style>
  :global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
  :global(.skip-link:focus) { transform: translateY(0); }
  .site-header { --header-bg: #0d1117; --header-ink: #edece8; --header-muted: #a4a5aa; --header-rule: #292929; background: var(--header-bg); color: var(--header-ink); padding: 0 24px; position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--header-rule); }
  .on-paper { --header-bg: var(--news-paper); --header-ink: var(--news-ink); --header-muted: var(--news-muted); --header-rule: var(--news-rule); }
  .header-shell { display: flex; align-items: center; gap: clamp(24px, 4vw, 56px); max-width: 1320px; margin: auto; min-height: 64px; }
  .wordmark { color: var(--header-ink); font: 800 27px/1 var(--news-display); letter-spacing: -.07em; white-space: nowrap; }
  .wordmark span { color: var(--news-red); }
  .wordmark:hover { color: var(--header-ink); opacity: .8; }
  [data-wordmark-visible="false"] .wordmark { display: none; }
  .header-sections { display: flex; flex-wrap: wrap; gap: 0 clamp(12px, 1.8vw, 24px); align-items: center; }
  .header-sections > a { display: inline-flex; align-items: center; position: relative; min-height: 44px; color: var(--header-muted); font: 500 13px/1.4 var(--news-ui); }
  .header-sections > a:hover, .header-sections > a.active { color: var(--header-ink); }
  .header-sections > a.active::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 2px; background: currentColor; }
  .header-tools { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .header-tools :global(.theme-toggle) { padding: 0; }
  .site-header :focus-visible { outline: 2px solid var(--header-ink); outline-offset: 3px; }
  :global(:root) { --site-header-height: 65px; }
  :global(html) { scroll-padding-block: calc(var(--site-header-height) + 16px) calc(var(--site-footer-height, 49px) + 16px); }
  @media(max-width: 760px) {
    :global(:root) { --site-header-height: 97px; }
    .header-shell { display: grid; grid-template-columns: 1fr auto; gap: 0 16px; padding-top: 4px; }
    .wordmark { font-size: 25px; }
    .header-tools { grid-column: 2; grid-row: 1; min-height: 44px; }
    .header-sections { grid-column: 1 / -1; grid-row: 2; justify-content: space-between; gap: 0 6px; padding-bottom: 4px; }
    .header-sections > a { font-size: 12px; }
  }
  @media(max-width: 540px) { .site-header { padding-inline: 18px; } }
  @media print { .site-header { display: none; } }
</style>

<script>
  import { observeHeaderWordmark } from '../scripts/header-wordmark';
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const refreshWordmark = observeHeaderWordmark(header);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
      refreshWordmark();
    }).observe(header);
  }

</script>
