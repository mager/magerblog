---
import '../styles/newspaper.css';
import ThemeToggle from './ThemeToggle.astro';
interface Props { homepage?: boolean; activeSection?: string; themeToggle?: boolean; revealWordmark?: boolean; }
const { homepage = false, activeSection, themeToggle = homepage, revealWordmark = false } = Astro.props;
const path = Astro.url.pathname;
const primary = [
  { name: 'Writing', href: '/blog/' },
  { name: 'Software', href: '/software/' },
];
const groups = [
  { title: 'By topic', links: [
    { name: 'Tech', href: '/tech/' },
    { name: 'Cooking', href: '/cooking/' },
    { name: 'Life', href: '/life/' },
  ] },
  { title: 'Notebook', links: [
    { name: 'Notes', href: '/notes/' },
    { name: 'Seen', href: '/seen/' },
    { name: 'Links', href: '/links/' },
    { name: 'Artifacts', href: '/artifacts/' },
  ] },
];
const current = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
const active = (href: string) => activeSection ? activeSection === href : current(href) || path.startsWith(href);

---
<header class:list={['site-header', { 'on-paper': homepage }]} data-reveal-wordmark={revealWordmark || undefined} data-wordmark-visible={revealWordmark ? 'false' : undefined}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="mager.co home" inert={revealWordmark}>mager<span>.</span>co</a>
    <nav class="header-primary" aria-label="Main navigation">
      {primary.map(section => <a class:list={{ active: active(section.href) }} href={section.href} aria-current={current(section.href) ? 'page' : undefined}>{section.name}</a>)}
    </nav>
    <nav class="header-sections" aria-label="Sections">
      {groups.map(group => <div class="section-group" role="group" aria-label={group.title}>
        {group.links.map(link => <a href={link.href} class:list={{ active: active(link.href) }} aria-current={current(link.href) ? 'page' : undefined}>{link.name}</a>)}
      </div>)}
    </nav>
    <div class="header-tools">
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</header>
<style>
  :global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
  :global(.skip-link:focus) { transform: translateY(0); }
  .site-header { --header-accent: oklch(78% 0.09 230); --header-bg: #0d1117; --header-ink: #edece8; --header-muted: #a4a5aa; --header-rule: #292929; background: var(--header-bg); color: var(--header-ink); padding: 0 24px; position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--header-rule); }
  .on-paper { --header-accent: var(--news-blue); --header-bg: var(--news-paper); --header-ink: var(--news-ink); --header-muted: var(--news-muted); --header-rule: var(--news-rule); }
  .header-shell { display: flex; align-items: center; gap: 28px; max-width: 1320px; margin: auto; min-height: 64px; }
  .wordmark { color: var(--header-ink); font: 800 27px/1 var(--news-display); letter-spacing: -.07em; white-space: nowrap; }
  .wordmark:hover { color: var(--header-ink); opacity: .8; }
  [data-wordmark-visible="false"] .wordmark { display: none; }
  .header-primary, .header-sections, .section-group { display: flex; align-items: center; gap: 20px; }
  .header-primary { flex-shrink: 0; }
  .header-sections { gap: 24px; padding-left: 28px; border-left: 1px solid var(--header-rule); }
  .section-group + .section-group { padding-left: 24px; border-left: 1px solid var(--header-rule); }
  nav a { display: inline-flex; align-items: center; position: relative; min-height: 44px; color: var(--header-muted); font: 500 13px/1.4 var(--news-ui); white-space: nowrap; }
  .header-primary a { color: var(--header-ink); font-weight: 600; }
  nav a:hover, nav a.active { color: var(--header-accent); }
  nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  nav a.active::after { content: ''; position: absolute; bottom: 3px; left: 0; right: 0; height: 2px; background: currentColor; }
  .header-tools { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .header-tools :global(.theme-toggle) { padding: 0; }
  .site-header :focus-visible { outline: 2px solid var(--header-accent); outline-offset: 3px; }
  :global(:root) { --site-header-height: 65px; }
  :global(html) { scroll-padding-block: calc(var(--site-header-height) + 16px) calc(var(--site-footer-height, 49px) + 16px); }
  @media(max-width: 1100px) {
    :global(:root) { --site-header-height: 101px; }
    .header-shell { display: grid; grid-template-columns: auto 1fr auto; gap: 0 24px; padding-top: 4px; }
    .wordmark { font-size: 25px; }
    .header-primary { grid-column: 2; grid-row: 1; }
    [data-wordmark-visible="false"] .header-primary { grid-column: 1 / 3; }
    .header-tools { grid-column: 3; grid-row: 1; min-height: 48px; }
    .header-sections { grid-column: 1 / -1; grid-row: 2; flex-wrap: wrap; gap: 0 28px; padding: 0 0 4px; border-left: 0; border-top: 1px solid var(--header-rule); }
    .section-group { gap: 24px; }
    .section-group + .section-group { padding-left: 0; border-left: 0; }
  }
  @media(max-width: 540px) {
    :global(:root) { --site-header-height: 145px; }
    .site-header { padding-inline: 18px; }
    .header-shell { column-gap: 12px; }
    .header-primary { gap: 16px; }
    .header-sections { justify-content: space-between; }
    .section-group { justify-content: space-between; width: 100%; gap: 16px; }
    .header-tools :global(.theme-toggle) { min-width: 44px; }
    .header-tools :global([data-theme-label]) { display: none; }
  }
  @media print { .site-header { display: none; } }
</style>

<script>
  import { observeHeaderWordmark } from '../scripts/header-wordmark';
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const refreshWordmark = observeHeaderWordmark(header);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
      refreshWordmark();
    }).observe(header);
  }

</script>
