---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	homepage?: boolean;
}

const { homepage = false } = Astro.props;
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
---

<header class:list={["site-header", { "header-light": homepage }]}>
	<nav>
		<a href="https://www.mager.co" class="logo" aria-label="Main mager.co home">
			<span class="logo-prompt" aria-hidden="true">▸</span><span class="logo-name">mager</span><span class="logo-tld">.co</span><span class="logo-cursor" aria-hidden="true"></span>
		</a>
		<div class="nav-right">
			<div class="internal-links">
				<a href="/" class:list={["home-link", { active: isHome }]} aria-label="Home">
					<svg viewBox="0 0 20 20" aria-hidden="true" fill="currentColor" width="18" height="18">
						<path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h4a1 1 0 001-1v-3h2v3a1 1 0 001 1h4a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
					</svg>
					<span>Home</span>
				</a>
				<HeaderLink href="/tech" style="--accent: var(--link-accent-indigo);">Tech</HeaderLink>
				<HeaderLink href="/life" style="--accent: var(--link-accent-teal);">Life</HeaderLink>
				<HeaderLink href="/cooking" style="--accent: var(--link-accent-amber);">Food</HeaderLink>
				<HeaderLink href="/notes" style="--accent: var(--accent-green);">Notes</HeaderLink>
				<HeaderLink href="/seen" style="--accent: var(--link-accent-indigo);">Seen</HeaderLink>
				<HeaderLink href="/about" style="--accent: var(--link-accent-neutral);">About</HeaderLink>
			</div>
			<div class="social-links">
				<a href="https://x.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Follow @mager on X</span>
					<svg viewBox="0 0 24 24" aria-hidden="true">
						<path
							fill="currentColor"
							d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
						></path>
					</svg>
				</a>
				<a href="https://github.com/mager" target="_blank" class="social-link">
					<span class="sr-only">Go to mager's GitHub page</span>
					<svg viewBox="0 0 16 16" aria-hidden="true">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(13, 17, 23, 0.92);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(48, 54, 61, 0.4);

		/* Dark mode defaults */
		--header-text: var(--text-primary, #e6edf3);
		--header-text-secondary: var(--text-secondary, #8b949e);
		--header-text-muted: var(--text-muted, #484f58);
		--header-logo-tld: var(--cyan, #79c0ff);
		--link-accent-indigo: var(--cyan, #79c0ff);
		--link-accent-teal: var(--accent-green, #3fb950);
		--link-accent-amber: var(--orange, #ffa657);
		--link-accent-neutral: var(--text-primary, #e6edf3);
		--header-social-border: rgba(48, 54, 61, 0.5);
		--header-hover-bg: rgba(255, 255, 255, 0.05);
	}

	/* Light mode for homepage */
	.header-light {
		background: rgba(250, 248, 245, 0.85);
		border-bottom: 1px solid rgba(26, 26, 46, 0.06);

		--header-text: #1a1a2e;
		--header-text-secondary: #4b5563;
		--header-text-muted: #9ca3af;
		--header-logo-tld: #6366f1;
		--link-accent-indigo: #6366f1;
		--link-accent-teal: #0d9488;
		--link-accent-amber: #d97706;
		--link-accent-neutral: #1a1a2e;
		--header-social-border: rgba(26, 26, 46, 0.1);
		--header-hover-bg: rgba(26, 26, 46, 0.04);
	}

	nav {
		display: flex;
		align-items: center;
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 2rem;
		height: 56px;
	}

	.logo {
		text-decoration: none;
		display: inline-flex;
		align-items: baseline;
		flex-shrink: 0;
		gap: 0;
	}

	.logo-prompt {
		font-family: 'JetBrains Mono', monospace;
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--header-logo-tld);
		margin-right: 0.35rem;
		transition: transform 0.25s cubic-bezier(0.25, 1, 0.5, 1);
		display: inline-block;
	}
	.logo:hover .logo-prompt {
		transform: translateX(3px);
	}

	.logo-name {
		font-family: 'JetBrains Mono', monospace;
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--header-text);
		letter-spacing: -0.03em;
		line-height: 1;
		transition: color 0.2s ease;
	}
	.logo:hover .logo-name {
		color: var(--header-logo-tld);
	}

	.logo-tld {
		font-family: 'JetBrains Mono', monospace;
		font-weight: 400;
		font-size: 1.25rem;
		color: var(--header-text-secondary);
		letter-spacing: -0.03em;
		line-height: 1;
		transition: color 0.2s ease;
	}
	.logo:hover .logo-tld {
		color: var(--header-logo-tld);
	}

	.logo-cursor {
		display: inline-block;
		width: 0.55em;
		height: 1.1em;
		background: var(--header-logo-tld);
		margin-left: 0.4em;
		vertical-align: -0.15em;
		border-radius: 2px;
		animation: blink 1s step-end infinite;
	}
	.logo:hover .logo-cursor {
		animation: none;
		opacity: 1;
	}

	@keyframes blink {
		0%, 100% { opacity: 1; }
		50% { opacity: 0; }
	}

	@media (prefers-reduced-motion: reduce) {
		.logo-cursor { animation: none; opacity: 0.7; }
		.logo-prompt { transition: none; }
	}

	.nav-right {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		margin-left: auto;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.1rem;
	}

	:global(.internal-links) a {
		padding: 0.3em 0.7em;
		color: var(--header-text-secondary);
		text-decoration: none;
		font-family: 'Space Grotesk', sans-serif;
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
	}

	:global(.internal-links) a:hover {
		color: var(--header-text);
		background: var(--header-hover-bg);
	}

	:global(.internal-links) a.active {
		color: var(--accent, var(--header-text));
		background: color-mix(in srgb, var(--accent, var(--header-text)) 10%, transparent);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
		padding-left: 1.25rem;
		border-left: 1px solid var(--header-social-border);
	}

	.social-link {
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--header-text-muted);
		padding: 0.4em;
		border-radius: 6px;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-link:hover {
		color: var(--header-text);
		background: var(--header-hover-bg);
	}

	.social-links svg {
		width: 18px;
		height: 18px;
		display: block;
	}

	/* Home link — desktop hidden, mobile tab */
	.home-link {
		display: none;
	}

	@media (max-width: 720px) {
		.home-link {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 3px;
			min-width: 48px;
			min-height: 48px;
			padding: 8px 10px;
			font-family: 'Space Grotesk', sans-serif;
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			text-decoration: none;
			border-radius: 8px;
			color: var(--header-text-secondary);
			transition: color 0.15s ease, background 0.15s ease;
		}
		.home-link:hover,
		.home-link.active {
			color: var(--header-text);
			background: var(--header-hover-bg);
		}
		.home-link svg { flex-shrink: 0; }
	}

	@media (max-width: 720px) {
		.site-header {
			position: fixed;
			top: auto;
			bottom: 0;
			left: 0;
			right: 0;
			border-top: 1px solid var(--header-social-border);
			border-bottom: none;
		}
		.header-light {
			background: rgba(250, 248, 245, 0.97);
		}

		nav {
			height: auto;
			padding: 0.4rem 0.5rem calc(0.4rem + env(safe-area-inset-bottom, 0));
			justify-content: space-around;
		}
		.logo { display: none; }
		.nav-right {
			width: 100%;
			margin-left: 0;
			gap: 0;
			justify-content: space-around;
		}
		.internal-links {
			width: 100%;
			justify-content: space-around;
			gap: 0;
		}
		.social-links { display: none; }

		:global(.internal-links) a {
			display: flex;
			flex-direction: column;
			align-items: center;
			min-width: 64px;
			min-height: 48px;
			padding: 8px 12px;
			font-size: 0.7rem;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.06em;
			border-radius: 8px;
		}
	}

	@media (max-width: 720px) {
		:global(body) {
			padding-bottom: calc(64px + env(safe-area-inset-bottom, 0));
		}
	}
</style>
