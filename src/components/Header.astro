---
import '../styles/newspaper.css';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
interface Props { homepage?: boolean; activeSection?: string; themeToggle?: boolean; revealWordmark?: boolean; }
const { homepage = false, activeSection, themeToggle = homepage, revealWordmark = false } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { name: 'Writing', href: '/blog/' },
  { name: 'Software', href: '/software/' },
  { name: 'Tech', href: '/tech/' },
  { name: 'Cooking', href: '/cooking/' },
  { name: 'Life', href: '/life/' },
  { name: 'Notes', href: '/notes/' },
  { name: 'Seen', href: '/seen/' },
  { name: 'Links', href: '/links/' },
];
const current = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
const active = (href: string) => activeSection ? activeSection === href : current(href) || path.startsWith(href);

---
<header class:list={['site-header', { 'on-paper': homepage }]} data-reveal-wordmark={revealWordmark || undefined} data-wordmark-visible={revealWordmark ? 'false' : undefined}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="mager.co home" inert={revealWordmark}>mager<span>.</span>co</a>
    <nav class="header-sections" aria-label="Main navigation">
      {sections.map(section => <a class:list={{ active: active(section.href) }} href={section.href} aria-current={current(section.href) ? 'page' : undefined}>{section.name}</a>)}
    </nav>
    <details class="header-browse">
      <summary aria-label="Main menu">
        <svg class="menu-open" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        <svg class="menu-close" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="2" /></svg>
        <span>Menu</span>
      </summary>
      <nav class="browse-panel" aria-label="Main navigation">
        {sections.map(section => <a href={section.href} class:list={{ active: active(section.href) }} aria-current={current(section.href) ? 'page' : undefined}>{section.name}</a>)}
      </nav>
    </details>
    <div class="header-tools">
      <button class="search-trigger" type="button" aria-label="Search" data-open-search aria-haspopup="dialog" aria-controls="site-search" hidden>
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.5" /></svg>
        <span>Search</span><kbd aria-hidden="true">/</kbd>
      </button>
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</header>
<Search />
<style>
  :global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
  :global(.skip-link:focus) { transform: translateY(0); }
  .site-header { --header-accent: oklch(78% 0.09 230); --header-bg: #0d1117; --header-ink: #edece8; --header-muted: #a4a5aa; --header-rule: #292929; background: var(--header-bg); color: var(--header-ink); padding: 0 24px; position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--header-rule); }
  .on-paper { --header-accent: var(--news-blue); --header-bg: var(--news-paper); --header-ink: var(--news-ink); --header-muted: var(--news-muted); --header-rule: var(--news-rule); }
  .header-shell { position: relative; display: flex; align-items: center; gap: clamp(20px, 2.5vw, 36px); max-width: 1320px; margin: auto; min-height: 64px; }
  .wordmark { color: var(--header-ink); font: 800 27px/1 var(--news-display); letter-spacing: -.07em; white-space: nowrap; }
  .wordmark:hover { color: var(--header-ink); opacity: .8; }
  [data-wordmark-visible="false"] .wordmark { display: none; }
  .header-sections { display: flex; flex-wrap: wrap; gap: 0 clamp(18px, 2vw, 28px); align-items: center; }
  .header-sections > a, .header-browse summary { display: inline-flex; align-items: center; position: relative; min-height: 44px; color: var(--header-ink); font: 700 16px/1.4 var(--news-ui); text-decoration: none; }
  .header-sections > a:hover, .header-sections > a.active, .header-browse summary:hover, .header-browse[open] summary { color: var(--header-accent); }
  .header-sections > a.active::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 3px; background: currentColor; }
  .header-browse { display: none; }
  .header-browse summary { list-style: none; cursor: pointer; gap: 10px; }
  .header-browse summary::-webkit-details-marker { display: none; }
  .menu-close, .header-browse[open] .menu-open { display: none; }
  .header-browse[open] .menu-close { display: block; }
  .browse-panel { position: absolute; top: calc(100% + 1px); left: 0; right: 0; padding: 16px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px 16px; background: var(--header-bg); border: 1px solid var(--header-rule); border-top: 0; box-shadow: 0 14px 28px #00000018; max-height: calc(100dvh - var(--site-header-height) - var(--site-footer-height, 77px) - 24px); overflow-y: auto; }
  .browse-panel a { display: flex; align-items: center; min-height: 48px; padding: 4px 8px; color: var(--header-ink); font: 700 18px/1.4 var(--news-ui); text-decoration: none; }
  .browse-panel a:hover, .browse-panel a.active { color: var(--header-accent); text-decoration: underline; text-underline-offset: 5px; }
  .header-tools { display: flex; flex-shrink: 0; align-items: center; gap: 12px; margin-left: auto; }
  .header-tools :global(.theme-toggle) { padding: 0; }
  .search-trigger { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 44px; padding: 0 10px; border: 0; border-radius: 3px; background: transparent; color: var(--header-ink); font: 500 13px/1.4 var(--news-ui); cursor: pointer; }
  .search-trigger[hidden] { display: none; }
  .search-trigger:hover { color: var(--header-accent); }
  .search-trigger kbd { margin-left: 10px; padding: 1px 6px; border: 1px solid var(--header-rule); color: var(--header-muted); font: 12px var(--news-mono); }
  .site-header :focus-visible { outline: 2px solid var(--header-accent); outline-offset: 3px; }
  :global(:root) { --site-header-height: 65px; }
  :global(html) { scroll-padding-block: calc(var(--site-header-height) + 16px) calc(var(--site-footer-height, 49px) + 16px); }
  @media (min-width: 761px) and (max-width: 1100px) {
    :global(:root) { --site-header-height: 109px; }
    .header-shell { flex-wrap: wrap; gap: 0 24px; padding-block: 4px; }
    .wordmark, .header-tools { min-height: 44px; display: flex; align-items: center; }
    .header-sections { order: 3; width: 100%; justify-content: space-between; }
    [data-wordmark-visible="false"] .header-sections { order: 0; width: auto; flex: 1; justify-content: flex-start; }
    .search-trigger span, .search-trigger kbd { display: none; }
    .search-trigger { min-width: 44px; }
  }
  @media(max-width: 760px) {
    .header-shell { gap: 16px; }
    .wordmark { font-size: 25px; }
    .header-sections { display: none; }
    .header-browse { display: block; order: -1; }
    .header-tools { gap: 12px; }
    .search-trigger { min-width: 44px; padding-inline: 4px; }
    .search-trigger span, .search-trigger kbd { display: none; }
  }
  @media(max-width: 540px) { .site-header { padding-inline: 18px; } }
  @media(max-width: 380px) {
    .header-shell { gap: 10px; }
    .header-tools { gap: 6px; }
    .header-browse summary { min-width: 44px; justify-content: center; }
    .header-browse summary span { display: none; }
  }
  @media print { .site-header { display: none; } }
</style>

<script>
  import { enhanceHeaderBrowse } from '../scripts/header-browse';
  import { observeHeaderWordmark } from '../scripts/header-wordmark';
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    enhanceHeaderBrowse(header);
    const refreshWordmark = observeHeaderWordmark(header);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
      refreshWordmark();
    }).observe(header);
  }

</script>
