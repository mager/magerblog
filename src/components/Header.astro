---
import '../styles/newspaper.css';
import ThemeToggle from './ThemeToggle.astro';
interface Props { homepage?: boolean; activeSection?: string; themeToggle?: boolean; revealWordmark?: boolean; }
const { homepage = false, activeSection, themeToggle = homepage, revealWordmark = false } = Astro.props;
const path = Astro.url.pathname;
const primary = [
  { name: 'Writing', href: '/blog/' },
  { name: 'Software', href: '/software/' },
];
const groups = [
  { title: 'By topic', links: [
    { name: 'Tech', href: '/tech/' },
    { name: 'Cooking', href: '/cooking/' },
    { name: 'Life', href: '/life/' },
  ] },
  { title: 'Notebook', links: [
    { name: 'Notes', href: '/notes/' },
    { name: 'Seen', href: '/seen/' },
    { name: 'Links', href: '/links/' },
    { name: 'Artifacts', href: '/artifacts/' },
  ] },
];
const current = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
const active = (href: string) => activeSection ? activeSection === href : current(href) || path.startsWith(href);
const browsing = groups.some(group => group.links.some(link => active(link.href)));

---
<header class:list={['site-header', { 'on-paper': homepage }]} data-reveal-wordmark={revealWordmark || undefined} data-wordmark-visible={revealWordmark ? 'false' : undefined}>
  <div class="header-shell">
    <a class="wordmark" href="/" aria-label="mager.co home" inert={revealWordmark}>mager<span>.</span>co</a>
    <nav class="header-sections" aria-label="Main navigation">
      {primary.map(section => <a class:list={{ active: active(section.href) }} href={section.href} aria-current={current(section.href) ? 'page' : undefined}>{section.name}</a>)}
      <details class="header-browse">
        <summary class:list={{ active: browsing }}>Browse <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="m3 4.5 3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></summary>
        <div class="browse-panel">
          {groups.map(group => <div class="browse-group"><p>{group.title}</p>{group.links.map(link => <a href={link.href} class:list={{ active: active(link.href) }} aria-current={current(link.href) ? 'page' : undefined}>{link.name}<span aria-hidden="true">↗</span></a>)}</div>)}
        </div>
      </details>
    </nav>
    <div class="header-tools">
      {themeToggle && <ThemeToggle />}
    </div>
  </div>
</header>
<style>
  :global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
  :global(.skip-link:focus) { transform: translateY(0); }
  .site-header { --header-bg: #0d1117; --header-ink: #edece8; --header-muted: #a4a5aa; --header-rule: #292929; background: var(--header-bg); color: var(--header-ink); padding: 0 24px; position: sticky; top: 0; z-index: 30; border-bottom: 1px solid var(--header-rule); }
  .on-paper { --header-bg: var(--news-paper); --header-ink: var(--news-ink); --header-muted: var(--news-muted); --header-rule: var(--news-rule); }
  .header-shell { position: relative; display: flex; align-items: center; gap: clamp(24px, 4vw, 56px); max-width: 1320px; margin: auto; min-height: 64px; }
  .wordmark { color: var(--header-ink); font: 800 27px/1 var(--news-display); letter-spacing: -.07em; white-space: nowrap; }
  .wordmark span { color: var(--news-red); }
  .wordmark:hover { color: var(--header-ink); opacity: .8; }
  [data-wordmark-visible="false"] .wordmark { display: none; }
  .header-sections { display: flex; gap: 0 clamp(24px, 3vw, 36px); align-items: center; }
  .header-sections > a, .header-browse summary { display: inline-flex; align-items: center; position: relative; min-height: 44px; color: var(--header-muted); font: 500 13px/1.4 var(--news-ui); }
  .header-sections > a:hover, .header-sections > a.active, .header-browse summary:hover, .header-browse summary.active, .header-browse[open] summary { color: var(--header-ink); }
  .header-sections > a.active::after, .header-browse summary.active::after { content: ''; position: absolute; bottom: 4px; left: 0; right: 0; height: 2px; background: currentColor; }
  .header-browse summary { list-style: none; cursor: pointer; gap: 8px; }
  .header-browse summary::-webkit-details-marker { display: none; }
  .header-browse summary svg { transition: transform 160ms ease; }
  .header-browse[open] summary svg { transform: rotate(180deg); }
  .browse-panel { position: absolute; top: calc(100% + 1px); left: 0; width: 400px; max-width: 100%; padding: 22px; display: grid; grid-template-columns: 1fr 1fr; gap: 24px; background: var(--header-bg); border: 1px solid var(--header-rule); border-top: 0; box-shadow: 0 14px 28px #00000018; }
  .browse-group p { margin: 0 0 10px; color: var(--header-muted); font: 500 10px/1.5 var(--news-mono); text-transform: uppercase; letter-spacing: .09em; }
  .browse-panel { max-height: calc(100dvh - var(--site-header-height) - var(--site-footer-height, 77px) - 24px); overflow-y: auto; }
  .browse-group a { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; color: var(--header-ink); font: 500 14px/1.4 var(--news-ui); }
  .browse-group a span { opacity: 0; color: var(--header-muted); }
  .browse-group a:hover, .browse-group a.active { text-decoration: underline; text-underline-offset: 5px; }
  .browse-group a:hover span, .browse-group a:focus-visible span { opacity: 1; }
  .header-tools { display: flex; align-items: center; gap: 18px; margin-left: auto; }
  .header-tools :global(.theme-toggle) { padding: 0; }
  .site-header :focus-visible { outline: 2px solid var(--header-ink); outline-offset: 3px; }
  :global(:root) { --site-header-height: 65px; }
  :global(html) { scroll-padding-block: calc(var(--site-header-height) + 16px) calc(var(--site-footer-height, 49px) + 16px); }
  @media(max-width: 760px) {
    :global(:root) { --site-header-height: 97px; }
    .header-shell { display: grid; grid-template-columns: 1fr auto; gap: 0 16px; padding-top: 4px; }
    .wordmark { font-size: 25px; }
    .header-tools { grid-column: 2; grid-row: 1; min-height: 44px; }
    .header-sections { grid-column: 1 / -1; grid-row: 2; justify-content: flex-start; gap: 0 30px; padding-bottom: 4px; }
    .header-sections > a, .header-browse summary { font-size: 12px; }
  }
  @media(max-width: 540px) { .site-header { padding-inline: 18px; } }
  @media(prefers-reduced-motion: reduce) { .header-browse summary svg { transition: none; } }
  @media print { .site-header { display: none; } }
</style>

<script>
  import { enhanceHeaderBrowse } from '../scripts/header-browse';
  import { observeHeaderWordmark } from '../scripts/header-wordmark';
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    enhanceHeaderBrowse(header);
    const refreshWordmark = observeHeaderWordmark(header);
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', `${header.getBoundingClientRect().height}px`);
      refreshWordmark();
    }).observe(header);
  }

</script>
