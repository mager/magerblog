---
import '../styles/newspaper.css';
interface Props { homepage?: boolean; masthead?: boolean; editionDate?: Date; }
const { homepage = false, masthead = false, editionDate } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { name: 'Tech', href: '/tech/', ink: 'blue' },
  { name: 'Food', href: '/cooking/', ink: 'red' },
  { name: 'Life', href: '/life/', ink: 'green' },
  { name: 'Notes', href: '/notes/', ink: 'blue' },
  { name: 'Seen', href: '/seen/', ink: 'green' },
  { name: 'Links', href: '/links/', ink: 'red' },
];
const active = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
---
{masthead && <a class="skip-link" href="#main-content">Skip to content</a>}
<header class:list={['press-header', { 'on-paper': homepage, masthead }]}>
  <div class="press-shell">
    <div class="nameplate">
      {masthead && <div class="edition-stamp"><span class="chicago-stars" aria-label="Four Chicago stars">✶ ✶ ✶ ✶</span><span>The Chicago edition</span>{editionDate && <time class="edition-date" datetime={editionDate.toISOString()}>Updated {editionDate.toLocaleDateString('en-US', {month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC'})}</time>}</div>}
      <a href="/" class="press-wordmark" aria-label="mager.co home">mager<span class="wordmark-dot">.</span>co</a>
      {masthead && <p class="edition-motto">Tech, food &amp; life from Chicago.</p>}
      {!masthead && <a class="home-edition" href="/">The Chicago edition <span aria-hidden="true">↗</span></a>}
    </div>
    <nav class="press-nav" aria-label="Main navigation">
      <span class="nav-label" aria-hidden="true">Explore</span>
      <div class="nav-sections">
        {sections.map(section => <a class:list={['nav-link', section.ink, { active: active(section.href) }]} href={section.href} aria-current={active(section.href) ? 'page' : undefined}>{section.name}</a>)}
      </div>
      <div class="nav-utility">
        <a href="https://bench.mager.co" class="utility-link">Bench <span aria-hidden="true">↗</span></a>
        <a class:list={['utility-link', { active: active('/about/') }]} href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
        <a class="utility-link rss-link" href="/rss.xml">RSS <span aria-hidden="true">↗</span></a>
      </div>
    </nav>
  </div>
</header>
<style>
:global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
:global(.skip-link:focus) { transform: translateY(0); }
.press-header { --press-bg: oklch(19% 0.02 260); --press-ink: oklch(94% 0.009 85); --press-muted: oklch(76% 0.014 260); --press-rule: oklch(39% 0.018 260); --nav-blue: oklch(72% 0.13 265); --nav-red: oklch(73% 0.14 30); --nav-green: oklch(75% 0.1 155); background: var(--press-bg); color: var(--press-ink); padding: 0 24px; }
.on-paper { --press-bg: var(--news-paper); --press-ink: var(--news-ink); --press-muted: var(--news-muted); --press-rule: var(--news-rule); --nav-blue: var(--news-blue); --nav-red: var(--news-red); --nav-green: var(--news-green); }
.press-shell { max-width: 1240px; margin: auto; }
.press-header a { color: inherit; }
.nameplate { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; }
.press-wordmark { font: 900 38px/.95 var(--news-display); letter-spacing: -.075em; white-space: nowrap; }
.press-header .press-wordmark:hover { text-decoration: none; }
.wordmark-dot { color: var(--news-red); display: inline-block; transition: transform 350ms var(--news-ease); }
.press-wordmark:hover .wordmark-dot { transform: translateY(-.14em); }
.home-edition { font: 500 10px/1.4 var(--news-mono); color: var(--press-muted); }
.home-edition:hover { color: var(--press-ink); }
.masthead .nameplate { display: grid; grid-template-columns: 1fr auto 1fr; padding: 24px 0 28px; }
.masthead .press-wordmark { font-size: clamp(78px, 12vw, 154px); }
.edition-stamp { display: flex; flex-direction: column; gap: 7px; font: 500 10px/1.4 var(--news-mono); text-transform: uppercase; letter-spacing: .06em; }
.chicago-stars { font-size: 28px; letter-spacing: .07em; color: var(--news-red); }
.edition-date { color: var(--press-muted); text-transform: none; letter-spacing: 0; }
.edition-motto { justify-self: end; margin: 0; font: italic 18px/1.45 var(--news-serif); }
.press-nav { display: flex; align-items: stretch; border-top: 2px solid var(--press-ink); border-bottom: 1px solid var(--press-rule); }
.nav-label { display: flex; align-items: center; padding-right: clamp(18px, 2vw, 28px); color: var(--press-muted); font: 600 9px/1.2 var(--news-mono); letter-spacing: .12em; text-transform: uppercase; }
.nav-sections, .nav-utility { display: flex; align-items: stretch; }
.nav-utility { margin-left: auto; border-left: 1px solid var(--press-rule); }
.press-nav a { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 54px; white-space: nowrap; transition: color 180ms ease, background-color 180ms ease; }
.nav-link { --link-accent: var(--press-ink); padding: 0 clamp(12px, 1.5vw, 21px); font: 600 14px/1.2 var(--news-ui); letter-spacing: -.02em; }
.nav-link.blue { --link-accent: var(--nav-blue); }
.nav-link.red { --link-accent: var(--nav-red); }
.nav-link.green { --link-accent: var(--nav-green); }
.nav-link::after, .utility-link::after { content: ''; position: absolute; bottom: -1px; left: 14px; right: 14px; height: 2px; background: var(--link-accent, var(--press-ink)); transform: scaleX(0); transition: transform 260ms var(--news-ease); }
.nav-link:hover, .nav-link.active { color: var(--link-accent); }
.nav-link:hover::after, .nav-link.active::after, .utility-link:hover::after, .utility-link.active::after { transform: scaleX(1); }
.utility-link { min-width: 44px; padding: 0 clamp(10px, 1.25vw, 17px); color: var(--press-muted) !important; font: 600 11px/1.2 var(--news-ui); gap: 5px; }
.utility-link:hover, .utility-link.active { color: var(--press-ink) !important; }
.utility-link span { font-size: 12px; transition: transform 220ms var(--news-ease); }
.utility-link:hover span { transform: translate(2px, -2px); }
.rss-link { font: 600 10px/1.2 var(--news-mono); text-transform: uppercase; }
@media(max-width: 800px) {
  .press-header { padding: 0 18px; }
  .masthead .nameplate { grid-template-columns: 1fr; text-align: center; padding: 20px 0; gap: 10px; }
  .masthead .press-wordmark { font-size: clamp(60px, 20vw, 125px); grid-row: 1; white-space: nowrap; }
  .edition-stamp { align-items: center; justify-content: center; gap: 2px; font-size: 9px; }
  .chicago-stars { font-size: 18px; white-space: nowrap; }
  .edition-motto { display: none; }
  .press-nav { flex-wrap: wrap; }
  .nav-label { display: none; }
  .nav-sections { flex: 1 0 100%; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .nav-link { padding: 0 3px; font-size: clamp(11px, 3vw, 14px); }
  .press-nav a { min-height: 44px; }
  .nav-utility { flex: 1 0 100%; justify-content: flex-end; border-left: 0; border-top: 1px solid var(--press-rule); }
  .utility-link { padding: 0 12px; }
  .nav-utility .utility-link:first-child { margin-right: auto; padding-left: 0; }
  .nav-utility .utility-link:last-child { padding-right: 0; }
}
@media(max-width: 420px) {
  .press-header:not(.masthead) .nameplate { gap: 10px; }
  .press-header:not(.masthead) .press-wordmark { font-size: 32px; }
  .home-edition { max-width: 95px; text-align: right; }
}
@media(prefers-reduced-motion: reduce) {
  .wordmark-dot, .utility-link span, .nav-link::after, .utility-link::after { transition: none; transform: none !important; }
  .nav-link::after, .utility-link::after { display: none; }
}
</style>
