---
import '../styles/newspaper.css';
interface Props { homepage?: boolean; masthead?: boolean; editionDate?: Date; }
const { homepage = false, masthead = false, editionDate } = Astro.props;
const path = Astro.url.pathname;
const sections = [
  { name: 'Tech', href: '/tech/', ink: 'blue' },
  { name: 'Food', href: '/cooking/', ink: 'red' },
  { name: 'Life', href: '/life/', ink: 'green' },
  { name: 'Notes', href: '/notes/', ink: 'blue' },
  { name: 'Seen', href: '/seen/', ink: 'green' },
];
const active = (href: string) => path.replace(/\/$/, '') === href.replace(/\/$/, '');
---
{masthead && <a class="skip-link" href="#main-content">Skip to content</a>}
<header class:list={['press-header', { 'on-paper': homepage, masthead }]}>
  <div class="press-shell">
    <div class="nameplate">
      {masthead && <div class="edition-stamp"><span class="chicago-stars" aria-label="Four Chicago stars">✶ ✶ ✶ ✶</span><span>The Chicago edition</span></div>}
      <a href="/" class="press-wordmark" aria-label="mager.co home">mager<span class="wordmark-dot">.</span>co</a>
      {masthead && <p class="edition-motto">Tech, food &amp; life from Chicago.</p>}
      {!masthead && <a class="home-edition" href="/">The Chicago edition <span aria-hidden="true">↗</span></a>}
    </div>
    {masthead && <div class="edition-dateline">
      {editionDate && <span>Latest dispatch <time datetime={editionDate.toISOString()}>{editionDate.toLocaleDateString('en-US', {month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC'})}</time></span>}
      <a href="/rss.xml">Delivered by RSS <span aria-hidden="true">↗</span></a>
    </div>}
    <nav class="press-nav" aria-label="Main navigation">
      {sections.map(section => <a class:list={['section-link', section.ink, { active: active(section.href) }]} href={section.href} aria-current={active(section.href) ? 'page' : undefined}>{section.name}</a>)}
      <a class="bench-link" href="https://bench.mager.co">mager-bench <span aria-hidden="true">↗</span></a>
      <a class:list={['about-link', { active: active('/about/') }]} href="/about/" aria-current={active('/about/') ? 'page' : undefined}>About</a>
    </nav>
  </div>
</header>
<style>
:global(.skip-link) { position: absolute; top: 8px; left: 16px; z-index: 1000; padding: 12px 18px; background: var(--news-blue); color: var(--news-paper); transform: translateY(-150%); font: 600 14px var(--news-ui); }
:global(.skip-link:focus) { transform: translateY(0); }
.press-header { --press-bg: oklch(19% 0.02 260); --press-ink: oklch(94% 0.009 85); --press-muted: oklch(76% 0.014 260); --press-rule: oklch(39% 0.018 260); background: var(--press-bg); color: var(--press-ink); padding: 0 24px; }
.on-paper { --press-bg: var(--news-paper); --press-ink: var(--news-ink); --press-muted: var(--news-muted); --press-rule: var(--news-rule); }
.press-shell { max-width: 1240px; margin: auto; }
.press-header a { color: inherit; }
.press-header a:hover { text-decoration: underline; text-underline-offset: 5px; }
.edition-dateline { display: flex; align-items: center; justify-content: space-between; gap: 16px; font: 500 10px/1.5 var(--news-mono); }
.nameplate { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 16px 0; }
.press-wordmark { font: 900 38px/.95 var(--news-display); letter-spacing: -.075em; }
.press-header .press-wordmark:hover { text-decoration: none; }
.wordmark-dot { color: var(--news-red); display: inline-block; transition: transform 350ms var(--news-ease); }
.press-wordmark:hover .wordmark-dot { transform: translateY(-.14em); }
.home-edition { font: 500 10px/1.4 var(--news-mono); color: var(--press-muted); }
.masthead .nameplate { display: grid; grid-template-columns: 1fr auto 1fr; padding: 24px 0 28px; }
.masthead .press-wordmark { font-size: clamp(78px, 12vw, 154px); }
.edition-stamp { display: flex; flex-direction: column; gap: 7px; font: 500 10px/1.4 var(--news-mono); text-transform: uppercase; letter-spacing: .06em; }
.chicago-stars { font-size: 28px; letter-spacing: .07em; color: var(--news-red); }
.edition-motto { justify-self: end; margin: 0; font: italic 18px/1.45 var(--news-serif); }
.edition-dateline { padding: 9px 0; border-top: 1px solid var(--press-rule); color: var(--press-muted); }
.edition-dateline time { margin-left: 8px; color: var(--press-ink); }
.press-nav { display: flex; align-items: center; gap: clamp(12px, 2.4vw, 34px); border-top: 1px solid var(--press-ink); border-bottom: 1px solid var(--press-ink); }
.press-nav a { display: inline-flex; align-items: center; justify-content: center; min-height: 46px; font: 700 12px/1.2 var(--news-ui); white-space: nowrap; }
.press-nav a.active { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
.on-paper .blue { color: var(--news-blue); }
.on-paper .red { color: var(--news-red); }
.on-paper .green { color: var(--news-green); }
.bench-link { margin-left: auto; gap: 8px; }
.press-nav .bench-link:hover { background: var(--news-yellow); color: var(--news-ink); text-decoration: none; }
.bench-link span { transition: transform 250ms var(--news-ease); }
.bench-link:hover span { transform: translate(2px, -2px); }
@media(max-width: 760px) {
  .press-header { padding: 0 18px; }
  .masthead .nameplate { grid-template-columns: 1fr; text-align: center; padding: 20px 0; gap: 10px; }
  .masthead .press-wordmark { font-size: clamp(60px, 20vw, 125px); grid-row: 1; white-space: nowrap; }
  .edition-stamp { flex-direction: row; align-items: center; justify-content: center; font-size: 9px; }
  .chicago-stars { font-size: 18px; }
  .edition-motto { display: none; }
  .edition-dateline { font-size: 9px; flex-wrap: wrap; gap: 5px 10px; }
  .press-nav { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; }
  .press-nav a { min-height: 44px; font-size: 11px; }
  .bench-link { margin-left: 0; gap: 4px; }
  .press-nav a:nth-child(n+5) { border-top: 1px solid var(--press-rule); }
}
@media(prefers-reduced-motion: reduce) { .wordmark-dot, .bench-link span { transition: none; transform: none !important; } }
</style>
