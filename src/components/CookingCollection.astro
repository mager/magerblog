---
import type { CollectionEntry } from 'astro:content';
import { entryHref } from '../lib/feed';
import { entryImage, entryDate } from '../lib/feed-display';
import { contentMeta } from '../lib/content-meta';
import { recipeCategoryIds, recipeCategoryLabels, recipeCategoryDescriptions } from '../lib/cooking';
interface Props { entries: CollectionEntry<'blog'>[]; }
const { entries } = Astro.props;
const filters = recipeCategoryIds.map(id => ({ id, label: recipeCategoryLabels[id], count: entries.filter(entry => entry.data.recipeCategories?.includes(id)).length })).filter(filter => filter.count);
const lead = entries[0];
const leads = [...new Set([lead, ...filters.map(filter => entries.find(entry => entry.data.recipeCategories?.includes(filter.id)))].filter((entry): entry is CollectionEntry<'blog'> => !!entry))];
---
<section class="cooking-collection" data-simple-list data-filter-by="recipe" data-item-name="recipe" data-cooking-world="all" aria-label="Recipe collection">
  <div class="simple-controls cooking-controls" hidden>
    <div class="cooking-filter-top">
      <p id="recipe-filter-label">Find something to cook</p>
      <div class="simple-search" role="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 5 5" /></svg>
        <input id="simple-query" type="search" aria-label="Search recipes or ingredients" placeholder="Search recipes or ingredients…" autocomplete="off" maxlength="200" />
        <button type="button" data-simple-clear hidden>Clear</button>
      </div>
    </div>
    <div class="cooking-filters" role="group" aria-labelledby="recipe-filter-label">
      <button type="button" data-simple-filter="all" data-filter-label="All recipes" aria-pressed="true" aria-controls="cooking-results">All recipes <span>{entries.length}</span></button>
      {filters.map(filter => <button type="button" data-simple-filter={filter.id} data-filter-label={filter.label} data-filter-description={recipeCategoryDescriptions[filter.id]} aria-pressed="false" aria-controls="cooking-results">{filter.label} <span>{filter.count}</span></button>)}
    </div>
    <div class="simple-search-status"><p data-simple-status role="status" aria-live="polite" aria-atomic="true"></p><button type="button" data-simple-retry hidden>Try again</button></div>
  </div>
  <div id="cooking-results">
    <div class="cooking-results-heading"><div><h2 id="simple-posts-heading" data-default-heading="Latest recipes">Latest recipes</h2><p class="cooking-world-description" data-cooking-description hidden></p></div><p data-simple-count aria-live="polite" aria-atomic="true">{entries.length} recipes</p></div>
    {leads.map(item => { const image = entryImage(item); return <article class:list={['cooking-feature', { 'cooking-feature-text': !image }]} data-simple-feature data-href={entryHref(item)} hidden={item !== lead}>
      {image && <a class="cooking-feature-image" href={entryHref(item)} aria-label={`Read ${item.data.title}`}><img src={image} alt={item.data.heroImageAlt || ''} width="800" height="600" loading={item === lead ? 'eager' : 'lazy'} decoding="async" fetchpriority={item === lead ? 'high' : 'auto'} /></a>}
      <div class="cooking-feature-copy">
        <h2><a href={entryHref(item)}>{item.data.title}</a></h2>
        <p>{item.data.description}</p>
        <div class="cooking-recipe-meta"><span>{contentMeta(item)}</span>{item.data.recipeYield && <span>{item.data.recipeYield}</span>}</div>
        <a class="cooking-read" href={entryHref(item)}>Cook this recipe <svg width="23" height="16" viewBox="0 0 24 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M1 8h21m-7-6 7 6-7 6" /></svg></a>
        <time datetime={(item.data.updatedDate || item.data.pubDate).toISOString()}>{item.data.updatedDate && 'Updated '}{entryDate(item.data.updatedDate || item.data.pubDate)}</time>
      </div>
    </article>; })}
    <ul id="simple-list" class="cooking-grid">
      {entries.map(entry => { const image = entryImage(entry); const categories = entry.data.recipeCategories || []; return <li data-simple-row data-href={entryHref(entry)} data-category="food" data-recipe-categories={categories.join(' ')} hidden={entry === lead}>
        <article class:list={['cooking-card', { 'cooking-card-text': !image }]}>
          {image && <a class="cooking-card-image" href={entryHref(entry)} tabindex="-1" aria-hidden="true"><img src={image} alt="" width="480" height="360" loading="lazy" decoding="async" /></a>}
          <div class="cooking-card-body">
            <div class="cooking-card-meta"><span>{categories[0] && recipeCategoryLabels[categories[0]]}</span><span>{contentMeta(entry)}</span></div>
            <h3><a class="simple-post-title" href={entryHref(entry)}>{entry.data.title}</a></h3>
            <p class="cooking-card-description">{entry.data.description}</p>
            <p class="simple-search-snippet" hidden></p>
            <time datetime={(entry.data.updatedDate || entry.data.pubDate).toISOString()}>{entry.data.updatedDate && 'Updated '}{entryDate(entry.data.updatedDate || entry.data.pubDate)}</time>
          </div>
        </article>
      </li>; })}
    </ul>
    <p class="simple-empty" data-simple-empty hidden>No recipes match. Try another search or choose All recipes.</p>
    <button class="simple-more" type="button" data-simple-more hidden>Show more recipes</button>
    {entries.length === 0 && <p>No recipes yet.</p>}
  </div>
</section>
<script>
  import '../scripts/simple-home';
</script>
