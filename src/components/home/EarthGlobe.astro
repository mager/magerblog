---
import { resolve } from 'node:path';
import sharp from 'sharp';
import { drawEarth } from '../../lib/earth-globe';

interface Props { date: Date; }
const { date } = Astro.props;
const texturePath = '/images/timeline/earth-surface.webp';
const { data, info } = await sharp(resolve('public', texturePath.slice(1))).ensureAlpha().raw().toBuffer({ resolveWithObject: true });
const size = 240;
const pixels = drawEarth(date, size, { width: info.width, height: info.height, pixels: data });
const still = await sharp(pixels, { raw: { width: size, height: size, channels: 4 } }).webp({ quality: 84 }).toBuffer();
---
<div class="earth-globe" data-earth-globe data-texture={texturePath} data-date={date.toISOString()}>
  <img width={size} height={size} alt={`Earth's sunlit hemisphere at ${date.toISOString().slice(0, 16).replace('T', ' ')} UTC`} src={`data:image/webp;base64,${still.toString('base64')}`} />
  <canvas width="384" height="384" hidden aria-hidden="true"></canvas>
</div>
<style>
  .earth-globe { position: relative; width: 100%; aspect-ratio: 1; }
  .earth-globe :is(img, canvas) {
    display: block; width: 100%; height: 100%; padding: 0; margin: 0;
    border: none; border-radius: 0; box-shadow: none; background: transparent;
  }
  .earth-globe canvas { position: absolute; inset: 0; }
  .earth-globe canvas[hidden] { display: none; }
  .earth-globe[data-painted] img { opacity: 0; }
</style>
<script>
  import { initEarthGlobe } from '../../scripts/earth-globe';
  const globe = document.querySelector<HTMLElement>('[data-earth-globe]');
  if (globe) initEarthGlobe(globe);
</script>
