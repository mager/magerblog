---
import EarthGlobe from './EarthGlobe.astro';
import { backdropBodiesAt } from '../../scripts/universe';

interface Props { date: Date; }
const { date } = Astro.props;
const bodies = backdropBodiesAt(date);

// Fixed seed gives the static page and the enhanced sky the same constellations.
let seed = 99173;
function random() {
  seed = Math.imul(48271, seed) | 0;
  return (seed >>> 0) / 4294967296;
}
const stars = Array.from({ length: 210 }, (_, index) => ({
  x: Math.round(random() * 1180),
  y: Math.round(random() * 780),
  size: index < 130 ? 1 : 1.5,
  opacity: (0.20 + random() * 0.55).toFixed(2),
}));
const glints = [
  [90, 117, 3.5], [274, 704, 2.5], [490, 249, 3], [718, 79, 4],
  [1083, 169, 2.8], [960, 493, 4], [605, 664, 2.8], [61, 474, 2.6],
];
---
<div class="universe-sky" aria-hidden="true" data-space-sky>
  <svg class="universe-stars" width="100%" height="100%" aria-hidden="true">
    <defs>
      <pattern id="universe-dust" patternUnits="userSpaceOnUse" width="1180" height="780">
        {stars.slice(0, 130).map(star => <rect x={star.x} y={star.y} width={star.size} height={star.size} opacity={star.opacity} />)}
      </pattern>
      <pattern id="universe-lights" patternUnits="userSpaceOnUse" width="1180" height="780">
        {stars.slice(130).map(star => <circle cx={star.x} cy={star.y} r={star.size / 2} opacity={star.opacity} />)}
        {glints.map(([x, y, size], index) => <path class:list={['universe-glint', `glint-${index % 3}`]} transform={`translate(${x} ${y}) scale(${size})`} d="M0-1 .19-.20 1 0 .2.18 0 1.25-.20.18-1 0-.19-.20Z" />)}
      </pattern>
    </defs>
    <g class="universe-far"><rect x="-100" y="-100" width="120%" height="140%" fill="url(#universe-dust)" /></g>
    <g class="universe-near"><rect x="-100" y="-100" width="120%" height="140%" fill="url(#universe-lights)" /></g>
  </svg>
  <div class="universe-planets">
    {bodies.map(({ name, x, y }) => <i data-sky-body={name} style={`--body-x:${x};--body-y:${y}`}></i>)}
  </div>
</div>
<figure class="universe-earth">
  <div class="earth-disc"><EarthGlobe date={date} /></div>
  <svg class="survey-track" viewBox="0 0 440 210" fill="none" aria-hidden="true" preserveAspectRatio="none">
    <path d="M105 140C52 164 19 191 33 200C52 212 125 190 181 163" stroke="currentColor" stroke-dasharray="2 5" />
  </svg>
  <svg class="survey-satellite" aria-hidden="true" viewBox="0 0 84 50" fill="none" shape-rendering="crispEdges">
    <defs>
      <g id="probe-panel">
        <rect x="-1" y="-1" width="24" height="13" fill="#26243b" />
        <rect width="22" height="11" fill="#718bb2" />
        {[0, 1, 2].map(column => [0, 1].map(row => <rect x={column * 7 + 1} y={row * 5 + 1} width="6" height="4" fill={row ? '#293c65' : '#3a5381'} />))}
        <path d="M0 0h22M0 0v11" stroke="#c4cbd6" stroke-width=".7" />
      </g>
    </defs>
    <path d="m22 33 40-12" stroke="#1c1c31" stroke-width="3" />
    <path d="m22 32 40-12" stroke="#dfb26c" stroke-width="1.5" />
    <use href="#probe-panel" transform="matrix(.95 -.27 .55 1 1 34)" />
    <use href="#probe-panel" transform="matrix(.95 -.27 .55 1 56 18)" />
    <path d="m32 22 15-5 7 10v11l-16 6-7-8Z" fill="#151b2e" stroke="#1c2033" stroke-width="2" />
    <path d="m32 22 15-5 7 10-16 5Z" fill="#f5c77e" />
    <path d="m32 22 6 10v12l-7-8Z" fill="#9e7349" />
    <path d="m38 32 16-5v11l-16 6Z" fill="#373848" />
    <path d="m40 33 11-4v2l-11 4Z" fill="#c9914d" />
    <path d="m39 29-6-10 3-1 6 10Z" fill="#fff0ce" />
    <path d="m38 24-7-11" stroke="#242338" stroke-width="3.5" />
    <path d="m37 23-7-11" stroke="#e5cb91" stroke-width="1.7" />
    <path d="m23 13 18-7-3 7-8 5Z" fill="#cba06c" stroke="#26243b" stroke-width="1.6" />
    <path d="m22 12 18-7-3 6-8 5Z" fill="#f8e3b4" />
    <path d="m27 7 3 5" stroke="#fff4d7" stroke-width="1.5" />
  </svg>
  <figcaption>Earth <span aria-hidden="true">/</span> <time data-earth-clock datetime={date.toISOString()} title={date.toUTCString()}>{date.toISOString().slice(11, 16)} UTC</time></figcaption>
</figure>

<style>
  .universe-sky {
    position: fixed;
    z-index: 0;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    color: #d4d4fe;
    background: radial-gradient(ellipse at 82% 18%, rgb(79 61 140 / .14), transparent 47%);
  }
  .universe-stars { display: block; overflow: visible; fill: currentColor; }
  .universe-sky::before {
    content: ''; position: absolute; width: 135%; height: 75%; top: 12%; left: 8%;
    transform: rotate(-33deg);
    background:
      radial-gradient(ellipse at 30% 51%, rgb(113 98 160 / .12), transparent 21%),
      radial-gradient(ellipse at 46% 50%, rgb(73 76 140 / .18), transparent 33%),
      radial-gradient(ellipse at 51% 54%, rgb(153 118 150 / .09), transparent 19%),
      radial-gradient(ellipse at 64% 47%, rgb(91 80 157 / .20), transparent 21%),
      radial-gradient(ellipse at 80% 42%, rgb(81 76 135 / .16), transparent 27%);
    pointer-events: none;
  }
  .universe-planets {
    position: absolute; inset: 0; opacity: .70;
    mask-image: radial-gradient(ellipse at 43% 54%, rgb(0 0 0 / .22) 20%, #000 80%);
  }
  [data-sky-body] {
    --diameter: 8px; --day: #d0bfb7; --night: #635c75;
    display: block; position: absolute; left: 0; top: 0;
    width: var(--diameter); height: var(--diameter); border-radius: 50%;
    transform: translate(var(--body-x), var(--body-y));
    background: radial-gradient(circle at 27% 26%, var(--day) 5%, var(--night) 65%, #252642 93%);
  }
  [data-sky-body="Sun"] {
    --diameter: 15px;
    background: radial-gradient(circle at 37% 35%, #ffe8b4, #ecc38b 60%, #bc8059);
    box-shadow: 0 0 8px #efbd7c60, 0 0 34px 9px #e9a56024;
  }
  [data-sky-body="Venus"] { --diameter: 10px; --day: #f5dfaa; --night: #997660; }
  [data-sky-body="Mars"] { --day: #ffbd95; --night: #9e524a; }
  [data-sky-body="Jupiter"] {
    --diameter: 21px;
    background:
      radial-gradient(circle at 26% 24%, transparent 12%, #272338d4 85%),
      repeating-linear-gradient(169deg, #e9d2ba 0 3px, #ab8076 3px 5px, #d8b7a6 5px 7px);
  }
  [data-sky-body="Saturn"] { --diameter: 16px; --day: #eddbc1; --night: #8f82a7; }
  [data-sky-body="Saturn"]::after {
    content: ''; position: absolute; inset: 32% -48%; transform: rotate(-22deg);
    border: 1px solid #c8b9b8; border-bottom-width: 2px; border-radius: 50%;
  }
  [data-sky-body="Uranus"] { --diameter: 11px; --day: #bcebee; --night: #558f9a; }
  [data-sky-body="Neptune"] { --diameter: 10px; --day: #9ebcff; --night: #4f6caa; }
  .universe-glint { fill: #e5dffa; }
  .universe-far { transform: translateY(var(--space-far, 0px)); }
  .universe-near { transform: translateY(var(--space-near, 0px)); }
  .universe-earth {
    pointer-events: none;
    position: absolute;
    inset: 50% 0 auto auto;
    width: 51%; height: 94%; max-height: 330px; margin: 0;
    transform: translateY(-50%); display: grid; place-items: center;
  }
  .earth-disc { width: min(77%, 292px); aspect-ratio: 1; }
  .survey-track {
    position: absolute; width: 80%; height: 77%; left: 9%; top: 4%;
    color: var(--space-accent); opacity: .5;
  }
  .survey-satellite {
    position: absolute; left: 20%; top: 70%; width: clamp(25px, 12%, 68px);
    height: auto; filter: drop-shadow(1px 2px 1px rgb(8 9 20 / .5));
  }
  figcaption {
    position: absolute; right: 8%; bottom: 3%;
    color: var(--space-soft); font: 500 11px/1.5 var(--space-mono);
    font-variant-numeric: tabular-nums;
  }
  figcaption span { color: var(--space-faint); margin-inline: 4px; }
  :global(html[data-theme='light']) .universe-sky {
    color: #53487c;
    background: radial-gradient(ellipse at 79% 16%, rgb(130 125 199 / .10), transparent 50%);
  }
  :global(html[data-theme='light']) .universe-glint { fill: #514374; }
  :global(html[data-theme='light']) .universe-planets { opacity: .53; }
  @media (max-width: 700px) {
    .universe-earth { width: 46%; height: 78%; }
    .earth-disc { width: min(88%, 195px); }
    .survey-satellite { left: 0; top: 67%; }
    .survey-track { left: -10%; }
    figcaption { font-size: 10px; right: 10%; bottom: 0; }
  }
  @media (max-width: 540px) {
    .universe-earth { height: 68%; top: 49%; }
    .earth-disc { width: min(85%, 132px); }
    figcaption { right: 5%; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .universe-glint { animation: scintillate 8s ease-in-out infinite alternate; }
    .glint-1 { animation-delay: -3s; animation-duration: 10s; }
    .glint-2 { animation-delay: -6s; animation-duration: 11s; }
    .survey-satellite { animation: survey-drift 12s ease-in-out infinite alternate; }
    [data-sky-body] { transition: transform 650ms cubic-bezier(.2,.7,.3,1); }
    :global(html[data-space-motion='paused']) [data-sky-body] { transition: none; }
    :global(html[data-space-motion='paused']) .survey-satellite,
    :global(html[data-space-motion='paused']) .universe-glint { animation-play-state: paused; }
  }
  @keyframes scintillate { from { opacity: .43; } to { opacity: .95; } }
  @keyframes survey-drift { from { transform: translate(0, 0) rotate(-2deg); } to { transform: translate(3%, -6%) rotate(2deg); } }
  @media print { .universe-earth, .universe-sky { display: none; } }
</style>
<script>
  import { initUniverse } from '../../scripts/universe';
  initUniverse();
</script>
