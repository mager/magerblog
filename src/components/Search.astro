---
import type { CollectionEntry } from 'astro:content';

interface Props {
	posts: CollectionEntry<'blog'>[];
	placeholder?: string;
}

const { posts, placeholder = "Search posts..." } = Astro.props;

// Prepare search data (title, description, category, slug, tags, heroImage)
const searchData = posts.map(post => ({
	title: post.data.title,
	description: post.data.description,
	category: post.data.category,
	slug: post.id,
	tags: post.data.tags || [],
	heroImage: post.data.heroImage || null,
}));
---

<div class="search-container">
	<div class="search-input-wrapper">
		<svg class="search-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
			<circle cx="11" cy="11" r="8"></circle>
			<path d="m21 21-4.3-4.3"></path>
		</svg>
		<input
			type="text"
			class="search-input"
			placeholder={placeholder}
			aria-label="Search posts"
			autocomplete="off"
		/>
		<button class="search-clear" type="button" aria-label="Clear search" hidden>
			<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M18 6 6 18"></path>
				<path d="m6 6 12 12"></path>
			</svg>
		</button>
	</div>
	<div class="search-results" hidden></div>
</div>

<script define:vars={{ searchData }}>
	const container = document.querySelector('.search-container');
	const input = container.querySelector('.search-input');
	const results = container.querySelector('.search-results');
	const clearBtn = container.querySelector('.search-clear');

	const categoryConfig = {
		code: { color: 'var(--status-purple)', label: 'code' },
		life: { color: 'var(--status-green)', label: 'life' },
		food: { color: 'var(--status-orange)', label: 'recipes' },
	};

	function escapeHtml(text) {
		const div = document.createElement('div');
		div.textContent = text;
		return div.innerHTML;
	}

	function highlightMatch(text, query) {
		if (!query) return escapeHtml(text);
		const escaped = escapeHtml(text);
		const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
		return escaped.replace(regex, '<mark>$1</mark>');
	}

	function search(query) {
		if (!query || query.length < 2) {
			results.hidden = true;
			return;
		}

		const q = query.toLowerCase();
		const allMatches = searchData.filter(post =>
			post.title.toLowerCase().includes(q) ||
			post.description.toLowerCase().includes(q) ||
			post.tags.some(tag => tag.toLowerCase().includes(q))
		);
		const matches = allMatches.slice(0, 8);

		if (matches.length === 0) {
			results.innerHTML = '<div class="no-results">No matches found</div>';
			results.hidden = false;
			return;
		}

		results.innerHTML = matches.map((post) => {
			const config = categoryConfig[post.category] || categoryConfig.code;
			const thumbnail = post.heroImage
				? `<img src="${post.heroImage}" alt="" class="search-result-thumb" loading="lazy" />`
				: `<div class="search-result-thumb search-result-thumb-placeholder"></div>`;
			return `
				<a href="/blog/${post.slug}/" class="search-result-item" style="--tag-color: ${config.color};">
					${thumbnail}
					<span class="search-result-title">${highlightMatch(post.title, query)}</span>
				</a>
			`;
		}).join('');
		results.hidden = false;
	}

	input.addEventListener('input', (e) => {
		const query = e.target.value.trim();
		clearBtn.hidden = query.length === 0;
		search(query);
	});

	clearBtn.addEventListener('click', () => {
		input.value = '';
		results.hidden = true;
		clearBtn.hidden = true;
		input.focus();
	});

	// Close results when clicking outside
	document.addEventListener('click', (e) => {
		if (!container.contains(e.target)) {
			results.hidden = true;
		}
	});

	// Keyboard navigation
	input.addEventListener('keydown', (e) => {
		const items = results.querySelectorAll('.search-result-item');
		const focused = results.querySelector('.search-result-item:focus');

		if (e.key === 'ArrowDown') {
			e.preventDefault();
			if (!focused && items.length > 0) {
				items[0].focus();
			} else if (focused) {
				const index = Array.from(items).indexOf(focused);
				if (index < items.length - 1) items[index + 1].focus();
			}
		} else if (e.key === 'ArrowUp') {
			e.preventDefault();
			if (focused) {
				const index = Array.from(items).indexOf(focused);
				if (index > 0) {
					items[index - 1].focus();
				} else {
					input.focus();
				}
			}
		} else if (e.key === 'Escape') {
			results.hidden = true;
			input.blur();
		}
	});

	// Re-focus input when typing while result is focused
	results.addEventListener('keydown', (e) => {
		if (e.key.length === 1 && !e.ctrlKey && !e.metaKey) {
			input.focus();
		}
	});
</script>

<style>
	.search-container {
		position: relative;
		width: 100%;
		max-width: 500px;
		margin: 2rem auto 2.5rem;
	}

	.search-input-wrapper {
		position: relative;
		display: flex;
		align-items: center;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		color: var(--text-muted);
		pointer-events: none;
		transition: color 0.2s ease;
	}

	.search-input {
		width: 100%;
		padding: 0.875rem 2.75rem 0.875rem 2.75rem;
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.9rem;
		color: var(--text-primary);
		background: var(--terminal-bg-dark);
		border: 1px solid var(--terminal-border);
		border-radius: 8px;
		outline: none;
		transition: all 0.2s ease;
	}

	.search-input::placeholder {
		color: var(--text-muted);
	}

	.search-input:focus {
		border-color: var(--status-cyan);
		box-shadow: 0 0 0 2px rgba(88, 166, 255, 0.1);
	}

	.search-input-wrapper:has(.search-input:focus) .search-icon {
		color: var(--status-cyan);
	}

	.search-clear {
		position: absolute;
		right: 0.75rem;
		padding: 0.4rem;
		background: none;
		border: none;
		color: var(--text-muted);
		cursor: pointer;
		border-radius: 4px;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}

	.search-clear:hover {
		color: var(--text-primary);
		background: var(--terminal-border);
	}

	.search-results {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 0;
		right: 0;
		background: var(--terminal-bg-dark);
		border: 1px solid var(--terminal-border);
		border-radius: 8px;
		overflow: hidden;
		z-index: 100;
		box-shadow: 0 8px 32px rgba(0, 0, 0, 0.5);
		max-height: 70vh;
		overflow-y: auto;
	}

	.search-result-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.625rem 1rem;
		text-decoration: none;
		color: var(--text-primary);
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.9rem;
		font-weight: 500;
		line-height: 1.4;
		transition: background 0.15s ease;
		border-bottom: 1px solid var(--terminal-border);
		border-left: 3px solid var(--tag-color);
	}

	.search-result-item:last-child {
		border-bottom: none;
	}

	.search-result-item:hover,
	.search-result-item:focus {
		background: rgba(88, 166, 255, 0.1);
		outline: none;
	}

	.search-result-thumb {
		width: 40px;
		height: 40px;
		border-radius: 4px;
		object-fit: cover;
		flex-shrink: 0;
		background: var(--terminal-border);
	}

	.search-result-thumb-placeholder {
		background: linear-gradient(135deg, var(--terminal-border) 0%, var(--editor-bg) 100%);
	}

	.search-result-title {
		flex: 1;
		min-width: 0;
	}

	.search-result-item mark {
		background: rgba(88, 166, 255, 0.3);
		color: var(--cyan);
		border-radius: 2px;
		padding: 0 3px;
	}

	.no-results {
		padding: 1rem;
		text-align: left;
		color: var(--text-muted);
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.85rem;
	}

	/* Mobile optimizations */
	@media (max-width: 720px) {
		.search-container {
			max-width: 100%;
			margin: 1.5rem auto 2rem;
		}

		.search-input {
			font-size: 16px; /* Prevents zoom on iOS */
		}

		.search-results {
			max-height: 60vh;
		}

		.search-result-item {
			padding: 0.5rem 0.75rem;
			font-size: 0.85rem;
			gap: 0.5rem;
		}

		.search-result-thumb {
			width: 32px;
			height: 32px;
		}
	}
</style>
