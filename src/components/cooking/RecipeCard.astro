---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  index?: number;
  /** Larger tile for editorial rhythm */
  wide?: boolean;
}

const { post, index = 0, wide = false } = Astro.props;
const { title, description, heroImage, prepTime, cookTime, subcategory } = post.data;
const totalTime = (prepTime || 0) + (cookTime || 0);

// Stable, valid custom-ident for the View Transitions filter morph.
const vtName = 'dish-' + post.id.replace(/[^a-zA-Z0-9]/g, '-');
---

<a
  href={`/blog/${post.id}/`}
  class:list={['dish', { 'dish--wide': wide, 'dish--noimg': !heroImage }]}
  data-sub={subcategory || 'other'}
  style={`--i:${index}; view-transition-name:${vtName};`}
>
  <figure class="dish__figure">
    {heroImage ? (
      <img src={heroImage} alt={`${title} — from the Mager kitchen`} loading="lazy" decoding="async" />
    ) : (
      <div class="dish__noimg-art" aria-hidden="true">
        <span class="dish__noimg-word">{title}</span>
      </div>
    )}
    <div class="dish__scrim"></div>
    {subcategory && <span class="dish__tag">{subcategory}</span>}
  </figure>

  <div class="dish__body">
    <h3 class="dish__title">{title}</h3>
    {description && <p class="dish__desc">{description}</p>}
    <div class="dish__meta">
      {totalTime > 0 && (
        <span class="dish__time">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          {totalTime} min
        </span>
      )}
      <span class="dish__date"><FormattedDate date={post.data.pubDate} /></span>
    </div>
  </div>
</a>

<style>
  .dish {
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: var(--k-ink);
    background: var(--k-bg-2);
    border: 1px solid var(--k-line);
    border-radius: 14px;
    overflow: hidden;
    transition:
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.4s ease,
      box-shadow 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  /* Scroll reveal: visible by default, transform applied only while "armed". */
  .dish.reveal { opacity: 0; transform: translateY(26px); }
  .dish.reveal.shown {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 45ms),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i, 0) * 45ms);
  }

  .dish:hover {
    transform: translateY(-5px);
    border-color: color-mix(in oklch, var(--k-terra) 55%, var(--k-line));
    box-shadow:
      0 18px 40px -18px rgba(0, 0, 0, 0.7),
      0 0 0 1px color-mix(in oklch, var(--k-terra) 22%, transparent),
      0 22px 70px -30px var(--k-ember);
  }

  .dish:focus-visible {
    outline: 2px solid var(--k-saffron);
    outline-offset: 3px;
  }

  /* ── Figure ── */
  .dish__figure {
    position: relative;
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--k-bg-3);
  }

  .dish--wide .dish__figure { aspect-ratio: 16 / 10; }

  .dish__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    filter: saturate(1.04) contrast(1.02) brightness(0.94);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1), filter 0.55s ease;
  }

  .dish:hover .dish__figure img {
    transform: scale(1.055);
    filter: saturate(1.12) contrast(1.04) brightness(1.02);
  }

  .dish__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0) 40%,
      color-mix(in oklch, var(--k-bg) 30%, transparent) 78%,
      color-mix(in oklch, var(--k-bg) 70%, transparent) 100%
    );
    pointer-events: none;
  }

  .dish__tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--k-ink);
    background: color-mix(in oklch, var(--k-bg) 62%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid color-mix(in oklch, var(--k-ink) 18%, transparent);
    padding: 0.28rem 0.6rem;
    border-radius: 999px;
  }

  /* No-image typographic tile */
  .dish__noimg-art {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    background:
      radial-gradient(120% 120% at 30% 20%, color-mix(in oklch, var(--k-ember) 38%, var(--k-bg-2)) 0%, var(--k-bg-2) 70%),
      var(--k-bg-2);
  }

  .dish__noimg-word {
    font-family: 'Spectral', Georgia, serif;
    font-weight: 600;
    font-style: italic;
    font-size: clamp(1.3rem, 3.4vw, 1.9rem);
    line-height: 1.1;
    color: color-mix(in oklch, var(--k-saffron) 88%, white);
    text-wrap: balance;
  }

  /* ── Body ── */
  .dish__body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.05rem 1.15rem 1.15rem;
    flex: 1;
  }

  .dish__title {
    font-family: 'Spectral', Georgia, serif;
    font-weight: 600;
    font-size: 1.22rem;
    line-height: 1.18;
    letter-spacing: -0.005em;
    color: var(--k-ink);
    margin: 0;
    transition: color 0.3s ease;
    text-wrap: balance;
  }

  .dish--wide .dish__title { font-size: 1.5rem; }

  .dish:hover .dish__title { color: var(--k-saffron); }

  .dish__desc {
    font-family: 'Spectral', Georgia, serif;
    font-size: 0.92rem;
    font-style: italic;
    line-height: 1.5;
    color: var(--k-ink-2);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dish--wide .dish__desc { -webkit-line-clamp: 3; }

  .dish__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.7rem;
    border-top: 1px solid var(--k-line);
    font-family: 'Bricolage Grotesque', sans-serif;
  }

  .dish__time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--k-terra-2);
  }

  .dish__date {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--k-ink-3);
  }

  @media (max-width: 640px) {
    .dish__title { font-size: 1.12rem; }
    .dish--wide .dish__title { font-size: 1.3rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .dish, .dish__figure img, .dish__title { transition: none; }
    .dish.reveal { opacity: 1; transform: none; }
    .dish:hover { transform: none; }
    .dish:hover .dish__figure img { transform: none; }
  }
</style>
