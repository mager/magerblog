---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const { title, description, heroImage, prepTime, cookTime, subcategory } = post.data;
const totalTime = (prepTime || 0) + (cookTime || 0);
---

<a
  href={`/blog/${post.id}/`}
  class={`recipe-card ${featured ? 'featured' : ''}`}
  data-subcategory={subcategory || ''}
  style={`animation-delay: ${index * 0.06}s`}
>
  <div class="card-image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="card-placeholder">
        <span>🍽</span>
      </div>
    )}
  </div>

  <div class="card-content">
    {subcategory && (
      <p class="card-category-label">{subcategory}</p>
    )}
    <h3 class="card-title">{title}</h3>
    {description && (
      <p class="card-description">{description}</p>
    )}
    <div class="card-footer">
      {totalTime > 0 && (
        <span class="card-time">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {totalTime} min
        </span>
      )}
      <span class="card-date">
        <FormattedDate date={post.data.pubDate} />
      </span>
    </div>
  </div>
</a>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    background: var(--ck-bg-card);
    border: 1px solid var(--ck-border);
    border-radius: 4px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    position: relative;
    transition: box-shadow 0.25s ease, border-color 0.25s ease;
    animation: ck-fadeUp 0.5s ease both;
  }

  .recipe-card:hover {
    box-shadow: var(--ck-shadow-lg);
    border-color: rgba(208, 2, 27, 0.2);
  }

  .recipe-card.featured {
    grid-column: 1 / -1;
  }

  /* ── Image ── */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ck-bg-surface);
  }

  .recipe-card.featured .card-image {
    aspect-ratio: 16 / 7;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    transition: transform 0.5s ease;
    display: block;
  }

  .recipe-card:hover .card-image img {
    transform: scale(1.03);
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ck-bg-surface);
    font-size: 2.5rem;
    opacity: 0.4;
  }

  /* ── Content ── */
  .card-content {
    padding: 1.25rem 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .card-category-label {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ck-gold);
    margin: 0;
  }

  .card-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ck-text);
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.2s ease;
  }

  .recipe-card.featured .card-title {
    font-size: 1.6rem;
  }

  .recipe-card:hover .card-title {
    color: var(--ck-gold);
  }

  .card-description {
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ck-text-secondary);
    line-height: 1.55;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe-card.featured .card-description {
    -webkit-line-clamp: 3;
    font-size: 0.95rem;
  }

  /* ── Footer ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ck-border);
  }

  .card-time {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--ck-gold);
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .card-date {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.7rem;
    color: var(--ck-text-muted);
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .card-content {
      padding: 1rem;
    }

    .card-title {
      font-size: 1.05rem;
    }

    .recipe-card.featured .card-title {
      font-size: 1.3rem;
    }

    .recipe-card.featured .card-image {
      aspect-ratio: 4 / 3;
    }
  }
</style>
