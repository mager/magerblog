---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, heroImage, prepTime, cookTime, subcategory } = post.data;
const totalTime = (prepTime || 0) + (cookTime || 0);
---

<a href={`/blog/${post.id}/`} class:list={['recipe', { 'recipe--noimg': !heroImage }]} data-sub={subcategory || 'other'}>
  <figure class="recipe__figure">
    {heroImage ? (
      <img src={heroImage} alt={`${title} — from the Mager kitchen`} loading="lazy" decoding="async" />
    ) : (
      <div class="recipe__placeholder" aria-hidden="true">
        <span>{title}</span>
      </div>
    )}
  </figure>

  <div class="recipe__body">
    {subcategory && <span class="recipe__kicker">{subcategory}</span>}
    <h3 class="recipe__title">{title}</h3>
    {description && <p class="recipe__desc">{description}</p>}
    <div class="recipe__meta">
      {totalTime > 0 && (
        <span class="recipe__time">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M12 7v5l3 2"></path>
          </svg>
          {totalTime} min
        </span>
      )}
      <span class="recipe__date"><FormattedDate date={post.data.pubDate} /></span>
    </div>
  </div>
</a>

<style>
  .recipe {
    display: flex;
    flex-direction: column;
    text-decoration: none !important;
    color: var(--ck-text);
    background: var(--ck-bg-card);
  }

  /* ── Figure ── */
  .recipe__figure {
    position: relative;
    margin: 0 0 1.05rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ck-bg-surface);
    border: 1px solid var(--ck-img-border);
    border-radius: 3px;
  }

  .recipe__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .recipe:hover .recipe__figure img,
  .recipe:focus-visible .recipe__figure img {
    transform: scale(1.04);
  }

  .recipe__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    background: var(--ck-bg-surface);
  }

  .recipe__placeholder span {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: clamp(1.2rem, 3vw, 1.6rem);
    line-height: 1.15;
    color: var(--ck-text-muted);
    text-wrap: balance;
  }

  /* ── Body ── */
  .recipe__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .recipe__kicker {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ck-gold);
  }

  .recipe__title {
    font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.4rem;
    line-height: 1.14;
    letter-spacing: -0.01em;
    color: var(--ck-text);
    margin: 0;
    transition: color 0.2s ease;
    text-wrap: balance;
  }

  .recipe:hover .recipe__title,
  .recipe:focus-visible .recipe__title {
    color: var(--ck-gold);
  }

  .recipe__desc {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ck-text-secondary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe__meta {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-top: 0.35rem;
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.74rem;
    letter-spacing: 0.02em;
    color: var(--ck-text-muted);
  }

  .recipe__time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    color: var(--ck-text-secondary);
  }

  .recipe__time::after {
    content: '';
    display: inline-block;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--ck-text-muted);
    margin-left: 0.55rem;
    opacity: 0.6;
  }

  .recipe__date {
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .recipe__figure img { transition: none; }
    .recipe:hover .recipe__figure img { transform: none; }
  }
</style>
