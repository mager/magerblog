---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
  featured?: boolean;
  index?: number;
}

const { post, featured = false, index = 0 } = Astro.props;
const { title, description, heroImage, prepTime, cookTime, subcategory, tags } = post.data;
const totalTime = (prepTime || 0) + (cookTime || 0);
---

<a
  href={`/blog/${post.id}/`}
  class={`recipe-card ${featured ? 'featured' : ''}`}
  data-subcategory={subcategory || ''}
  style={`animation-delay: ${index * 0.08}s`}
>
  <div class="card-image">
    {heroImage ? (
      <img src={heroImage} alt={title} loading="lazy" />
    ) : (
      <div class="card-placeholder">
        <span>🍽</span>
      </div>
    )}
    <div class="card-image-overlay"></div>
    {subcategory && (
      <span class="card-category">{subcategory}</span>
    )}
  </div>

  <div class="card-content">
    <h3 class="card-title">{title}</h3>

    <p class="card-description">{description}</p>

    <div class="card-footer">
      {totalTime > 0 && (
        <span class="card-time">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 6 12 12 16 14"></polyline>
          </svg>
          {totalTime} min
        </span>
      )}
      <span class="card-date">
        <FormattedDate date={post.data.pubDate} />
      </span>
    </div>
  </div>
</a>

<style>
  .recipe-card {
    display: flex;
    flex-direction: column;
    background: var(--ck-bg-card);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none !important;
    color: inherit;
    border: 1px solid var(--ck-border);
    position: relative;
    transition: all 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    box-shadow: var(--ck-shadow);
    animation: ck-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .recipe-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--ck-shadow-lg), 0 0 0 1px var(--ck-border-gold);
    border-color: var(--ck-border-gold);
  }

  .recipe-card.featured {
    grid-column: 1 / -1;
  }

  /* ── Image ── */
  .card-image {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .recipe-card.featured .card-image {
    aspect-ratio: 21 / 9;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    border-radius: 0;
  }

  .recipe-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      var(--ck-overlay-end) 0%,
      transparent 50%
    );
    pointer-events: none;
    opacity: 0.4;
    transition: opacity 0.4s ease;
  }

  .recipe-card:hover .card-image-overlay {
    opacity: 0.2;
  }

  .card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ck-bg-surface);
    font-size: 3rem;
    opacity: 0.4;
  }

  .card-category {
    position: absolute;
    top: 1rem;
    left: 1rem;
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ck-gold);
    background: var(--ck-badge-bg);
    border: 1px solid var(--ck-badge-border);
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    backdrop-filter: blur(8px);
    z-index: 2;
  }

  /* ── Content ── */
  .card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .card-title {
    font-family: 'Playfair Display', 'Georgia', serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--ck-text);
    margin: 0;
    letter-spacing: -0.01em;
    transition: color 0.3s ease;
  }

  .recipe-card.featured .card-title {
    font-size: 2rem;
  }

  .recipe-card:hover .card-title {
    color: var(--ck-gold);
  }

  .card-description {
    font-family: 'Lora', 'Georgia', serif;
    font-size: 0.9rem;
    color: var(--ck-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe-card.featured .card-description {
    -webkit-line-clamp: 3;
    font-size: 1rem;
  }

  /* ── Footer ── */
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--ck-border);
  }

  .card-time {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ck-gold);
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-time svg {
    opacity: 0.7;
  }

  .card-date {
    font-family: 'DM Sans', -apple-system, sans-serif;
    font-size: 0.72rem;
    color: var(--ck-text-muted);
    letter-spacing: 0.02em;
  }

  /* ── Responsive ── */
  @media (max-width: 720px) {
    .card-content {
      padding: 1.25rem;
    }

    .card-title {
      font-size: 1.15rem;
    }

    .recipe-card.featured .card-title {
      font-size: 1.5rem;
    }

    .recipe-card.featured .card-image {
      aspect-ratio: 16 / 10;
    }

    .card-description {
      font-size: 0.85rem;
      -webkit-line-clamp: 2;
    }
  }
</style>
