---
import '../../styles/photo-viewer.css';
---
<recipe-photo-viewer>
  <dialog id="recipe-photo-dialog" class="photo-viewer" aria-label="Recipe photo viewer" aria-modal="true">
    <button class="photo-viewer-close" type="button" aria-label="Close photo" autofocus>
      <span>Close</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
    <figure>
      <img class="photo-viewer-image" alt="" decoding="async" hidden />
      <figcaption class="photo-viewer-caption" aria-hidden="true"></figcaption>
      <p class="photo-viewer-status" role="status" hidden></p>
      <a class="photo-viewer-original" hidden>Open original photo</a>
    </figure>
  </dialog>
</recipe-photo-viewer>
<script>import '../../scripts/photo-viewer';</script>
