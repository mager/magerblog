---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import Tags from './Tags.astro';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;

// Category config for styling
const categoryConfig: Record<string, { color: string; label: string }> = {
	code: { color: 'var(--status-purple)', label: 'code' },
	life: { color: 'var(--status-green)', label: 'life' },
	food: { color: 'var(--status-orange)', label: 'recipes' },
};

const config = categoryConfig[post.data.category || 'code'] || categoryConfig.code;
const hasImage = !!post.data.heroImage;
---

<a href={`/blog/${post.id}/`} class={`card ${hasImage ? 'has-image' : 'no-image'}`} data-category={post.data.category}>
	<!-- Hero Image - Full Bleed -->
	{post.data.heroImage && (
		<div class="image-container">
			<img src={post.data.heroImage} alt="" loading="lazy" />
			<div class="image-overlay"></div>
		</div>
	)}

	<!-- Content -->
	<div class="content">
		<!-- Category Tag -->
		<div class="meta-row">
			<span class="category-tag" style={`--tag-color: ${config.color};`}>
				{config.label}
			</span>
			<span class="date">
				<FormattedDate date={post.data.pubDate} />
			</span>
		</div>

		<!-- Title -->
		<h3 class="title">{post.data.title}</h3>

		<!-- Description -->
		<p class="description">{post.data.description}</p>

		<!-- Tags -->
		{post.data.tags && post.data.tags.length > 0 && (
			<Tags tags={post.data.tags} size="small" />
		)}

		<!-- Recipe Meta -->
		{(post.data.prepTime || post.data.cookTime) && (
			<div class="recipe-meta">
				{post.data.prepTime && (
					<span class="time-badge">
						<span class="time-icon">prep</span>
						{post.data.prepTime}m
					</span>
				)}
				{post.data.cookTime && (
					<span class="time-badge">
						<span class="time-icon">cook</span>
						{post.data.cookTime}m
					</span>
				)}
			</div>
		)}
	</div>
</a>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--editor-bg-light);
		border-radius: 16px;
		overflow: hidden;
		text-decoration: none;
		color: inherit;
		border: 1px solid var(--terminal-border);
		position: relative;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
	}

	/* Category-specific glow on hover */
	.card[data-category="code"] { --glow-color: var(--status-purple); }
	.card[data-category="life"] { --glow-color: var(--status-green); }
	.card[data-category="food"] { --glow-color: var(--status-orange); }

	.card:hover {
		transform: translateY(-6px);
		box-shadow:
			0 12px 40px rgba(0, 0, 0, 0.4),
			0 0 40px -10px var(--glow-color, var(--status-purple));
		border-color: var(--glow-color, var(--status-purple));
	}

	/* Image Container - Full Showcase */
	.image-container {
		position: relative;
		width: 100%;
		aspect-ratio: 16 / 10;
		overflow: hidden;
	}

	.image-container img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.card:hover .image-container img {
		transform: scale(1.05);
	}

	/* Subtle gradient overlay at bottom of image */
	.image-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 60%;
		background: linear-gradient(
			to top,
			var(--editor-bg-light) 0%,
			rgba(22, 27, 34, 0.6) 40%,
			transparent 100%
		);
		pointer-events: none;
	}

	/* No-image variant */
	.card.no-image {
		background: linear-gradient(
			145deg,
			var(--editor-bg-light) 0%,
			var(--terminal-bg-dark) 100%
		);
	}

	.card.no-image::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 4px;
		background: var(--glow-color, var(--status-purple));
		opacity: 0.6;
	}

	/* Content */
	.content {
		padding: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		flex: 1;
	}

	.has-image .content {
		margin-top: -2rem;
		position: relative;
		z-index: 2;
	}

	/* Meta Row */
	.meta-row {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.category-tag {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.7rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		color: var(--tag-color);
		padding: 0.3rem 0.6rem;
		background: color-mix(in srgb, var(--tag-color) 15%, transparent);
		border: 1px solid color-mix(in srgb, var(--tag-color) 30%, transparent);
		border-radius: 4px;
	}

	.date {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.75rem;
		color: var(--text-muted);
	}

	/* Title */
	.title {
		margin: 0;
		font-size: 1.4rem;
		font-weight: 700;
		line-height: 1.3;
		color: var(--text-primary);
		transition: color 0.2s ease;
	}

	.card:hover .title {
		color: var(--glow-color, var(--cyan));
	}

	/* Description */
	.description {
		margin: 0;
		font-size: 0.95rem;
		color: var(--text-secondary);
		line-height: 1.6;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* Recipe Meta */
	.recipe-meta {
		display: flex;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.time-badge {
		font-family: 'JetBrains Mono', 'Fira Code', monospace;
		font-size: 0.7rem;
		color: var(--text-secondary);
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.25rem 0.5rem;
		background: var(--terminal-bg-dark);
		border-radius: 4px;
	}

	.time-icon {
		color: var(--status-orange);
		font-weight: 600;
	}

	/* Responsive */
	@media (max-width: 720px) {
		.content {
			padding: 1.25rem;
		}

		.title {
			font-size: 1.2rem;
		}

		.description {
			font-size: 0.9rem;
			-webkit-line-clamp: 2;
		}
	}
</style>
