---
import type { FeedEntry } from '../lib/feed';
import SimpleList from './SimpleList.astro';
import SimpleSidebar from './SimpleSidebar.astro';
interface Props { entries: FeedEntry[]; }
const { entries } = Astro.props;
const filters: [string, string][] = [['all', 'All'], ['tech', 'Tech'], ['food', 'Cooking'], ['life', 'Life'], ['notes', 'Notes'], ['links', 'Links'], ['seen', 'Seen']];
---
<section class="simple-home" aria-label="Latest posts">
  <h1 class="simple-intro">Writing, photos, and things I’m making.</h1>
  <div class="simple-columns"><SimpleList entries={entries} filters={filters} /><SimpleSidebar entries={entries} /></div>
</section>
