---
interface Props {
	date: Date | string | undefined;
}

const { date } = Astro.props;

// Ensure we have a valid date
let dateObj: Date | null = null;
if (date instanceof Date) {
	dateObj = date;
} else if (typeof date === 'string') {
	dateObj = new Date(date);
} else if (date) {
	dateObj = new Date(date);
}

// If we still don't have a valid date, return empty
if (!dateObj || isNaN(dateObj.getTime())) {
	return null;
}

// Date-only frontmatter is stored at UTC midnight. Preserve its calendar date;
// timestamped posts use Chicago time so an evening update stays on that day.
const timeZone = dateObj.toISOString().endsWith('T00:00:00.000Z') ? 'UTC' : 'America/Chicago';
---

<time datetime={dateObj.toISOString()}>
	{
		dateObj.toLocaleDateString('en-US', {
			timeZone,
			month: 'long',
			day: 'numeric',
			year: 'numeric',
		})
	}
</time>
