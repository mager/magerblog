---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About — ${SITE_TITLE}`}
			description="Software engineer, home cook, Chicago. I build things with AI, write about it, and cook dinner."
		/>
		<style>
			body {
				background: #faf8f5;
				color: #1a1a2e;
			}
			main {
				max-width: 720px;
				margin: 0 auto;
				padding: 4rem 2rem 6rem;
			}

			/* ── Page header ──────────────────────────────── */
			.about-eyebrow {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				color: #9ca3af;
				margin: 0 0 1rem;
			}

			.about-headline {
				font-family: 'Fraunces', serif;
				font-weight: 800;
				font-style: italic;
				font-variation-settings: 'opsz' 144, 'SOFT' 100, 'WONK' 1;
				font-size: clamp(2.2rem, 5vw, 3.5rem);
				line-height: 1.08;
				letter-spacing: -0.02em;
				color: #111;
				margin: 0 0 2.5rem;
			}
			.about-headline em {
				color: #6366f1;
				font-style: italic;
			}

			/* ── Photo ────────────────────────────────────── */
			.about-photo-wrap {
				margin: 0 0 2.5rem;
				border-radius: 20px;
				overflow: hidden;
				aspect-ratio: 4 / 3;
				background: linear-gradient(135deg, #e0e7ff, #ccfbf1);
			}
			.about-photo {
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 20%;
				display: block;
				transition: transform 0.6s ease;
			}
			.about-photo-wrap:hover .about-photo {
				transform: scale(1.02);
			}

			/* ── Body copy ────────────────────────────────── */
			.about-body {
				font-family: 'Atkinson Hyperlegible', 'Atkinson', sans-serif;
				font-size: 1.05rem;
				line-height: 1.75;
				color: #374151;
			}
			.about-body p {
				margin: 0 0 1.4rem;
			}
			.about-body p:last-child {
				margin-bottom: 0;
			}
			.about-body a {
				color: #6366f1;
				text-decoration: underline;
				text-decoration-color: rgba(99,102,241,0.3);
				text-underline-offset: 3px;
				transition: text-decoration-color 0.2s ease;
			}
			.about-body a:hover {
				text-decoration-color: #6366f1;
			}

			/* ── Divider ──────────────────────────────────── */
			.about-divider {
				width: 40px;
				height: 3px;
				border-radius: 2px;
				background: linear-gradient(90deg, #6366f1, #14b8a6);
				margin: 2rem 0;
				border: none;
			}

			/* ── Chips ────────────────────────────────────── */
			.chips {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin: 1.5rem 0 0;
			}
			.chip {
				font-family: 'Space Grotesk', sans-serif;
				font-size: 0.8rem;
				font-weight: 600;
				padding: 0.3rem 0.75rem;
				border-radius: 999px;
				background: rgba(99,102,241,0.08);
				color: #6366f1;
				border: 1px solid rgba(99,102,241,0.15);
			}
			.chip.teal {
				background: rgba(20,184,166,0.08);
				color: #0d9488;
				border-color: rgba(20,184,166,0.15);
			}
			.chip.amber {
				background: rgba(245,158,11,0.08);
				color: #d97706;
				border-color: rgba(245,158,11,0.15);
			}

			/* ── Projects grid ────────────────────────────── */
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.65rem;
				color: #6366f1;
				margin-top: 0.15rem;
			}

			/* ── Links row ────────────────────────────────── */
			.about-links {
				display: flex;
				gap: 0.75rem;
				flex-wrap: wrap;
				margin-top: 2.5rem;
			}
			.about-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: 'Space Grotesk', sans-serif;
				font-size: 0.88rem;
				font-weight: 600;
				text-decoration: none;
				padding: 0.5rem 1.1rem;
				border-radius: 999px;
				border: 1.5px solid rgba(99,102,241,0.25);
				color: #6366f1;
				background: rgba(99,102,241,0.05);
				transition: all 0.2s ease;
			}
			.about-link:hover {
				background: rgba(99,102,241,0.1);
				border-color: rgba(99,102,241,0.45);
				transform: translateY(-1px);
			}
			.about-link.gh {
				color: #1a1a2e;
				border-color: rgba(26,26,46,0.2);
				background: rgba(26,26,46,0.04);
			}
			.about-link.gh:hover {
				background: rgba(26,26,46,0.08);
				border-color: rgba(26,26,46,0.35);
			}

			@media (max-width: 600px) {
				main {
					padding: 2rem 1.25rem calc(80px + 2rem);
				}
				.about-headline { font-size: 1.9rem; }
				.about-photo-wrap { aspect-ratio: 1 / 1; border-radius: 14px; }
				.about-body { font-size: 0.97rem; }
