---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import NewspaperHero from '../components/NewspaperHero.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get all non-draft posts. The homepage is the English front page, so drop
// Japanese translations (locale: 'ja') — they live on their own post pages and
// share a translationKey with the English version. This prevents the same post
// showing up twice (e.g. the sumo / Hanshin Tigers EN + JA pairs).
const allPosts = (await getCollection('blog'))
	.filter(post => !post.data.draft)
	.filter(post => post.data.locale !== 'ja');

// Helper to get the most recent date (updatedDate or pubDate)
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

// Get posts from each category, sorted by date (newest first)
const techPosts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const lifePosts = allPosts
	.filter(post => post.data.category === 'life')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const recipePosts = allPosts
	.filter(post => post.data.category === 'food')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

// OG image: use first available hero image across categories
const ogImage =
	techPosts.find(p => p.data.heroImage)?.data.heroImage ||
	lifePosts.find(p => p.data.heroImage)?.data.heroImage ||
	recipePosts.find(p => p.data.heroImage)?.data.heroImage ||
	'/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			body {
				background-color: #faf8f5;
				overflow-x: hidden;
				color: #0a0a0a;
			}

			/* Full-bleed override */
			main {
				max-width: 100%;
				width: 100%;
				padding: 0;
				margin: 0;
				position: relative;
				z-index: 1;
			}
		</style>
	</head>
	<body>
		<main>
			<NewspaperHero
				techPosts={techPosts}
				lifePosts={lifePosts}
				recipePosts={recipePosts}
			/>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
