---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SimpleHome from '../components/SimpleHome.astro';
import { getFeed } from '../lib/feed';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import '../styles/simple.css';
const entries = await getFeed();
const ogImage = entries.find(entry => entry.collection === 'blog' && entry.data.heroImage);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage?.collection === 'blog' ? ogImage.data.heroImage : undefined} /></head>
  <body class="publication simple-page">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header homepage themeToggle />
    <main id="main-content" class="simple-shell"><SimpleHome entries={entries} /></main>
    <Footer homepage />
  </body>
</html>
