---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get latest post from each category
const allPosts = await getCollection('blog');

const latestCode = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const latestLife = allPosts
	.filter(post => post.data.category === 'life')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const latestFood = allPosts
	.filter(post => post.data.category === 'food')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];

const featuredPosts = [latestCode, latestLife, latestFood].filter(Boolean);

// Use the first featured post's hero image for OG image, or fallback to a default
const ogImage = featuredPosts.find(post => post.data.heroImage)?.data.heroImage || '/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			body {
				background-color: var(--editor-bg);
			}

			main {
				width: 1200px;
				padding: 3rem 2rem;
			}

			.page-header {
				text-align: center;
				margin-bottom: 3rem;
			}

			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}

			.page-header h1 {
				font-size: 2.8em;
				margin-bottom: 0.5rem;
				color: var(--text-primary);
				font-weight: 800;
				letter-spacing: -0.03em;
			}

			.page-header h1::after {
				content: '█';
				color: var(--accent-green);
				animation: blink 1s infinite;
				margin-left: 0.25rem;
			}

			.page-header p {
				font-size: 1.15rem;
				color: var(--text-secondary);
				font-family: 'JetBrains Mono', monospace;
			}

			.featured-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
				gap: 2rem;
			}

			@media (max-width: 1200px) {
				.featured-grid {
					grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
				}
			}

			@media (max-width: 720px) {
				.page-header h1 {
					font-size: 1.5em;
				}
				.page-header p {
					font-size: 1rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-header">
					<h1>$ ls -la ~/latest</h1>
					<p>Latest from Code, Life, and Recipes</p>
				</div>
				<div class="featured-grid">
					{
						featuredPosts.map((post) => (
							<Card {post} />
						))
					}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>