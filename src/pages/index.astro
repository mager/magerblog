---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Card from '../components/Card.astro';
import Search from '../components/Search.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get latest 3 posts from each category, sorted by most recent update
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);

// Helper to get the most recent date (updatedDate or pubDate)
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const latestCode = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a))
	.slice(0, 3);

const latestLife = allPosts
	.filter(post => post.data.category === 'life')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a))
	.slice(0, 3);

const latestFood = allPosts
	.filter(post => post.data.category === 'food')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a))
	.slice(0, 3);

const categories = [
	{ name: 'Code', slug: 'code', posts: latestCode, color: 'purple' },
	{ name: 'Life', slug: 'life', posts: latestLife, color: 'green' },
	{ name: 'Recipes', slug: 'recipes', posts: latestFood, color: 'orange' },
];

// Use the first post's hero image for OG image, or fallback to a default
const ogImage = [...latestCode, ...latestLife, ...latestFood].find(post => post?.data.heroImage)?.data.heroImage || '/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			/* Cursor glow effect */
			.cursor-glow {
				position: fixed;
				width: 600px;
				height: 600px;
				border-radius: 50%;
				background: radial-gradient(
					circle,
					rgba(163, 113, 247, 0.05) 0%,
					rgba(88, 166, 255, 0.02) 30%,
					transparent 60%
				);
				pointer-events: none;
				z-index: 0;
				transform: translate(-50%, -50%);
				transition: left 0.2s ease-out, top 0.2s ease-out;
				will-change: left, top;
			}

			body {
				background-color: var(--editor-bg);
				overflow-x: hidden;
			}

			main {
				width: 1200px;
				padding: 3rem 2rem;
				position: relative;
				z-index: 1;
			}

			/* Hero Section */
			.hero-section {
				text-align: center;
				margin-bottom: 4rem;
				padding: 2rem 0;
			}

			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}

			.hero-title {
				font-size: 2.5rem;
				margin-bottom: 1rem;
				color: var(--text-primary);
				font-weight: 700;
				letter-spacing: -0.03em;
			}

			.hero-title .command {
				color: var(--text-muted);
				font-weight: 400;
			}

			.cursor-block {
				display: inline-block;
				width: 0.55em;
				height: 1em;
				background: var(--status-green);
				animation: blink 1s step-end infinite;
				vertical-align: middle;
				margin-left: 0.25rem;
				border-radius: 2px;
			}

			.hero-subtitle {
				font-size: 1.1rem;
				color: var(--text-secondary);
				font-family: 'JetBrains Mono', 'Fira Code', monospace;
				margin: 0;
			}

			/* Status indicators */
			.status-row {
				display: flex;
				justify-content: center;
				gap: 2rem;
				margin-top: 2rem;
				flex-wrap: wrap;
			}

			.status-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-family: 'JetBrains Mono', 'Fira Code', monospace;
				font-size: 0.8rem;
				color: var(--text-muted);
			}

			.status-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
				animation: pulse 2s ease-in-out infinite;
			}

			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.4; }
			}

			.status-dot.purple { background: var(--status-purple); }
			.status-dot.green { background: var(--status-green); }
			.status-dot.orange { background: var(--status-orange); }

			/* Category Columns */
			.category-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 2rem;
			}

			.category-column {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.category-header {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding-bottom: 0.75rem;
				border-bottom: 1px solid var(--terminal-border);
				margin-bottom: 0.5rem;
			}

			.category-header .status-dot {
				width: 8px;
				height: 8px;
				border-radius: 50%;
			}

			.category-header h2 {
				font-family: 'JetBrains Mono', 'Fira Code', monospace;
				font-size: 0.85rem;
				font-weight: 500;
				color: var(--text-muted);
				margin: 0;
				text-transform: lowercase;
			}

			.category-header a {
				margin-left: auto;
				font-family: 'JetBrains Mono', 'Fira Code', monospace;
				font-size: 0.7rem;
				color: var(--text-muted);
				text-decoration: none;
				opacity: 0.6;
				transition: opacity 0.2s ease;
			}

			.category-header a:hover {
				opacity: 1;
			}

			.post-list {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
			}

			.post-item {
				display: flex;
				gap: 0.75rem;
				padding: 0.75rem;
				background: var(--terminal-bg-dark);
				border: 1px solid var(--terminal-border);
				border-radius: 6px;
				text-decoration: none;
				transition: all 0.2s ease;
			}

			.post-item:hover {
				border-color: var(--text-muted);
				background: var(--editor-bg-light);
			}

			.post-item.purple:hover { border-color: var(--status-purple); }
			.post-item.green:hover { border-color: var(--status-green); }
			.post-item.orange:hover { border-color: var(--status-orange); }

			.post-item-thumb {
				width: 48px;
				height: 48px;
				object-fit: cover;
				border-radius: 4px;
				flex-shrink: 0;
				border: 1px solid var(--terminal-border);
			}

			.post-item-content {
				min-width: 0;
				flex: 1;
			}

			.post-item-title {
				font-family: 'JetBrains Mono', 'Fira Code', monospace;
				font-size: 0.85rem;
				font-weight: 500;
				color: var(--text-primary);
				margin: 0 0 0.375rem 0;
				line-height: 1.3;
			}

			.post-item-desc {
				font-size: 0.75rem;
				color: var(--text-muted);
				margin: 0;
				line-height: 1.4;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			@media (max-width: 900px) {
				.category-grid {
					grid-template-columns: 1fr;
					gap: 2.5rem;
				}
			}

			@media (max-width: 720px) {
				main {
					padding: 2rem 1rem;
				}

				.hero-section {
					margin-bottom: 3rem;
					padding: 1rem 0;
				}

				.hero-title {
					font-size: 1.75rem;
				}

				.hero-subtitle {
					font-size: 0.95rem;
				}

				.status-row {
					gap: 1.5rem;
				}

				.cursor-glow {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<!-- Cursor Glow Effect -->
		<div class="cursor-glow" id="cursor-glow"></div>

		<Header />
		<main>
			<!-- Hero Section -->
			<section class="hero-section">
				<h1 class="hero-title">
					<span class="command">$ ls</span> ~/latest<span class="cursor-block"></span>
				</h1>
				<p class="hero-subtitle">Latest from Code, Life, and Recipes</p>

				<div class="status-row">
					<div class="status-item">
						<span class="status-dot purple"></span>
						<span>Code</span>
					</div>
					<div class="status-item">
						<span class="status-dot green"></span>
						<span>Life</span>
					</div>
					<div class="status-item">
						<span class="status-dot orange"></span>
						<span>Recipes</span>
					</div>
				</div>

				<!-- Search -->
				<Search posts={allPosts} placeholder="Search all posts..." />
			</section>

			<!-- Category Columns -->
			<section class="category-grid">
				{categories.map((category) => (
					<div class="category-column">
						<div class="category-header">
							<span class={`status-dot ${category.color}`}></span>
							<h2>{category.name}</h2>
							<a href={`/${category.slug}/`}>view all →</a>
						</div>
						<div class="post-list">
							{category.posts.map((post) => (
								<a href={`/blog/${post.id}/`} class={`post-item ${category.color}`}>
									{post.data.heroImage && (
										<img src={post.data.heroImage} alt="" class="post-item-thumb" />
									)}
									<div class="post-item-content">
										<h3 class="post-item-title">{post.data.title}</h3>
										<p class="post-item-desc">{post.data.description}</p>
									</div>
								</a>
							))}
						</div>
					</div>
				))}
			</section>
		</main>
		<Footer />

		<!-- Cursor Glow Script -->
		<script>
			const glow = document.getElementById('cursor-glow');
			let mouseX = 0;
			let mouseY = 0;
			let currentX = 0;
			let currentY = 0;

			document.addEventListener('mousemove', (e) => {
				mouseX = e.clientX;
				mouseY = e.clientY;
			});

			function animate() {
				currentX += (mouseX - currentX) * 0.1;
				currentY += (mouseY - currentY) * 0.1;

				if (glow) {
					glow.style.left = currentX + 'px';
					glow.style.top = currentY + 'px';
				}

				requestAnimationFrame(animate);
			}

			animate();

			document.addEventListener('mouseleave', () => {
				if (glow) glow.style.opacity = '0';
			});

			document.addEventListener('mouseenter', () => {
				if (glow) glow.style.opacity = '1';
			});
		</script>
	</body>
</html>
