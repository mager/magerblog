---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import NewspaperHero from '../components/NewspaperHero.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// The homepage is one reverse-chronological feed of posts + notes. Drop drafts
// and Japanese translations (locale: 'ja') — they live on their own post pages
// and share a translationKey with the English version, so the EN copy already
// represents them in the stream.
const posts = (await getCollection('blog'))
	.filter(post => !post.data.draft)
	.filter(post => post.data.locale !== 'ja')
	.sort((a, b) => (b.data.updatedDate || b.data.pubDate).valueOf() - (a.data.updatedDate || a.data.pubDate).valueOf());

// Short-form notes, newest first; the component interleaves them with posts.
const notes = (await getCollection('notes'))
	.filter(note => !note.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// OG image: first available hero image in the feed.
const ogImage = posts.find(p => p.data.heroImage)?.data.heroImage || '/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			body {
				background-color: #faf8f5;
				overflow-x: hidden;
				color: #0a0a0a;
			}

			/* Full-bleed override */
			main {
				max-width: 100%;
				width: 100%;
				padding: 0;
				margin: 0;
				position: relative;
				z-index: 1;
			}
		</style>
	</head>
	<body>
		<main>
			<NewspaperHero posts={posts} notes={notes} />
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={posts} />
	</body>
</html>
