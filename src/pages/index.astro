---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BentoHero from '../components/BentoHero.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get all non-draft posts
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);

// Helper to get the most recent date (updatedDate or pubDate)
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

// Get posts from each category, sorted by date (newest first)
const codePosts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const lifePosts = allPosts
	.filter(post => post.data.category === 'life')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const recipePosts = allPosts
	.filter(post => post.data.category === 'food')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

// OG image: use first available hero image across categories
const ogImage =
	codePosts.find(p => p.data.heroImage)?.data.heroImage ||
	lifePosts.find(p => p.data.heroImage)?.data.heroImage ||
	recipePosts.find(p => p.data.heroImage)?.data.heroImage ||
	'/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			body {
				background-color: #030712;
				overflow-x: hidden;
			}

			/* Full-bleed override — let cosmos-page span edge-to-edge */
			main {
				max-width: 100%;
				width: 100%;
				padding: 0;
				margin: 0;
				position: relative;
				z-index: 1;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<BentoHero
				codePosts={codePosts}
				lifePosts={lifePosts}
				recipePosts={recipePosts}
			/>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
