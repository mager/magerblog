---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BentoHero from '../components/BentoHero.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Get all non-draft posts
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);

// Helper to get the most recent date (updatedDate or pubDate)
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

// Get posts from each category, sorted by date
const codePosts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const lifePosts = allPosts
	.filter(post => post.data.category === 'life')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const recipePosts = allPosts
	.filter(post => post.data.category === 'food')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

// Featured posts are the first from each category
const featuredCode = codePosts[0];
const featuredLife = lifePosts[0];
const featuredRecipe = recipePosts[0];

// Use the first post's hero image for OG image
const ogImage = featuredCode?.data.heroImage || featuredLife?.data.heroImage || featuredRecipe?.data.heroImage || '/blog-placeholder-1.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} image={ogImage} />
		<style>
			body {
				background-color: var(--editor-bg);
				overflow-x: hidden;
			}

			main {
				position: relative;
				z-index: 1;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<BentoHero
				featuredCode={featuredCode}
				featuredLife={featuredLife}
				featuredRecipe={featuredRecipe}
				codePosts={codePosts}
				lifePosts={lifePosts}
				recipePosts={recipePosts}
			/>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
