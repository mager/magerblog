---
import { type CollectionEntry, getCollection } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import CookingPost from '../../layouts/CookingPost.astro';
import LifePost from '../../layouts/LifePost.astro';
import AlbumPost from '../../layouts/AlbumPost.astro';
import { render } from 'astro:content';

export async function getStaticPaths() {
	// Drafts have direct previews linked from /drafts, but stay out of discovery.
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
Astro.locals.draft = post.data.draft === true;
const { Content, headings } = await render(post);
const isCooking = post.data.category === 'food';
const isLife = post.data.category === 'life';
---

{isCooking ? (
	<CookingPost {...post.data} postId={post.id}>
		<Content />
	</CookingPost>
) : isLife && post.data.lifeLayout === 'albums' ? (
	<AlbumPost {...post.data}>
		<Content />
	</AlbumPost>
) : isLife ? (
	<LifePost {...post.data} postId={post.id}>
		<Content />
	</LifePost>
) : (
	<BlogPost {...post.data} postId={post.id} headings={headings}>
		<Content />
	</BlogPost>
)}
