---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechPostRow from '../components/tech/TechPostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const posts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const latestIssueDate = featuredPost?.data.updatedDate || featuredPost?.data.pubDate || new Date();
const issueNumber = String(posts.length).padStart(3, '0');

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const postYears = posts.map(post => post.data.pubDate.getFullYear());
const firstYear = postYears.length ? Math.min(...postYears) : latestIssueDate.getFullYear();
const newestYear = postYears.length ? Math.max(...postYears) : latestIssueDate.getFullYear();
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const hasFeaturedImage = !!featuredPost?.data.heroImage;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech - ${SITE_TITLE}`} description="Technical notes from mager.co on AI agents, developer tools, CLIs, personal software, and the workflows that compound." />
		<style>
			body {
				background: oklch(91% 0.008 76);
				color: oklch(18% 0.008 70);
			}

			:global(.site-header.header-light) {
				background: color-mix(in oklch, oklch(91% 0.008 76) 88%, transparent);
				border-bottom: 1px solid oklch(70% 0.006 76);
				--header-text: oklch(18% 0.008 70);
				--header-text-secondary: oklch(36% 0.006 70);
				--header-text-muted: oklch(55% 0.005 70);
				--header-logo-tld: oklch(18% 0.008 70);
				--link-accent-indigo: oklch(18% 0.008 70);
				--link-accent-teal: oklch(18% 0.008 70);
				--link-accent-amber: oklch(18% 0.008 70);
				--link-accent-neutral: oklch(18% 0.008 70);
				--header-social-border: color-mix(in oklch, oklch(18% 0.008 70) 16%, transparent);
				--header-hover-bg: color-mix(in oklch, oklch(18% 0.008 70) 6%, transparent);
			}

			main.tech-page {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				--paper: oklch(91% 0.008 76);
				--paper-quiet: oklch(86.5% 0.008 76);
				--paper-deep: oklch(80% 0.007 76);
				--ink: oklch(18% 0.008 70);
				--ink-soft: oklch(32% 0.007 70);
				--ink-muted: oklch(49% 0.006 70);
				--rule: oklch(69% 0.006 76);
				--rule-strong: oklch(43% 0.006 70);
				--surface: oklch(94% 0.007 76);
				--surface-strong: oklch(96% 0.006 76);
				--font-display: 'Fraunces', Georgia, serif;
				--font-body: 'Source Serif 4', Georgia, serif;
				--font-ui: 'Space Grotesk', system-ui, sans-serif;
				--font-mono: 'JetBrains Mono', monospace;
				min-height: 100vh;
				background:
					linear-gradient(90deg, color-mix(in oklch, var(--rule) 28%, transparent) 1px, transparent 1px),
					linear-gradient(180deg, color-mix(in oklch, var(--ink) 7%, transparent), transparent 26rem),
					var(--paper);
				background-size: 7.25rem 100%, auto, auto;
			}

			.tech-shell {
				width: min(1360px, 100%);
				margin: 0 auto;
				padding: 1.2rem 1.5rem 4rem;
			}

			.dateline,
			.tech-kicker,
			.section-label,
			.story-meta,
			.archive-note,
			.empty-state,
			.issue-mark {
				font-family: var(--font-mono);
			}

			.dateline {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.95rem 0 1.15rem;
				border-bottom: 1px solid var(--rule);
				font-size: 0.78rem;
				color: var(--ink-soft);
			}

			.dateline a {
				color: var(--ink);
				text-decoration: none;
			}

			.dateline a:hover {
				color: var(--ink-soft);
			}

			.dateline-pack,
			.dateline-right,
			.lead-meta-line,
			.archive-actions {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				flex-wrap: wrap;
			}

			.dateline-mark {
				color: var(--ink);
				font-weight: 700;
			}

			.tech-masthead {
				display: grid;
				grid-template-columns: minmax(17rem, 0.78fr) minmax(0, 1.22fr);
				gap: 1.2rem;
				padding: 1.2rem 0;
				border-bottom: 2px solid var(--ink);
			}

			.masthead-copy,
			.lead-story {
				border: 1px solid var(--rule);
				background: color-mix(in oklch, var(--surface) 86%, var(--paper));
			}

			.masthead-copy {
				display: grid;
				align-content: space-between;
				gap: 2rem;
				min-height: 24rem;
				padding: 1rem;
			}

			.tech-kicker {
				margin: 0;
				font-size: 0.78rem;
				font-weight: 700;
				color: var(--ink-soft);
			}

			.masthead-copy h1 {
				margin: 0;
				font-family: var(--font-display);
				font-size: clamp(4rem, 11vw, 8.8rem);
				line-height: 0.82;
				letter-spacing: 0;
				color: var(--ink);
				font-variation-settings: 'opsz' 144, 'wght' 900;
			}

			.masthead-copy p {
				max-width: 38rem;
				margin: 0.9rem 0 0;
				font-family: var(--font-body);
				font-size: clamp(1.15rem, 2vw, 1.55rem);
				line-height: 1.35;
				color: var(--ink-soft);
			}

			.issue-strip {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				border-top: 1px solid var(--rule);
			}

			.issue-mark {
				display: grid;
				gap: 0.2rem;
				padding: 0.75rem 0.65rem 0 0;
				font-size: 0.72rem;
				color: var(--ink-muted);
			}

			.issue-mark strong {
				font-family: var(--font-ui);
				font-size: 1.25rem;
				line-height: 1;
				color: var(--ink);
			}

			.lead-story {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(13rem, 0.36fr);
				color: inherit;
				text-decoration: none;
				transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background 180ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			.lead-story:hover {
				transform: translateY(-2px);
				background: var(--surface-strong);
			}

			.lead-copy {
				display: grid;
				align-content: end;
				padding: clamp(1rem, 3vw, 2rem);
			}

			.section-label {
				display: block;
				margin-bottom: 0.45rem;
				font-size: 0.75rem;
				color: var(--ink-soft);
				font-weight: 700;
			}

			.lead-copy h2 {
				max-width: 58rem;
				margin: 0;
				font-family: var(--font-display);
				font-size: clamp(2.4rem, 5vw, 4.8rem);
				line-height: 0.96;
				letter-spacing: 0;
				color: var(--ink);
				font-variation-settings: 'opsz' 120, 'wght' 860;
			}

			.lead-copy p {
				max-width: 68ch;
				margin: 0.95rem 0 0;
				font-family: var(--font-body);
				font-size: clamp(1.05rem, 1.6vw, 1.28rem);
				line-height: 1.5;
				color: var(--ink-soft);
			}

			.lead-meta {
				display: grid;
				align-content: space-between;
				gap: 1rem;
				padding: 1rem;
				border-left: 1px solid var(--rule);
				background: var(--paper-quiet);
			}

			.story-meta,
			.archive-note {
				font-size: 0.74rem;
				color: var(--ink-soft);
			}

			.tag-stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag-stack span,
			.archive-note {
				display: inline-flex;
				align-items: center;
				border: 1px solid var(--rule-strong);
				background: color-mix(in oklch, var(--paper-quiet) 88%, var(--surface));
				color: var(--ink-soft);
				padding: 0.36rem 0.48rem;
				font-size: 0.72rem;
				line-height: 1;
			}

			.lead-image {
				display: block;
				aspect-ratio: 4 / 3;
				border: 1px solid var(--rule);
				overflow: hidden;
				background: var(--paper-deep);
			}

			.lead-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: grayscale(1) contrast(1.08);
			}

			.archive-board {
				margin-top: 1.2rem;
				border: 1px solid var(--rule);
				background: color-mix(in oklch, var(--surface) 82%, var(--paper));
			}

			.archive-head {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem;
				border-bottom: 1px solid var(--rule);
			}

			.archive-head h2 {
				margin: 0;
				font-family: var(--font-ui);
				font-size: 1.15rem;
				line-height: 1.1;
				letter-spacing: 0;
				color: var(--ink);
			}

			.archive-head p {
				max-width: 56ch;
				margin: 0.45rem 0 0;
				font-family: var(--font-body);
				font-size: 1rem;
				line-height: 1.45;
				color: var(--ink-soft);
			}

			.archive-list {
				list-style: none;
				margin: 0;
				padding: 0 1rem;
			}

			.archive-actions {
				justify-content: flex-end;
			}

			.empty-state {
				margin: 0;
				padding: 1rem 0;
				color: var(--ink-muted);
			}

			@media (prefers-reduced-motion: reduce) {
				.lead-story,
				:global(.tech-row) {
					transition: none;
				}

				.lead-story:hover,
				:global(.tech-row:hover) {
					transform: none;
				}
			}

			@media (max-width: 1040px) {
				.tech-masthead,
				.lead-story {
					grid-template-columns: 1fr;
				}

				.masthead-copy {
					min-height: 0;
				}

				.lead-meta {
					border-left: none;
					border-top: 1px solid var(--rule);
				}
			}

			@media (max-width: 760px) {
				main.tech-page {
					background-size: 4.5rem 100%, auto, auto;
				}

				.tech-shell {
					padding: 0.8rem 0.85rem 2.8rem;
				}

				.dateline,
				.archive-head {
					align-items: flex-start;
					flex-direction: column;
				}

				.dateline {
					gap: 0.45rem;
					font-size: 0.72rem;
				}

				.tech-masthead {
					gap: 0.85rem;
					padding-top: 0.9rem;
				}

				.masthead-copy {
					padding: 0.9rem;
				}

				.issue-strip {
					grid-template-columns: 1fr;
					gap: 0.55rem;
					padding-top: 0.75rem;
				}

				.issue-mark {
					padding: 0;
				}

				.lead-copy {
					padding: 1rem;
				}

				.archive-list {
					padding: 0 0.85rem;
				}

				.archive-actions {
					justify-content: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main class="tech-page">
			<div class="tech-shell">
				<div class="dateline" aria-label="Tech page metadata">
					<div class="dateline-pack">
						<a href="/">mager.co</a>
						<span class="dateline-mark">/</span>
						<span>tech</span>
					</div>
					<div class="dateline-right">
						<span>{fullDate}</span>
						<span class="dateline-mark">issue {issueNumber}</span>
						<span>{firstYear} to {newestYear}</span>
					</div>
				</div>

				<div class="tech-masthead">
					<section class="masthead-copy" aria-labelledby="tech-title">
						<div>
							<p class="tech-kicker">field notes from the workbench</p>
							<h1 id="tech-title">Tech</h1>
							<p>Agent systems, dev tools, CLIs, and the small pieces of software that keep turning into bigger ideas.</p>
						</div>
						<div class="issue-strip" aria-label="Tech section summary">
							<span class="issue-mark"><strong>{posts.length}</strong>posts</span>
							<span class="issue-mark"><strong>{issueNumber}</strong>current issue</span>
							<span class="issue-mark"><strong>{archivePosts.length}</strong>archive rows</span>
						</div>
					</section>

					{featuredPost && (
						<a href={leadHref} class="lead-story">
							<div class="lead-copy">
								<span class="section-label">Lead story</span>
								<h2>{featuredPost.data.title}</h2>
								<p>{featuredPost.data.description}</p>
							</div>
							<div class="lead-meta">
								<div class="lead-meta-line">
									<span class="story-meta">{shortDate(featuredPost.data.pubDate)}</span>
									<span class="archive-note">latest</span>
								</div>
								{hasFeaturedImage && (
									<span class="lead-image" aria-hidden="true">
										<img src={featuredPost.data.heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
									</span>
								)}
								<div class="tag-stack">
									{leadTags.map(tag => <span>{tag}</span>)}
								</div>
							</div>
						</a>
					)}
				</div>

				<section class="archive-board" aria-labelledby="archive-heading">
					<header class="archive-head">
						<div>
							<span class="section-label">Archive</span>
							<h2 id="archive-heading">Build log</h2>
							<p>Newest first. Dates, titles, summaries, and tags stay visible so the index works even when you are just scanning.</p>
						</div>
						<div class="archive-actions">
							<span class="archive-note">newest first</span>
							<span class="archive-note">{archivePosts.length} notes</span>
						</div>
					</header>
					<ul class="archive-list">
						{archivePosts.length > 0
							? archivePosts.map((post) => <TechPostRow post={post} />)
							: <p class="empty-state">No tech posts yet.</p>}
					</ul>
				</section>
			</div>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
