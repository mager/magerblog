---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechPostRow from '../components/tech/TechPostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const posts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const latestIssueDate = featuredPost?.data.updatedDate || featuredPost?.data.pubDate || new Date();

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const postYears = posts.map(post => post.data.pubDate.getFullYear());
const firstYear = postYears.length ? Math.min(...postYears) : latestIssueDate.getFullYear();
const newestYear = postYears.length ? Math.max(...postYears) : latestIssueDate.getFullYear();
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const aiNeedles = ['ai', 'agent', 'agents', 'llm', 'claude', 'codex', 'openai', 'openclaw', 'loooom', 'gpt', 'model', 'promptfoo', 'langgraph', 'mcp', 'autoresearch', 'deepagents', 'brainpack', 'memory', 'eval'];
const isAiPost = (post) => {
	const haystack = [
		post.data.title,
		post.data.description,
		...(post.data.tags || []),
	].join(' ').toLowerCase();

	return aiNeedles.some(needle => haystack.includes(needle));
};
const aiPosts = posts.filter(isAiPost);

const drawerDefs = [
	{ key: 'agents', label: 'agents', hint: 'fleets, roles, orchestration', needles: ['agent', 'agents', 'openclaw', 'hermes', 'deepagents', 'langgraph', 'channels'] },
	{ key: 'tools', label: 'tools', hint: 'mcp, cli, plugins, sdk', needles: ['tool', 'tools', 'mcp', 'cli', 'plugin', 'plugins', 'sdk', 'server'] },
	{ key: 'models', label: 'model swaps', hint: 'claude, codex, openai, llms', needles: ['model', 'models', 'claude', 'codex', 'openai', 'gpt', 'llm', 'llms'] },
	{ key: 'evals', label: 'eval loops', hint: 'benchmarks, validation, judges', needles: ['eval', 'evals', 'promptfoo', 'benchmark', 'validation', 'validate', 'judge'] },
	{ key: 'memory', label: 'memory', hint: 'context, brains, recall', needles: ['memory', 'brain', 'context', 'mem0', 'me.md', 'openviking'] },
];

const drawerBuckets = drawerDefs
	.map((bucket) => {
		const bucketPosts = aiPosts.filter((post) => {
			const haystack = [
				post.data.title,
				post.data.description,
				...(post.data.tags || []),
			].join(' ').toLowerCase();

			return bucket.needles.some(needle => haystack.includes(needle));
		});

		return {
			...bucket,
			count: bucketPosts.length,
			latest: bucketPosts[0],
		};
	})
	.filter(bucket => bucket.count > 0);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech - ${SITE_TITLE}`} description="Technical notes from mager.co on AI agents, developer tools, CLIs, personal software, and the workflows that compound." />
		<style>
			body {
				background: oklch(91% 0.008 76);
				color: oklch(18% 0.008 70);
			}

			:global(.site-header.header-light) {
				background: color-mix(in oklch, oklch(91% 0.008 76) 86%, transparent);
				border-bottom: 1px solid oklch(70% 0.006 76);
				--header-text: oklch(18% 0.008 70);
				--header-text-secondary: oklch(36% 0.006 70);
				--header-text-muted: oklch(55% 0.005 70);
				--header-logo-tld: oklch(18% 0.008 70);
				--link-accent-indigo: oklch(18% 0.008 70);
				--link-accent-teal: oklch(18% 0.008 70);
				--link-accent-amber: oklch(18% 0.008 70);
				--link-accent-neutral: oklch(18% 0.008 70);
				--header-social-border: color-mix(in oklch, oklch(18% 0.008 70) 16%, transparent);
				--header-hover-bg: color-mix(in oklch, oklch(18% 0.008 70) 6%, transparent);
			}

			main.tech-page {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				--paper: oklch(91% 0.008 76);
				--paper-quiet: oklch(86.5% 0.008 76);
				--paper-warm: oklch(82% 0.007 76);
				--ink: oklch(18% 0.008 70);
				--ink-soft: oklch(32% 0.007 70);
				--ink-muted: oklch(49% 0.006 70);
				--rule: oklch(70% 0.006 76);
				--rule-strong: oklch(44% 0.006 70);
				--surface: oklch(94% 0.007 76);
				--surface-dark: oklch(18% 0.01 70);
				--surface-dark-quiet: oklch(27% 0.008 70);
				--surface-dark-soft: oklch(23% 0.012 70);
				--on-dark: oklch(90% 0.007 76);
				--terminal-green: oklch(83% 0.14 150);
				--terminal-cyan: oklch(79% 0.09 215);
				--font-display: 'Fraunces', Georgia, serif;
				--font-body: 'Source Serif 4', Georgia, serif;
				--font-ui: 'Space Grotesk', system-ui, sans-serif;
				--font-mono: 'JetBrains Mono', monospace;
				min-height: 100vh;
				background:
					linear-gradient(90deg, color-mix(in oklch, var(--rule) 30%, transparent) 1px, transparent 1px),
					radial-gradient(circle at top, color-mix(in oklch, var(--terminal-cyan) 10%, transparent), transparent 34%),
					linear-gradient(180deg, color-mix(in oklch, var(--ink) 8%, transparent), transparent 24rem),
					var(--paper);
				background-size: 7.25rem 100%, auto, auto, auto;
			}

			.tech-shell {
				width: min(1440px, 100%);
				margin: 0 auto;
				padding: 1.2rem 1.5rem 4rem;
			}

			.tech-kicker,
			.dateline,
			.lead-label,
			.section-label,
			.story-meta,
			.archive-note,
			.empty-state,
			.hero-chip,
			.drawer-chip,
			.drawer-stat-label,
			.drawer-hint,
			.prompt-line,
			.prompt-copy {
				font-family: var(--font-mono);
			}

			.dateline {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.95rem 0 1.15rem;
				border-bottom: 1px solid var(--rule);
				font-size: 0.78rem;
				color: var(--ink-soft);
			}

			.dateline a {
				color: var(--ink);
				text-decoration: none;
			}

			.dateline a:hover {
				color: var(--ink-soft);
			}

			.dateline-pack,
			.dateline-right {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				flex-wrap: wrap;
			}

			.dateline-mark {
				color: var(--ink);
				font-weight: 700;
			}

			.hero-board {
				display: grid;
				grid-template-columns: minmax(0, 1.08fr) minmax(24rem, 0.92fr);
				gap: 1.2rem;
				padding: 1.6rem 0 1.2rem;
				border-bottom: 1px solid var(--rule);
			}

			.tech-hero {
				display: grid;
				grid-template-rows: auto 1fr auto;
				min-height: 28rem;
				border: 1px solid var(--rule);
				background:
					linear-gradient(135deg, color-mix(in oklch, var(--terminal-cyan) 12%, transparent), transparent 38%),
					linear-gradient(180deg, var(--surface), var(--paper-quiet));
				padding: 1.25rem;
				position: relative;
				overflow: hidden;
			}

			.tech-hero::after {
				content: '';
				position: absolute;
				inset: auto -12% -22% auto;
				width: 22rem;
				height: 22rem;
				border-radius: 50%;
				background: radial-gradient(circle, color-mix(in oklch, var(--terminal-green) 20%, transparent), transparent 66%);
				opacity: 0.45;
				pointer-events: none;
			}

			.tech-kicker {
				color: var(--ink-soft);
				font-size: 0.8rem;
				font-weight: 700;
				position: relative;
				z-index: 1;
			}

			.hero-type {
				align-self: end;
				position: relative;
				z-index: 1;
				max-width: 68rem;
			}

			.hero-chip-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 0.9rem;
			}

			.hero-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
				padding: 0.34rem 0.55rem;
				border: 1px solid color-mix(in oklch, var(--rule-strong) 70%, transparent);
				background: color-mix(in oklch, var(--surface) 88%, transparent);
				font-size: 0.7rem;
				color: var(--ink-soft);
			}

			.hero-type h1 {
				margin: 0;
				font-family: var(--font-display);
				font-size: 6.5rem;
				line-height: 0.88;
				letter-spacing: 0;
				color: var(--ink);
				font-variation-settings: 'opsz' 144, 'wght' 900;
			}

			.hero-type p {
				max-width: 52rem;
				margin: 1rem 0 0;
				font-family: var(--font-body);
				font-size: 1.28rem;
				line-height: 1.5;
				color: var(--ink-soft);
			}

			.hero-foot {
				position: relative;
				z-index: 1;
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.2rem;
			}

			.prompt-line,
			.prompt-copy {
				display: block;
			}

			.prompt-line {
				font-size: 0.74rem;
				color: var(--ink-soft);
			}

			.prompt-copy {
				font-size: 0.95rem;
				color: var(--ink);
			}

			.drawer-card {
				display: grid;
				grid-template-rows: auto 1fr auto;
				min-height: 28rem;
				border: 1px solid color-mix(in oklch, var(--terminal-green) 18%, var(--ink));
				background:
					linear-gradient(180deg, color-mix(in oklch, var(--terminal-cyan) 5%, transparent), transparent 26%),
					var(--surface-dark);
				color: var(--on-dark);
				box-shadow: 0 22px 48px color-mix(in oklch, var(--surface-dark) 65%, transparent);
			}

			.drawer-card a {
				color: inherit;
				text-decoration: none;
			}

			.drawer-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.85rem 1rem;
				border-bottom: 1px solid var(--surface-dark-quiet);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: oklch(78% 0.006 76);
			}

			.drawer-chip-row {
				display: flex;
				gap: 0.45rem;
				flex-wrap: wrap;
			}

			.drawer-chip {
				display: inline-flex;
				align-items: center;
				padding: 0.28rem 0.5rem;
				border: 1px solid color-mix(in oklch, var(--terminal-green) 26%, transparent);
				background: color-mix(in oklch, var(--terminal-green) 10%, transparent);
				color: var(--terminal-green);
				font-size: 0.69rem;
			}

			.drawer-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.75rem;
				padding: 1rem;
			}

			.drawer-stat {
				display: grid;
				gap: 0.45rem;
				padding: 0.8rem;
				border: 1px solid color-mix(in oklch, var(--on-dark) 10%, transparent);
				background: color-mix(in oklch, white 2%, transparent);
			}

			.drawer-stat:hover {
				background: color-mix(in oklch, var(--terminal-cyan) 8%, transparent);
			}

			.drawer-stat-top {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 0.75rem;
			}

			.drawer-stat-label {
				font-size: 0.72rem;
				color: oklch(72% 0.01 76);
				text-transform: uppercase;
			}

			.drawer-stat-count {
				font-family: var(--font-ui);
				font-size: 1.35rem;
				font-weight: 700;
				line-height: 1;
				color: var(--on-dark);
			}

			.drawer-hint {
				font-size: 0.69rem;
				line-height: 1.35;
				color: oklch(63% 0.008 76);
			}

			.drawer-latest {
				font-family: var(--font-ui);
				font-size: 0.92rem;
				font-weight: 600;
				line-height: 1.25;
				color: oklch(94% 0.007 76);
			}

			.drawer-foot {
				padding: 0.95rem 1rem 1rem;
				border-top: 1px solid var(--surface-dark-quiet);
			}

			.drawer-foot .prompt-line {
				color: oklch(67% 0.008 76);
			}

			.drawer-foot .prompt-copy {
				color: oklch(90% 0.007 76);
			}

			.lead-story {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(17rem, 0.34fr);
				gap: 1.2rem;
				align-items: stretch;
				margin: 0 0 1.2rem;
				border: 1px solid var(--ink);
				background: var(--surface);
				color: inherit;
				text-decoration: none;
				transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background 180ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			.lead-story:hover {
				transform: translateY(-2px);
				background: color-mix(in oklch, var(--terminal-cyan) 10%, var(--surface));
			}

			.lead-body {
				padding: 1.1rem 0 1.1rem 1.1rem;
			}

			.lead-label,
			.story-meta,
			.archive-note {
				font-size: 0.76rem;
				color: var(--ink-soft);
			}

			.lead-body h2 {
				margin: 0.35rem 0 0;
				max-width: 62rem;
				font-family: var(--font-display);
				font-size: 3rem;
				line-height: 1;
				letter-spacing: 0;
				color: var(--ink);
			}

			.lead-body p {
				max-width: 64ch;
				margin: 0.75rem 0 0;
				font-family: var(--font-body);
				font-size: 1.12rem;
				line-height: 1.55;
				color: var(--ink-soft);
			}

			.lead-meta {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem;
				border-left: 1px solid var(--rule);
				background: linear-gradient(180deg, var(--paper-quiet), color-mix(in oklch, var(--terminal-cyan) 6%, var(--paper-quiet)));
			}

			.tag-stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag-stack span,
			.archive-note {
				display: inline-flex;
				align-items: center;
				border: 1px solid var(--rule-strong);
				background: var(--paper-quiet);
				color: var(--ink-soft);
				padding: 0.36rem 0.48rem;
				font-size: 0.72rem;
				line-height: 1;
			}

			.archive-board {
				margin-top: 1.2rem;
				border: 1px solid var(--rule);
				background: color-mix(in oklch, var(--surface) 82%, var(--paper));
			}

			.archive-head {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem 1rem 0.9rem;
				border-bottom: 1px solid var(--rule);
			}

			.section-label {
				display: block;
				margin-bottom: 0.35rem;
				font-size: 0.75rem;
				color: var(--ink-soft);
				font-weight: 700;
			}

			.archive-head h2 {
				margin: 0;
				font-family: var(--font-ui);
				font-size: 1.15rem;
				line-height: 1.1;
				letter-spacing: 0;
				color: var(--ink);
			}

			.archive-head p {
				max-width: 52ch;
				margin: 0.45rem 0 0;
				font-family: var(--font-body);
				font-size: 0.98rem;
				line-height: 1.45;
				color: var(--ink-soft);
			}

			.archive-list {
				list-style: none;
				margin: 0;
				padding: 0 1rem;
			}

			.archive-actions {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.empty-state {
				margin: 0;
				padding: 1rem 0;
				color: var(--ink-muted);
			}

			@media (prefers-reduced-motion: reduce) {
				.lead-story,
				:global(.tech-row),
				.drawer-stat {
					transition: none;
				}

				.lead-story:hover,
				:global(.tech-row:hover) {
					transform: none;
				}
			}

			@media (max-width: 1100px) {
				.hero-board {
					grid-template-columns: 1fr;
				}

				.hero-type h1 {
					font-size: 5.5rem;
				}
			}

			@media (max-width: 760px) {
				main.tech-page {
					background-size: 4.5rem 100%, auto, auto, auto;
				}

				.tech-shell {
					padding: 0.8rem 0.85rem 2.8rem;
				}

				.dateline {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.45rem;
					font-size: 0.72rem;
				}

				.hero-board {
					padding-top: 0.9rem;
				}

				.tech-hero,
				.drawer-card {
					min-height: 0;
				}

				.tech-hero {
					padding: 1rem;
				}

				.hero-type h1 {
					font-size: 3.8rem;
					line-height: 0.9;
				}

				.hero-type p {
					font-size: 1.08rem;
					line-height: 1.5;
				}

				.drawer-grid {
					grid-template-columns: 1fr;
				}

				.lead-story {
					grid-template-columns: 1fr;
					gap: 0;
				}

				.lead-body {
					padding: 0.9rem;
				}

				.lead-body h2 {
					font-size: 2rem;
					line-height: 1.05;
				}

				.lead-body p {
					font-size: 1rem;
				}

				.lead-meta {
					border-left: none;
					border-top: 1px solid var(--rule);
				}

				.archive-head {
					align-items: flex-start;
					flex-direction: column;
				}

				.archive-list {
					padding: 0 0.85rem;
				}

				.archive-actions {
					justify-content: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main class="tech-page">
			<div class="tech-shell">
				<div class="dateline" aria-label="Tech page metadata">
					<div class="dateline-pack">
						<a href="/">mager.co</a>
						<span class="dateline-mark">/</span>
						<span>tech</span>
					</div>
					<div class="dateline-right">
						<span>{fullDate}</span>
						<span class="dateline-mark">{posts.length} posts</span>
						<span>{firstYear}—{newestYear}</span>
					</div>
				</div>

				<div class="hero-board">
					<section class="tech-hero" aria-labelledby="tech-title">
						<p class="tech-kicker">field log / always changing</p>
						<div class="hero-type">
							<div class="hero-chip-row">
								<span class="hero-chip">agents</span>
								<span class="hero-chip">tools</span>
								<span class="hero-chip">model swaps</span>
								<span class="hero-chip">eval loops</span>
							</div>
							<h1 id="tech-title">Tech</h1>
							<p>Technical notes from mager.co: terminal-native agents, personal software, weird little systems, and the stack edits that keep compounding.</p>
						</div>
						<div class="hero-foot" aria-label="tech shell prompt">
							<div>
								<span class="prompt-line">~/Code/magerblog $ ls tech/</span>
								<span class="prompt-copy">dispatches, build log, AI drawer, experiments</span>
							</div>
						</div>
					</section>

					<aside class="drawer-card" aria-label="AI drawer">
						<div class="drawer-top">
							<span>AI drawer</span>
							<div class="drawer-chip-row">
								<span class="drawer-chip">{aiPosts.length} notes</span>
								<span class="drawer-chip">live stack</span>
							</div>
						</div>
						<div class="drawer-grid">
							{drawerBuckets.map((bucket) => (
								<a class="drawer-stat" href={bucket.latest ? `/blog/${bucket.latest.id}/` : '/tech'}>
									<div class="drawer-stat-top">
										<span class="drawer-stat-label">{bucket.label}</span>
										<span class="drawer-stat-count">{bucket.count}</span>
									</div>
									<span class="drawer-hint">{bucket.hint}</span>
									{bucket.latest && <span class="drawer-latest">{bucket.latest.data.title}</span>}
								</a>
							))}
						</div>
						<div class="drawer-foot">
							<span class="prompt-line">drawer contents</span>
							<span class="prompt-copy">A tighter place for the AI notes — without repeating the whole archive back at you.</span>
						</div>
					</aside>
				</div>

				{featuredPost && (
					<a href={leadHref} class="lead-story">
						<div class="lead-body">
							<span class="lead-label">latest dispatch</span>
							<h2>{featuredPost.data.title}</h2>
							<p>{featuredPost.data.description}</p>
						</div>
						<div class="lead-meta">
							<span class="story-meta">{shortDate(featuredPost.data.pubDate)}</span>
							<div class="tag-stack">
								{leadTags.map(tag => <span>{tag}</span>)}
							</div>
						</div>
					</a>
				)}

				<section class="archive-board" aria-labelledby="archive-heading">
					<header class="archive-head">
						<div>
							<span class="section-label">archive</span>
							<h2 id="archive-heading">Build log</h2>
							<p>Newest first. One lead story up top, then the rest of the tech archive below — cleaner, less fake-magazine issue baggage.</p>
						</div>
						<div class="archive-actions">
							<span class="archive-note">sorted newest first</span>
							<span class="archive-note">{archivePosts.length} rows</span>
						</div>
					</header>
					<ul class="archive-list">
						{archivePosts.length > 0
							? archivePosts.map((post) => <TechPostRow post={post} />)
							: <p class="empty-state">No tech posts yet.</p>}
					</ul>
				</section>
			</div>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
