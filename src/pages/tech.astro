---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechPostRow from '../components/tech/TechPostRow.astro';
import TechNoteRow from '../components/tech/TechNoteRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

// English front page for tech, so drop Japanese translations (locale: 'ja').
const allPosts = (await getCollection('blog'))
	.filter(post => !post.data.draft)
	.filter(post => post.data.locale !== 'ja');
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const posts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const featuredPost = posts[0];
const archivePosts = posts.slice(1);

// Short notes filed under tech surface here too, as "Field notes".
const techNotes = (await getCollection('notes'))
	.filter(note => !note.data.draft)
	.filter(note => note.data.category === 'tech')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const latestIssueDate = featuredPost?.data.updatedDate || featuredPost?.data.pubDate || new Date();
const issueNumber = String(posts.length).padStart(3, '0');

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const postYears = posts.map(post => post.data.pubDate.getFullYear());
const firstYear = postYears.length ? Math.min(...postYears) : latestIssueDate.getFullYear();
const newestYear = postYears.length ? Math.max(...postYears) : latestIssueDate.getFullYear();
const leadTags = (featuredPost?.data.tags || []).slice(0, 5);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const hasFeaturedImage = !!featuredPost?.data.heroImage;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech - ${SITE_TITLE}`} description="Technical notes from mager.co on AI agents, developer tools, CLIs, personal software, and the workflows that compound." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..900;1,9..144,400..900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400..600&family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
		<style>
			/* ── Light editorial token system (matches the homepage) ── */
			main.tech-page {
				--paper:      #faf8f5;
				--surface:    #f5f3f0;
				--ink:        #1f1c17;
				--ink-mid:    #6c6760;
				--ink-light:  #8d867d;
				--rule:       #ddd6cd;
				--rule-dark:  #cbc3b8;
				--accent:     oklch(45% 0.15 240); /* tech blue — identity color */

				--font-display: 'Fraunces', Georgia, serif;
				--font-body:    'Source Serif 4', Georgia, serif;
				--font-ui:      'Space Grotesk', system-ui, sans-serif;
				--font-mono:    'JetBrains Mono', 'Fira Code', monospace;

				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				min-height: 100vh;
				background: var(--paper);
				color: var(--ink);
			}

			.tech-shell {
				width: min(1200px, 100%);
				margin: 0 auto;
				padding: 1.25rem 1.5rem 5rem;
			}

			/* ── Dateline ─────────────────────────────────────────── */
			.dateline {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.85rem 0 1rem;
				border-bottom: 1px solid var(--rule);
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--ink-light);
				letter-spacing: 0.02em;
			}

			.dateline-pack,
			.dateline-right {
				display: flex;
				align-items: center;
				gap: 0.55rem;
				flex-wrap: wrap;
			}

			.dateline a {
				color: var(--ink-mid);
				text-decoration: none;
				transition: color 0.15s ease;
			}

			.dateline a:hover { color: var(--accent); }

			.dateline .sep { color: var(--rule-dark); }

			.dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--accent);
				flex-shrink: 0;
			}

			/* ── Hero: featured post ──────────────────────────────── */
			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
				gap: clamp(1.75rem, 4vw, 3.5rem);
				align-items: center;
				padding: clamp(2.25rem, 5vw, 4rem) 0;
				border-bottom: 1px solid var(--rule-dark);
			}

			.hero.no-image { grid-template-columns: 1fr; }

			.eyebrow {
				margin: 0 0 1rem;
				font-family: var(--font-ui);
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--accent);
			}

			.hero-title {
				margin: 0;
				font-family: var(--font-display);
				font-variation-settings: 'opsz' 144, 'wght' 800;
				font-size: clamp(2.4rem, 5.5vw, 4.5rem);
				line-height: 0.98;
				letter-spacing: -0.025em;
				text-wrap: balance;
			}

			.hero-title a {
				color: var(--ink);
				text-decoration: none;
				transition: color 0.18s ease;
			}

			.hero-title a:hover { color: var(--accent); }

			.hero-desc {
				margin: 1.1rem 0 0;
				max-width: 56ch;
				font-family: var(--font-body);
				font-size: clamp(1rem, 1.3vw, 1.18rem);
				line-height: 1.6;
				color: var(--ink-mid);
			}

			.hero-foot {
				display: flex;
				align-items: center;
				gap: 0.75rem 1.5rem;
				flex-wrap: wrap;
				margin-top: 1.6rem;
			}

			.tags {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				flex-wrap: wrap;
			}

			.tag {
				font-family: var(--font-mono);
				font-size: 0.66rem;
				letter-spacing: 0.03em;
				color: var(--ink-mid);
				border: 1px solid var(--rule);
				border-radius: 999px;
				padding: 0.28rem 0.62rem;
				line-height: 1;
				background: var(--surface);
			}

			.read {
				font-family: var(--font-ui);
				font-size: 0.82rem;
				font-weight: 700;
				letter-spacing: 0.02em;
				color: var(--accent);
				text-decoration: none;
				white-space: nowrap;
			}

			.read:hover {
				text-decoration: underline;
				text-underline-offset: 4px;
				text-decoration-thickness: 1.5px;
			}

			.hero-meta {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: var(--ink-light);
				letter-spacing: 0.02em;
			}

			.hero-image {
				display: block;
				aspect-ratio: 4 / 3;
				overflow: hidden;
				border-radius: 6px;
				border: 1px solid var(--rule-dark);
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: saturate(0.95);
				transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s ease;
			}

			.hero-image:hover img {
				transform: scale(1.035);
				filter: saturate(1.05);
			}

			/* ── Archive ──────────────────────────────────────────── */
			.archive {
				margin-top: 2.5rem;
			}

			.archive-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1rem;
				padding-bottom: 0.7rem;
				border-bottom: 2px solid var(--accent);
			}

			.archive-label {
				font-family: var(--font-ui);
				font-size: 0.75rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: var(--accent);
			}

			.archive-count {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--ink-light);
			}

			.archive-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}

			.empty {
				margin: 0;
				padding: 1.5rem 0;
				font-family: var(--font-body);
				font-style: italic;
				font-size: 0.95rem;
				color: var(--ink-light);
			}

			/* Page-load fade */
			@keyframes techFade {
				from { opacity: 0; transform: translateY(10px); }
				to   { opacity: 1; transform: translateY(0); }
			}

			.hero   { animation: techFade 0.5s ease both; }
			.archive { animation: techFade 0.5s 0.1s ease both; }

			@media (prefers-reduced-motion: reduce) {
				.hero, .archive { animation: none; }
				.hero-image img { transition: none; }
			}

			/* ── Responsive ───────────────────────────────────────── */
			@media (max-width: 940px) {
				.hero {
					grid-template-columns: 1fr;
					gap: 1.75rem;
				}

				.hero-image {
					order: -1;
					aspect-ratio: 16 / 9;
				}
			}

			@media (max-width: 600px) {
				.tech-shell { padding: 1rem 1.1rem 3rem; }

				.dateline {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.35rem;
					font-size: 0.68rem;
				}
			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main class="tech-page">
			<div class="tech-shell">

				<!-- Dateline -->
				<div class="dateline" aria-label="Tech section metadata">
					<div class="dateline-pack">
						<span class="dot" aria-hidden="true"></span>
						<a href="/">mager.co</a>
						<span class="sep">/</span>
						<span>tech</span>
					</div>
					<div class="dateline-right">
						<span>{fullDate}</span>
						<span class="sep">·</span>
						<span>issue {issueNumber}</span>
						<span class="sep">·</span>
						<span>{firstYear}–{newestYear}</span>
					</div>
				</div>

				<!-- Hero: featured post -->
				{featuredPost && (
					<section class:list={['hero', { 'no-image': !hasFeaturedImage }]} aria-labelledby="tech-hero-title">
						<div class="hero-copy">
							<p class="eyebrow">Lead story</p>
							<h1 class="hero-title" id="tech-hero-title">
								<a href={leadHref}>{featuredPost.data.title}</a>
							</h1>
							<p class="hero-desc">{featuredPost.data.description}</p>
							<div class="hero-foot">
								{leadTags.length > 0 && (
									<div class="tags">
										{leadTags.map(tag => <span class="tag">{tag}</span>)}
									</div>
								)}
								<a href={leadHref} class="read">Read post →</a>
								<span class="hero-meta">{shortDate(featuredPost.data.pubDate)} · {archivePosts.length} more below</span>
							</div>
						</div>

						{hasFeaturedImage && (
							<a class="hero-image" href={leadHref} aria-label={`Open ${featuredPost.data.title}`}>
								<img src={featuredPost.data.heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
							</a>
						)}
					</section>
				)}

				<!-- Field notes -->
				{techNotes.length > 0 && (
					<section class="archive field-notes" aria-labelledby="notes-heading">
						<header class="archive-head">
							<span class="archive-label" id="notes-heading">Field notes</span>
							<span class="archive-count">{techNotes.length}</span>
						</header>
						<ul class="archive-list">
							{techNotes.map((note) => <TechNoteRow note={note} />)}
						</ul>
					</section>
				)}

				<!-- Archive -->
				<section class="archive" aria-labelledby="archive-heading">
					<header class="archive-head">
						<span class="archive-label" id="archive-heading">All posts</span>
						<span class="archive-count">{archivePosts.length}</span>
					</header>
					<ul class="archive-list">
						{archivePosts.length > 0
							? archivePosts.map((post) => <TechPostRow post={post} />)
							: <p class="empty">No additional posts yet.</p>}
					</ul>
				</section>

			</div>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
