---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechPostRow from '../components/tech/TechPostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const posts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const featuredPost = posts[0];
const issuePosts = posts.slice(1);
const latestIssueDate = featuredPost?.data.updatedDate || featuredPost?.data.pubDate || new Date();

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const postYears = posts.map(post => post.data.pubDate.getFullYear());
const firstYear = postYears.length ? Math.min(...postYears) : latestIssueDate.getFullYear();
const newestYear = postYears.length ? Math.max(...postYears) : latestIssueDate.getFullYear();
const issueNumber = String(posts.length).padStart(3, '0');
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const aiNeedles = ['ai', 'agent', 'agents', 'llm', 'claude', 'codex', 'openai', 'openclaw', 'loooom', 'gpt', 'model', 'promptfoo', 'langgraph', 'mcp', 'autoresearch', 'deepagents', 'brainpack'];
const isAiPost = (post) => {
	const haystack = [
		post.data.title,
		post.data.description,
		...(post.data.tags || []),
	].join(' ').toLowerCase();

	return aiNeedles.some(needle => haystack.includes(needle));
};
const aiPosts = posts.filter(isAiPost);
const deskNotes = aiPosts.slice(0, 4);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech - ${SITE_TITLE}`} description="Technical notes from mager.co on AI agents, developer tools, CLIs, personal software, and the workflows that compound." />
		<style>
			body {
				background: oklch(91% 0.008 76);
				color: oklch(18% 0.008 70);
			}

			:global(.site-header.header-light) {
				background: color-mix(in oklch, oklch(91% 0.008 76) 86%, transparent);
				border-bottom: 1px solid oklch(70% 0.006 76);
				--header-text: oklch(18% 0.008 70);
				--header-text-secondary: oklch(36% 0.006 70);
				--header-text-muted: oklch(55% 0.005 70);
				--header-logo-tld: oklch(18% 0.008 70);
				--link-accent-indigo: oklch(18% 0.008 70);
				--link-accent-teal: oklch(18% 0.008 70);
				--link-accent-amber: oklch(18% 0.008 70);
				--link-accent-neutral: oklch(18% 0.008 70);
				--header-social-border: color-mix(in oklch, oklch(18% 0.008 70) 16%, transparent);
				--header-hover-bg: color-mix(in oklch, oklch(18% 0.008 70) 6%, transparent);
			}

			main.tech-page {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				--paper: oklch(91% 0.008 76);
				--paper-quiet: oklch(86.5% 0.008 76);
				--paper-warm: oklch(82% 0.007 76);
				--ink: oklch(18% 0.008 70);
				--ink-soft: oklch(32% 0.007 70);
				--ink-muted: oklch(49% 0.006 70);
				--rule: oklch(70% 0.006 76);
				--rule-strong: oklch(44% 0.006 70);
				--surface: oklch(94% 0.007 76);
				--surface-dark: oklch(22% 0.007 70);
				--surface-dark-quiet: oklch(29% 0.006 70);
				--on-dark: oklch(90% 0.007 76);
				--yc: var(--ink);
				--tech-blue: var(--ink);
				--surface-blue: var(--paper-quiet);
				--font-display: 'Fraunces', Georgia, serif;
				--font-body: 'Source Serif 4', Georgia, serif;
				--font-ui: 'Space Grotesk', system-ui, sans-serif;
				--font-mono: 'JetBrains Mono', monospace;
				min-height: 100vh;
				background:
					linear-gradient(90deg, color-mix(in oklch, var(--rule) 36%, transparent) 1px, transparent 1px),
					linear-gradient(180deg, color-mix(in oklch, var(--ink) 9%, transparent), transparent 24rem),
					var(--paper);
				background-size: 7.25rem 100%, auto, auto;
			}

			.tech-shell {
				width: min(1440px, 100%);
				margin: 0 auto;
				padding: 1.2rem 1.5rem 4rem;
			}

			.tech-kicker,
			.dateline,
			.lead-label,
			.section-label,
			.story-meta,
			.deck-item,
			.archive-note,
			.empty-state {
				font-family: var(--font-mono);
			}

			.dateline {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.9rem 0 1.1rem;
				border-bottom: 1px solid var(--rule);
				font-size: 0.78rem;
				color: var(--ink-soft);
			}

			.dateline a {
				color: var(--ink);
				text-decoration: none;
			}

			.dateline a:hover {
				color: var(--ink-soft);
			}

			.dateline-pack,
			.dateline-right {
				display: flex;
				align-items: center;
				gap: 0.7rem;
				flex-wrap: wrap;
			}

			.dateline-mark {
				color: var(--ink);
				font-weight: 700;
			}

			.hero-board {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(22rem, 0.85fr);
				gap: 1.2rem;
				padding: 1.6rem 0 1.2rem;
				border-bottom: 1px solid var(--rule);
			}

			.tech-hero {
				display: grid;
				grid-template-rows: auto 1fr;
				min-height: 27rem;
				border: 1px solid var(--rule);
				background:
					linear-gradient(135deg, color-mix(in oklch, var(--ink) 8%, transparent), transparent 38%),
					linear-gradient(180deg, var(--surface), var(--paper-quiet));
				padding: 1.25rem;
				position: relative;
				overflow: hidden;
			}

			.tech-kicker {
				color: var(--ink-soft);
				font-size: 0.8rem;
				font-weight: 700;
				position: relative;
				z-index: 1;
			}

			.hero-type {
				align-self: end;
				position: relative;
				z-index: 1;
				max-width: 68rem;
			}

			.hero-type h1 {
				margin: 0;
				font-family: var(--font-display);
				font-size: 7rem;
				line-height: 0.86;
				letter-spacing: 0;
				color: var(--ink);
				font-variation-settings: 'opsz' 144, 'wght' 900;
			}

			.hero-type p {
				max-width: 54rem;
				margin: 1.1rem 0 0;
				font-family: var(--font-body);
				font-size: 1.35rem;
				line-height: 1.45;
				color: var(--ink-soft);
			}

			.desk-card {
				display: grid;
				grid-template-rows: auto 1fr auto;
				min-height: 27rem;
				border: 1px solid var(--ink);
				background: var(--surface-dark);
				color: var(--on-dark);
			}

			.desk-card a {
				color: inherit;
				text-decoration: none;
			}

			.desk-top {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.85rem 1rem;
				border-bottom: 1px solid var(--surface-dark-quiet);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				color: oklch(78% 0.006 76);
			}

			.desk-list {
				list-style: none;
				margin: 0;
				padding: 0.2rem 1rem 0;
			}

			.deck-item {
				display: grid;
				grid-template-columns: minmax(0, 1fr);
				padding: 1rem 0;
				border-bottom: 1px solid var(--surface-dark-quiet);
				font-size: 0.78rem;
				line-height: 1.45;
			}

			.deck-item:last-child {
				border-bottom: none;
			}

			.deck-title {
				display: block;
				font-family: var(--font-ui);
				font-size: 1rem;
				font-weight: 700;
				line-height: 1.2;
				color: oklch(94% 0.007 76);
			}

			.deck-meta {
				display: block;
				margin-top: 0.35rem;
				color: oklch(69% 0.006 76);
			}

			.desk-foot {
				padding: 0.9rem 1rem;
				border-top: 1px solid var(--surface-dark-quiet);
				font-family: var(--font-body);
				font-size: 1rem;
				line-height: 1.45;
				color: oklch(82% 0.006 76);
			}

			.lead-story {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(15rem, 0.34fr);
				gap: 1.2rem;
				align-items: stretch;
				margin: 0 0 1.2rem;
				border: 1px solid var(--ink);
				background: var(--surface);
				color: inherit;
				text-decoration: none;
				transition: transform 180ms cubic-bezier(0.22, 1, 0.36, 1), background 180ms cubic-bezier(0.22, 1, 0.36, 1);
			}

			.lead-story:hover {
				transform: translateY(-2px);
				background: color-mix(in oklch, var(--ink) 4%, var(--surface));
			}

			.lead-body {
				padding: 1.1rem 0 1.1rem 1.1rem;
			}

			.lead-label,
			.story-meta,
			.archive-note {
				font-size: 0.76rem;
				color: var(--ink-soft);
			}

			.lead-body h2 {
				margin: 0.35rem 0 0;
				max-width: 62rem;
				font-family: var(--font-display);
				font-size: 3rem;
				line-height: 1;
				letter-spacing: 0;
				color: var(--ink);
			}

			.lead-body p {
				max-width: 64ch;
				margin: 0.75rem 0 0;
				font-family: var(--font-body);
				font-size: 1.12rem;
				line-height: 1.55;
				color: var(--ink-soft);
			}

			.lead-meta {
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem;
				border-left: 1px solid var(--rule);
				background: var(--paper-quiet);
			}

			.tag-stack {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag-stack span,
			.archive-note {
				display: inline-flex;
				align-items: center;
				border: 1px solid var(--rule-strong);
				background: var(--paper-quiet);
				color: var(--ink-soft);
				padding: 0.36rem 0.48rem;
				font-size: 0.72rem;
				line-height: 1;
			}

			.archive-board {
				border: 1px solid var(--rule);
				background: color-mix(in oklch, var(--surface) 82%, var(--paper));
			}

			.archive-head {
				display: flex;
				align-items: end;
				justify-content: space-between;
				gap: 1rem;
				padding: 1rem 1rem 0.9rem;
				border-bottom: 1px solid var(--rule);
			}

			.section-label {
				display: block;
				margin-bottom: 0.35rem;
				font-size: 0.75rem;
				color: var(--ink-soft);
				font-weight: 700;
			}

			.archive-head h2 {
				margin: 0;
				font-family: var(--font-ui);
				font-size: 1.15rem;
				line-height: 1.1;
				letter-spacing: 0;
				color: var(--ink);
			}

			.archive-head p {
				max-width: 52ch;
				margin: 0.45rem 0 0;
				font-family: var(--font-body);
				font-size: 0.98rem;
				line-height: 1.45;
				color: var(--ink-soft);
			}

			.archive-list {
				list-style: none;
				margin: 0;
				padding: 0 1rem;
			}

			.archive-board {
				margin-top: 1.2rem;
			}

			.archive-head {
				align-items: start;
			}

			.archive-actions {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
				justify-content: flex-end;
			}

			.empty-state {
				margin: 0;
				padding: 1rem 0;
				color: var(--ink-muted);
			}

			@media (prefers-reduced-motion: reduce) {
				.lead-story,
				:global(.tech-row) {
					transition: none;
				}

				.lead-story:hover,
				:global(.tech-row:hover) {
					transform: none;
				}
			}

			@media (max-width: 1100px) {
				.hero-board {
					grid-template-columns: 1fr;
				}

				.hero-type h1 {
					font-size: 5.6rem;
				}
			}

			@media (max-width: 760px) {
				main.tech-page {
					background-size: 4.5rem 100%, auto, auto;
				}

				.tech-shell {
					padding: 0.8rem 0.85rem 2.8rem;
				}

				.dateline {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.45rem;
					font-size: 0.72rem;
				}

				.hero-board {
					padding-top: 0.9rem;
				}

				.tech-hero,
				.desk-card {
					min-height: 0;
				}

				.tech-hero {
					padding: 1rem;
				}

				.hero-type h1 {
					font-size: 3.8rem;
					line-height: 0.9;
				}

				.hero-type p {
					font-size: 1.08rem;
					line-height: 1.5;
				}

				.desk-list {
					padding: 0 0.85rem;
				}

				.deck-item {
					padding: 0.85rem 0;
				}

				.lead-story {
					grid-template-columns: 1fr;
					gap: 0;
				}

				.lead-body {
					padding: 0.9rem;
				}

				.lead-body h2 {
					font-size: 2rem;
					line-height: 1.05;
				}

				.lead-body p {
					font-size: 1rem;
				}

				.lead-meta {
					border-left: none;
					border-top: 1px solid var(--rule);
				}

				.archive-head {
					align-items: flex-start;
					flex-direction: column;
				}

				.archive-list {
					padding: 0 0.85rem;
				}

				.archive-actions {
					justify-content: flex-start;
				}

			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main class="tech-page">
			<div class="tech-shell">
				<div class="dateline" aria-label="Tech page metadata">
					<div class="dateline-pack">
						<a href="/">mager.co</a>
						<span class="dateline-mark">/</span>
						<span>tech</span>
					</div>
					<div class="dateline-right">
						<span>{fullDate}</span>
						<span class="dateline-mark">issue {issueNumber}</span>
						<span>evening edition</span>
					</div>
				</div>

				<div class="hero-board">
					<section class="tech-hero" aria-labelledby="tech-title">
						<p class="tech-kicker">Issue {issueNumber}</p>
						<div class="hero-type">
							<h1 id="tech-title">Tech</h1>
							<p>Technical notes from mager.co: agents, CLIs, personal software, and the small systems I keep coming back to.</p>
						</div>
					</section>

					<aside class="desk-card" aria-label="AI dispatch">
						<div class="desk-top">
							<span>mager dispatch</span>
							<span>{aiPosts.length} AI notes</span>
						</div>
						<ul class="desk-list">
							{deskNotes.map((post) => (
								<li class="deck-item">
									<a href={`/blog/${post.id}/`}>
										<span class="deck-title">{post.data.title}</span>
										<span class="deck-meta">{shortDate(post.data.pubDate)}</span>
									</a>
								</li>
							))}
						</ul>
						<p class="desk-foot">A tight drawer for the AI notes: agents, tools, model swaps, eval loops, and the parts of the stack that keep changing.</p>
					</aside>
				</div>

				{featuredPost && (
					<a href={leadHref} class="lead-story">
						<div class="lead-body">
							<span class="lead-label">Lead story</span>
							<h2>{featuredPost.data.title}</h2>
							<p>{featuredPost.data.description}</p>
						</div>
						<div class="lead-meta">
							<span class="story-meta">{shortDate(featuredPost.data.pubDate)}</span>
							<div class="tag-stack">
								{leadTags.map(tag => <span>{tag}</span>)}
							</div>
						</div>
					</a>
				)}

				<section class="archive-board" aria-labelledby="archive-heading">
					<header class="archive-head">
						<div>
							<span class="section-label">Latest</span>
							<h2 id="archive-heading">Issue notes</h2>
							<p>Newest first, with the lead story pulled above the fold. Each published tech post advances the issue number.</p>
						</div>
						<div class="archive-actions">
							<span class="archive-note">sorted newest first</span>
							<span class="archive-note">{firstYear} to {newestYear}</span>
						</div>
					</header>
					<ul class="archive-list">
						{issuePosts.length > 0
							? issuePosts.map((post) => <TechPostRow post={post} />)
							: <p class="empty-state">No tech posts yet.</p>}
					</ul>
				</section>
			</div>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
