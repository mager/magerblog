---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TechPostRow from '../components/tech/TechPostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const getLatestDate = (post) => (post.data.updatedDate || post.data.pubDate).valueOf();

const posts = allPosts
	.filter(post => post.data.category === 'tech')
	.sort((a, b) => getLatestDate(b) - getLatestDate(a));

const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const latestIssueDate = featuredPost?.data.updatedDate || featuredPost?.data.pubDate || new Date();
const issueNumber = String(posts.length).padStart(3, '0');

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric',
		timeZone: 'UTC',
	}).format(date);

const tagHueMap = new Map([
	['ai', 280],
	['agents', 224],
	['agent', 224],
	['claude', 292],
	['claude-code', 292],
	['codex', 250],
	['openai', 255],
	['openclaw', 205],
	['hermes', 34],
	['developer-tools', 198],
	['tools', 198],
	['cli', 170],
	['mcp', 154],
	['llms', 318],
	['evals', 18],
	['promptfoo', 18],
	['context', 84],
	['memory', 84],
	['loooom', 330],
	['design', 28],
	['frontend', 28],
	['langgraph', 142],
	['skills', 44],
]);

const fallbackHue = (value: string) =>
	[...value].reduce((sum, char) => sum + char.charCodeAt(0), 0) % 360;

const getTagHue = (tag = '') => {
	const key = tag.toLowerCase();
	return tagHueMap.get(key) ?? fallbackHue(key || 'tech');
};

const postYears = posts.map(post => post.data.pubDate.getFullYear());
const firstYear = postYears.length ? Math.min(...postYears) : latestIssueDate.getFullYear();
const newestYear = postYears.length ? Math.max(...postYears) : latestIssueDate.getFullYear();
const leadTags = (featuredPost?.data.tags || []).slice(0, 5).map(tag => ({
	name: tag,
	hue: getTagHue(tag),
}));
const leadHue = leadTags[0]?.hue ?? 252;
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const hasFeaturedImage = !!featuredPost?.data.heroImage;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Tech - ${SITE_TITLE}`} description="Technical notes from mager.co on AI agents, developer tools, CLIs, personal software, and the workflows that compound." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Space+Grotesk:wght@400;500;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,700;9..144,900&display=swap" rel="stylesheet" />
		<style>
			/* ── Dark-terminal token system ─────────────────────── */
			:root {
				--font-display: 'Fraunces', Georgia, serif;
				--font-ui:      'Space Grotesk', system-ui, sans-serif;
				--font-mono:    'JetBrains Mono', 'Fira Code', monospace;
			}

			body {
				/* Ground everything in the site's dark editor bg */
				background: oklch(10% 0.022 var(--lead-hue));
				color: oklch(88% 0.022 var(--lead-hue));
			}

			/* Header override — keep it dark on the dark page */
			:global(.site-header) {
				background: color-mix(in oklch, oklch(9% 0.02 var(--lead-hue)) 92%, transparent) !important;
				border-bottom: 1px solid color-mix(in oklch, oklch(60% 0.18 var(--lead-hue)) 18%, transparent) !important;
				--header-text: oklch(88% 0.022 var(--lead-hue)) !important;
				--header-text-secondary: oklch(62% 0.035 var(--lead-hue)) !important;
				--header-text-muted: oklch(48% 0.04 var(--lead-hue)) !important;
				--header-logo-tld: oklch(72% 0.2 var(--lead-hue)) !important;
				--link-accent-indigo: oklch(72% 0.2 var(--lead-hue)) !important;
				--link-accent-teal: oklch(72% 0.18 calc(var(--lead-hue) - 58)) !important;
				--link-accent-amber: oklch(76% 0.17 calc(var(--lead-hue) + 86)) !important;
				--link-accent-neutral: oklch(88% 0.018 var(--lead-hue)) !important;
				--header-social-border: color-mix(in oklch, oklch(60% 0.16 var(--lead-hue)) 18%, transparent) !important;
				--header-hover-bg: color-mix(in oklch, oklch(60% 0.16 var(--lead-hue)) 12%, transparent) !important;
			}

			main.tech-page {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;

				/* Dark token set */
				--bg:           oklch(10% 0.022 var(--lead-hue));
				--bg-raise:     oklch(13% 0.028 var(--lead-hue));
				--bg-lift:      oklch(16% 0.032 var(--lead-hue));
				--border:       color-mix(in oklch, oklch(60% 0.18 var(--lead-hue)) 16%, transparent);
				--border-mid:   color-mix(in oklch, oklch(60% 0.18 var(--lead-hue)) 28%, transparent);
				--border-hot:   color-mix(in oklch, oklch(70% 0.2  var(--lead-hue)) 55%, transparent);
				--ink:          oklch(94% 0.014 var(--lead-hue));
				--ink-soft:     oklch(70% 0.028 var(--lead-hue));
				--ink-muted:    oklch(46% 0.032 var(--lead-hue));
				--accent:       oklch(72% 0.22 var(--lead-hue));
				--accent-glow:  color-mix(in oklch, oklch(72% 0.22 var(--lead-hue)) 35%, transparent);
				--accent-hot:   oklch(78% 0.2  calc(var(--lead-hue) + 48));
				--accent-cool:  oklch(72% 0.18 calc(var(--lead-hue) - 52));

				min-height: 100vh;
				/* Subtle scanline texture layered on dark base */
				background:
					linear-gradient(
						180deg,
						transparent 0px,
						color-mix(in oklch, oklch(100% 0 0) 2.5%, transparent) 1px,
						transparent 2px
					),
					radial-gradient(ellipse 70% 55% at 18% 0%, color-mix(in oklch, var(--accent-hot) 18%, transparent), transparent 52%),
					radial-gradient(ellipse 60% 45% at 86% 4%, color-mix(in oklch, var(--accent-cool) 14%, transparent), transparent 48%),
					var(--bg);
				background-size: 100% 3px, auto, auto, auto;
			}

			.tech-shell {
				width: min(1380px, 100%);
				margin: 0 auto;
				padding: 1.1rem 1.5rem 5rem;
			}

			/* ── Fonts ────────────────────────────────────────────── */
			.dateline,
			.hero-kicker,
			.hero-eyebrow,
			.hero-prompt,
			.story-meta,
			.tag-pill,
			.archive-note,
			.section-label,
			.log-count,
			.empty-state {
				font-family: var(--font-mono);
			}

			/* ── Dateline bar ─────────────────────────────────────── */
			.dateline {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				padding: 0.85rem 0 1rem;
				border-bottom: 1px solid var(--border);
				font-size: 0.74rem;
				color: var(--ink-muted);
				letter-spacing: 0.01em;
			}

			.dateline a {
				color: var(--ink-soft);
				text-decoration: none;
			}

			.dateline a:hover { color: var(--accent); }

			.dateline-pack,
			.dateline-right {
				display: flex;
				align-items: center;
				gap: 0.6rem;
				flex-wrap: wrap;
			}

			.dateline-mark {
				color: var(--accent);
				font-weight: 700;
			}

			.status-dot {
				display: inline-block;
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--accent);
				box-shadow: 0 0 8px var(--accent-glow);
				animation: dotPulse 2.8s ease-in-out infinite;
				flex-shrink: 0;
			}

			/* ── Hero stage ───────────────────────────────────────── */
			.hero-stage {
				display: grid;
				grid-template-columns: minmax(0, 1.12fr) minmax(17rem, 0.58fr);
				gap: clamp(1rem, 2vw, 1.75rem);
				min-height: clamp(32rem, calc(100svh - 8rem), 50rem);
				margin-top: 1.1rem;
				padding: clamp(1.25rem, 3vw, 2.5rem);
				border: 1px solid var(--border-mid);
				position: relative;
				overflow: hidden;
				background:
					/* Scanline grid */
					linear-gradient(90deg, var(--border) 1px, transparent 1px),
					linear-gradient(180deg, var(--border) 1px, transparent 1px),
					/* Radial glow pools */
					radial-gradient(ellipse 55% 60% at 10% 10%, color-mix(in oklch, var(--accent-hot) 28%, transparent), transparent 55%),
					radial-gradient(ellipse 50% 50% at 88% 14%, color-mix(in oklch, var(--accent-cool) 22%, transparent), transparent 50%),
					/* Dark base */
					linear-gradient(145deg, oklch(14% 0.04 var(--lead-hue)), oklch(10% 0.025 calc(var(--lead-hue) + 30)) 55%, oklch(8% 0.018 calc(var(--lead-hue) - 20)));
				background-size: 6rem 6rem, 6rem 6rem, auto, auto, auto;
				/* Glowing border on the left edge */
				box-shadow:
					inset 3px 0 0 0 var(--accent-glow),
					0 0 80px color-mix(in oklch, var(--accent) 8%, transparent),
					0 2px 0 0 var(--border-mid);
			}

			/* Corner decoration — terminal prompt top-left */
			.hero-stage::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 2px;
				background: linear-gradient(90deg, var(--accent), var(--accent-cool) 60%, transparent);
				opacity: 0.7;
			}

			/* Vignette — fade grid toward edges */
			.hero-stage::after {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(ellipse 70% 80% at 38% 55%, transparent 40%, oklch(9% 0.02 var(--lead-hue)) 100%);
				pointer-events: none;
			}

			.hero-copy,
			.hero-media {
				position: relative;
				z-index: 1;
			}

			.hero-copy {
				display: grid;
				align-content: space-between;
				gap: 1.5rem;
			}

			/* Prompt line at the top */
			.hero-prompt {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.72rem;
				color: var(--ink-muted);
			}

			.hero-prompt .prompt-sym {
				color: var(--accent);
				font-weight: 700;
			}

			.hero-prompt .prompt-cursor {
				display: inline-block;
				width: 8px;
				height: 1em;
				background: var(--accent);
				opacity: 0.85;
				animation: cursorBlink 1.1s step-end infinite;
				vertical-align: text-bottom;
				margin-left: 1px;
			}

			.hero-brand { display: grid; gap: 0.9rem; }

			.hero-eyebrow {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				margin: 0;
				font-size: 0.72rem;
				font-weight: 700;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}

			.hero-eyebrow::before {
				content: '//';
				color: var(--ink-muted);
				font-weight: 400;
			}

			.hero-title {
				display: block;
				font-family: var(--font-display);
				font-size: clamp(3.4rem, 9vw, 8rem);
				line-height: 0.86;
				font-variation-settings: 'opsz' 144, 'wght' 900;
				/* Gradient text — accent color to near-white */
				background: linear-gradient(
					140deg,
					var(--accent) 0%,
					var(--ink) 42%,
					oklch(98% 0.008 var(--lead-hue)) 100%
				);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				text-wrap: balance;
				max-width: 14ch;
				letter-spacing: -0.01em;
			}

			.hero-description {
				max-width: 60ch;
				margin: 0.6rem 0 0;
				font-family: var(--font-ui);
				font-size: clamp(1rem, 1.5vw, 1.3rem);
				line-height: 1.5;
				color: var(--ink-soft);
				font-weight: 400;
			}

			.hero-footer { display: grid; gap: 1.1rem; }

			/* Tags */
			.hero-tags {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				flex-wrap: wrap;
			}

			.tag-pill {
				display: inline-flex;
				align-items: center;
				border: 1px solid color-mix(in oklch, oklch(72% 0.2 var(--tag-hue)) 48%, transparent);
				background: color-mix(in oklch, oklch(65% 0.2 var(--tag-hue)) 14%, transparent);
				color: oklch(80% 0.14 var(--tag-hue));
				padding: 0.32rem 0.56rem;
				font-size: 0.68rem;
				font-weight: 500;
				line-height: 1;
				letter-spacing: 0.04em;
				box-shadow: inset 0 0 10px color-mix(in oklch, oklch(72% 0.2 var(--tag-hue)) 8%, transparent);
			}

			/* Actions row */
			.hero-actions {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.hero-cta {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				min-height: 2.6rem;
				padding: 0.6rem 1.1rem;
				border: 1px solid var(--border-hot);
				background: color-mix(in oklch, var(--accent) 14%, transparent);
				color: var(--accent);
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 700;
				line-height: 1;
				text-decoration: none;
				letter-spacing: 0.03em;
				transition: background 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
			}

			.hero-cta:hover {
				background: color-mix(in oklch, var(--accent) 24%, transparent);
				box-shadow: 0 0 20px var(--accent-glow);
				border-color: var(--accent);
			}

			.hero-cta .cta-arrow { font-size: 1em; }

			.story-meta {
				font-size: 0.72rem;
				color: var(--ink-muted);
				align-self: center;
			}

			/* ── Right column: image + meta card ─────────────────── */
			.hero-media {
				display: grid;
				align-content: stretch;
				gap: 0.85rem;
				min-width: 0;
			}

			.hero-image {
				display: block;
				min-height: 0;
				height: 100%;
				border: 1px solid var(--border-mid);
				background: oklch(14% 0.032 var(--lead-hue));
				overflow: hidden;
				box-shadow:
					0 0 40px color-mix(in oklch, var(--accent) 12%, transparent),
					inset 0 0 0 1px var(--border);
			}

			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				filter: brightness(0.88) contrast(1.05);
				transition: filter 220ms ease;
			}

			.hero-image:hover img { filter: brightness(0.96) contrast(1.02); }

			/* Meta card — terminal window style */
			.hero-card {
				display: grid;
				gap: 0;
				border: 1px solid var(--border-mid);
				background: oklch(12% 0.03 var(--lead-hue));
				overflow: hidden;
			}

			.hero-card-titlebar {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				padding: 0.5rem 0.75rem;
				border-bottom: 1px solid var(--border);
				background: oklch(14% 0.032 var(--lead-hue));
			}

			.titlebar-dot {
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: oklch(55% 0.18 var(--lead-hue));
				opacity: 0.7;
			}

			.titlebar-dot:nth-child(2) { background: oklch(72% 0.16 calc(var(--lead-hue) + 48)); }
			.titlebar-dot:nth-child(3) { background: oklch(70% 0.16 calc(var(--lead-hue) - 52)); }

			.titlebar-label {
				margin-left: auto;
				font-family: var(--font-mono);
				font-size: 0.66rem;
				color: var(--ink-muted);
			}

			.hero-card-body {
				padding: 0.85rem;
				display: grid;
				gap: 0.35rem;
			}

			.hero-card-body strong {
				font-family: var(--font-mono);
				font-size: 0.76rem;
				color: var(--accent);
				font-weight: 700;
			}

			.hero-card-body span {
				font-family: var(--font-ui);
				font-size: 0.84rem;
				color: var(--ink-soft);
				line-height: 1.45;
			}

			/* ── Archive board ────────────────────────────────────── */
			.archive-board {
				margin-top: 1.1rem;
				border: 1px solid var(--border);
				background: oklch(11.5% 0.026 var(--lead-hue));
			}

			.archive-head {
				display: flex;
				align-items: start;
				justify-content: space-between;
				gap: 1rem;
				padding: 1.1rem 1.25rem;
				border-bottom: 1px solid var(--border);
				background: oklch(13% 0.03 var(--lead-hue));
			}

			.archive-head-left { display: grid; gap: 0.2rem; }

			.section-label {
				font-size: 0.68rem;
				font-weight: 700;
				color: var(--accent);
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}

			.section-label::before { content: '// '; color: var(--ink-muted); }

			.archive-head h2 {
				margin: 0;
				font-family: var(--font-ui);
				font-size: 1.05rem;
				font-weight: 700;
				line-height: 1.1;
				color: var(--ink);
			}

			.archive-head p {
				margin: 0.3rem 0 0;
				font-family: var(--font-mono);
				font-size: 0.72rem;
				line-height: 1.5;
				color: var(--ink-muted);
				max-width: 56ch;
			}

			.archive-meta {
				display: flex;
				align-items: center;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.archive-note {
				display: inline-flex;
				align-items: center;
				border: 1px solid var(--border);
				background: color-mix(in oklch, var(--accent) 8%, transparent);
				color: var(--ink-muted);
				padding: 0.3rem 0.55rem;
				font-size: 0.66rem;
				font-weight: 500;
				line-height: 1;
				letter-spacing: 0.04em;
			}

			.log-count {
				font-size: 0.66rem;
				color: var(--accent);
				font-weight: 700;
			}

			/* Archive list */
			.archive-list {
				list-style: none;
				margin: 0;
				padding: 0 1.25rem;
			}

			.empty-state {
				margin: 0;
				padding: 1.25rem 0;
				font-size: 0.78rem;
				color: var(--ink-muted);
			}

			/* ── Animations ───────────────────────────────────────── */
			@keyframes dotPulse {
				0%, 100% { box-shadow: 0 0 6px var(--accent-glow); }
				50%       { box-shadow: 0 0 18px var(--accent-glow), 0 0 36px color-mix(in oklch, var(--accent) 15%, transparent); }
			}

			@keyframes cursorBlink {
				0%, 100% { opacity: 0.85; }
				50%       { opacity: 0; }
			}

			@media (prefers-reduced-motion: reduce) {
				.status-dot { animation: none; }
				.hero-prompt .prompt-cursor { animation: none; }
			}

			/* ── Responsive ───────────────────────────────────────── */
			@media (max-width: 1040px) {
				.hero-stage {
					grid-template-columns: 1fr;
					min-height: 0;
				}

				.hero-image {
					aspect-ratio: 16 / 9;
					height: auto;
				}

				.hero-title { font-size: clamp(3rem, 12vw, 5.5rem); }
			}

			@media (max-width: 760px) {
				.tech-shell { padding: 0.75rem 0.9rem 3rem; }

				.dateline {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.35rem;
					font-size: 0.7rem;
				}

				.hero-stage {
					margin-top: 0.75rem;
					padding: 1.1rem;
					/* Simplify bg on mobile for perf */
					background-size: 5rem 5rem, 5rem 5rem, auto, auto, auto;
				}

				.hero-title { font-size: clamp(2.6rem, 16vw, 4rem); max-width: 11ch; }
				.hero-description { font-size: 0.95rem; }

				.archive-head {
					flex-direction: column;
					align-items: flex-start;
				}

				.archive-list { padding: 0 0.9rem; }
			}
		</style>
	</head>
	<body style={`--lead-hue: ${leadHue};`}>
		<Header homepage={true} />
		<main class="tech-page" style={`--lead-hue: ${leadHue};`}>
			<div class="tech-shell">

				<!-- Dateline -->
				<div class="dateline" aria-label="Tech page metadata">
					<div class="dateline-pack">
						<span class="status-dot" aria-hidden="true"></span>
						<a href="/">mager.co</a>
						<span class="dateline-mark">/</span>
						<span>tech</span>
					</div>
					<div class="dateline-right">
						<span>{fullDate}</span>
						<span class="dateline-mark">·</span>
						<span>issue {issueNumber}</span>
						<span class="dateline-mark">·</span>
						<span>{firstYear}–{newestYear}</span>
					</div>
				</div>

				<!-- Hero: featured post -->
				{featuredPost && (
					<section class="hero-stage" aria-labelledby="tech-hero-title">
						<div class="hero-copy">
							<!-- Terminal prompt line -->
							<div class="hero-prompt" aria-hidden="true">
								<span class="prompt-sym">$</span>
								<span>cat lead-story.md</span>
								<span class="prompt-cursor"></span>
							</div>

							<div class="hero-brand">
								<p class="hero-eyebrow">Lead story</p>
								<span class="hero-title" id="tech-hero-title">{featuredPost.data.title}</span>
								<p class="hero-description">{featuredPost.data.description}</p>
							</div>

							<div class="hero-footer">
								<div class="hero-tags">
									{leadTags.map(tag => (
										<span class="tag-pill" style={`--tag-hue: ${tag.hue};`}>{tag.name}</span>
									))}
								</div>
								<div class="hero-actions">
									<a href={leadHref} class="hero-cta">
										Read post <span class="cta-arrow" aria-hidden="true">↗</span>
									</a>
									<span class="story-meta">{shortDate(featuredPost.data.pubDate)} · {archivePosts.length} more in log</span>
								</div>
							</div>
						</div>

						<div class="hero-media">
							{hasFeaturedImage && (
								<a class="hero-image" href={leadHref} aria-label={`Open ${featuredPost.data.title}`}>
									<img src={featuredPost.data.heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
								</a>
							)}
							<div class="hero-card">
								<div class="hero-card-titlebar" aria-hidden="true">
									<span class="titlebar-dot"></span>
									<span class="titlebar-dot"></span>
									<span class="titlebar-dot"></span>
									<span class="titlebar-label">tech.log — issue {issueNumber}</span>
								</div>
								<div class="hero-card-body">
									<strong>// build log</strong>
									<span>Agent systems, dev tools, CLIs, and the software ideas I keep testing in public.</span>
								</div>
							</div>
						</div>
					</section>
				)}

				<!-- Archive board -->
				<section class="archive-board" aria-labelledby="archive-heading">
					<header class="archive-head">
						<div class="archive-head-left">
							<span class="section-label">Archive</span>
							<h2 id="archive-heading">Build log</h2>
							<p>Dates, titles, summaries — sorted newest first. Tags are color-coded by topic.</p>
						</div>
						<div class="archive-meta">
							<span class="archive-note">newest first</span>
							<span class="archive-note log-count">{archivePosts.length} entries</span>
						</div>
					</header>
					<ul class="archive-list">
						{archivePosts.length > 0
							? archivePosts.map((post) => <TechPostRow post={post} />)
							: <p class="empty-state">// no additional entries yet</p>}
					</ul>
				</section>

			</div>
		</main>
		<Footer homepage={true} />
		<SecretSearch posts={allPosts} />
	</body>
</html>
