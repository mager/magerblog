---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodePostRow from '../components/code/CodePostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);
const latestIssueDate = featuredPost?.data.pubDate ?? new Date();

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric'
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric'
	}).format(date);

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags || []) {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	}
}

const topTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8);

const yearsCovered = new Set(posts.map(post => post.data.pubDate.getFullYear()));
const decadeStart = Math.min(...posts.map(post => post.data.pubDate.getFullYear()));
const issueNumber = String(posts.length).padStart(3, '0');
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Code - ${SITE_TITLE}`} description="A sharper editorial front page for programming, AI systems, product experiments, and shipping notes." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
		<style>
			:root {
				--bg: #071018;
				--bg-2: #0d1721;
				--panel: #121d27;
				--paper: #f5ecdb;
				--paper-2: #efe3cf;
				--ink: #0b1218;
				--ink-soft: #31424d;
				--line: rgba(11, 18, 24, 0.14);
				--line-strong: rgba(11, 18, 24, 0.28);
				--cream-line: rgba(245, 236, 219, 0.12);
				--mint: #7ef0bf;
				--cyan: #98cfff;
				--amber: #ffcf66;
				--red: #ff6c64;
				--paper-shadow: 0 28px 80px rgba(0, 0, 0, 0.35);
			}

			body {
				background:
					radial-gradient(circle at top, rgba(126, 240, 191, 0.12), transparent 24%),
					linear-gradient(180deg, #03080d 0%, var(--bg) 26%, var(--bg-2) 100%);
			}

			main.code-frontpage {
				width: min(1440px, calc(100% - 2rem));
				max-width: none;
				padding: 1rem 1rem 4rem;
			}

			.frontpage-shell {
				position: relative;
				border-radius: 24px;
				overflow: hidden;
				border: 1px solid rgba(245, 236, 219, 0.12);
				background:
					repeating-linear-gradient(0deg, rgba(255,255,255,0.025) 0, rgba(255,255,255,0.025) 1px, transparent 1px, transparent 5px),
					linear-gradient(180deg, rgba(6, 11, 16, 0.95), rgba(12, 20, 28, 0.98));
				box-shadow: 0 40px 120px rgba(0,0,0,0.5);
			}

			.monitor-topbar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				padding: 0.9rem 1rem;
				border-bottom: 1px solid var(--cream-line);
				background: rgba(255,255,255,0.02);
			}

			.monitor-lights,
			.topbar-meta {
				display: flex;
				align-items: center;
				gap: 0.65rem;
			}

			.monitor-lights span {
				width: 0.72rem;
				height: 0.72rem;
				border-radius: 999px;
				display: inline-block;
			}

			.monitor-lights span:nth-child(1) { background: var(--red); }
			.monitor-lights span:nth-child(2) { background: var(--amber); }
			.monitor-lights span:nth-child(3) { background: var(--mint); box-shadow: 0 0 12px rgba(126, 240, 191, 0.45); }

			.shell-label,
			.paper-label,
			.kicker,
			.terminal-chip,
			.ticker-item,
			.archive-kicker,
			.mini-label,
			.stat-label,
			.column-label {
				font-family: 'IBM Plex Mono', monospace;
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}

			.shell-label {
				font-size: 0.72rem;
				color: rgba(245, 236, 219, 0.74);
			}

			.topbar-meta {
				color: rgba(245, 236, 219, 0.45);
			}

			.newspaper {
				margin: 1rem;
				padding: 1.2rem;
				background: linear-gradient(180deg, var(--paper) 0%, var(--paper-2) 100%);
				color: var(--ink);
				border-radius: 18px;
				border: 1px solid rgba(11, 18, 24, 0.12);
				box-shadow: var(--paper-shadow);
			}

			.edition-bar {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--line-strong);
			}

			.edition-bar > div:nth-child(2) { text-align: center; }
			.edition-bar > div:last-child { text-align: right; }

			.paper-label {
				display: block;
				font-size: 0.7rem;
				color: #0e6a4b;
				margin-bottom: 0.18rem;
			}

			.edition-copy {
				display: block;
				font-family: 'IBM Plex Sans', sans-serif;
				font-size: 0.95rem;
				line-height: 1.35;
				color: var(--ink-soft);
			}

			.masthead {
				padding: 1.15rem 0 1rem;
				border-bottom: 3px double var(--line-strong);
				text-align: center;
			}

			.kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-size: 0.72rem;
				color: #0e6a4b;
			}

			.kicker::before,
			.kicker::after {
				content: '';
				width: 2.25rem;
				height: 1px;
				background: currentColor;
				opacity: 0.38;
			}

			.masthead-title {
				margin: 0.65rem 0 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(3.5rem, 10vw, 8rem);
				line-height: 0.85;
				letter-spacing: -0.06em;
				text-transform: uppercase;
				color: #09111a;
			}

			.masthead-subtitle {
				max-width: 52rem;
				margin: 0.85rem auto 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(1.1rem, 2vw, 1.7rem);
				line-height: 1.18;
				color: var(--ink-soft);
			}

			.ticker {
				display: grid;
				grid-template-columns: auto 1fr;
				margin: 1rem 0 1.25rem;
				border: 1px solid var(--line-strong);
				background: rgba(11, 18, 24, 0.04);
			}

			.ticker-label {
				padding: 0.8rem 1rem;
				background: #101920;
				color: var(--paper);
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.72rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			.ticker-track {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				padding: 0.7rem 1rem;
				flex-wrap: wrap;
			}

			.ticker-item {
				font-size: 0.7rem;
				color: var(--ink-soft);
			}

			.ticker-item strong { color: var(--ink); }

			.front-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.35fr) minmax(290px, 0.8fr);
				gap: 1.4rem;
			}

			.hero-story {
				display: grid;
				grid-template-columns: minmax(0, 1.2fr) 16rem;
				gap: 1.1rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid var(--line-strong);
			}

			.hero-card {
				display: flex;
				flex-direction: column;
				gap: 0.9rem;
			}

			.terminal-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.45rem 0.7rem;
				width: fit-content;
				font-size: 0.72rem;
				background: #101920;
				color: var(--mint);
				border-radius: 999px;
			}

			.terminal-chip::before {
				content: '▋';
				text-shadow: 0 0 8px rgba(126, 240, 191, 0.5);
			}

			.hero-headline {
				margin: 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(2.2rem, 5.5vw, 5.4rem);
				line-height: 0.9;
				letter-spacing: -0.05em;
				text-transform: uppercase;
			}

			.hero-headline a,
			.secondary-card-title a,
			.mini-story-title a {
				color: inherit;
			}

			.hero-deck {
				margin: 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(1.15rem, 1.8vw, 1.55rem);
				line-height: 1.18;
				color: var(--ink-soft);
			}

			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
			}

			.hero-tag,
			.tag-board span {
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.68rem;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				padding: 0.42rem 0.55rem;
				border: 1px solid rgba(11, 18, 24, 0.12);
				background: rgba(11, 18, 24, 0.035);
				color: var(--ink-soft);
			}

			.hero-notes,
			.rail-panel {
				padding: 1rem;
				background: rgba(255, 255, 255, 0.24);
				border: 1px solid var(--line-strong);
			}

			.hero-notes {
				display: grid;
				gap: 0.9rem;
			}

			.hero-note {
				padding-bottom: 0.8rem;
				border-bottom: 1px solid rgba(11, 18, 24, 0.08);
			}

			.hero-note:last-child {
				padding-bottom: 0;
				border-bottom: none;
			}

			.hero-note strong,
			.secondary-card-title,
			.stat-value,
			.archive-heading,
			.mini-story-title {
				font-family: 'IBM Plex Sans Condensed', sans-serif;
			}

			.hero-note strong {
				display: block;
				font-size: 1.1rem;
				letter-spacing: -0.03em;
				margin-bottom: 0.2rem;
			}

			.hero-note span,
			.secondary-card-copy,
			.archive-copy,
			.mini-story-copy,
			.sidebar-list {
				font-family: 'IBM Plex Sans', sans-serif;
				color: var(--ink-soft);
				line-height: 1.5;
			}

			.news-columns {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.9rem;
				margin-top: 1rem;
			}

			.secondary-card {
				padding-top: 0.85rem;
				border-top: 1px solid var(--line);
				display: grid;
				gap: 0.45rem;
			}

			.mini-label,
			.archive-kicker,
			.column-label,
			.stat-label {
				font-size: 0.68rem;
				color: #0e6a4b;
			}

			.secondary-card-title {
				font-size: clamp(1.35rem, 2.2vw, 2rem);
				line-height: 0.96;
				letter-spacing: -0.04em;
				text-transform: uppercase;
				margin: 0;
			}

			.side-rail,
			.archive-aside,
			.mini-stories {
				display: grid;
				gap: 1rem;
			}

			.stats-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.7rem;
			}

			.stat-box {
				padding: 0.75rem;
				background: rgba(11, 18, 24, 0.05);
				border: 1px solid rgba(11, 18, 24, 0.08);
			}

			.stat-value {
				display: block;
				font-size: 1.9rem;
				line-height: 0.9;
			}

			.sidebar-list {
				margin: 0;
				padding-left: 1.15rem;
			}

			.rail-panel.dark {
				background: #0f1720;
				border-color: rgba(126, 240, 191, 0.14);
			}

			.rail-panel.dark .column-label,
			.rail-panel.dark .mini-story-copy {
				color: rgba(126, 240, 191, 0.75);
			}

			.mini-story {
				padding-top: 0.75rem;
				border-top: 1px solid rgba(245, 236, 219, 0.08);
			}

			.mini-story:first-child {
				padding-top: 0;
				border-top: none;
			}

			.mini-story-title {
				margin: 0 0 0.2rem;
				font-size: 1.15rem;
				line-height: 1;
				text-transform: uppercase;
				letter-spacing: -0.03em;
				color: var(--paper);
			}

			.archive-section {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 18rem;
				gap: 1.3rem;
				margin-top: 1.3rem;
				padding-top: 1.3rem;
				border-top: 3px double var(--line-strong);
			}

			.archive-heading {
				margin: 0.25rem 0 0.5rem;
				font-size: clamp(1.9rem, 4vw, 3.2rem);
				line-height: 0.92;
				letter-spacing: -0.05em;
				text-transform: uppercase;
			}

			.archive-list {
				border-top: 1px solid var(--line-strong);
			}

			.tag-board {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag-board strong { color: var(--ink); }

			@media (max-width: 1080px) {
				.front-grid,
				.hero-story,
				.archive-section {
					grid-template-columns: 1fr;
				}

				.archive-aside {
					order: -1;
				}
			}

			@media (max-width: 720px) {
				main.code-frontpage {
					width: 100%;
					padding: 0.65rem 0 2rem;
				}

				.frontpage-shell {
					border-radius: 0;
					border-left: none;
					border-right: none;
				}

				.monitor-topbar {
					padding: 0.8rem 0.9rem;
				}

				.topbar-meta {
					gap: 0.45rem;
					font-size: 0.66rem;
				}

				.newspaper {
					margin: 0.7rem;
					padding: 0.95rem;
					border-radius: 14px;
				}

				.edition-bar {
					display: flex;
					flex-direction: column;
					gap: 0.55rem;
					padding-bottom: 0.85rem;
				}

				.edition-bar > div,
				.edition-bar > div:nth-child(2),
				.edition-bar > div:last-child {
					text-align: left;
				}

				.edition-bar > div:nth-child(2),
				.edition-bar > div:last-child {
					display: none;
				}

				.masthead {
					padding: 0.95rem 0 0.85rem;
					text-align: left;
				}

				.kicker {
					display: flex;
					justify-content: flex-start;
					font-size: 0.66rem;
					letter-spacing: 0.14em;
				}

				.kicker::after {
					display: none;
				}

				.masthead-title {
					font-size: clamp(2.5rem, 16vw, 4rem);
					line-height: 0.88;
					max-width: 6ch;
				}

				.masthead-subtitle {
					margin: 0.65rem 0 0;
					font-size: 1.35rem;
					line-height: 1.08;
				}

				.ticker {
					grid-template-columns: 1fr;
					margin: 0.9rem 0 1rem;
				}

				.ticker-label {
					padding: 0.65rem 0.8rem;
				}

				.ticker-track {
					padding: 0.65rem 0.8rem;
					gap: 0.55rem;
				}

				.hero-story {
					gap: 0.9rem;
					padding-bottom: 1rem;
				}

				.hero-card {
					gap: 0.75rem;
				}

				.hero-headline {
					font-size: clamp(1.95rem, 10vw, 3.1rem);
				}

				.hero-deck {
					font-size: 1.15rem;
				}

				.hero-notes {
					display: none;
				}

				.news-columns,
				.stats-grid {
					grid-template-columns: 1fr;
				}

				.secondary-card {
					padding-top: 0.7rem;
				}

				.secondary-card-title {
					font-size: 1.6rem;
				}

				.side-rail {
					margin-top: 0.9rem;
				}

				.side-rail .rail-panel:nth-child(2),
				.archive-aside .rail-panel:last-child {
					display: none;
				}

				.archive-section {
					margin-top: 1rem;
					padding-top: 1rem;
				}

				.archive-heading {
					font-size: 1.8rem;
				}

				.archive-copy {
					font-size: 0.98rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="code-frontpage">
			<div class="frontpage-shell">
				<div class="monitor-topbar">
					<div class="monitor-lights" aria-hidden="true">
						<span></span><span></span><span></span>
					</div>
					<div class="topbar-meta">
						<span class="shell-label">mager.co/code</span>
						<span>•</span>
						<span class="shell-label">live edition</span>
					</div>
				</div>

				<div class="newspaper">
					<div class="edition-bar">
						<div>
							<span class="paper-label">Edition {issueNumber}</span>
							<span class="edition-copy">{fullDate}</span>
						</div>
						<div>
							<span class="paper-label">Mager Multiplex Terminal</span>
							<span class="edition-copy">Shipping notes, AI systems, and code worth reading twice.</span>
						</div>
						<div>
							<span class="paper-label">Since {decadeStart}</span>
							<span class="edition-copy">{yearsCovered.size} years in archive</span>
						</div>
					</div>

					<div class="masthead">
						<div class="kicker">Late Edition • Tech Newspaper</div>
						<h1 class="masthead-title">Code Dispatch</h1>
						<p class="masthead-subtitle">Part newsroom, part terminal multiplexer, part running log of experiments worth stealing from.</p>
					</div>

					<div class="ticker">
						<div class="ticker-label">On the wire</div>
						<div class="ticker-track">
							{topTags.map(([tag, count]) => (
								<span class="ticker-item"><strong>{tag}</strong> {count}</span>
							))}
						</div>
					</div>

					<div class="front-grid">
						<section>
							{featuredPost && (
								<>
									<div class="hero-story">
										<div class="hero-card">
											<div class="terminal-chip">Lead story • {shortDate(featuredPost.data.pubDate)}</div>
											<h2 class="hero-headline"><a href={leadHref}>{featuredPost.data.title}</a></h2>
											<p class="hero-deck">The code section should feel like a publication, not a category page. Stronger type. Sharper contrast. Faster scanning.</p>
											<div class="hero-meta">
												{leadTags.map(tag => <span class="hero-tag">{tag}</span>)}
											</div>
										</div>

										<div class="hero-notes">
											<div class="hero-note">
												<strong>Editorial first</strong>
												<span>Lead with the newest idea and make the rest feel like a wire service.</span>
											</div>
											<div class="hero-note">
												<strong>Terminal frame</strong>
												<span>Keep the monitor shell, but let the paper do the talking.</span>
											</div>
											<div class="hero-note">
												<strong>Phone readable</strong>
												<span>Fewer boxes, stronger headlines, no invisible labels.</span>
											</div>
										</div>
									</div>

									<div class="news-columns">
										{secondaryPosts.map(post => (
											<article class="secondary-card">
												<span class="mini-label">{shortDate(post.data.pubDate)}</span>
												<h3 class="secondary-card-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
												<p class="secondary-card-copy">{(post.data.tags || []).slice(0, 4).join(' • ') || 'AI • systems • shipping'}</p>
											</article>
										))}
									</div>
								</>
							)}
						</section>

						<aside class="side-rail">
							<div class="rail-panel">
								<span class="column-label">Desk stats</span>
								<div class="stats-grid">
									<div class="stat-box">
										<span class="stat-value">{posts.length}</span>
										<span class="stat-label">stories</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">{topTags.length}</span>
										<span class="stat-label">beats</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">{yearsCovered.size}</span>
										<span class="stat-label">years</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">24/7</span>
										<span class="stat-label">hum</span>
									</div>
								</div>
							</div>

							<div class="rail-panel">
								<span class="column-label">Coverage map</span>
								<div class="tag-board">
									{topTags.map(([tag, count]) => <span><strong>{count}</strong> {tag}</span>)}
								</div>
							</div>

							<div class="rail-panel dark">
								<span class="column-label">Night desk</span>
								<div class="mini-stories">
									{posts.slice(0, 3).map(post => (
										<article class="mini-story">
											<h3 class="mini-story-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
											<p class="mini-story-copy">{shortDate(post.data.pubDate)} · {(post.data.tags || []).slice(0, 3).join(' • ') || 'field notes from the build queue'}</p>
										</article>
									))}
								</div>
							</div>
						</aside>
					</div>

					<div class="archive-section">
						<section>
							<span class="archive-kicker">Archive feed</span>
							<h2 class="archive-heading">All dispatches, sorted like a wire.</h2>
							<p class="archive-copy">The front page now does the seduction. The archive below does the work.</p>
							<div class="archive-list">
								{posts.length > 0
									? posts.map((post, i) => <CodePostRow post={post} index={i} />)
									: <p class="archive-copy">No code posts yet.</p>}
							</div>
						</section>

						<aside class="archive-aside">
							<div class="rail-panel">
								<span class="column-label">Archive note</span>
								<p class="archive-copy" style="margin: 0;">This should feel like a publication with a terminal problem, not a terminal with a publication problem.</p>
							</div>
						</aside>
					</div>
				</div>
			</div>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
