---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodePostRow from '../components/code/CodePostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);
const latestIssueDate = featuredPost?.data.pubDate ?? new Date();

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric'
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric'
	}).format(date);

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags || []) {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	}
}

const topTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8);

const yearsCovered = new Set(posts.map(post => post.data.pubDate.getFullYear()));
const decadeStart = Math.min(...posts.map(post => post.data.pubDate.getFullYear()));
const issueNumber = String(posts.length).padStart(3, '0');
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
const latestTitles = posts.slice(0, 4).map(post => post.data.title);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Code - ${SITE_TITLE}`} description="A premium dark-theme terminal landing page for code, AI systems, and build notes." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
		<style>
			:root {
				--bg: #04070c;
				--bg-2: #09111a;
				--bg-3: #0d1620;
				--panel: rgba(11, 17, 24, 0.86);
				--panel-2: rgba(15, 24, 34, 0.94);
				--line: rgba(230, 237, 243, 0.08);
				--line-strong: rgba(230, 237, 243, 0.16);
				--text: #e6edf3;
				--text-soft: #a4b0bb;
				--text-dim: #6f7a85;
				--mint: #7ee787;
				--cyan: #79c0ff;
				--purple: #bc8cff;
				--amber: #e3b341;
				--red: #ff7b72;
			}

			body {
				background:
					radial-gradient(circle at 15% 0%, rgba(121, 192, 255, 0.16), transparent 24%),
					radial-gradient(circle at 85% 0%, rgba(188, 140, 255, 0.14), transparent 22%),
					radial-gradient(circle at 50% 20%, rgba(126, 231, 135, 0.08), transparent 28%),
					linear-gradient(180deg, #020409 0%, var(--bg) 24%, var(--bg-2) 100%);
				color: var(--text);
			}

			main.code-frontpage {
				width: min(1500px, calc(100% - 2rem));
				max-width: none;
				padding: 1rem 1rem 4rem;
			}

			.frontpage-shell {
				position: relative;
				border-radius: 28px;
				overflow: hidden;
				border: 1px solid rgba(230, 237, 243, 0.08);
				background:
					repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.018) 0, rgba(255, 255, 255, 0.018) 1px, transparent 1px, transparent 4px),
					repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.015) 0, rgba(255, 255, 255, 0.015) 1px, transparent 1px, transparent 96px),
					linear-gradient(180deg, rgba(5, 8, 12, 0.98), rgba(9, 14, 21, 0.98));
				box-shadow: 0 50px 180px rgba(0, 0, 0, 0.58);
			}

			.frontpage-shell::before {
				content: '';
				position: absolute;
				inset: 0;
				background:
					radial-gradient(circle at 20% 0%, rgba(121, 192, 255, 0.14), transparent 28%),
					radial-gradient(circle at 100% 0%, rgba(188, 140, 255, 0.12), transparent 24%),
					radial-gradient(circle at 50% 100%, rgba(126, 231, 135, 0.06), transparent 25%);
				pointer-events: none;
			}

			.monitor-topbar,
			.stage,
			.hero-grid,
			.hero-main,
			.command-ribbon,
			.wire-grid,
			.archive-shell {
				position: relative;
				z-index: 1;
			}

			.monitor-topbar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				padding: 0.95rem 1.1rem;
				border-bottom: 1px solid var(--line);
				background: rgba(255, 255, 255, 0.025);
				backdrop-filter: blur(12px);
			}

			.monitor-lights,
			.topbar-meta,
			.topbar-status {
				display: flex;
				align-items: center;
				gap: 0.7rem;
			}

			.monitor-lights span {
				width: 0.74rem;
				height: 0.74rem;
				border-radius: 999px;
				display: inline-block;
			}

			.monitor-lights span:nth-child(1) { background: var(--red); }
			.monitor-lights span:nth-child(2) { background: var(--amber); }
			.monitor-lights span:nth-child(3) { background: var(--mint); box-shadow: 0 0 12px rgba(126, 231, 135, 0.46); }

			.shell-label,
			.kicker,
			.metric-label,
			.metric-chip,
			.panel-label,
			.ribbon-item,
			.wire-label,
			.archive-kicker,
			.hero-tag,
			.tag-board span,
			.mini-label,
			.stat-label {
				font-family: 'IBM Plex Mono', monospace;
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}

			.shell-label {
				font-size: 0.72rem;
				color: rgba(230, 237, 243, 0.74);
			}

			.topbar-meta,
			.topbar-status {
				color: rgba(230, 237, 243, 0.42);
				font-size: 0.72rem;
			}

			.live-dot {
				width: 0.5rem;
				height: 0.5rem;
				border-radius: 999px;
				background: var(--mint);
				box-shadow: 0 0 10px rgba(126, 231, 135, 0.55);
			}

			.stage {
				padding: 1.1rem;
			}

			.hero-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.28fr) minmax(290px, 0.72fr);
				gap: 1rem;
			}

			.hero-main,
			.panel,
			.archive-shell {
				border: 1px solid var(--line-strong);
				background: linear-gradient(180deg, rgba(12, 19, 27, 0.96), rgba(8, 13, 19, 0.96));
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
			}

			.hero-main {
				padding: 1.4rem;
				border-radius: 22px;
				overflow: hidden;
			}

			.hero-main::before {
				content: 'CODE';
				position: absolute;
				right: -0.04em;
				top: -0.08em;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(7rem, 18vw, 15rem);
				line-height: 0.8;
				letter-spacing: -0.08em;
				color: rgba(121, 192, 255, 0.07);
				pointer-events: none;
			}

			.hero-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-start;
				gap: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--line);
			}

			.kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-size: 0.7rem;
				color: var(--cyan);
			}

			.kicker::before,
			.kicker::after {
				content: '';
				width: 1.8rem;
				height: 1px;
				background: currentColor;
				opacity: 0.42;
			}

			.hero-subcopy {
				max-width: 28rem;
				margin-top: 0.85rem;
				font-family: 'Instrument Serif', serif;
				font-size: 1.15rem;
				line-height: 1.2;
				color: #c9d1d9;
			}

			.hero-metrics {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.7rem;
				min-width: 14rem;
			}

			.metric {
				padding: 0.8rem;
				border: 1px solid rgba(121, 192, 255, 0.1);
				background: rgba(121, 192, 255, 0.04);
				border-radius: 12px;
			}

			.metric-value {
				display: block;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: 1.9rem;
				line-height: 0.9;
				letter-spacing: -0.04em;
				color: var(--text);
			}

			.metric-label {
				display: block;
				margin-top: 0.35rem;
				font-size: 0.62rem;
				color: var(--mint);
			}

			.hero-body {
				display: grid;
				grid-template-columns: minmax(0, 1.25fr) 17rem;
				gap: 1rem;
				padding-top: 1.2rem;
			}

			.hero-copy {
				display: grid;
				gap: 0.85rem;
			}

			.hero-headline {
				margin: 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(2.6rem, 6vw, 5.7rem);
				line-height: 0.88;
				letter-spacing: -0.06em;
				text-transform: uppercase;
			}

			.hero-headline a,
			.secondary-card-title a,
			.mini-story-title a {
				color: inherit;
			}

			.hero-deck {
				margin: 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(1.18rem, 1.9vw, 1.6rem);
				line-height: 1.12;
				color: var(--text);
			}

			.hero-note-line {
				font-family: 'IBM Plex Sans', sans-serif;
				font-size: 1rem;
				line-height: 1.55;
				color: var(--text-soft);
				max-width: 48rem;
			}

			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
			}

			.hero-tag,
			.metric-chip,
			.tag-board span {
				font-size: 0.66rem;
				padding: 0.44rem 0.6rem;
				border: 1px solid rgba(121, 192, 255, 0.16);
				background: rgba(121, 192, 255, 0.06);
				color: var(--cyan);
				border-radius: 999px;
			}

			.hero-side {
				display: grid;
				gap: 0.8rem;
			}

			.side-card {
				padding: 0.95rem;
				border: 1px solid var(--line);
				border-radius: 14px;
				background: rgba(255, 255, 255, 0.02);
			}

			.panel-label,
			.wire-label,
			.archive-kicker,
			.stat-label,
			.mini-label {
				font-size: 0.66rem;
				color: var(--mint);
			}

			.side-title {
				margin: 0.4rem 0 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: 1.2rem;
				line-height: 1;
				letter-spacing: -0.03em;
				color: var(--text);
				text-transform: uppercase;
			}

			.side-copy,
			.secondary-card-copy,
			.archive-copy,
			.mini-story-copy,
			.edition-copy {
				font-family: 'IBM Plex Sans', sans-serif;
				line-height: 1.5;
				color: var(--text-soft);
			}

			.command-ribbon {
				display: grid;
				grid-template-columns: auto 1fr auto;
				gap: 1rem;
				align-items: center;
				margin-top: 1rem;
				padding: 0.9rem 1rem;
				border: 1px solid var(--line);
				border-radius: 16px;
				background: linear-gradient(90deg, rgba(126, 231, 135, 0.05), rgba(121, 192, 255, 0.05));
			}

			.command {
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.82rem;
				color: var(--mint);
				white-space: nowrap;
			}

			.ribbon-copy {
				font-family: 'IBM Plex Sans', sans-serif;
				font-size: 0.95rem;
				color: var(--text-soft);
			}

			.ribbon-pills {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.wire-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.9rem;
				margin-top: 1rem;
			}

			.secondary-card {
				padding: 1rem;
				border: 1px solid var(--line);
				border-radius: 16px;
				background: linear-gradient(180deg, rgba(15, 22, 31, 0.88), rgba(10, 15, 22, 0.88));
				display: grid;
				gap: 0.45rem;
			}

			.secondary-card-title {
				margin: 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(1.4rem, 2vw, 2rem);
				line-height: 0.95;
				letter-spacing: -0.04em;
				text-transform: uppercase;
				color: var(--text);
			}

			.sidebar {
				display: grid;
				gap: 1rem;
			}

			.panel {
				padding: 1rem;
				border-radius: 18px;
			}

			.night-desk {
				background:
					radial-gradient(circle at top right, rgba(126, 231, 135, 0.08), transparent 30%),
					linear-gradient(180deg, rgba(9, 16, 22, 0.98), rgba(6, 10, 15, 0.98));
			}

			.mini-stories,
			.tag-board {
				display: grid;
				gap: 0.75rem;
			}

			.mini-story {
				padding-top: 0.75rem;
				border-top: 1px solid rgba(230, 237, 243, 0.06);
			}

			.mini-story:first-child {
				padding-top: 0;
				border-top: none;
			}

			.mini-story-title {
				margin: 0 0 0.2rem;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: 1.15rem;
				line-height: 1;
				letter-spacing: -0.03em;
				color: var(--text);
				text-transform: uppercase;
			}

			.stats-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.7rem;
			}

			.stat-box {
				padding: 0.82rem;
				border: 1px solid rgba(121, 192, 255, 0.1);
				border-radius: 12px;
				background: rgba(121, 192, 255, 0.04);
			}

			.stat-value {
				display: block;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: 1.95rem;
				line-height: 0.9;
				letter-spacing: -0.04em;
				color: var(--text);
			}

			.tag-board {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.archive-shell {
				margin-top: 1rem;
				padding: 1.15rem;
				border-radius: 22px;
			}

			.archive-header {
				display: flex;
				justify-content: space-between;
				align-items: end;
				gap: 1rem;
				padding-bottom: 1rem;
				border-bottom: 1px solid var(--line);
			}

			.archive-heading {
				margin: 0.28rem 0 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(2rem, 4vw, 3.3rem);
				line-height: 0.92;
				letter-spacing: -0.05em;
				color: var(--text);
				text-transform: uppercase;
			}

			.archive-meta {
				display: flex;
				gap: 0.5rem;
				flex-wrap: wrap;
			}

			.archive-list {
				margin-top: 1rem;
				border-top: 1px solid var(--line);
			}

			@media (max-width: 1100px) {
				.hero-grid,
				.hero-body {
					grid-template-columns: 1fr;
				}

				.hero-metrics {
					min-width: 0;
				}
			}

			@media (max-width: 780px) {
				main.code-frontpage {
					width: 100%;
					padding: 0.65rem 0 2rem;
				}

				.frontpage-shell {
					border-radius: 0;
					border-left: none;
					border-right: none;
				}

				.monitor-topbar {
					padding: 0.82rem 0.9rem;
				}

				.topbar-meta,
				.topbar-status {
					font-size: 0.66rem;
					gap: 0.45rem;
				}

				.topbar-status { display: none; }

				.stage {
					padding: 0.75rem;
				}

				.hero-main,
				.archive-shell,
				.panel {
					padding: 0.95rem;
					border-radius: 14px;
				}

				.hero-header {
					grid-template-columns: 1fr;
					display: grid;
				}

				.hero-metrics {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.metric:nth-child(n+3) { display: none; }

				.hero-main::before {
					font-size: 7rem;
					right: -0.06em;
					top: 0.1em;
				}

				.kicker {
					font-size: 0.64rem;
				}

				.kicker::after { display: none; }

				.hero-subcopy {
					font-size: 1rem;
					max-width: none;
				}

				.hero-headline {
					font-size: clamp(2.15rem, 12vw, 3.6rem);
				}

				.hero-deck {
					font-size: 1.08rem;
				}

				.hero-note-line {
					font-size: 0.96rem;
				}

				.hero-side { grid-template-columns: 1fr; }

				.command-ribbon {
					grid-template-columns: 1fr;
					gap: 0.7rem;
				}

				.command { white-space: normal; }

				.wire-grid,
				.stats-grid {
					grid-template-columns: 1fr;
				}

				.sidebar .panel:nth-child(3) { display: none; }

				.archive-header {
					align-items: start;
					flex-direction: column;
					padding-bottom: 0.85rem;
				}

				.archive-heading {
					font-size: 1.8rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="code-frontpage">
			<div class="frontpage-shell">
				<div class="monitor-topbar">
					<div class="monitor-lights" aria-hidden="true">
						<span></span><span></span><span></span>
					</div>
					<div class="topbar-meta">
						<span class="shell-label">mager.co/code</span>
						<span>•</span>
						<span class="shell-label">edition {issueNumber}</span>
					</div>
					<div class="topbar-status">
						<span class="live-dot" aria-hidden="true"></span>
						<span>live dispatch</span>
					</div>
				</div>

				<div class="stage">
					<div class="hero-grid">
						<section class="hero-main">
							<div class="hero-header">
								<div>
									<div class="kicker">Late Edition • Terminal Dispatch</div>
									<div class="hero-subcopy">{fullDate} · The front page for shipped ideas, coding systems, AI workflows, and things worth stealing for your own stack.</div>
								</div>

								<div class="hero-metrics">
									<div class="metric">
										<span class="metric-value">{posts.length}</span>
										<span class="metric-label">dispatches</span>
									</div>
									<div class="metric">
										<span class="metric-value">{yearsCovered.size}</span>
										<span class="metric-label">years live</span>
									</div>
									<div class="metric">
										<span class="metric-value">{topTags.length}</span>
										<span class="metric-label">active beats</span>
									</div>
									<div class="metric">
										<span class="metric-value">24/7</span>
										<span class="metric-label">terminal hum</span>
									</div>
								</div>
							</div>

							<div class="hero-body">
								<div class="hero-copy">
									{featuredPost && (
										<>
											<div class="metric-chip">Lead story • {shortDate(featuredPost.data.pubDate)}</div>
											<h1 class="hero-headline"><a href={leadHref}>{featuredPost.data.title}</a></h1>
											<p class="hero-deck">The best dark theme code landing page on the web should feel like a cinematic build console: crisp hierarchy, premium contrast, terminal attitude, zero dead weight.</p>
											<p class="hero-note-line">This isn’t a category page anymore. It’s a publication surface with a command-line soul — one dominant lead, luminous metadata, and a feed that feels alive instead of merely organized.</p>
											<div class="hero-meta">
												{leadTags.map(tag => <span class="hero-tag">{tag}</span>)}
											</div>
										</>
									)}
								</div>

								<div class="hero-side">
									<div class="side-card">
										<span class="panel-label">Terminal desk</span>
										<h2 class="side-title">Dark. Sharp. Expensive.</h2>
										<p class="side-copy">No paper cosplay. No washed-out type. Just premium dark surfaces, electric accents, and a feed that scans instantly on mobile.</p>
									</div>
									<div class="side-card">
										<span class="panel-label">Coverage since {decadeStart}</span>
										<h2 class="side-title">Build queue alive</h2>
										<p class="side-copy">{latestTitles[0]} · {latestTitles[1]} · {latestTitles[2]}</p>
									</div>
								</div>
							</div>

							<div class="command-ribbon">
								<div class="command">$ tail -f ~/builds/code-dispatch.log</div>
								<div class="ribbon-copy">Terminal-grade typography, live-wire hierarchy, and a layout that makes recent work feel urgent and collectible.</div>
								<div class="ribbon-pills">
									{topTags.slice(0, 3).map(([tag]) => <span class="metric-chip">{tag}</span>)}
								</div>
							</div>

							<div class="wire-grid">
								{secondaryPosts.map(post => (
									<article class="secondary-card">
										<span class="wire-label">{shortDate(post.data.pubDate)}</span>
										<h2 class="secondary-card-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
										<p class="secondary-card-copy">{(post.data.tags || []).slice(0, 4).join(' • ') || 'AI • systems • shipping'}</p>
									</article>
								))}
							</div>
						</section>

						<aside class="sidebar">
							<section class="panel night-desk">
								<span class="panel-label">Night desk</span>
								<div class="mini-stories">
									{posts.slice(0, 3).map(post => (
										<article class="mini-story">
											<span class="mini-label">{shortDate(post.data.pubDate)}</span>
											<h2 class="mini-story-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
											<p class="mini-story-copy">{(post.data.tags || []).slice(0, 3).join(' • ') || 'field notes from the build queue'}</p>
										</article>
									))}
								</div>
							</section>

							<section class="panel">
								<span class="panel-label">Desk stats</span>
								<div class="stats-grid">
									<div class="stat-box">
										<span class="stat-value">{posts.length}</span>
										<span class="stat-label">stories</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">{topTags.length}</span>
										<span class="stat-label">beats</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">{yearsCovered.size}</span>
										<span class="stat-label">years</span>
									</div>
									<div class="stat-box">
										<span class="stat-value">{issueNumber}</span>
										<span class="stat-label">edition</span>
									</div>
								</div>
							</section>

							<section class="panel">
								<span class="panel-label">Coverage map</span>
								<div class="tag-board">
									{topTags.map(([tag, count]) => <span><strong>{count}</strong> {tag}</span>)}
								</div>
							</section>
						</aside>
					</div>

					<section class="archive-shell">
						<div class="archive-header">
							<div>
								<span class="archive-kicker">Archive feed</span>
								<h2 class="archive-heading">All dispatches, sorted like a wire.</h2>
								<p class="archive-copy">Keep the glow. Keep the speed. Let the archive feel like the terminal output beneath the hero.</p>
							</div>
							<div class="archive-meta">
								<span class="metric-chip">dark theme</span>
								<span class="metric-chip">terminal-first</span>
								<span class="metric-chip">mobile ready</span>
							</div>
						</div>

						<div class="archive-list">
							{posts.length > 0
								? posts.map((post, i) => <CodePostRow post={post} index={i} />)
								: <p class="archive-copy">No code posts yet.</p>}
						</div>
					</section>
				</div>
			</div>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
