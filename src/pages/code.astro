---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodePostRow from '../components/code/CodePostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featuredPost = posts[0];
const secondaryPosts = posts.slice(1, 5);
const latestIssueDate = featuredPost?.data.pubDate ?? new Date();

const fullDate = new Intl.DateTimeFormat('en-US', {
	weekday: 'long',
	month: 'long',
	day: 'numeric',
	year: 'numeric'
}).format(latestIssueDate);

const shortDate = (date: Date) =>
	new Intl.DateTimeFormat('en-US', {
		month: 'short',
		day: '2-digit',
		year: 'numeric'
	}).format(date);

const tagCounts = new Map<string, number>();
for (const post of posts) {
	for (const tag of post.data.tags || []) {
		tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
	}
}

const topTags = [...tagCounts.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 8);

const yearsCovered = new Set(posts.map(post => post.data.pubDate.getFullYear()));
const decadeStart = Math.min(...posts.map(post => post.data.pubDate.getFullYear()));
const issueNumber = String(posts.length).padStart(3, '0');
const leadTags = (featuredPost?.data.tags || []).slice(0, 4);
const leadHref = featuredPost ? `/blog/${featuredPost.id}/` : '#';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Code - ${SITE_TITLE}`} description="Dark terminal dispatches on code, AI systems, product experiments, and shipping notes." />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@500;600;700&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
		<style>
			:root {
				--bg: #060b10;
				--bg-2: #0b1117;
				--panel: #0f1720;
				--panel-2: #131c26;
				--panel-3: #0b141d;
				--line: rgba(230, 237, 243, 0.08);
				--line-strong: rgba(230, 237, 243, 0.16);
				--text: #e6edf3;
				--text-soft: #8b949e;
				--text-dim: #6e7681;
				--mint: #7ee787;
				--cyan: #79c0ff;
				--purple: #bc8cff;
				--amber: #e3b341;
				--red: #ff7b72;
			}

			body {
				background:
					radial-gradient(circle at top, rgba(121, 192, 255, 0.09), transparent 28%),
					radial-gradient(circle at 20% 0%, rgba(126, 231, 135, 0.08), transparent 24%),
					linear-gradient(180deg, #020409 0%, var(--bg) 26%, var(--bg-2) 100%);
			}

			main.code-frontpage {
				width: min(1440px, calc(100% - 2rem));
				max-width: none;
				padding: 1rem 1rem 4rem;
			}

			.frontpage-shell {
				position: relative;
				border-radius: 24px;
				overflow: hidden;
				border: 1px solid rgba(230, 237, 243, 0.08);
				background:
					repeating-linear-gradient(0deg, rgba(255,255,255,0.018) 0, rgba(255,255,255,0.018) 1px, transparent 1px, transparent 4px),
					linear-gradient(180deg, rgba(6, 10, 14, 0.98), rgba(11, 17, 23, 0.98));
				box-shadow: 0 42px 140px rgba(0,0,0,0.55);
			}

			.monitor-topbar {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 1rem;
				padding: 0.9rem 1rem;
				border-bottom: 1px solid var(--line);
				background: rgba(255,255,255,0.02);
			}

			.monitor-lights,
			.topbar-meta {
				display: flex;
				align-items: center;
				gap: 0.65rem;
			}

			.monitor-lights span {
				width: 0.72rem;
				height: 0.72rem;
				border-radius: 999px;
				display: inline-block;
			}

			.monitor-lights span:nth-child(1) { background: var(--red); }
			.monitor-lights span:nth-child(2) { background: var(--amber); }
			.monitor-lights span:nth-child(3) { background: var(--mint); box-shadow: 0 0 12px rgba(126, 231, 135, 0.45); }

			.shell-label,
			.kicker,
			.terminal-chip,
			.ticker-item,
			.archive-kicker,
			.mini-label,
			.stat-label,
			.column-label,
			.panel-label,
			.hero-tag,
			.tag-board span {
				font-family: 'IBM Plex Mono', monospace;
				text-transform: uppercase;
				letter-spacing: 0.12em;
			}

			.shell-label {
				font-size: 0.72rem;
				color: rgba(230, 237, 243, 0.74);
			}

			.topbar-meta {
				color: rgba(230, 237, 243, 0.42);
			}

			.terminal-screen {
				padding: 1rem;
			}

			.hero-shell {
				padding: 1.15rem;
				background: linear-gradient(180deg, rgba(15, 23, 32, 0.98), rgba(11, 20, 29, 0.98));
				border: 1px solid var(--line-strong);
				border-radius: 18px;
				box-shadow: inset 0 1px 0 rgba(255,255,255,0.03);
			}

			.edition-bar {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
				padding-bottom: 0.9rem;
				border-bottom: 1px solid var(--line);
			}

			.edition-bar > div:nth-child(2) { text-align: center; }
			.edition-bar > div:last-child { text-align: right; }

			.panel-label,
			.column-label,
			.archive-kicker,
			.stat-label,
			.mini-label {
				font-size: 0.68rem;
				color: var(--mint);
			}

			.edition-copy,
			.hero-note span,
			.secondary-card-copy,
			.archive-copy,
			.mini-story-copy,
			.sidebar-list {
				font-family: 'IBM Plex Sans', sans-serif;
				line-height: 1.5;
				color: var(--text-soft);
			}

			.edition-copy {
				display: block;
				font-size: 0.94rem;
				margin-top: 0.18rem;
			}

			.masthead {
				padding: 1.1rem 0 1rem;
				border-bottom: 1px solid var(--line);
			}

			.kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				font-size: 0.7rem;
				color: var(--cyan);
			}

			.kicker::before,
			.kicker::after {
				content: '';
				width: 2rem;
				height: 1px;
				background: currentColor;
				opacity: 0.42;
			}

			.masthead-title {
				margin: 0.65rem 0 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(3.5rem, 10vw, 8rem);
				line-height: 0.83;
				letter-spacing: -0.06em;
				text-transform: uppercase;
				color: var(--text);
				text-shadow: 0 0 24px rgba(121, 192, 255, 0.08);
			}

			.masthead-subtitle {
				max-width: 54rem;
				margin: 0.8rem 0 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(1.12rem, 1.8vw, 1.55rem);
				line-height: 1.14;
				color: #c9d1d9;
			}

			.ticker {
				display: grid;
				grid-template-columns: auto 1fr;
				margin: 1rem 0 1.2rem;
				border: 1px solid var(--line);
				background: rgba(121, 192, 255, 0.03);
			}

			.ticker-label {
				padding: 0.8rem 1rem;
				background: #0a131b;
				color: var(--mint);
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.12em;
				text-transform: uppercase;
				border-right: 1px solid var(--line);
			}

			.ticker-track {
				display: flex;
				align-items: center;
				gap: 0.85rem;
				padding: 0.72rem 1rem;
				flex-wrap: wrap;
			}

			.ticker-item {
				font-size: 0.68rem;
				color: var(--text-soft);
			}

			.ticker-item strong {
				color: var(--cyan);
				margin-right: 0.3rem;
			}

			.front-grid {
				display: grid;
				grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.82fr);
				gap: 1.3rem;
			}

			.hero-story {
				display: grid;
				grid-template-columns: minmax(0, 1.2fr) 16rem;
				gap: 1rem;
				padding-bottom: 1.2rem;
				border-bottom: 1px solid var(--line);
			}

			.hero-card {
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
			}

			.terminal-chip {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.46rem 0.68rem;
				width: fit-content;
				font-size: 0.7rem;
				background: rgba(126, 231, 135, 0.08);
				color: var(--mint);
				border: 1px solid rgba(126, 231, 135, 0.14);
				border-radius: 999px;
			}

			.terminal-chip::before {
				content: '▋';
				text-shadow: 0 0 8px rgba(126, 231, 135, 0.5);
			}

			.hero-headline {
				margin: 0;
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				font-size: clamp(2.2rem, 5.6vw, 5.2rem);
				line-height: 0.9;
				letter-spacing: -0.05em;
				text-transform: uppercase;
			}

			.hero-headline a,
			.secondary-card-title a,
			.mini-story-title a {
				color: inherit;
			}

			.hero-deck {
				margin: 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(1.08rem, 1.7vw, 1.4rem);
				line-height: 1.15;
				color: #c9d1d9;
			}

			.hero-meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.55rem;
			}

			.hero-tag,
			.tag-board span {
				font-size: 0.66rem;
				padding: 0.42rem 0.55rem;
				border: 1px solid rgba(121, 192, 255, 0.15);
				background: rgba(121, 192, 255, 0.06);
				color: var(--cyan);
			}

			.hero-notes,
			.rail-panel,
			.archive-shell {
				padding: 1rem;
				background: linear-gradient(180deg, rgba(17, 25, 34, 0.94), rgba(11, 18, 25, 0.94));
				border: 1px solid var(--line);
				border-radius: 14px;
			}

			.hero-notes {
				display: grid;
				gap: 0.85rem;
			}

			.hero-note {
				padding-bottom: 0.78rem;
				border-bottom: 1px solid rgba(230, 237, 243, 0.06);
			}

			.hero-note:last-child {
				padding-bottom: 0;
				border-bottom: none;
			}

			.hero-note strong,
			.secondary-card-title,
			.stat-value,
			.archive-heading,
			.mini-story-title {
				font-family: 'IBM Plex Sans Condensed', sans-serif;
				color: var(--text);
			}

			.hero-note strong {
				display: block;
				font-size: 1.08rem;
				letter-spacing: -0.03em;
				margin-bottom: 0.2rem;
			}

			.news-columns {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.9rem;
				margin-top: 1rem;
			}

			.secondary-card {
				display: grid;
				gap: 0.42rem;
				padding: 0.95rem 0;
				border-top: 1px solid var(--line);
			}

			.secondary-card-title {
				margin: 0;
				font-size: clamp(1.3rem, 2.1vw, 1.9rem);
				line-height: 0.96;
				letter-spacing: -0.04em;
				text-transform: uppercase;
			}

			.side-rail,
			.archive-aside,
			.mini-stories {
				display: grid;
				gap: 1rem;
			}

			.stats-grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 0.7rem;
			}

			.stat-box {
				padding: 0.78rem;
				background: rgba(121, 192, 255, 0.04);
				border: 1px solid rgba(121, 192, 255, 0.08);
				border-radius: 10px;
			}

			.stat-value {
				display: block;
				font-size: 1.85rem;
				line-height: 0.9;
			}

			.sidebar-list {
				margin: 0;
				padding-left: 1.1rem;
			}

			.rail-panel.dark {
				background: linear-gradient(180deg, rgba(10, 18, 24, 0.98), rgba(7, 13, 18, 0.98));
				border-color: rgba(126, 231, 135, 0.12);
			}

			.rail-panel.dark .column-label {
				color: var(--mint);
			}

			.mini-story {
				padding-top: 0.76rem;
				border-top: 1px solid rgba(230, 237, 243, 0.06);
			}

			.mini-story:first-child {
				padding-top: 0;
				border-top: none;
			}

			.mini-story-title {
				margin: 0 0 0.2rem;
				font-size: 1.12rem;
				line-height: 1;
				letter-spacing: -0.03em;
				text-transform: uppercase;
			}

			.archive-shell {
				margin-top: 1.2rem;
			}

			.archive-section {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 18rem;
				gap: 1.2rem;
			}

			.archive-heading {
				margin: 0.25rem 0 0.45rem;
				font-size: clamp(1.9rem, 4vw, 3rem);
				line-height: 0.92;
				letter-spacing: -0.05em;
				text-transform: uppercase;
			}

			.archive-list {
				border-top: 1px solid var(--line);
			}

			.tag-board {
				display: flex;
				flex-wrap: wrap;
				gap: 0.45rem;
			}

			.tag-board strong { color: var(--text); }

			@media (max-width: 1080px) {
				.front-grid,
				.hero-story,
				.archive-section {
					grid-template-columns: 1fr;
				}

				.archive-aside {
					order: -1;
				}
			}

			@media (max-width: 720px) {
				main.code-frontpage {
					width: 100%;
					padding: 0.65rem 0 2rem;
				}

				.frontpage-shell {
					border-radius: 0;
					border-left: none;
					border-right: none;
				}

				.monitor-topbar {
					padding: 0.8rem 0.9rem;
				}

				.topbar-meta {
					gap: 0.45rem;
				}

				.shell-label {
					font-size: 0.66rem;
				}

				.terminal-screen {
					padding: 0.75rem;
				}

				.hero-shell,
				.archive-shell,
				.rail-panel {
					padding: 0.9rem;
					border-radius: 12px;
				}

				.edition-bar {
					display: flex;
					flex-direction: column;
					gap: 0.48rem;
					padding-bottom: 0.75rem;
				}

				.edition-bar > div,
				.edition-bar > div:nth-child(2),
				.edition-bar > div:last-child {
					text-align: left;
				}

				.edition-bar > div:nth-child(2),
				.edition-bar > div:last-child {
					display: none;
				}

				.masthead {
					padding: 0.9rem 0 0.85rem;
				}

				.kicker {
					font-size: 0.64rem;
					letter-spacing: 0.14em;
				}

				.kicker::after {
					display: none;
				}

				.masthead-title {
					font-size: clamp(2.4rem, 15vw, 4rem);
					max-width: 6ch;
				}

				.masthead-subtitle {
					font-size: 1.05rem;
					line-height: 1.16;
				}

				.ticker {
					grid-template-columns: 1fr;
					margin: 0.9rem 0 1rem;
				}

				.ticker-label {
					padding: 0.68rem 0.8rem;
					border-right: none;
					border-bottom: 1px solid var(--line);
				}

				.ticker-track {
					padding: 0.68rem 0.8rem;
					gap: 0.55rem;
				}

				.hero-story {
					gap: 0.9rem;
					padding-bottom: 1rem;
				}

				.hero-headline {
					font-size: clamp(1.95rem, 10vw, 3rem);
				}

				.hero-deck {
					font-size: 1rem;
				}

				.hero-notes {
					display: none;
				}

				.news-columns,
				.stats-grid {
					grid-template-columns: 1fr;
				}

				.side-rail {
					margin-top: 0.9rem;
				}

				.side-rail .rail-panel:nth-child(2),
				.archive-aside .rail-panel:last-child {
					display: none;
				}

				.archive-shell {
					margin-top: 1rem;
				}

				.archive-heading {
					font-size: 1.7rem;
				}

				.archive-copy {
					font-size: 0.95rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="code-frontpage">
			<div class="frontpage-shell">
				<div class="monitor-topbar">
					<div class="monitor-lights" aria-hidden="true">
						<span></span><span></span><span></span>
					</div>
					<div class="topbar-meta">
						<span class="shell-label">mager.co/code</span>
						<span>•</span>
						<span class="shell-label">live edition</span>
					</div>
				</div>

				<div class="terminal-screen">
					<div class="hero-shell">
						<div class="edition-bar">
							<div>
								<span class="panel-label">Edition {issueNumber}</span>
								<span class="edition-copy">{fullDate}</span>
							</div>
							<div>
								<span class="panel-label">Terminal desk</span>
								<span class="edition-copy">Code, AI systems, and shipping notes from the build queue.</span>
							</div>
							<div>
								<span class="panel-label">Since {decadeStart}</span>
								<span class="edition-copy">{yearsCovered.size} years in archive</span>
							</div>
						</div>

						<div class="masthead">
							<div class="kicker">Late Edition • Terminal Dispatch</div>
							<h1 class="masthead-title">Code Dispatch</h1>
							<p class="masthead-subtitle">A dark multiplex for code posts: lead story up top, wire feed underneath, terminal hum all the way through.</p>
						</div>

						<div class="ticker">
							<div class="ticker-label">On the wire</div>
							<div class="ticker-track">
								{topTags.map(([tag, count]) => (
									<span class="ticker-item"><strong>{tag}</strong> {count}</span>
								))}
							</div>
						</div>

						<div class="front-grid">
							<section>
								{featuredPost && (
									<>
										<div class="hero-story">
											<div class="hero-card">
												<div class="terminal-chip">Lead story • {shortDate(featuredPost.data.pubDate)}</div>
												<h2 class="hero-headline"><a href={leadHref}>{featuredPost.data.title}</a></h2>
												<p class="hero-deck">The code section should feel like a real terminal publication: sharp, dark, fast to scan, and a little dangerous.</p>
												<div class="hero-meta">
													{leadTags.map(tag => <span class="hero-tag">{tag}</span>)}
												</div>
											</div>

											<div class="hero-notes">
												<div class="hero-note">
													<strong>Dark by default</strong>
													<span>No paper tones. No washed-out headlines. The archive should glow, not fade.</span>
												</div>
												<div class="hero-note">
													<strong>Terminal first</strong>
													<span>Everything sits inside one coherent shell: monitor chrome, wire labels, luminous tags.</span>
												</div>
												<div class="hero-note">
													<strong>Phone readable</strong>
													<span>One strong lead, clean feed rows, and no decorative baggage that muddies the hierarchy.</span>
												</div>
											</div>
										</div>

										<div class="news-columns">
											{secondaryPosts.map(post => (
												<article class="secondary-card">
													<span class="mini-label">{shortDate(post.data.pubDate)}</span>
													<h3 class="secondary-card-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
													<p class="secondary-card-copy">{(post.data.tags || []).slice(0, 4).join(' • ') || 'AI • systems • shipping'}</p>
												</article>
											))}
										</div>
									</>
								)}
							</section>

							<aside class="side-rail">
								<div class="rail-panel">
									<span class="column-label">Desk stats</span>
									<div class="stats-grid">
										<div class="stat-box">
											<span class="stat-value">{posts.length}</span>
											<span class="stat-label">stories</span>
										</div>
										<div class="stat-box">
											<span class="stat-value">{topTags.length}</span>
											<span class="stat-label">beats</span>
										</div>
										<div class="stat-box">
											<span class="stat-value">{yearsCovered.size}</span>
											<span class="stat-label">years</span>
										</div>
										<div class="stat-box">
											<span class="stat-value">24/7</span>
											<span class="stat-label">hum</span>
										</div>
									</div>
								</div>

								<div class="rail-panel dark">
									<span class="column-label">Night desk</span>
									<div class="mini-stories">
										{posts.slice(0, 3).map(post => (
											<article class="mini-story">
												<h3 class="mini-story-title"><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
												<p class="mini-story-copy">{shortDate(post.data.pubDate)} · {(post.data.tags || []).slice(0, 3).join(' • ') || 'field notes from the build queue'}</p>
											</article>
										))}
									</div>
								</div>

								<div class="rail-panel">
									<span class="column-label">Coverage map</span>
									<div class="tag-board">
										{topTags.map(([tag, count]) => <span><strong>{count}</strong> {tag}</span>)}
									</div>
								</div>
							</aside>
						</div>
					</div>

					<div class="archive-shell">
						<div class="archive-section">
							<section>
								<span class="archive-kicker">Archive feed</span>
								<h2 class="archive-heading">All dispatches, sorted like a wire.</h2>
								<p class="archive-copy">Lead story on top. Terminal feed below. Dark all the way through.</p>
								<div class="archive-list">
									{posts.length > 0
										? posts.map((post, i) => <CodePostRow post={post} index={i} />)
										: <p class="archive-copy">No code posts yet.</p>}
								</div>
							</section>

							<aside class="archive-aside">
								<div class="rail-panel">
									<span class="column-label">Archive note</span>
									<p class="archive-copy" style="margin: 0;">This now reads like a terminal publication, not a beige editorial experiment wearing the wrong clothes.</p>
								</div>
							</aside>
						</div>
					</div>
				</div>
			</div>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
