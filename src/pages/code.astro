---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CodePostRow from '../components/code/CodePostRow.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
	.filter(post => post.data.category === 'code')
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Code - ${SITE_TITLE}`} description="Programming, development, and tech adventures" />
		<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&display=swap" rel="stylesheet" />
		<style>
			main {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 2.5rem;
			}

			/* ── HERO HEADER ───────────────────────────────── */
			.page-header {
				padding: 4rem 0 0;
				margin-bottom: 0;
				position: relative;
				overflow: hidden;
			}

			/* Scanline CRT overlay */
			.page-header::after {
				content: '';
				position: absolute;
				inset: 0;
				background: repeating-linear-gradient(
					0deg,
					transparent,
					transparent 2px,
					rgba(163, 113, 247, 0.018) 2px,
					rgba(163, 113, 247, 0.018) 4px
				);
				pointer-events: none;
				z-index: 1;
			}

			.hero-title {
				font-family: 'Barlow Condensed', sans-serif;
				font-weight: 900;
				font-size: clamp(5.5rem, 20vw, 12rem);
				line-height: 0.88;
				letter-spacing: -0.02em;
				margin: 0;
				background: linear-gradient(
					135deg,
					#E6EDF3 0%,
					#BC8CFF 35%,
					#79C0FF 70%,
					#58A6FF 100%
				);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				animation: heroIn 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
				position: relative;
				z-index: 2;
			}

			@keyframes heroIn {
				from { opacity: 0; transform: translateY(24px) skewY(1deg); }
				to   { opacity: 1; transform: translateY(0) skewY(0deg); }
			}

			.page-header-meta {
				display: flex;
				align-items: center;
				gap: 1.5rem;
				padding: 1rem 0 2rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				animation: metaIn 0.7s 0.15s cubic-bezier(0.16, 1, 0.3, 1) both;
				position: relative;
				z-index: 2;
			}

			@keyframes metaIn {
				from { opacity: 0; transform: translateX(-12px); }
				to   { opacity: 1; transform: translateX(0); }
			}

			@keyframes blink {
				0%, 100% { opacity: 1; }
				50% { opacity: 0; }
			}

			.terminal-prompt {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.82rem;
				font-weight: 700;
				color: var(--text-secondary);
				letter-spacing: -0.01em;
			}

			.terminal-prompt .prompt {
				color: var(--accent-green);
				margin-right: 0.4rem;
			}

			.terminal-prompt .cursor {
				color: var(--accent-green);
				animation: blink 1s infinite;
			}

			.post-count {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				color: var(--text-muted);
				letter-spacing: 0.03em;
			}

			.post-count strong {
				color: var(--purple-bright);
				font-weight: 700;
			}

			/* ── COLUMN HEADERS ────────────────────────────── */
			.list-header {
				display: grid;
				grid-template-columns: 8.5rem 1fr auto;
				gap: 2rem;
				padding: 0.5rem 1.25rem;
				margin-top: 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.06);
				animation: metaIn 0.7s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;
			}

			.list-header span {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.62rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.14em;
				color: var(--text-muted);
				opacity: 0.45;
			}

			/* ── POST LIST ─────────────────────────────────── */
			.post-list {
				padding: 0.25rem 0 4rem;
			}

			/* Staggered row entrance */
			.post-list :global(.code-row) {
				opacity: 0;
				animation: rowIn 0.45s cubic-bezier(0.16, 1, 0.3, 1) forwards;
			}

			@keyframes rowIn {
				from { opacity: 0; transform: translateX(-10px); }
				to   { opacity: 1; transform: translateX(0); }
			}

			.post-list :global(.code-row:nth-child(1))  { animation-delay: 0.32s; }
			.post-list :global(.code-row:nth-child(2))  { animation-delay: 0.37s; }
			.post-list :global(.code-row:nth-child(3))  { animation-delay: 0.42s; }
			.post-list :global(.code-row:nth-child(4))  { animation-delay: 0.47s; }
			.post-list :global(.code-row:nth-child(5))  { animation-delay: 0.52s; }
			.post-list :global(.code-row:nth-child(6))  { animation-delay: 0.57s; }
			.post-list :global(.code-row:nth-child(7))  { animation-delay: 0.61s; }
			.post-list :global(.code-row:nth-child(8))  { animation-delay: 0.65s; }
			.post-list :global(.code-row:nth-child(9))  { animation-delay: 0.68s; }
			.post-list :global(.code-row:nth-child(10)) { animation-delay: 0.71s; }
			.post-list :global(.code-row:nth-child(11)) { animation-delay: 0.73s; }
			.post-list :global(.code-row:nth-child(12)) { animation-delay: 0.75s; }
			.post-list :global(.code-row:nth-child(n+13)) { animation-delay: 0.77s; }

			.empty-state {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--text-muted);
				padding: 3rem 1rem;
				text-align: center;
			}

			@media (max-width: 720px) {
				main {
					padding: 0;
				}

				.page-header {
					padding: 2rem 1.25rem 0;
				}

				.list-header {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1 class="hero-title">CODE</h1>
				<div class="page-header-meta">
					<span class="terminal-prompt">
						<span class="prompt">~</span>$ ls -la ~/code<span class="cursor">█</span>
					</span>
					<span class="post-count">
						<strong>{posts.length}</strong> post{posts.length !== 1 ? 's' : ''} · sorted by date desc
					</span>
				</div>
			</div>

			<div class="list-header">
				<span>date</span>
				<span>title</span>
				<span>tags</span>
			</div>

			<div class="post-list">
				{posts.length > 0
					? posts.map((post, i) => <CodePostRow post={post} index={i} />)
					: <p class="empty-state">// no posts yet</p>
				}
			</div>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />

		<script>
			// 👾 hey nerd — you opened devtools on a blog. respect.
			console.log(
				'%c CODE  ',
				'background: linear-gradient(135deg, #A371F7, #79C0FF); color: #0D1117; font-family: monospace; font-weight: 900; font-size: 28px; padding: 4px 8px; border-radius: 2px;'
			);
			console.log('%c → mager.co  |  built with Astro + vibes + too much coffee', 'color: #7EE787; font-family: monospace; font-size: 11px;');
			console.log('%c   source: github.com/mager  |  hire me maybe?            ', 'color: #484F58; font-family: monospace; font-size: 11px;');
		</script>
	</body>
</html>
