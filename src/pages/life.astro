---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import LifeCard from '../components/life/LifeCard.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import '../styles/life.css';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
  .filter(post => post.data.category === 'life')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
const featuredTags = (featured?.data.tags || []).slice(0, 3);
const latestYear = posts[0]?.data.pubDate.getFullYear() || new Date().getFullYear();
---

<html lang="en" data-life>
  <head>
    <BaseHead title={`Life — ${SITE_TITLE}`} description="Chicago exploration and personal adventures" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500;600&family=Cormorant+Garamond:wght@500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <style>
      .life-shell {
        position: relative;
        isolation: isolate;
      }

      .life-shell::before,
      .life-shell::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: -1;
      }

      .life-shell::before {
        background:
          radial-gradient(circle at 8% 14%, rgba(95, 128, 76, 0.18), transparent 18%),
          radial-gradient(circle at 92% 10%, rgba(160, 108, 71, 0.14), transparent 18%),
          radial-gradient(circle at 50% 48%, rgba(95, 128, 76, 0.08), transparent 30%);
      }

      .life-shell::after {
        background-image:
          linear-gradient(to right, rgba(95, 128, 76, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(95, 128, 76, 0.04) 1px, transparent 1px);
        background-size: 88px 88px;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 84%);
      }

      .life-hero {
        position: relative;
        padding: 7.5rem 1.5rem 2.5rem;
        overflow: clip;
      }

      .life-hero::before,
      .life-hero::after {
        content: '';
        position: absolute;
        pointer-events: none;
      }

      .life-hero::before {
        inset: 0 auto auto 0;
        width: min(42rem, 58vw);
        height: 24rem;
        background:
          radial-gradient(circle at 50% 40%, rgba(250, 242, 228, 0.86), rgba(250, 242, 228, 0.2) 38%, transparent 70%);
        filter: blur(10px);
      }

      .life-hero::after {
        right: -5rem;
        top: -5rem;
        width: 24rem;
        height: 24rem;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(128, 155, 98, 0.16), transparent 62%);
        filter: blur(12px);
      }

      .canopy {
        position: absolute;
        inset: 0 0 auto;
        height: min(30rem, 54vw);
        pointer-events: none;
        opacity: 0.92;
      }

      .canopy svg {
        width: 100%;
        height: 100%;
        display: block;
      }

      .canopy-layer {
        transform-origin: top center;
        animation: lf-sway 18s ease-in-out infinite;
      }

      .canopy-layer.layer-2 {
        animation-duration: 24s;
        animation-direction: reverse;
        opacity: 0.82;
      }

      .hero-inner {
        position: relative;
        z-index: 2;
        max-width: 1240px;
        margin: 0 auto;
        display: grid;
        gap: 2rem;
      }

      .hero-top {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
        gap: 1.7rem;
        align-items: end;
      }

      .hero-copy {
        position: relative;
        padding: 2.2rem 0 0 1.4rem;
      }

      .hero-copy::before {
        content: '';
        position: absolute;
        left: 0;
        top: 1rem;
        bottom: 1rem;
        width: 1px;
        background: linear-gradient(to bottom, transparent, rgba(94, 118, 80, 0.46), transparent);
      }

      .hero-copy::after {
        content: '';
        position: absolute;
        left: 0;
        bottom: 0;
        width: 9rem;
        height: 9rem;
        border-left: 1px solid rgba(94, 118, 80, 0.16);
        border-bottom: 1px solid rgba(94, 118, 80, 0.16);
        border-bottom-left-radius: 2.25rem;
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0 0 1.3rem;
        font-family: 'Azeret Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--lf-green);
        animation: lf-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
      }

      .hero-kicker::before {
        content: '';
        width: 2.4rem;
        height: 1px;
        background: currentColor;
        opacity: 0.7;
      }

      .hero-title {
        margin: 0;
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
        font-size: clamp(4.8rem, 15vw, 10rem);
        letter-spacing: -0.07em;
        line-height: 0.82;
        color: var(--lf-text);
        animation: lf-fadeUp 0.74s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
      }

      .hero-title .ink {
        position: relative;
        display: inline-block;
      }

      .hero-title .ink::after {
        content: '';
        position: absolute;
        left: 0.08em;
        right: 0.06em;
        bottom: 0.16em;
        height: 0.18em;
        background: rgba(160, 108, 71, 0.18);
        border-radius: 999px;
        z-index: -1;
        transform: rotate(-1.8deg);
      }

      .hero-subtitle {
        max-width: 38rem;
        margin: 1.35rem 0 0;
        font-size: 1.2rem;
        line-height: 1.72;
        color: var(--lf-text-secondary);
        animation: lf-fadeUp 0.82s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
        margin-top: 1.9rem;
        animation: lf-fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
      }

      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.68rem 1rem;
        border-radius: 999px;
        background: rgba(255, 251, 245, 0.72);
        border: 1px solid rgba(94, 118, 80, 0.13);
        box-shadow: 0 10px 24px rgba(73, 59, 41, 0.05);
        color: var(--lf-text-secondary);
        font-family: 'Azeret Mono', monospace;
        font-size: 0.67rem;
        letter-spacing: 0.09em;
        text-transform: uppercase;
      }

      .hero-chip .seed {
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        background: var(--lf-green);
        box-shadow: 0 0 0 6px rgba(94, 118, 80, 0.08);
        animation: lf-glow 2.8s ease-in-out infinite;
      }

      .hero-aside {
        display: grid;
        gap: 1rem;
      }

      .field-note,
      .hero-orbit {
        position: relative;
        border-radius: 1.8rem;
        overflow: hidden;
        border: 1px solid rgba(94, 118, 80, 0.12);
        box-shadow: var(--lf-shadow);
        backdrop-filter: blur(10px);
      }

      .field-note {
        padding: 1.45rem;
        background: linear-gradient(180deg, rgba(255,255,255,0.58), rgba(244, 236, 223, 0.78));
        animation: lf-fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.34s both;
      }

      .field-note::before {
        content: '';
        position: absolute;
        inset: auto -1.2rem -1.8rem auto;
        width: 10rem;
        height: 10rem;
        border: 1px solid rgba(94, 118, 80, 0.18);
        border-radius: 60% 40% 55% 45%;
        transform: rotate(18deg);
      }

      .field-note::after {
        content: '❦';
        position: absolute;
        right: 1rem;
        top: 0.8rem;
        font-size: 2.1rem;
        color: rgba(94, 118, 80, 0.18);
        animation: lf-sway 7s ease-in-out infinite;
      }

      .field-note-label,
      .orbit-label,
      .featured-label,
      .section-kicker {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }

      .field-note-label {
        color: var(--lf-accent);
        margin-bottom: 0.9rem;
      }

      .field-note p {
        margin: 0;
        font-size: 1.02rem;
        color: var(--lf-text-secondary);
      }

      .field-note p + p {
        margin-top: 1rem;
      }

      .hero-orbit {
        min-height: 10rem;
        padding: 1.2rem 1.3rem;
        background:
          radial-gradient(circle at 20% 26%, rgba(255,255,255,0.52), transparent 22%),
          linear-gradient(180deg, rgba(242, 234, 221, 0.86), rgba(234, 224, 207, 0.84));
        animation: lf-fadeUp 0.85s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
      }

      .orbit-label {
        color: var(--lf-green);
      }

      .orbit-rings {
        position: relative;
        height: 7.4rem;
        margin-top: 0.7rem;
      }

      .orbit-rings span {
        position: absolute;
        inset: 50% auto auto 50%;
        border: 1px solid rgba(94, 118, 80, 0.16);
        border-radius: 50%;
        transform: translate(-50%, -50%);
      }

      .orbit-rings span:nth-child(1) { width: 8.4rem; height: 8.4rem; }
      .orbit-rings span:nth-child(2) { width: 5.9rem; height: 5.9rem; }
      .orbit-rings span:nth-child(3) { width: 3.4rem; height: 3.4rem; }

      .orbit-rings::before,
      .orbit-rings::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        background: var(--lf-green);
      }

      .orbit-rings::before {
        width: 0.7rem;
        height: 0.7rem;
        left: calc(50% + 3.5rem);
        top: calc(50% - 2.8rem);
        box-shadow: 0 0 0 10px rgba(94, 118, 80, 0.06);
      }

      .orbit-rings::after {
        width: 0.42rem;
        height: 0.42rem;
        left: calc(50% - 1.2rem);
        top: calc(50% + 1.4rem);
        background: var(--lf-accent);
        box-shadow: 0 0 0 7px rgba(160, 108, 71, 0.08);
      }

      .hero-featured {
        max-width: 1240px;
        margin: 1.6rem auto 0;
        padding: 1.2rem;
        border-radius: 2rem;
        position: relative;
        background:
          linear-gradient(135deg, rgba(255,255,255,0.64), rgba(238, 229, 214, 0.78)),
          linear-gradient(180deg, rgba(94, 118, 80, 0.05), rgba(160, 108, 71, 0.05));
        border: 1px solid rgba(94, 118, 80, 0.14);
        box-shadow: var(--lf-shadow-lg);
        overflow: hidden;
      }

      .hero-featured::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 6% 18%, rgba(255,255,255,0.3), transparent 16%),
          radial-gradient(circle at 92% 78%, rgba(94, 118, 80, 0.08), transparent 22%);
        pointer-events: none;
      }

      .featured-grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
        gap: 1.3rem;
        align-items: stretch;
      }

      .featured-copy {
        padding: 1rem 0.35rem 0.65rem 0.5rem;
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      .featured-label {
        color: var(--lf-green);
        margin-bottom: 0.8rem;
      }

      .featured-copy h2 {
        font-family: 'Cormorant Garamond', serif;
        font-size: clamp(2.5rem, 6vw, 4.8rem);
        line-height: 0.9;
        letter-spacing: -0.05em;
        margin: 0;
        text-wrap: balance;
      }

      .featured-copy p {
        margin: 1rem 0 0;
        max-width: 34rem;
        font-size: 1.06rem;
        line-height: 1.72;
        color: var(--lf-text-secondary);
      }

      .featured-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.7rem;
        margin-top: 1.3rem;
      }

      .featured-pill,
      .featured-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.6rem;
        padding: 0.72rem 1rem;
        border-radius: 999px;
        font-family: 'Azeret Mono', monospace;
        font-size: 0.66rem;
        letter-spacing: 0.11em;
        text-transform: uppercase;
      }

      .featured-pill {
        background: rgba(255,255,255,0.66);
        border: 1px solid rgba(94, 118, 80, 0.12);
        color: var(--lf-text-secondary);
      }

      .featured-link {
        background: linear-gradient(135deg, rgba(94, 118, 80, 0.98), rgba(64, 88, 58, 0.98));
        color: #f7f1e7 !important;
        box-shadow: 0 18px 34px rgba(49, 70, 46, 0.18);
      }

      .featured-link:hover {
        color: #fff8ef !important;
        transform: translateY(-1px);
      }

      .featured-trails {
        border-radius: 1.5rem;
        padding: 1.05rem 1.1rem;
        background: rgba(252, 249, 244, 0.58);
        border: 1px solid rgba(94, 118, 80, 0.1);
        display: grid;
        align-content: start;
        gap: 0.85rem;
      }

      .featured-trails strong {
        font-family: 'Cormorant Garamond', serif;
        font-size: 1.5rem;
        font-weight: 600;
        letter-spacing: -0.03em;
      }

      .featured-trails ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.7rem;
      }

      .featured-trails li {
        display: grid;
        gap: 0.2rem;
        padding-left: 1rem;
        position: relative;
      }

      .featured-trails li::before {
        content: '•';
        position: absolute;
        left: 0;
        top: 0.02rem;
        color: var(--lf-accent);
      }

      .featured-trails span {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.62rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
      }

      .featured-trails p {
        margin: 0;
        color: var(--lf-text-secondary);
        font-size: 0.95rem;
        line-height: 1.55;
      }

      .life-grid-section {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.8rem 1.5rem 6rem;
      }

      .section-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        padding: 0 0 1.35rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(94, 118, 80, 0.16);
      }

      .section-copy {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
      }

      .section-kicker {
        color: var(--lf-green);
      }

      .section-copy strong {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
        font-size: clamp(2.2rem, 5vw, 3.25rem);
        letter-spacing: -0.045em;
        line-height: 0.95;
      }

      .section-copy p {
        margin: 0;
        max-width: 36rem;
        color: var(--lf-text-secondary);
        font-size: 1rem;
      }

      .section-count {
        padding: 0.72rem 1rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.58);
        border: 1px solid rgba(94, 118, 80, 0.12);
        color: var(--lf-text-secondary);
        font-family: 'Azeret Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .life-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.7rem;
      }

      .life-grid > :first-child {
        grid-column: 1 / -1;
      }

      .life-footer {
        padding: 0 1.5rem 4.5rem;
      }

      .footer-panel {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.7rem 1.8rem;
        border-radius: 1.8rem;
        background: linear-gradient(180deg, rgba(255,255,255,0.52), rgba(238, 228, 213, 0.74));
        border: 1px solid rgba(94, 118, 80, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        align-items: center;
        justify-content: space-between;
      }

      .footer-copyblock {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .footer-brand {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: var(--lf-text);
      }

      .footer-tagline,
      .footer-copy {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-link {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--lf-green-bright) !important;
      }

      .footer-link:hover {
        color: var(--lf-accent) !important;
      }

      .footer-copy a {
        color: inherit !important;
      }

      kbd {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.65rem;
        padding: 0.12rem 0.4rem;
        background: rgba(255,255,255,0.78);
        border: 1px solid rgba(94, 118, 80, 0.12);
        border-radius: 0.45rem;
        box-shadow: inset 0 -2px 0 rgba(94, 118, 80, 0.08);
      }

      @media (max-width: 960px) {
        .hero-top,
        .featured-grid {
          grid-template-columns: 1fr;
        }

        .hero-copy {
          padding-right: 0;
        }

        .hero-aside {
          max-width: 40rem;
        }

        .life-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        .life-hero {
          padding: 6.3rem 1.15rem 1.8rem;
        }

        .canopy {
          height: 13rem;
        }

        .hero-copy {
          padding: 1.7rem 0 0 0.9rem;
        }

        .hero-title {
          font-size: clamp(4rem, 21vw, 5.8rem);
        }

        .hero-subtitle {
          font-size: 1.04rem;
        }

        .hero-featured,
        .life-grid-section,
        .life-footer {
          padding-left: 1.15rem;
          padding-right: 1.15rem;
        }

        .hero-featured {
          padding: 0.9rem;
        }

        .featured-copy h2 {
          font-size: 2.3rem;
        }

        .footer-panel {
          padding: 1.35rem 1.2rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <div class="life-shell">
      <section class="life-hero">
        <div class="canopy" aria-hidden="true">
          <svg viewBox="0 0 1600 520" fill="none" xmlns="http://www.w3.org/2000/svg">
            <g class="canopy-layer layer-1">
              <path d="M0 0H1600V190C1498 168 1410 128 1308 146C1217 161 1146 239 1032 223C932 209 857 131 763 132C653 134 585 245 461 255C335 266 248 170 136 148C95 139 52 141 0 152V0Z" fill="rgba(72, 97, 60, 0.18)"/>
              <path d="M0 0H1600V130C1511 115 1452 82 1367 92C1272 104 1232 187 1146 194C1077 200 1019 152 954 132C880 109 805 108 740 150C665 198 642 277 545 285C430 294 360 184 259 167C172 152 93 188 0 213V0Z" fill="rgba(58, 80, 49, 0.12)"/>
            </g>
            <g class="canopy-layer layer-2">
              <path d="M0 0H1600V94C1509 127 1408 171 1303 163C1201 155 1143 87 1040 83C920 78 853 173 724 182C592 191 518 94 402 84C260 71 142 164 0 180V0Z" fill="rgba(129, 153, 104, 0.14)"/>
            </g>
          </svg>
        </div>

        <div class="hero-inner">
          <div class="hero-top">
            <div class="hero-copy">
              <p class="hero-kicker">life in the understory</p>
              <h1 class="hero-title"><span class="ink">Life</span></h1>
              <p class="hero-subtitle">
                Notes from Chicago, travel, cooking-adjacent detours, and the kind of days worth pressing into a journal until they start to feel like mythology.
              </p>
              <div class="hero-meta">
                <div class="hero-chip"><span class="seed"></span> Chicago, IL</div>
                <div class="hero-chip">forest earth vine tree</div>
                <div class="hero-chip">edition {latestYear}</div>
              </div>
            </div>

            <aside class="hero-aside">
              <div class="field-note">
                <div class="field-note-label">Field note</div>
                <p>I wanted this page to feel less like a category archive and more like a handcrafted clearing in the site.</p>
                <p>Warm paper. Mossy greens. Bark shadows. Little signs of wind moving through it.</p>
              </div>

              <div class="hero-orbit">
                <div class="orbit-label">Trail map</div>
                <div class="orbit-rings">
                  <span></span>
                  <span></span>
                  <span></span>
                </div>
              </div>
            </aside>
          </div>
        </div>

        {featured && (
          <div class="hero-featured">
            <div class="featured-grid">
              <div class="featured-copy">
                <div class="featured-label">Featured story</div>
                <h2>{featured.data.title}</h2>
                <p>{featured.data.description}</p>
                <div class="featured-meta">
                  <a href={`/blog/${featured.id}/`} class="featured-link">Read the feature</a>
                  {featuredTags.map((tag) => (
                    <span class="featured-pill">{tag}</span>
                  ))}
                </div>
              </div>

              <aside class="featured-trails">
                <strong>What lives here</strong>
                <ul>
                  <li>
                    <span>Travel scraps</span>
                    <p>Places, visits, and the stories that stick after the flight home.</p>
                  </li>
                  <li>
                    <span>Personal seasons</span>
                    <p>Gardening, food, change, career turns, and the weirdly important small stuff.</p>
                  </li>
                  <li>
                    <span>Collected moods</span>
                    <p>A quieter shelf of the blog where memory matters more than velocity.</p>
                  </li>
                </ul>
              </aside>
            </div>
          </div>
        )}
      </section>

      <main class="life-grid-section">
        <div class="section-heading">
          <div class="section-copy">
            <span class="section-kicker">Collected posts</span>
            <strong>Stories, snapshots, and side trails</strong>
            <p>Everything in this section is part diary, part artifact — a record of places, eras, experiments, and whatever felt worth keeping.</p>
          </div>
          <div class="section-count">{posts.length} entries</div>
        </div>

        <div class="life-grid" id="life-grid">
          {featured && (
            <LifeCard post={featured} featured={true} index={0} />
          )}
          {rest.map((post, i) => (
            <LifeCard post={post} index={i + 1} />
          ))}
        </div>
      </main>

      <footer class="life-footer">
        <div class="footer-panel">
          <div class="footer-copyblock">
            <div class="footer-brand">Life</div>
            <p class="footer-tagline">Stories from Chicago and beyond</p>
            <p class="footer-copy">Built with <a href="https://astro.build" target="_blank">Astro</a> · press <kbd>/</kbd> to search</p>
          </div>
          <div class="footer-links">
            <a href="/" class="footer-link">mager.co</a>
            <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
          </div>
        </div>
      </footer>
    </div>

    <SecretSearch posts={allPosts} />
  </body>
</html>
