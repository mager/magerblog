---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import LifeCard from '../components/life/LifeCard.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import '../styles/life.css';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
  .filter(post => post.data.category === 'life')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
---

<html lang="en" data-life>
  <head>
    <BaseHead title={`Life — ${SITE_TITLE}`} description="Chicago exploration and personal adventures" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* ── Hero Section ── */
      .life-hero {
        position: relative;
        padding: 10rem 2rem 6rem;
        text-align: center;
        overflow: hidden;
        background: var(--lf-bg);
      }

      /* Ambient orbs */
      .life-hero::before,
      .life-hero::after {
        content: '';
        position: absolute;
        border-radius: 50%;
        filter: blur(120px);
        pointer-events: none;
      }

      .life-hero::before {
        width: 600px;
        height: 600px;
        background: rgba(63, 185, 80, 0.08);
        top: -250px;
        right: -150px;
      }

      .life-hero::after {
        width: 400px;
        height: 400px;
        background: rgba(88, 166, 255, 0.06);
        bottom: -150px;
        left: -100px;
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 800px;
        margin: 0 auto;
      }

      .hero-eyebrow {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--lf-green);
        margin-bottom: 1.5rem;
        animation: lf-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
      }

      .hero-eyebrow::before {
        content: '> ';
        opacity: 0.5;
      }

      .hero-title {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-weight: 700;
        font-size: clamp(4rem, 12vw, 8rem);
        letter-spacing: -0.04em;
        line-height: 0.95;
        color: var(--lf-text);
        margin: 0 0 1.5rem;
        animation: lf-fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
      }

      .hero-title .green-dot {
        color: var(--lf-green-bright);
        text-shadow: 0 0 20px rgba(63, 185, 80, 0.4);
      }

      .hero-subtitle {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.95rem;
        color: var(--lf-text-secondary);
        line-height: 1.7;
        max-width: 500px;
        margin: 0 auto 2.5rem;
        animation: lf-fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.25s both;
      }

      /* Location badge */
      .hero-location {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
        background: var(--lf-bg-surface);
        border: 1px solid var(--lf-border);
        padding: 0.5rem 1rem;
        border-radius: 100px;
        animation: lf-fadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.35s both;
      }

      .hero-location .pulse {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--lf-green);
        box-shadow: 0 0 8px var(--lf-green-glow);
        animation: lf-glow 2s ease-in-out infinite;
      }

      /* ── Post Grid ── */
      .life-grid-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 3rem 2rem 6rem;
      }

      .section-label {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
        margin-bottom: 2rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--lf-border);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        animation: lf-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.4s both;
      }

      .section-label .count {
        color: var(--lf-green);
        font-weight: 700;
      }

      .life-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 2rem;
      }

      /* Featured card spans full width */
      .life-grid > :first-child {
        grid-column: 1 / -1;
      }

      /* ── Footer ── */
      .life-footer {
        padding: 3rem 2rem;
        background: var(--lf-bg-alt);
        border-top: 1px solid var(--lf-border);
        text-align: center;
      }

      .footer-brand {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--lf-green);
        letter-spacing: 0.15em;
        margin-bottom: 0.5rem;
      }

      .footer-tagline {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.8rem;
        color: var(--lf-text-muted);
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .footer-link {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.75rem;
        color: var(--lf-text-muted) !important;
        text-decoration: none !important;
        transition: color 0.2s ease !important;
      }

      .footer-link:hover {
        color: var(--lf-green) !important;
      }

      .footer-copy {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.65rem;
        color: var(--lf-text-muted);
        margin-top: 1.5rem;
        opacity: 0.5;
      }

      /* ── Mobile ── */
      @media (max-width: 720px) {
        .life-hero {
          padding: 6rem 1.5rem 4rem;
        }

        .hero-title {
          letter-spacing: -0.03em;
        }

        .hero-subtitle {
          font-size: 0.85rem;
        }

        .life-grid-section {
          padding: 2rem 1.25rem 4rem;
        }

        .life-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- Hero -->
    <section class="life-hero">
      <div class="hero-inner">
        <p class="hero-eyebrow">from the city</p>
        <h1 class="hero-title">LIFE<span class="green-dot">.</span></h1>
        <p class="hero-subtitle">
          Adventures, explorations & stories from
          Chicago and beyond.
        </p>
        <div class="hero-location">
          <span class="pulse"></span>
          Chicago, IL
        </div>
      </div>
    </section>

    <!-- Post Grid -->
    <main class="life-grid-section">
      <div class="section-label">
        All posts <span class="count">{posts.length}</span>
      </div>
      <div class="life-grid" id="life-grid">
        {featured && (
          <LifeCard post={featured} featured={true} index={0} />
        )}
        {rest.map((post, i) => (
          <LifeCard post={post} index={i + 1} />
        ))}
      </div>
    </main>

    <!-- Footer -->
    <footer class="life-footer">
      <div class="footer-brand">LIFE</div>
      <p class="footer-tagline">Stories from Chicago and beyond</p>
      <div class="footer-links">
        <a href="/" class="footer-link">mager.co</a>
        <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} · Built with <a href="https://astro.build" target="_blank" class="footer-link" style="display:inline">Astro</a> · Press <kbd style="font-family:'JetBrains Mono',monospace;font-size:0.6rem;padding:0.1rem 0.35rem;background:var(--lf-bg-surface);border:1px solid var(--lf-border);border-radius:3px">/</kbd> to search</p>
    </footer>

    <SecretSearch posts={allPosts} />
  </body>
</html>
