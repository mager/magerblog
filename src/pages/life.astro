---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import LifeCard from '../components/life/LifeCard.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import '../styles/life.css';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = allPosts
  .filter(post => post.data.category === 'life')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
const latestYear = posts[0]?.data.pubDate.getFullYear() || new Date().getFullYear();
---

<html lang="en" data-life>
  <head>
    <BaseHead title={`Life — ${SITE_TITLE}`} description="Chicago exploration and personal adventures" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500;600&family=Cormorant+Garamond:wght@500;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" rel="stylesheet" />
    <style>
      .life-shell {
        position: relative;
        isolation: isolate;
      }

      .life-shell::before,
      .life-shell::after {
        content: '';
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: -1;
      }

      .life-shell::before {
        background:
          radial-gradient(circle at 8% 14%, rgba(95, 128, 76, 0.18), transparent 18%),
          radial-gradient(circle at 92% 10%, rgba(160, 108, 71, 0.14), transparent 18%),
          radial-gradient(circle at 50% 48%, rgba(95, 128, 76, 0.08), transparent 30%);
      }

      .life-shell::after {
        background-image:
          linear-gradient(to right, rgba(95, 128, 76, 0.04) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(95, 128, 76, 0.04) 1px, transparent 1px);
        background-size: 88px 88px;
        mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.32), transparent 84%);
      }

      .life-hero {
        position: relative;
        padding: 7.3rem 1.5rem 1.8rem;
      }

      .life-hero::before {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        height: 14rem;
        pointer-events: none;
        background: radial-gradient(circle at 20% 0%, rgba(250, 242, 228, 0.85), transparent 38%);
        filter: blur(12px);
      }

      .hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1240px;
        margin: 0 auto;
      }

      .hero-copy {
        max-width: 44rem;
        padding-left: 1.1rem;
        position: relative;
      }

      .hero-copy::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0.2rem;
        bottom: 0.2rem;
        width: 1px;
        background: linear-gradient(to bottom, transparent, rgba(94, 118, 80, 0.42), transparent);
      }

      .hero-kicker,
      .section-kicker {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--lf-green);
      }

      .hero-kicker {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        margin: 0 0 1.15rem;
        animation: lf-fadeUp 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
      }

      .hero-kicker::before {
        content: '';
        width: 2.2rem;
        height: 1px;
        background: currentColor;
        opacity: 0.7;
      }

      .hero-title {
        margin: 0;
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
        font-size: clamp(4rem, 12vw, 7.2rem);
        letter-spacing: -0.06em;
        line-height: 0.88;
        color: var(--lf-text);
        animation: lf-fadeUp 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
      }

      .hero-subtitle {
        max-width: 38rem;
        margin: 1.15rem 0 0;
        font-size: 1.12rem;
        line-height: 1.72;
        color: var(--lf-text-secondary);
        animation: lf-fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
      }

      .hero-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.72rem;
        margin-top: 1.5rem;
        animation: lf-fadeUp 0.84s cubic-bezier(0.22, 1, 0.36, 1) 0.28s both;
      }

      .hero-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.62rem 0.92rem;
        border-radius: 999px;
        background: rgba(255, 251, 245, 0.68);
        border: 1px solid rgba(94, 118, 80, 0.12);
        box-shadow: 0 8px 18px rgba(73, 59, 41, 0.04);
        color: var(--lf-text-secondary);
        font-family: 'Azeret Mono', monospace;
        font-size: 0.65rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .hero-chip .seed {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: var(--lf-green);
        box-shadow: 0 0 0 6px rgba(94, 118, 80, 0.08);
        animation: lf-glow 2.8s ease-in-out infinite;
      }

      .life-grid-section {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.2rem 1.5rem 6rem;
      }

      .section-heading {
        display: flex;
        flex-wrap: wrap;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        padding: 0 0 1.35rem;
        margin-bottom: 2rem;
        border-bottom: 1px solid rgba(94, 118, 80, 0.16);
      }

      .section-copy {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
      }

      .section-copy strong {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 600;
        font-size: clamp(2.2rem, 5vw, 3.25rem);
        letter-spacing: -0.045em;
        line-height: 0.95;
      }

      .section-copy p {
        margin: 0;
        max-width: 36rem;
        color: var(--lf-text-secondary);
        font-size: 1rem;
      }

      .section-count {
        padding: 0.72rem 1rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.58);
        border: 1px solid rgba(94, 118, 80, 0.12);
        color: var(--lf-text-secondary);
        font-family: 'Azeret Mono', monospace;
        font-size: 0.7rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .life-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.7rem;
      }

      .life-grid > :first-child {
        grid-column: 1 / -1;
      }

      .life-footer {
        padding: 0 1.5rem 4.5rem;
      }

      .footer-panel {
        max-width: 1240px;
        margin: 0 auto;
        padding: 1.7rem 1.8rem;
        border-radius: 1.8rem;
        background: linear-gradient(180deg, rgba(255,255,255,0.52), rgba(238, 228, 213, 0.74));
        border: 1px solid rgba(94, 118, 80, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 2rem;
        align-items: center;
        justify-content: space-between;
      }

      .footer-copyblock {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .footer-brand {
        font-family: 'Cormorant Garamond', serif;
        font-size: 2rem;
        font-weight: 600;
        letter-spacing: -0.04em;
        color: var(--lf-text);
      }

      .footer-tagline,
      .footer-copy {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-link {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--lf-green-bright) !important;
      }

      .footer-link:hover {
        color: var(--lf-accent) !important;
      }

      .footer-copy a {
        color: inherit !important;
      }

      kbd {
        font-family: 'Azeret Mono', monospace;
        font-size: 0.65rem;
        padding: 0.12rem 0.4rem;
        background: rgba(255,255,255,0.78);
        border: 1px solid rgba(94, 118, 80, 0.12);
        border-radius: 0.45rem;
        box-shadow: inset 0 -2px 0 rgba(94, 118, 80, 0.08);
      }

      @media (max-width: 960px) {
        .life-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 720px) {
        .life-hero {
          padding: 6.1rem 1.15rem 1.2rem;
        }

        .hero-copy {
          padding-left: 0.9rem;
        }

        .hero-title {
          font-size: clamp(3.6rem, 18vw, 5.2rem);
        }

        .hero-subtitle {
          font-size: 1rem;
        }

        .life-grid-section,
        .life-footer {
          padding-left: 1.15rem;
          padding-right: 1.15rem;
        }

        .footer-panel {
          padding: 1.35rem 1.2rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <div class="life-shell">
      <section class="life-hero">
        <div class="hero-inner">
          <div class="hero-copy">
            <p class="hero-kicker">life archive</p>
            <h1 class="hero-title">Life</h1>
            <p class="hero-subtitle">
              Stories from Chicago and beyond — travel, personal history, small seasons, and the things I wanted to keep.
            </p>
            <div class="hero-meta">
              <div class="hero-chip"><span class="seed"></span> Chicago, IL</div>
              <div class="hero-chip">since 2008</div>
              <div class="hero-chip">edition {latestYear}</div>
            </div>
          </div>
        </div>
      </section>

      <main class="life-grid-section">
        <div class="section-heading">
          <div class="section-copy">
            <span class="section-kicker">Collected posts</span>
            <strong>Stories, snapshots, and side trails</strong>
            <p>Everything in this section is part diary, part artifact — a record of places, eras, experiments, and whatever felt worth keeping.</p>
          </div>
          <div class="section-count">{posts.length} entries</div>
        </div>

        <div class="life-grid" id="life-grid">
          {featured && (
            <LifeCard post={featured} featured={true} index={0} />
          )}
          {rest.map((post, i) => (
            <LifeCard post={post} index={i + 1} />
          ))}
        </div>
      </main>

      <footer class="life-footer">
        <div class="footer-panel">
          <div class="footer-copyblock">
            <div class="footer-brand">Life</div>
            <p class="footer-tagline">Stories from Chicago and beyond</p>
            <p class="footer-copy">Built with <a href="https://astro.build" target="_blank">Astro</a> · press <kbd>/</kbd> to search</p>
          </div>
          <div class="footer-links">
            <a href="/" class="footer-link">mager.co</a>
            <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
          </div>
        </div>
      </footer>
    </div>

    <SecretSearch posts={allPosts} />
  </body>
</html>
