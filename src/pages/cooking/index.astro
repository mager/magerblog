---
import Archive from '../../layouts/Archive.astro';
import { getFeed } from '../../lib/feed';
const all = await getFeed();
const entries = all.filter(entry => entry.collection === 'blog' && entry.data.category === 'food');
const types = [...new Set(entries.flatMap(entry => entry.collection === 'blog' && entry.data.subcategory ? [entry.data.subcategory] : []))].sort();
const filters: [string, string][] = [['all', 'All recipes'], ...types.map(type => [type, type[0].toUpperCase() + type.slice(1)] as [string, string])];
---
<Archive title="Cooking" description="Recipes from my kitchen: soups, pasta, slow braises, and more." entries={entries} sidebarEntries={all} featured filters={filters} filterBy="subcategory" />
