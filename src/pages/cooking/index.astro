---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import RecipeCard from '../../components/cooking/RecipeCard.astro';
import SecretSearch from '../../components/SecretSearch.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import '../../styles/cooking.css';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const recipes = allPosts
  .filter(post => post.data.category === 'food')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = recipes[0];
const rest = recipes.slice(1);

// Build collection schema for recipes
const siteUrl = 'https://mager.co';
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cooking — Recipes from the Mager Kitchen',
  description: 'A collection of homemade recipes including soups, meatballs, pasta dishes, and comfort food classics. Step-by-step instructions with photos.',
  url: `${siteUrl}/cooking`,
  image: featured?.data.heroImage,
  author: {
    '@type': 'Person',
    name: 'Mager'
  },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: recipes.map((recipe, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${recipe.id}`,
      name: recipe.data.title
    }))
  }
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cooking',
      item: `${siteUrl}/cooking`
    }
  ]
};
---

<html lang="en" data-cooking>
  <head>
    <BaseHead title={`Cooking — ${SITE_TITLE}`} description="Homemade recipes from a Chicago kitchen. Soups, meatballs, comfort food, and weeknight dinners with step-by-step instructions and photos." keywords="recipes, cooking, soup, meatballs, comfort food, homemade, dinner, easy recipes" />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <style>
      /* ── Page Header ── */
      .cooking-header {
        background: var(--ck-bg);
        text-align: center;
        padding: 4rem 2rem 0;
        border-bottom: 1px solid var(--ck-border);
      }

      .header-inner {
        max-width: 700px;
        margin: 0 auto 2rem;
      }

      .header-eyebrow {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ck-text-muted);
        margin-bottom: 0.75rem;
      }

      .header-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-weight: 900;
        font-size: clamp(3rem, 10vw, 5rem);
        letter-spacing: -0.02em;
        line-height: 1.0;
        color: var(--ck-text);
        margin: 0 0 0.75rem;
      }

      .header-subtitle {
        font-family: Georgia, serif;
        font-size: 1rem;
        font-style: italic;
        color: var(--ck-text-muted);
        line-height: 1.6;
        margin: 0;
      }

      /* ── Filter Bar ── */
      .filter-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 2rem 1rem;
      }

      .filter-bar {
        display: flex;
        align-items: center;
        gap: 0;
        flex-wrap: wrap;
        border-bottom: 1px solid var(--ck-border);
        padding-bottom: 0;
      }

      .filter-btn {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--ck-text-muted);
        background: none;
        border: none;
        border-bottom: 2px solid transparent;
        padding: 0.6rem 1rem;
        margin-bottom: -1px;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease;
        white-space: nowrap;
      }

      .filter-btn:hover {
        color: var(--ck-text);
      }

      .filter-btn.active {
        color: var(--ck-text);
        border-bottom-color: var(--ck-gold);
      }

      .filter-count {
        font-size: 0.6rem;
        opacity: 0.5;
        margin-left: 0.2rem;
      }

      /* ── Recipe Grid ── */
      .recipe-grid-section {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2.5rem 2rem 5rem;
      }

      .recipe-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 2rem;
      }

      .recipe-grid > .featured {
        grid-column: 1 / -1;
      }

      .empty-state {
        text-align: center;
        padding: 4rem 2rem;
        grid-column: 1 / -1;
      }

      .empty-state p {
        font-family: Georgia, serif;
        color: var(--ck-text-muted);
        font-style: italic;
        font-size: 1.1rem;
      }

      /* ── Footer ── */
      .cooking-footer {
        padding: 2.5rem 2rem;
        border-top: 1px solid var(--ck-border);
        text-align: center;
      }

      .footer-text {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8rem;
        color: var(--ck-text-muted);
        margin: 0;
      }

      .footer-text a {
        color: var(--ck-text-muted);
        text-decoration: none;
      }

      .footer-text a:hover {
        color: var(--ck-gold);
      }

      /* ── Mobile ── */
      @media (max-width: 720px) {
        .cooking-header {
          padding: 3rem 1.5rem 0;
        }

        .filter-section {
          padding: 1.5rem 1.25rem 0.5rem;
          overflow-x: auto;
        }

        .filter-bar {
          flex-wrap: nowrap;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
          scrollbar-width: none;
        }

        .filter-bar::-webkit-scrollbar {
          display: none;
        }

        .recipe-grid-section {
          padding: 2rem 1.25rem 4rem;
        }

        .recipe-grid {
          grid-template-columns: 1fr;
          gap: 1.5rem;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- Page Header -->
    <section class="cooking-header">
      <div class="header-inner">
        <p class="header-eyebrow">From the Mager Kitchen</p>
        <h1 class="header-title">Cooking</h1>
        <p class="header-subtitle">Recipes, experiments &amp; stories from a Chicago kitchen</p>
      </div>

      <!-- Filter tabs sit at the bottom of the header -->
      <div class="filter-section" style="padding-bottom:0; max-width:1200px; margin:0 auto;">
        <div class="filter-bar">
          <button class="filter-btn active" data-filter="all">All<span class="filter-count">{recipes.length}</span></button>
          <button class="filter-btn" data-filter="soup">Soup</button>
          <button class="filter-btn" data-filter="casserole">Casserole</button>
          <button class="filter-btn" data-filter="chicken">Chicken</button>
          <button class="filter-btn" data-filter="meat">Meat</button>
          <button class="filter-btn" data-filter="pasta">Pasta</button>
          <button class="filter-btn" data-filter="comfort">Comfort Food</button>
        </div>
      </div>
    </section>

    <!-- Recipe Grid -->
    <main class="recipe-grid-section">
      <div class="recipe-grid" id="recipe-grid">
        {featured && (
          <RecipeCard post={featured} featured={true} index={0} />
        )}
        {rest.map((post, i) => (
          <RecipeCard post={post} index={i + 1} />
        ))}
        {recipes.length === 0 && (
          <div class="empty-state">
            <p>No recipes yet. Check back soon.</p>
          </div>
        )}
      </div>
    </main>

    <!-- Footer -->
    <footer class="cooking-footer">
      <p class="footer-text">
        <a href="/">mager.co</a> · Cooking · Chicago
      </p>
    </footer>

    <!-- Theme restore -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('cooking-theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Category Filter Logic -->
    <script>
      const buttons = document.querySelectorAll('.filter-btn');
      const cards = document.querySelectorAll('.recipe-card');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          const filter = (btn as HTMLElement).dataset.filter;

          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          cards.forEach(card => {
            const el = card as HTMLElement;
            const sub = el.dataset.subcategory;
            if (filter === 'all') {
              el.style.display = '';
            } else if (sub === filter) {
              el.style.display = '';
            } else {
              el.style.display = 'none';
            }
          });
        });
      });
    </script>

    <SecretSearch posts={allPosts} />
  </body>
</html>
