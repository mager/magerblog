---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import RecipeCard from '../../components/cooking/RecipeCard.astro';
import SecretSearch from '../../components/SecretSearch.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import '../../styles/cooking.css';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const recipes = allPosts
  .filter(post => post.data.category === 'food')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Featured = most recent recipe that actually has a photo.
const featured = recipes.find(r => r.data.heroImage) ?? recipes[0];
const grid = recipes.filter(r => r !== featured);

// Categories derive from the real kitchen, not invented buckets.
const counts = new Map<string, number>();
for (const r of grid) {
  const s = r.data.subcategory || 'other';
  counts.set(s, (counts.get(s) || 0) + 1);
}
const order = ['soup', 'meat', 'comfort', 'pasta', 'casserole', 'side', 'salad'];
const filters = [
  { key: 'all', label: 'All', count: grid.length },
  ...order
    .filter(k => (counts.get(k) || 0) >= 2)
    .map(k => ({ key: k, label: k[0].toUpperCase() + k.slice(1), count: counts.get(k) || 0 })),
];

// Ledger stats.
const soupCount = recipes.filter(r => r.data.subcategory === 'soup').length;
const startYear = Math.min(...recipes.map(r => r.data.pubDate.getFullYear()));
const featTime = (featured?.data.prepTime || 0) + (featured?.data.cookTime || 0);

const siteUrl = 'https://mager.co';
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Cooking — Recipes from the Mager Kitchen',
  description: 'Soups, braises, pasta, and comfort food from a home kitchen in Chicago. Step-by-step recipes with photos.',
  url: `${siteUrl}/cooking`,
  image: featured?.data.heroImage,
  author: { '@type': 'Person', name: 'Mager' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: recipes.map((recipe, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `${siteUrl}/blog/${recipe.id}`,
      name: recipe.data.title,
    })),
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Cooking', item: `${siteUrl}/cooking` },
  ],
};
---

<html lang="en" data-cooking>
  <head>
    <BaseHead
      title={`Cooking — ${SITE_TITLE}`}
      description="Soups, braises, and weeknight dinners from a home kitchen in Chicago. Step-by-step recipes with photos."
      keywords="recipes, cooking, soup, braise, comfort food, homemade, dinner, dutch oven, chicago kitchen"
    />
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ============================================================
         COOKING — landing page
         Editorial, Cook's-Illustrated-inspired: classic serif display,
         cream/white ground, a single warm accent, generous whitespace,
         hairline rules, and a clean recipe grid as the hero.
         Uses the shared --ck-* theme so it matches the recipe pages.
         ============================================================ */
      html[data-cooking] {
        --kx-maxw: 1180px;
        --kx-pad: clamp(1.25rem, 5vw, 3.5rem);
      }

      html[data-cooking] body {
        font-family: 'Source Serif 4', Georgia, 'Times New Roman', serif;
      }

      /* Page shell ---------------------------------------------------- */
      .ci-shell { position: relative; z-index: 1; }

      .ci-wrap {
        max-width: var(--kx-maxw);
        margin: 0 auto;
        padding: 0 var(--kx-pad);
      }

      /* Masthead ------------------------------------------------------ */
      .ci-mast {
        max-width: var(--kx-maxw);
        margin: 0 auto;
        padding: clamp(2.75rem, 7vw, 5rem) var(--kx-pad) clamp(1.75rem, 4vw, 2.75rem);
        text-align: center;
      }
      .ci-kicker {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.28em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 0 0 1.1rem;
      }
      .ci-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: clamp(3.2rem, 11vw, 6rem);
        line-height: 0.98;
        letter-spacing: -0.02em;
        margin: 0;
        text-wrap: balance;
        font-variation-settings: 'opsz' 144, 'SOFT' 0;
      }
      .ci-title em {
        font-style: italic;
        color: var(--ck-gold);
      }
      .ci-lede {
        max-width: 48ch;
        margin: 1.35rem auto 0;
        font-size: clamp(1.05rem, 2vw, 1.22rem);
        line-height: 1.62;
        color: var(--ck-text-secondary);
        text-wrap: pretty;
      }
      .ci-ledger {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem 1rem;
        margin-top: 1.5rem;
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.8rem;
        letter-spacing: 0.02em;
        color: var(--ck-text-muted);
      }
      .ci-ledger b { color: var(--ck-text); font-weight: 600; }
      .ci-ledger .dot { color: var(--ck-gold); opacity: 0.6; }

      /* Rule with a centered ornament -------------------------------- */
      .ci-rule {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        max-width: var(--kx-maxw);
        margin: clamp(2rem, 5vw, 3rem) auto;
        padding: 0 var(--kx-pad);
        color: var(--ck-gold);
      }
      .ci-rule::before,
      .ci-rule::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--ck-divider);
      }
      .ci-rule svg { flex: 0 0 auto; opacity: 0.85; }

      /* Featured recipe ---------------------------------------------- */
      .ci-feature {
        max-width: var(--kx-maxw);
        margin: 0 auto;
        padding: 0 var(--kx-pad);
      }
      .feature-card {
        display: grid;
        grid-template-columns: 1.15fr 1fr;
        align-items: stretch;
        gap: clamp(1.5rem, 4vw, 3rem);
        text-decoration: none !important;
        color: var(--ck-text);
      }
      .feature-figure {
        position: relative;
        margin: 0;
        overflow: hidden;
        border: 1px solid var(--ck-img-border);
        border-radius: 4px;
        aspect-ratio: 3 / 2;
        background: var(--ck-bg-surface);
      }
      .feature-figure img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        border-radius: 0;
        transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .feature-card:hover .feature-figure img,
      .feature-card:focus-visible .feature-figure img {
        transform: scale(1.03);
      }
      .feature-text {
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: 38ch;
      }
      .feature-eyebrow {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 0 0 0.85rem;
      }
      .feature-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: clamp(2rem, 4.5vw, 3.1rem);
        line-height: 1.05;
        letter-spacing: -0.015em;
        margin: 0;
        text-wrap: balance;
        font-variation-settings: 'opsz' 144;
      }
      .feature-desc {
        margin: 1rem 0 0;
        font-size: clamp(1rem, 1.6vw, 1.12rem);
        line-height: 1.55;
        color: var(--ck-text-secondary);
        text-wrap: pretty;
      }
      .feature-foot {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        margin-top: 1.4rem;
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: 0.02em;
      }
      .feature-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        color: var(--ck-gold);
        transition: gap 0.3s ease;
      }
      .feature-card:hover .feature-cta { gap: 0.75rem; }
      .feature-time { color: var(--ck-text-muted); }
      .feature-time::before {
        content: '·';
        margin-right: 1rem;
        color: var(--ck-text-muted);
        opacity: 0.7;
      }

      /* Index header + category row ---------------------------------- */
      .ci-index-head {
        max-width: var(--kx-maxw);
        margin: clamp(2.5rem, 6vw, 4rem) auto 0;
        padding: 0 var(--kx-pad);
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        border-bottom: 1px solid var(--ck-divider);
        padding-bottom: 1.1rem;
      }
      .ci-index-title {
        font-family: 'Fraunces', 'Playfair Display', Georgia, serif;
        font-weight: 600;
        font-size: clamp(1.5rem, 3vw, 2rem);
        letter-spacing: -0.01em;
        margin: 0;
        font-variation-settings: 'opsz' 144;
      }
      .ci-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem 0.4rem;
      }
      .chip {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.78rem;
        font-weight: 500;
        letter-spacing: 0.02em;
        color: var(--ck-text-secondary);
        background: transparent;
        border: none;
        border-radius: 999px;
        padding: 0.38rem 0.85rem;
        cursor: pointer;
        white-space: nowrap;
        transition: color 0.2s ease, background 0.2s ease;
      }
      .chip:hover { color: var(--ck-text); background: var(--ck-bg-surface); }
      .chip[aria-pressed='true'] {
        color: var(--ck-bg);
        background: var(--ck-gold);
        font-weight: 600;
      }
      .chip-count {
        font-size: 0.82em;
        opacity: 0.55;
        margin-left: 0.3rem;
        font-variant-numeric: tabular-nums;
      }
      .chip[aria-pressed='true'] .chip-count { opacity: 0.75; }

      /* The grid ------------------------------------------------------ */
      html[data-cooking] main.ci-index {
        width: 100%;
        max-width: var(--kx-maxw);
        margin: 0 auto;
        padding: clamp(2rem, 4vw, 3rem) var(--kx-pad) clamp(4rem, 8vw, 6.5rem);
      }
      .ci-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 3vw, 2.5rem);
      }
      .ci-empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 4rem 1rem;
        font-style: italic;
        color: var(--ck-text-muted);
      }

      /* Footer -------------------------------------------------------- */
      .ci-foot {
        max-width: var(--kx-maxw);
        margin: 0 auto;
        padding: 2.25rem var(--kx-pad) 4rem;
        border-top: 1px solid var(--ck-divider);
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.8rem;
        color: var(--ck-text-muted);
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .ci-foot a { color: var(--ck-text-secondary); text-decoration: none; }
      .ci-foot a:hover { color: var(--ck-gold); }

      /* Responsive ---------------------------------------------------- */
      @media (max-width: 760px) {
        .feature-card { grid-template-columns: 1fr; gap: 1.25rem; }
        .feature-text { max-width: none; }
        .ci-index-head { padding-bottom: 1rem; }
      }

      @media (prefers-reduced-motion: reduce) {
        html[data-cooking] { scroll-behavior: auto; }
        .feature-figure img { transition: none; }
        .feature-card:hover .feature-figure img { transform: none; }
      }
    </style>
  </head>

  <body>
    <div class="ci-shell">
      <Header homepage={true} />

      <!-- Masthead -->
      <header class="ci-mast">
        <p class="ci-kicker">From a Chicago kitchen</p>
        <h1 class="ci-title">Cooking</h1>
        <p class="ci-lede">
          Mostly soups and slow braises, with the pasta, casseroles, and weeknight
          dinners that actually get made. Real recipes, real photos &mdash; written down
          so I can find them again.
        </p>
        <div class="ci-ledger">
          <span><b>{recipes.length}</b> recipes</span>
          <span class="dot">&middot;</span>
          <span><b>{soupCount}</b> of them soups</span>
          <span class="dot">&middot;</span>
          <span>cooking in public since <b>{startYear}</b></span>
        </div>
      </header>

      <!-- Ornamental rule -->
      <div class="ci-rule" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 11h18M5 11V8a7 7 0 0 1 14 0v3M4 11l1.2 6.5a2 2 0 0 0 2 1.5h9.6a2 2 0 0 0 2-1.5L20 11" />
        </svg>
      </div>

      <!-- Featured recipe -->
      {featured && (
        <section class="ci-feature">
          <a class="feature-card" href={`/blog/${featured.id}/`}>
            <figure class="feature-figure">
              {featured.data.heroImage && (
                <img src={featured.data.heroImage} alt={`${featured.data.title} — the latest recipe`} fetchpriority="high" />
              )}
            </figure>
            <div class="feature-text">
              <p class="feature-eyebrow">Latest recipe</p>
              <h2 class="feature-title">{featured.data.title}</h2>
              {featured.data.description && <p class="feature-desc">{featured.data.description}</p>}
              <div class="feature-foot">
                <span class="feature-cta">
                  Read the recipe
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </span>
                {featTime > 0 && <span class="feature-time">{featTime} min</span>}
              </div>
            </div>
          </a>
        </section>
      )}

      <!-- Index header + category filters -->
      <div class="ci-index-head">
        <h2 class="ci-index-title">The recipe box</h2>
        <nav class="ci-filters" id="filterRail" aria-label="Filter recipes by type">
          {filters.map((f, i) => (
            <button class="chip" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}<span class="chip-count">{f.count}</span>
            </button>
          ))}
        </nav>
      </div>

      <!-- Grid -->
      <main class="ci-index">
        <div class="ci-grid" id="recipeGrid">
          {grid.map((post) => (
            <RecipeCard post={post} />
          ))}
          {grid.length === 0 && <p class="ci-empty">No recipes yet. Check back soon.</p>}
        </div>
      </main>

      <footer class="ci-foot">
        <span><a href="/">mager.co</a> &middot; Cooking</span>
        <span>Chicago &middot; since {startYear}</span>
      </footer>
    </div>

    <!-- Category filter (graceful: works without View Transitions) -->
    <script is:inline>
      (function () {
        const rail = document.getElementById('filterRail');
        const grid = document.getElementById('recipeGrid');
        if (!rail || !grid) return;
        const chips = Array.from(rail.querySelectorAll('.chip'));
        const cards = Array.from(grid.querySelectorAll('.recipe'));
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function apply(filter) {
          cards.forEach(function (c) {
            const sub = c.getAttribute('data-sub') || 'other';
            c.hidden = !(filter === 'all' || sub === filter);
          });
        }

        rail.addEventListener('click', function (e) {
          const btn = e.target.closest('.chip');
          if (!btn) return;
          const filter = btn.getAttribute('data-filter');
          chips.forEach(function (c) { c.setAttribute('aria-pressed', String(c === btn)); });
          if (reduce || !document.startViewTransition) { apply(filter); return; }
          document.startViewTransition(function () { apply(filter); });
        });
      })();
    </script>

    <SecretSearch posts={allPosts} />
  </body>
</html>
