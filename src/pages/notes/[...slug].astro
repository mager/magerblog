---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import ReadingPost from '../../layouts/ReadingPost.astro';
import { linkHost } from '../../lib/link-share';

export async function getStaticPaths() {
  return (await getCollection('notes')).map(note => ({ params: { slug: note.id }, props: note }));
}
type Props = CollectionEntry<'notes'>;
const note = Astro.props;
const { Content, headings } = await render(note);
const { title = 'A note', description = title, pubDate, link, linkText, tags, draft } = note.data;
const notes = (await getCollection('notes')).filter(note => !note.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const index = notes.findIndex(entry => entry.id === note.id);
const previous = index >= 0 ? notes[index + 1] : undefined;
const next = index > 0 ? notes[index - 1] : undefined;
const minutes = Math.max(1, Math.ceil((note.body || '').split(/\s+/).length / 220));
---
<ReadingPost {title} {description} {pubDate} {tags} {draft} {headings} {minutes} kind="Note"
  source={link ? { url: link, label: linkText || linkHost(link) } : undefined}
  previous={previous && { title: previous.data.title || 'A note', href: `/notes/${previous.id}/` }}
  next={next && { title: next.data.title || 'A note', href: `/notes/${next.id}/` }}>
  <Content />
</ReadingPost>
