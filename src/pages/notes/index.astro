---
import { getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const DESCRIPTION = 'Short notes — quick links, thoughts, and things learned.';

const notes = (await getCollection('notes'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// render() is async, so resolve every note's Content before mapping in JSX.
const items = await Promise.all(
	notes.map(async (note) => ({ note, Content: (await render(note)).Content }))
);

const hostOf = (url: string) => {
	try {
		return new URL(url).host.replace(/^www\./, '');
	} catch {
		return url;
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Notes - ${SITE_TITLE}`} description={DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: 100%;
			}
			.page-header {
				margin: 1rem 0 2.5rem;
			}
			.page-header h1 {
				font-family: 'JetBrains Mono', monospace;
				font-size: 2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--text-primary);
				margin: 0 0 0.4rem;
			}
			.page-header h1::after {
				content: '█';
				color: var(--accent-green);
				animation: blink 1s steps(1) infinite;
				margin-left: 0.25rem;
			}
			@keyframes blink { 50% { opacity: 0; } }
			.page-header p {
				font-family: 'JetBrains Mono', monospace;
				color: var(--text-secondary, #8b949e);
				font-size: 0.95rem;
				margin: 0;
			}
			.stream {
				display: flex;
				flex-direction: column;
				gap: 0;
			}
			.note {
				padding: 1.75rem 0;
				border-top: 1px solid var(--terminal-border, #30363d);
			}
			.note:last-child { border-bottom: 1px solid var(--terminal-border, #30363d); }
			.note-meta {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.8rem;
				color: var(--text-muted, #6e7681);
				margin-bottom: 0.6rem;
			}
			.note-meta a.permalink {
				color: var(--text-muted, #6e7681);
				text-decoration: none;
			}
			.note-meta a.permalink:hover { color: var(--accent-green); }
			.note-title {
				font-family: 'JetBrains Mono', monospace;
				font-size: 1.25rem;
				font-weight: 700;
				margin: 0 0 0.5rem;
				line-height: 1.3;
			}
			.note-title a { color: var(--text-primary); text-decoration: none; }
			.note-title a:hover { color: var(--accent-green); }
			.linkout {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--accent, #58a6ff);
				text-decoration: none;
				margin-bottom: 0.75rem;
				word-break: break-word;
			}
			.linkout:hover { text-decoration: underline; }
			.linkout::before { content: '→'; opacity: 0.7; }
			.note-body { color: var(--text-primary); line-height: 1.65; }
			.note-body :global(p) { margin: 0 0 0.9rem; }
			.note-body :global(p:last-child) { margin-bottom: 0; }
			.note-body :global(pre) {
				border: 1px solid var(--terminal-border, #30363d);
				border-radius: 8px;
				padding: 1rem;
				overflow-x: auto;
				font-size: 0.85rem;
			}
			.note-body :global(code) { font-family: 'JetBrains Mono', monospace; }
			.tags { margin-top: 0.9rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
			.tag {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.72rem;
				color: var(--text-muted, #6e7681);
			}
			.tag::before { content: '#'; opacity: 0.6; }
			.feed-link {
				display: inline-block;
				margin-top: 2.5rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.85rem;
				color: var(--text-muted, #6e7681);
				text-decoration: none;
			}
			.feed-link:hover { color: var(--accent-green); }
			.empty { color: var(--text-muted, #6e7681); font-family: 'JetBrains Mono', monospace; }
			@media (max-width: 720px) {
				.page-header h1 { font-size: 1.5rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-header">
					<h1>$ tail -f ~/notes</h1>
					<p>Quick links, thoughts, and things learned. Long-form lives on the <a href="/blog">blog</a>.</p>
				</div>

				{items.length === 0 && <p class="empty">No notes yet.</p>}

				<div class="stream">
					{items.map(({ note, Content }) => {
						const slug = `/notes/${note.id}/`;
						return (
							<article class="note" id={note.id}>
								<div class="note-meta">
									<a class="permalink" href={slug}>
										<FormattedDate date={note.data.pubDate} />
									</a>
								</div>

								{note.data.title && (
									<h2 class="note-title"><a href={slug}>{note.data.title}</a></h2>
								)}

								{note.data.link && (
									<a class="linkout" href={note.data.link} target="_blank" rel="noopener">
										{note.data.linkText ?? hostOf(note.data.link)}
									</a>
								)}

								<div class="note-body"><Content /></div>

								{note.data.tags && note.data.tags.length > 0 && (
									<div class="tags">
										{note.data.tags.map((t) => <span class="tag">{t}</span>)}
									</div>
								)}
							</article>
						);
					})}
				</div>

				<a class="feed-link" href="/notes/rss.xml">$ curl ~/notes/rss.xml</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
