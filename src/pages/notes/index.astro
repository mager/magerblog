---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';

const DESCRIPTION = 'Short notes — quick links, thoughts, and things learned.';

const notes = (await getCollection('notes'))
	.filter((n) => !n.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const hostOf = (url: string) => {
	try {
		return new URL(url).host.replace(/^www\./, '');
	} catch {
		return url;
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Notes - ${SITE_TITLE}`} description={DESCRIPTION} />
		<style>
			main {
				width: 760px;
				max-width: 100%;
			}
			.page-header {
				margin: 1rem 0 2.5rem;
			}
			.page-header h1 {
				font-family: 'JetBrains Mono', monospace;
				font-size: 2rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--text-primary);
				margin: 0 0 0.4rem;
			}
			.page-header h1::after {
				content: '█';
				color: var(--accent-green);
				animation: blink 1s steps(1) infinite;
				margin-left: 0.25rem;
			}
			@keyframes blink { 50% { opacity: 0; } }
			.page-header p {
				font-family: 'JetBrains Mono', monospace;
				color: var(--text-secondary, #8b949e);
				font-size: 0.95rem;
				margin: 0;
			}
			.stream {
				display: flex;
				flex-direction: column;
				gap: 0;
			}
			.note-row {
				display: flex;
				align-items: baseline;
				gap: 1.1rem;
				padding: 0.8rem 0;
				border-top: 1px solid var(--terminal-border, #30363d);
				color: inherit;
				text-decoration: none;
			}
			.stream a.note-row:last-child { border-bottom: 1px solid var(--terminal-border, #30363d); }
			.row-date {
				flex-shrink: 0;
				width: 5.25rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.75rem;
				color: var(--text-muted, #6e7681);
			}
			.row-title {
				flex: 1;
				min-width: 0;
				font-family: 'JetBrains Mono', monospace;
				font-size: 1rem;
				font-weight: 600;
				line-height: 1.35;
				color: var(--text-primary);
			}
			.note-row:hover .row-title { color: var(--accent-green); }
			.row-tags {
				flex-shrink: 0;
				display: flex;
				flex-wrap: wrap;
				justify-content: flex-end;
				gap: 0.35rem;
				max-width: 40%;
			}
			.tag {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.68rem;
				color: var(--text-muted, #6e7681);
				white-space: nowrap;
			}
			.tag::before { content: '#'; opacity: 0.6; }
			.feed-link {
				display: inline-block;
				margin-top: 2.5rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.85rem;
				color: var(--text-muted, #6e7681);
				text-decoration: none;
			}
			.feed-link:hover { color: var(--accent-green); }
			.empty { color: var(--text-muted, #6e7681); font-family: 'JetBrains Mono', monospace; }
			@media (max-width: 720px) {
				.page-header h1 { font-size: 1.5rem; }
				.note-row { flex-wrap: wrap; gap: 0.3rem 1rem; }
				.row-tags { max-width: 100%; justify-content: flex-start; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<div class="page-header">
					<h1>$ tail -f ~/notes</h1>
					<p>Quick links, thoughts, and things learned. Long-form lives on the <a href="/blog">blog</a>.</p>
				</div>

				{notes.length === 0 && <p class="empty">No notes yet.</p>}

				<div class="stream">
					{notes.map((note) => {
						const slug = `/notes/${note.id}/`;
						const title = note.data.title ?? (note.data.link ? (note.data.linkText ?? hostOf(note.data.link)) : 'Note');
						return (
							<a class="note-row" href={slug}>
								<span class="row-date"><FormattedDate date={note.data.pubDate} /></span>
								<span class="row-title">{title}</span>
								{note.data.tags && note.data.tags.length > 0 && (
									<span class="row-tags">
										{note.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}
									</span>
								)}
							</a>
						);
					})}
				</div>

				<a class="feed-link" href="/notes/rss.xml">$ curl ~/notes/rss.xml</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
