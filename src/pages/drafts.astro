---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SecretSearch from '../components/SecretSearch.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = (await getCollection('blog'))
	.filter(post => post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryMeta: Record<string, { label: string; color: string; marker: string }> = {
	tech: { label: 'tech', color: '#5a53d6', marker: 'violet' },
	life: { label: 'life', color: '#2f7b4b', marker: 'green' },
	food: { label: 'food', color: '#c46a1d', marker: 'orange' },
};

const featured = posts[0];
const rest = posts.slice(1);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Drafts - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Patrick+Hand&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
		<style>
			:root {
				--paper: #fbf6e8;
				--paper-dark: #f3ebd8;
				--paper-line: rgba(54, 84, 165, 0.18);
				--paper-margin: rgba(206, 84, 84, 0.28);
				--ink: #1e1b18;
				--muted: #675f56;
				--shadow: 0 26px 60px rgba(72, 49, 22, 0.16);
				--tape: #f4d45d;
				--tape-dark: #c9a83b;
				--blueprint: #b8c8de;
				--card-line: rgba(30, 27, 24, 0.12);
			}

			body {
				background:
					radial-gradient(circle at top left, rgba(255,255,255,0.65), transparent 20%),
					linear-gradient(180deg, #c6d4e7 0%, #d9e3ef 22%, #e7e5dd 22%, #e7dfcf 100%);
				color: var(--ink);
			}

			main {
				width: min(1240px, calc(100% - 2rem));
				max-width: 1240px;
				padding: 5.8rem 0 5rem;
			}

			.drafts-board {
				position: relative;
			}

			.drafts-board::before {
				content: '';
				position: absolute;
				inset: 0;
				background-image:
					radial-gradient(rgba(255,255,255,0.3) 0.7px, transparent 0.7px),
					linear-gradient(to right, rgba(255,255,255,0.12) 1px, transparent 1px),
					linear-gradient(to bottom, rgba(255,255,255,0.12) 1px, transparent 1px);
				background-size: 18px 18px, 90px 90px, 90px 90px;
				opacity: 0.25;
				pointer-events: none;
			}

			.hero-sheet,
			.site-note,
			.lead-card,
			.draft-card,
			.empty-sheet {
				position: relative;
				background:
					linear-gradient(transparent 0 37px, var(--paper-line) 37px 38px),
					linear-gradient(90deg, transparent 0 52px, var(--paper-margin) 52px 54px, transparent 54px),
					var(--paper);
				background-size: 100% 38px, 100% 100%, 100% 100%;
				border: 1px solid rgba(70, 54, 35, 0.18);
				box-shadow: var(--shadow);
			}

			.hero {
				display: grid;
				grid-template-columns: minmax(0, 1.2fr) 20rem;
				gap: 1.25rem;
				align-items: start;
				margin-bottom: 1.6rem;
			}

			.hero-sheet {
				padding: 2.1rem 2rem 1.8rem 4.5rem;
				border-radius: 28px 28px 22px 22px;
				transform: rotate(-0.55deg);
			}

			.hero-sheet::before,
			.hero-sheet::after,
			.lead-card::before,
			.draft-card::before,
			.empty-sheet::before {
				content: '';
				position: absolute;
				top: 18px;
				left: 18px;
				width: calc(100% - 36px);
				height: 18px;
				pointer-events: none;
				background:
					radial-gradient(circle, rgba(145, 120, 77, 0.42) 0 5px, transparent 5.5px) left center / 34px 18px repeat-x;
				opacity: 0.75;
			}

			.hero-sheet::after,
			.lead-card::after,
			.draft-card::after,
			.empty-sheet::after {
				content: '';
				position: absolute;
				top: -10px;
				right: 5%;
				width: 102px;
				height: 28px;
				background: linear-gradient(180deg, rgba(255, 228, 128, 0.92), rgba(231, 192, 77, 0.86));
				border: 1px solid rgba(135, 104, 17, 0.18);
				box-shadow: 0 10px 18px rgba(120, 92, 24, 0.16);
				transform: rotate(2.8deg);
				opacity: 0.95;
			}

			.kicker,
			.note-kicker,
			.badge,
			.meta,
			.action,
			.small-label {
				font-family: 'IBM Plex Mono', monospace;
				text-transform: uppercase;
				letter-spacing: 0.14em;
			}

			.kicker {
				display: inline-block;
				margin: 0 0 0.9rem;
				padding: 0.45rem 0.65rem;
				background: rgba(20, 19, 18, 0.92);
				color: #f7f2e6;
				font-size: 0.65rem;
				border-radius: 999px;
			}

			.hero-title {
				margin: 0;
				font-family: 'Instrument Serif', serif;
				font-size: clamp(3.4rem, 9vw, 6.2rem);
				line-height: 0.9;
				letter-spacing: -0.06em;
			}

			.hero-copy {
				max-width: 44rem;
				margin: 0.9rem 0 1.2rem;
				font-family: 'Patrick Hand', cursive;
				font-size: 1.45rem;
				line-height: 1.35;
				color: #433b33;
			}

			.hero-row {
				display: flex;
				flex-wrap: wrap;
				gap: 0.7rem;
			}

			.badge {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.65rem 0.8rem;
				font-size: 0.64rem;
				background: rgba(255,255,255,0.55);
				border: 1px dashed rgba(59, 48, 36, 0.28);
				border-radius: 999px;
			}

			.badge-dot {
				width: 0.55rem;
				height: 0.55rem;
				border-radius: 999px;
				background: #d98d24;
			}

			.site-note {
				padding: 1.2rem 1.1rem 1rem 3.3rem;
				border-radius: 24px;
				transform: rotate(1deg);
			}

			.site-note::after {
				right: auto;
				left: 22px;
				width: 88px;
				transform: rotate(-7deg);
			}

			.note-kicker {
				font-size: 0.62rem;
				color: #7d673d;
			}

			.note-title {
				margin: 0.6rem 0 0.4rem;
				font-family: 'Patrick Hand', cursive;
				font-size: 2rem;
				line-height: 1;
			}

			.note-copy,
			.note-list {
				font-family: 'Patrick Hand', cursive;
				font-size: 1.22rem;
				line-height: 1.3;
				color: #4f463f;
			}

			.note-list {
				list-style: none;
				padding: 0;
				margin: 0.85rem 0 0;
			}

			.note-list li + li {
				margin-top: 0.55rem;
			}

			.stack-header {
				display: flex;
				justify-content: space-between;
				align-items: flex-end;
				gap: 1rem;
				margin: 0 0 1rem;
				padding: 0 0.35rem;
			}

			.stack-title {
				margin: 0;
				font-family: 'Patrick Hand', cursive;
				font-size: 2.3rem;
				line-height: 1;
			}

			.stack-copy {
				margin: 0.2rem 0 0;
				font-family: 'Patrick Hand', cursive;
				font-size: 1.15rem;
				color: #544b44;
			}

			.small-label {
				font-size: 0.64rem;
				color: #5a544d;
			}

			.lead-card {
				display: grid;
				grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
				gap: 1.1rem;
				padding: 2rem 1.5rem 1.4rem 4.5rem;
				border-radius: 28px;
				margin-bottom: 1.2rem;
				text-decoration: none;
				transform: rotate(0.35deg);
				transition: transform 0.22s ease, box-shadow 0.22s ease;
			}

			.lead-card:hover,
			.draft-card:hover {
				transform: translateY(-4px) rotate(0deg);
				box-shadow: 0 30px 60px rgba(72, 49, 22, 0.22);
			}

			.sketch-panel {
				position: relative;
				min-height: 18rem;
				border-radius: 22px;
				background:
					linear-gradient(transparent 23px, rgba(78, 120, 214, 0.18) 23px 24px),
					linear-gradient(90deg, transparent 0 36px, rgba(215, 86, 86, 0.2) 36px 38px, transparent 38px),
					linear-gradient(135deg, rgba(255,255,255,0.82), rgba(240, 232, 212, 0.88));
				background-size: 100% 24px, 100% 100%, 100% 100%;
				border: 1px solid rgba(78, 59, 33, 0.15);
				overflow: hidden;
			}

			.sketch-panel::before {
				content: 'UNDER CONSTRUCTION';
				position: absolute;
				left: -28px;
				top: 28px;
				padding: 0.55rem 2.5rem;
				background: repeating-linear-gradient(-45deg, #181512 0 12px, #e2b430 12px 24px);
				color: #fff8e7;
				font-family: 'IBM Plex Mono', monospace;
				font-size: 0.62rem;
				letter-spacing: 0.16em;
				transform: rotate(-12deg);
				box-shadow: 0 8px 18px rgba(0,0,0,0.16);
			}

			.sketch-lines,
			.sketch-lines::before,
			.sketch-lines::after {
				position: absolute;
				border: 2px solid rgba(40, 91, 189, 0.72);
				border-radius: 18px;
				content: '';
			}

			.sketch-lines {
				left: 18%;
				top: 25%;
				width: 54%;
				height: 48%;
			}

			.sketch-lines::before {
				left: -12%;
				top: 14%;
				width: 32%;
				height: 34%;
			}

			.sketch-lines::after {
				right: -10%;
				bottom: -14%;
				width: 36%;
				height: 30%;
			}

			.sketch-scribble {
				position: absolute;
				right: 1rem;
				bottom: 1rem;
				font-family: 'Patrick Hand', cursive;
				font-size: 1.3rem;
				color: rgba(31, 72, 155, 0.88);
				transform: rotate(-4deg);
			}

			.lead-copy {
				display: flex;
				flex-direction: column;
				justify-content: center;
			}

			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				font-size: 0.64rem;
				color: #5f584f;
			}

			.marker {
				display: inline-flex;
				padding: 0.28rem 0.58rem;
				border-radius: 999px;
				background: rgba(255,255,255,0.62);
				border: 1px dashed rgba(58, 49, 39, 0.24);
			}

			.lead-title,
			.card-title {
				margin: 0.65rem 0 0.45rem;
				font-family: 'Instrument Serif', serif;
				letter-spacing: -0.05em;
				line-height: 0.95;
			}

			.lead-title {
				font-size: clamp(2.5rem, 4.5vw, 3.8rem);
			}

			.lead-description,
			.card-description {
				margin: 0;
				font-family: 'Patrick Hand', cursive;
				color: #4b443d;
				line-height: 1.32;
			}

			.lead-description {
				font-size: 1.28rem;
			}

			.action {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				margin-top: 1rem;
				font-size: 0.66rem;
				color: #1e4fb8;
			}

			.card-grid {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: 1rem;
			}

			.draft-card {
				padding: 1.55rem 1.25rem 1.15rem 4.2rem;
				border-radius: 24px;
				text-decoration: none;
				transition: transform 0.22s ease, box-shadow 0.22s ease;
			}

			.draft-card:nth-child(3n + 1) { transform: rotate(-0.7deg); }
			.draft-card:nth-child(3n + 2) { transform: rotate(0.55deg); }
			.draft-card:nth-child(3n + 3) { transform: rotate(-0.2deg); }

			.draft-card::after {
				width: 82px;
				height: 24px;
				right: auto;
				left: 50%;
				transform: translateX(-50%) rotate(-2deg);
			}

			.card-title {
				font-size: 2rem;
			}

			.card-description {
				font-size: 1.12rem;
			}

			.card-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: 0.75rem;
				margin-top: 1rem;
			}

			.pen-note {
				font-family: 'Patrick Hand', cursive;
				font-size: 1.08rem;
				color: var(--muted);
			}

			.empty-sheet {
				padding: 2rem 1.4rem 1.8rem 4rem;
				border-radius: 26px;
			}

			.empty-sheet h2 {
				margin: 0.55rem 0 0.4rem;
				font-family: 'Patrick Hand', cursive;
				font-size: 2.4rem;
			}

			.empty-sheet p {
				margin: 0;
				font-family: 'Patrick Hand', cursive;
				font-size: 1.18rem;
				color: #4d453d;
			}

			@media (max-width: 1080px) {
				.hero,
				.lead-card,
				.card-grid {
					grid-template-columns: 1fr;
				}

				.site-note {
					transform: rotate(0.4deg);
				}
			}

			@media (max-width: 720px) {
				main {
					width: min(100% - 1rem, 1240px);
					padding-top: 5rem;
				}

				.hero-sheet,
				.site-note,
				.lead-card,
				.draft-card,
				.empty-sheet {
					padding-left: 3.1rem;
					padding-right: 1rem;
					border-radius: 20px;
				}

				.hero-title {
					font-size: clamp(2.8rem, 16vw, 4.2rem);
				}

				.hero-copy,
				.note-copy,
				.note-list,
				.lead-description,
				.card-description,
				.pen-note,
				.empty-sheet p {
					font-size: 1.05rem;
				}

				.stack-header,
				.card-footer {
					flex-direction: column;
					align-items: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main>
			<div class="drafts-board">
				<section class="hero">
					<div class="hero-sheet">
						<div class="kicker">working file</div>
						<h1 class="hero-title">Drafts</h1>
						<p class="hero-copy">The half-built room. Notebook paper, scratched ideas, loose headlines, and posts that still smell like fresh ink.</p>
						<div class="hero-row">
							<div class="badge"><span class="badge-dot"></span>{posts.length} active drafts</div>
							<div class="badge"><span class="badge-dot"></span>{featured ? 'latest draft pinned up top' : 'waiting for first sketch'}</div>
							<div class="badge"><span class="badge-dot"></span>messy on purpose</div>
						</div>
					</div>

					<aside class="site-note">
						<div class="note-kicker">margin note</div>
						<h2 class="note-title">Needs to feel built by hand</h2>
						<p class="note-copy">More sketchbook than archive. More pen and yellow tape than clean CMS.</p>
						<ul class="note-list">
							<li>→ ruled paper, visible margin lines</li>
							<li>→ rough construction details, not polished cards</li>
							<li>→ stuff I want to finish next, not organize forever</li>
						</ul>
					</aside>
				</section>

				{featured ? (
					<>
						<div class="stack-header">
							<div>
								<h2 class="stack-title">Pinned to the board</h2>
								<p class="stack-copy">The freshest draft gets the big sheet and the caution tape.</p>
							</div>
							<div class="small-label">1 lead draft · {rest.length} in the pile</div>
						</div>

						<a href={`/blog/${featured.id}/`} class="lead-card">
							<div class="sketch-panel">
								<div class="sketch-lines"></div>
								<div class="sketch-scribble">headline still cooking...</div>
							</div>
							<div class="lead-copy">
								<div class="meta">
									{(() => {
										const meta = categoryMeta[featured.data.category || 'tech'] || categoryMeta.tech;
										return <span class="marker" style={`color:${meta.color}`}>{meta.label}</span>;
									})()}
									<span><FormattedDate date={featured.data.pubDate} /></span>
									<span>draft:true</span>
								</div>
								<h3 class="lead-title">{featured.data.title}</h3>
								<p class="lead-description">{featured.data.description}</p>
								<div class="action">open notebook ↗</div>
							</div>
						</a>

						{rest.length > 0 ? (
							<>
								<div class="stack-header">
									<div>
										<h2 class="stack-title">Still on the desk</h2>
										<p class="stack-copy">Smaller scraps, still alive.</p>
									</div>
									<div class="small-label">grab one and finish it</div>
								</div>

								<div class="card-grid">
									{rest.map((post) => {
										const meta = categoryMeta[post.data.category || 'tech'] || categoryMeta.tech;
										return (
											<a href={`/blog/${post.id}/`} class="draft-card">
												<div class="meta">
													<span class="marker" style={`color:${meta.color}`}>{meta.label}</span>
													<span><FormattedDate date={post.data.pubDate} /></span>
												</div>
												<h3 class="card-title">{post.data.title}</h3>
												<p class="card-description">{post.data.description}</p>
												<div class="card-footer">
													<div class="action">reopen draft ↗</div>
													<div class="pen-note">still under construction</div>
												</div>
											</a>
										);
									})}
								</div>
							</>
						) : null}
					</>
				) : (
					<div class="empty-sheet">
						<div class="note-kicker">construction pause</div>
						<h2>No drafts on the board</h2>
						<p>When the next post starts life as a scribble instead of a finished thing, it lands here first.</p>
					</div>
				)}
			</div>
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
