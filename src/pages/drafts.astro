---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SecretSearch from '../components/SecretSearch.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const posts = (await getCollection('blog'))
	.filter(post => post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Drafts - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(720px, calc(100% - 2rem));
				margin: 0 auto;
				padding: 5rem 0 4rem;
			}

			h1 {
				margin: 0 0 2rem;
				font-size: 1rem;
				font-weight: 500;
				color: var(--text-muted);
			}

			ul {
				list-style: none;
				padding: 0;
				margin: 0;
			}

			li {
				padding: 0.5rem 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}

			a {
				color: var(--text-primary);
				text-decoration: none;
			}

			a:hover {
				color: var(--cyan);
			}

			.date {
				color: var(--text-muted);
				font-size: 0.85rem;
				margin-right: 0.75rem;
			}

			.empty {
				color: var(--text-muted);
			}
		</style>
	</head>
	<body>
		<Header homepage={true} />
		<main>
			<h1>drafts ({posts.length})</h1>
			{posts.length > 0 ? (
				<ul>
					{posts.map((post) => (
						<li>
							<span class="date"><FormattedDate date={post.data.pubDate} /></span>
							<a href={`/blog/${post.id}/`}>{post.data.title}</a>
						</li>
					))}
				</ul>
			) : (
				<p class="empty">none</p>
			)}
		</main>
		<Footer />
		<SecretSearch posts={allPosts} />
	</body>
</html>
