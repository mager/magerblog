---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tags from '../components/Tags.astro';
import SecretSearch from '../components/SecretSearch.astro';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime, category, tags, postId, draft, recipeLayout } = Astro.props;

// Prepend [DRAFT] to title if draft
const displayTitle = draft ? `[DRAFT] ${title}` : title;

// Get all posts for terminal search and category navigation
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const categoryPosts = allPosts
	.filter(post => post.data.category?.toLowerCase() === category?.toLowerCase())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = categoryPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < categoryPosts.length - 1 ? categoryPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : null;

// Map category to emoji + label for badge
const getCategoryBadge = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		tech: '💻 Tech',
		food: '🍳 Recipes',
		life: '🌆 Life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

const categoryBadge = getCategoryBadge(category);
---

<html lang="en">
	<head>
		<BaseHead title={displayTitle} description={description} image={heroImage} />
		<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&display=swap" rel="stylesheet" />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				flex: 1;
			}

			.sticky-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				background: var(--editor-bg);
				border-bottom: 1px solid var(--terminal-border);
				z-index: 1000;
				transform: translateY(-100%);
				transition: transform 0.3s ease;
			}

			.sticky-header.visible {
				transform: translateY(0);
			}

			.sticky-content {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0.75rem 2rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1.5rem;
			}

			.sticky-left {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				justify-content: flex-start;
			}

			.sticky-category {
				font-size: 1.1rem;
			}

			.sticky-logo {
				font-family: 'JetBrains Mono', monospace;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--cyan);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.sticky-logo:hover {
				color: var(--accent-green);
			}

			.sticky-title {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--text-secondary);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				text-align: center;
			}

			.scroll-to-top {
				background: transparent;
				border: 2px solid var(--text-muted);
				color: var(--text-primary);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				font-weight: 700;
				padding: 0.4rem 0.8rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.2s ease;
				justify-self: flex-end;
			}

			.scroll-to-top:hover {
				border-color: var(--accent-green);
				color: var(--accent-green);
				transform: translateY(-2px);
			}

			.hero {
				padding: 0;
				text-align: center;
				background: var(--editor-bg);
				position: relative;
				overflow: hidden;
				min-height: 100svh;
				display: flex;
				flex-direction: column;
			}

			.hero[data-has-image="false"] {
				min-height: auto;
			}


			.hero-image {
				width: 100%;
				max-width: 100%;
				margin: 0;
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				padding: 0;
				overflow: hidden;
			}

			.hero-image::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 60%;
				background: linear-gradient(to top, var(--editor-bg) 0%, var(--editor-bg) 20%, transparent 100%);
				pointer-events: none;
				z-index: 2;
			}

			.hero-image img {
				display: block;
				margin: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				border-radius: 0;
				border: none;
				box-shadow: none;
				transition: all 0.5s ease;
				image-rendering: -webkit-optimize-contrast;
			}

			.hero-image img:hover {
				transform: scale(1.01);
			}

			/* Draft styling */
			article.draft {
				position: relative;
				border: 2px dashed var(--status-amber);
				border-radius: 8px;
				margin: 1rem;
				background: linear-gradient(
					135deg,
					rgba(210, 153, 34, 0.05) 0%,
					transparent 50%,
					rgba(210, 153, 34, 0.05) 100%
				);
			}

			article.draft::before {
				content: 'DRAFT';
				position: absolute;
				top: 1rem;
				right: 1rem;
				padding: 0.4rem 0.8rem;
				background: var(--status-amber);
				color: var(--terminal-black);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				border-radius: 4px;
				z-index: 10;
				box-shadow: 0 2px 8px rgba(210, 153, 34, 0.3);
			}

			article.draft .hero {
				border-radius: 6px 6px 0 0;
			}

			article.draft .prose {
				border-radius: 0 0 6px 6px;
			}

			.prose {
				width: 100%;
				max-width: 100ch;
				margin: 2rem auto 2rem;
				padding: 2em;
				color: #b8c4ce;
				font-size: 1.125rem;
				line-height: 1.9;
				letter-spacing: 0.01em;
			}

			.title {
				margin: 0;
				padding: 3rem 2em 4rem;
				line-height: 1.2;
				position: relative;
				z-index: 10;
				background: transparent;
				margin-top: auto;
				text-align: left;
				max-width: 1200px;
			}

			.hero[data-has-image="false"] .title {
				padding-top: 6rem;
			}

			.title h1 {
				font-size: clamp(2.5rem, 6vw, 4rem);
				margin: 0;
				color: var(--text-primary);
				text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8), 0 4px 16px rgba(0, 0, 0, 0.6), 0 8px 32px rgba(0, 0, 0, 0.4);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}

			/* Tech category: bold magazine title */
			body[data-category="tech"] {
				background:
					radial-gradient(circle at 10% 10%, rgba(163, 113, 247, 0.16), transparent 28rem),
					radial-gradient(circle at 90% 8%, rgba(88, 166, 255, 0.12), transparent 26rem),
					linear-gradient(180deg, #05070c 0%, var(--editor-bg) 45%, #070a10 100%);
			}

			body[data-category="tech"] .hero {
				background:
					linear-gradient(115deg, rgba(5, 7, 12, 0.96) 0%, rgba(13, 17, 23, 0.68) 48%, rgba(5, 7, 12, 0.92) 100%),
					radial-gradient(circle at 18% 24%, rgba(163, 113, 247, 0.28), transparent 24rem),
					radial-gradient(circle at 84% 20%, rgba(88, 166, 255, 0.18), transparent 28rem),
					var(--editor-bg);
				isolation: isolate;
			}

			body[data-category="tech"] .hero::before,
			body[data-category="tech"] .hero::after {
				content: '';
				position: absolute;
				inset: 0;
				pointer-events: none;
				z-index: 3;
			}

			body[data-category="tech"] .hero::before {
				background-image:
					linear-gradient(rgba(88, 166, 255, 0.055) 1px, transparent 1px),
					linear-gradient(90deg, rgba(163, 113, 247, 0.05) 1px, transparent 1px);
				background-size: 48px 48px;
				mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.9), transparent 82%);
			}

			body[data-category="tech"] .hero::after {
				background:
					linear-gradient(90deg, transparent 0 7%, rgba(121, 192, 255, 0.12) 7% 7.08%, transparent 7.08% 100%),
					linear-gradient(to bottom, transparent 0%, var(--editor-bg) 96%);
			}

			body[data-category="tech"] .title {
				width: min(1360px, calc(100% - 4rem));
				margin-inline: auto;
				padding: clamp(5.25rem, 8vw, 7rem) 0 clamp(3rem, 6vw, 4.5rem);
				display: block;
			}

			body[data-category="tech"] .hero[data-has-image="true"] .title {
				min-height: 76svh;
				display: flex;
				align-items: flex-end;
			}

			body[data-category="tech"] .title-main {
				min-width: 0;
			}

			body[data-category="tech"] .tech-kicker {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				margin-bottom: 1rem;
				padding: 0.42rem 0.72rem;
				border: 1px solid rgba(121, 192, 255, 0.18);
				border-radius: 8px;
				background: rgba(5, 10, 18, 0.72);
				color: rgba(205, 218, 232, 0.86);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 0 32px rgba(88, 166, 255, 0.08);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.75rem;
				font-weight: 700;
				letter-spacing: 0.02em;
				line-height: 1;
			}

			body[data-category="tech"] .tech-kicker::before {
				content: '';
				width: 0.55rem;
				height: 0.55rem;
				border-radius: 999px;
				background: var(--accent-green);
				box-shadow: 0 0 16px rgba(80, 250, 123, 0.76);
			}

			body[data-category="tech"] .title h1 {
				font-family: 'Barlow Condensed', sans-serif;
				font-weight: 900;
				font-size: clamp(3.5rem, 7vw, 7.4rem);
				line-height: 0.94;
				letter-spacing: -0.02em;
				max-width: 15.5ch;
				background: linear-gradient(135deg, #ffffff 0%, #e6edf3 24%, #bc8cff 58%, #79c0ff 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				text-shadow: none;
				text-wrap: balance;
			}

			body[data-category="tech"] .title-dek {
				max-width: 76ch;
				margin: 1.25rem 0 0;
				color: rgba(205, 218, 232, 0.82);
				font-family: 'JetBrains Mono', monospace;
				font-size: clamp(1rem, 1.15vw, 1.12rem);
				line-height: 1.7;
				text-shadow: 0 2px 18px rgba(0, 0, 0, 0.58);
			}

			body[data-category="tech"] .title-tags {
				margin-top: 1.15rem;
				max-width: 76ch;
			}

			body[data-category="tech"] .title-tags .tags {
				justify-content: flex-start;
			}

			body[data-category="tech"] .tech-brief {
				position: relative;
				padding: 1rem;
				border: 1px solid rgba(121, 192, 255, 0.18);
				border-radius: 18px;
				background:
					linear-gradient(145deg, rgba(13, 17, 23, 0.86), rgba(1, 4, 9, 0.72)),
					rgba(1, 4, 9, 0.72);
				box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34), inset 0 1px 0 rgba(255, 255, 255, 0.05);
				backdrop-filter: blur(16px);
			}

			body[data-category="tech"] .tech-brief::before {
				content: '';
				position: absolute;
				inset: -1px;
				border-radius: inherit;
				padding: 1px;
				background: linear-gradient(135deg, rgba(163, 113, 247, 0.58), rgba(88, 166, 255, 0.28), transparent 60%);
				-webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
				-webkit-mask-composite: xor;
				mask-composite: exclude;
				pointer-events: none;
			}

			body[data-category="tech"] .tech-brief-row {
				display: grid;
				grid-template-columns: 6.5rem 1fr;
				gap: 0.8rem;
				align-items: baseline;
				padding: 0.86rem 0.9rem;
				border-bottom: 1px solid rgba(255, 255, 255, 0.07);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.78rem;
				line-height: 1.45;
			}

			body[data-category="tech"] .tech-brief-row:last-child {
				border-bottom: 0;
			}

			body[data-category="tech"] .tech-brief-label {
				color: rgba(139, 148, 158, 0.86);
				font-size: 0.68rem;
				font-weight: 800;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}

			body[data-category="tech"] .tech-brief-value {
				color: rgba(230, 237, 243, 0.92);
			}

			body[data-category="tech"] .tech-brief-value.accent {
				color: var(--cyan);
			}

			body[data-category="tech"] .date::before {
				content: '⚡ ';
				font-size: 0.85em;
			}

			/* No-image tech posts: minimal hero, direct entry */
			body[data-category="tech"] .hero[data-has-image="false"] {
				min-height: auto;
				border-bottom: 1px solid rgba(163, 113, 247, 0.2);
			}

			body[data-category="tech"] .hero[data-has-image="false"] .title {
				padding-top: 4rem;
				padding-bottom: 2.5rem;
			}

			.date {
				margin-bottom: 0.75em;
				color: var(--cyan);
				font-size: 0.9em;
				font-family: 'JetBrains Mono', monospace;
				letter-spacing: 0.5px;
				font-weight: 600;
				text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5);
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.hero-home-link {
				color: inherit;
				text-decoration: none;
				opacity: 0.8;
				transition: opacity 0.2s ease, color 0.2s ease;
			}

			.hero-home-link:hover {
				opacity: 1;
				color: var(--text-primary);
			}

			body[data-category="food"] .date {
				color: #ffa500;
			}

			body[data-category="life"] .date {
				color: #50fa7b;
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				color: #e2e8f0;
			}
			.prose p {
				margin-bottom: 1.75rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem auto;
				border-radius: 8px;
				display: block;
				transition: all 0.3s ease;
			}

			/* Tech category - Purple */
			body[data-category="tech"] .prose img {
				border: 1px solid var(--purple);
			}

			body[data-category="tech"] .prose img:hover {
				border-color: var(--cyan);
				transform: scale(1.01);
			}

			/* Food category - Orange */
			body[data-category="food"] .prose img {
				border: 1px solid #ff6b35;
			}

			body[data-category="food"] .prose img:hover {
				border-color: #ffa500;
				transform: scale(1.01);
			}

			/* Life category - Green */
			body[data-category="life"] .prose img {
				border: 1px solid var(--accent-green);
			}

			body[data-category="life"] .prose img:hover {
				border-color: #50fa7b;
				transform: scale(1.01);
			}
			.prose hr {
				margin: 3rem 0;
			}

			/* Tech category: enhanced code blocks */
			body[data-category="tech"] .prose pre {
				border: 1px solid var(--purple);
				border-radius: 8px;
				position: relative;
				margin: 2rem 0;
			}

			body[data-category="tech"] .prose pre::before {
				content: '●  ●  ●';
				display: block;
				padding: 0.5rem 1rem;
				font-size: 0.65rem;
				color: var(--text-muted);
				border-bottom: 1px solid var(--terminal-border);
				letter-spacing: 0.15em;
			}

			body[data-category="tech"] .prose blockquote {
				border-left: 3px solid var(--purple);
				background: rgba(163, 113, 247, 0.05);
				padding: 1rem 1.5rem;
				margin: 1.5rem 0;
				border-radius: 0 6px 6px 0;
			}

			body[data-category="tech"] .prose a {
				color: var(--cyan);
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition: border-color 0.2s ease;
			}

			body[data-category="tech"] .prose a:hover {
				border-bottom-color: var(--cyan);
			}

			body[data-category="tech"] .prose table {
				border: 1px solid var(--terminal-border);
				border-radius: 8px;
				overflow: hidden;
				width: 100%;
				border-collapse: separate;
				border-spacing: 0;
				margin: 2rem 0;
			}

			body[data-category="tech"] .prose th {
				background: rgba(163, 113, 247, 0.1);
				color: var(--purple-bright);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.85rem;
				font-weight: 600;
				text-align: left;
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--terminal-border);
			}

			body[data-category="tech"] .prose td {
				padding: 0.6rem 1rem;
				border-bottom: 1px solid var(--terminal-border);
				font-size: 0.95rem;
			}

			body[data-category="tech"] .prose tr:last-child td {
				border-bottom: none;
			}

			body[data-category="tech"] .prose code:not(pre code) {
				background: rgba(163, 113, 247, 0.1);
				color: var(--purple-bright);
				padding: 0.15em 0.4em;
				border-radius: 4px;
				font-size: 0.9em;
			}

			.prose .recipe-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 0 auto 3rem;
				padding: 1rem;
				font-family: 'JetBrains Mono', monospace;
			}

			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.meta-icon {
				font-size: 1.2rem;
			}

			.meta-label {
				color: var(--cyan);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.meta-value {
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.95rem;
			}

			.meta-divider {
				color: var(--text-muted);
				font-size: 1.2rem;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 0;
					min-height: 100svh;
				}
				.hero[data-has-image="false"] {
					min-height: auto;
				}
				.title {
					padding: 2rem 1.25rem 3rem;
				}
				.title h1 {
					font-size: clamp(1.8rem, 7vw, 2.5rem);
					letter-spacing: -0.02em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
					font-size: 1.05rem;
					/* Prevent any child from busting out of the viewport */
					overflow-x: hidden;
				}
				.prose pre {
					font-size: 0.78rem;
					padding: 1em 0.875em;
					border-radius: 8px;
					/* Scroll within the block, don't blow out the page */
					overflow-x: auto;
					max-width: 100%;
					-webkit-overflow-scrolling: touch;
				}
				.prose pre code {
					font-size: inherit;
					white-space: pre;
				}
				.hero-image {
					padding: 0;
				}
				.hero-image::after {
					height: 70%;
				}
				.hero-image img {
					transform: none;
					height: 100%;
					object-fit: cover;
				}
				.recipe-meta {
					flex-direction: column;
					gap: 1rem;
				}
				.meta-divider {
					display: none;
				}
			}

			/* Compact Recipe Layout */
			body[data-recipe-layout="compact"] .prose {
				max-width: 1400px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				align-items: start;
			}

			body[data-recipe-layout="compact"] .prose .recipe-meta {
				grid-column: 1 / -1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-text {
				grid-column: 1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images {
				grid-column: 2;
				position: sticky;
				top: 100px;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images img {
				margin: 0;
				width: 100%;
			}

			@media (max-width: 900px) {
				body[data-recipe-layout="compact"] .prose {
					display: block;
					max-width: 100ch;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images {
					position: static;
					margin-top: 2rem;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images img {
					margin: 1rem auto;
				}
