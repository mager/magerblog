---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tags from '../components/Tags.astro';
import SecretSearch from '../components/SecretSearch.astro';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime, category, tags, postId, draft, recipeLayout } = Astro.props;

// Prepend [DRAFT] to title if draft
const displayTitle = draft ? `[DRAFT] ${title}` : title;

// Get all posts for terminal search and category navigation
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const categoryPosts = allPosts
	.filter(post => post.data.category?.toLowerCase() === category?.toLowerCase())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = categoryPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < categoryPosts.length - 1 ? categoryPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : null;

// Map category to emoji + label for badge
const getCategoryBadge = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: '💻 Code',
		food: '🍳 Recipes',
		life: '🌆 Life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

const categoryBadge = getCategoryBadge(category);
---

<html lang="en">
	<head>
		<BaseHead title={displayTitle} description={description} image={heroImage} />
		<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&display=swap" rel="stylesheet" />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
				flex: 1;
			}

			.sticky-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				background: var(--editor-bg);
				border-bottom: 1px solid var(--terminal-border);
				z-index: 1000;
				transform: translateY(-100%);
				transition: transform 0.3s ease;
			}

			.sticky-header.visible {
				transform: translateY(0);
			}

			.sticky-content {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0.75rem 2rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1.5rem;
			}

			.sticky-left {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				justify-content: flex-start;
			}

			.sticky-category {
				font-size: 1.1rem;
			}

			.sticky-logo {
				font-family: 'JetBrains Mono', monospace;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--cyan);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.sticky-logo:hover {
				color: var(--accent-green);
			}

			.sticky-title {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--text-secondary);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				text-align: center;
			}

			.scroll-to-top {
				background: transparent;
				border: 2px solid var(--text-muted);
				color: var(--text-primary);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				font-weight: 700;
				padding: 0.4rem 0.8rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.2s ease;
				justify-self: flex-end;
			}

			.scroll-to-top:hover {
				border-color: var(--accent-green);
				color: var(--accent-green);
				transform: translateY(-2px);
			}

			.hero {
				padding: 0;
				text-align: center;
				background: var(--editor-bg);
				position: relative;
				overflow: hidden;
				min-height: 100svh;
				display: flex;
				flex-direction: column;
			}

			.hero[data-has-image="false"] {
				min-height: auto;
			}


			.hero-image {
				width: 100%;
				max-width: 100%;
				margin: 0;
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				padding: 0;
				overflow: hidden;
			}

			.hero-image::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 60%;
				background: linear-gradient(to top, var(--editor-bg) 0%, var(--editor-bg) 20%, transparent 100%);
				pointer-events: none;
				z-index: 2;
			}

			.hero-image img {
				display: block;
				margin: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				border-radius: 0;
				border: none;
				box-shadow: none;
				transition: all 0.5s ease;
				image-rendering: -webkit-optimize-contrast;
			}

			.hero-image img:hover {
				transform: scale(1.01);
			}

			/* Draft styling */
			article.draft {
				position: relative;
				border: 2px dashed var(--status-amber);
				border-radius: 8px;
				margin: 1rem;
				background: linear-gradient(
					135deg,
					rgba(210, 153, 34, 0.05) 0%,
					transparent 50%,
					rgba(210, 153, 34, 0.05) 100%
				);
			}

			article.draft::before {
				content: 'DRAFT';
				position: absolute;
				top: 1rem;
				right: 1rem;
				padding: 0.4rem 0.8rem;
				background: var(--status-amber);
				color: var(--terminal-black);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				border-radius: 4px;
				z-index: 10;
				box-shadow: 0 2px 8px rgba(210, 153, 34, 0.3);
			}

			article.draft .hero {
				border-radius: 6px 6px 0 0;
			}

			article.draft .prose {
				border-radius: 0 0 6px 6px;
			}

			.prose {
				width: 100%;
				max-width: 100ch;
				margin: 2rem auto 2rem;
				padding: 2em;
				color: #b8c4ce;
				font-size: 1.125rem;
				line-height: 1.9;
				letter-spacing: 0.01em;
			}

			.title {
				margin: 0;
				padding: 3rem 2em 4rem;
				line-height: 1.2;
				position: relative;
				z-index: 10;
				background: transparent;
				margin-top: auto;
				text-align: left;
				max-width: 1200px;
			}

			.hero[data-has-image="false"] .title {
				padding-top: 6rem;
			}

			.title h1 {
				font-size: clamp(2.5rem, 6vw, 4rem);
				margin: 0;
				color: var(--text-primary);
				text-shadow: 0 2px 4px rgba(0, 0, 0, 0.8), 0 4px 16px rgba(0, 0, 0, 0.6), 0 8px 32px rgba(0, 0, 0, 0.4);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}

			/* Code category: bold magazine title */
			body[data-category="code"] .title h1 {
				font-family: 'Barlow Condensed', sans-serif;
				font-weight: 900;
				font-size: clamp(3rem, 8vw, 6.5rem);
				line-height: 0.95;
				letter-spacing: -0.01em;
				background: linear-gradient(
					135deg,
					#E6EDF3 0%,
					#BC8CFF 40%,
					#79C0FF 100%
				);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				text-shadow: none;
			}

			body[data-category="code"] .title::before {
				content: '> ';
				color: rgba(163, 113, 247, 0.55);
				font-family: 'JetBrains Mono', monospace;
				font-size: clamp(1rem, 2vw, 1.4rem);
				font-weight: 400;
				opacity: 1;
			}

			body[data-category="code"] .date::before {
				content: '⚡ ';
				font-size: 0.85em;
			}

			/* No-image code posts: minimal hero, direct entry */
			body[data-category="code"] .hero[data-has-image="false"] {
				min-height: auto;
				border-bottom: 1px solid rgba(163, 113, 247, 0.2);
			}

			body[data-category="code"] .hero[data-has-image="false"] .title {
				padding-top: 4rem;
				padding-bottom: 2.5rem;
			}

			.date {
				margin-bottom: 0.75em;
				color: var(--cyan);
				font-size: 0.9em;
				font-family: 'JetBrains Mono', monospace;
				letter-spacing: 0.5px;
				font-weight: 600;
				text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8), 0 2px 8px rgba(0, 0, 0, 0.5);
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
			}

			.hero-home-link {
				color: inherit;
				text-decoration: none;
				opacity: 0.8;
				transition: opacity 0.2s ease, color 0.2s ease;
			}

			.hero-home-link:hover {
				opacity: 1;
				color: var(--text-primary);
			}

			body[data-category="food"] .date {
				color: #ffa500;
			}

			body[data-category="life"] .date {
				color: #50fa7b;
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				color: #e2e8f0;
			}
			.prose p {
				margin-bottom: 1.75rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem auto;
				border-radius: 8px;
				display: block;
				transition: all 0.3s ease;
			}

			/* Code category - Purple */
			body[data-category="code"] .prose img {
				border: 1px solid var(--purple);
			}

			body[data-category="code"] .prose img:hover {
				border-color: var(--cyan);
				transform: scale(1.01);
			}

			/* Food category - Orange */
			body[data-category="food"] .prose img {
				border: 1px solid #ff6b35;
			}

			body[data-category="food"] .prose img:hover {
				border-color: #ffa500;
				transform: scale(1.01);
			}

			/* Life category - Green */
			body[data-category="life"] .prose img {
				border: 1px solid var(--accent-green);
			}

			body[data-category="life"] .prose img:hover {
				border-color: #50fa7b;
				transform: scale(1.01);
			}
			.prose hr {
				margin: 3rem 0;
			}

			/* Code category: enhanced code blocks */
			body[data-category="code"] .prose pre {
				border: 1px solid var(--purple);
				border-radius: 8px;
				position: relative;
				margin: 2rem 0;
			}

			body[data-category="code"] .prose pre::before {
				content: '●  ●  ●';
				display: block;
				padding: 0.5rem 1rem;
				font-size: 0.65rem;
				color: var(--text-muted);
				border-bottom: 1px solid var(--terminal-border);
				letter-spacing: 0.15em;
			}

			body[data-category="code"] .prose blockquote {
				border-left: 3px solid var(--purple);
				background: rgba(163, 113, 247, 0.05);
				padding: 1rem 1.5rem;
				margin: 1.5rem 0;
				border-radius: 0 6px 6px 0;
			}

			body[data-category="code"] .prose a {
				color: var(--cyan);
				text-decoration: none;
				border-bottom: 1px solid transparent;
				transition: border-color 0.2s ease;
			}

			body[data-category="code"] .prose a:hover {
				border-bottom-color: var(--cyan);
			}

			body[data-category="code"] .prose table {
				border: 1px solid var(--terminal-border);
				border-radius: 8px;
				overflow: hidden;
				width: 100%;
				border-collapse: separate;
				border-spacing: 0;
				margin: 2rem 0;
			}

			body[data-category="code"] .prose th {
				background: rgba(163, 113, 247, 0.1);
				color: var(--purple-bright);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.85rem;
				font-weight: 600;
				text-align: left;
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--terminal-border);
			}

			body[data-category="code"] .prose td {
				padding: 0.6rem 1rem;
				border-bottom: 1px solid var(--terminal-border);
				font-size: 0.95rem;
			}

			body[data-category="code"] .prose tr:last-child td {
				border-bottom: none;
			}

			body[data-category="code"] .prose code:not(pre code) {
				background: rgba(163, 113, 247, 0.1);
				color: var(--purple-bright);
				padding: 0.15em 0.4em;
				border-radius: 4px;
				font-size: 0.9em;
			}

			.prose .recipe-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 0 auto 3rem;
				padding: 1rem;
				font-family: 'JetBrains Mono', monospace;
			}

			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.meta-icon {
				font-size: 1.2rem;
			}

			.meta-label {
				color: var(--cyan);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.meta-value {
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.95rem;
			}

			.meta-divider {
				color: var(--text-muted);
				font-size: 1.2rem;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 0;
					min-height: 100svh;
				}
				.hero[data-has-image="false"] {
					min-height: auto;
				}
				.title {
					padding: 2rem 1.25rem 3rem;
				}
				.title h1 {
					font-size: clamp(1.8rem, 7vw, 2.5rem);
					letter-spacing: -0.02em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
					font-size: 1.05rem;
					/* Prevent any child from busting out of the viewport */
					overflow-x: hidden;
				}
				.prose pre {
					font-size: 0.78rem;
					padding: 1em 0.875em;
					border-radius: 8px;
					/* Scroll within the block, don't blow out the page */
					overflow-x: auto;
					max-width: 100%;
					-webkit-overflow-scrolling: touch;
				}
				.prose pre code {
					font-size: inherit;
					white-space: pre;
				}
				.hero-image {
					padding: 0;
				}
				.hero-image::after {
					height: 70%;
				}
				.hero-image img {
					transform: none;
					height: 100%;
					object-fit: cover;
				}
				.recipe-meta {
					flex-direction: column;
					gap: 1rem;
				}
				.meta-divider {
					display: none;
				}
			}

			/* Compact Recipe Layout */
			body[data-recipe-layout="compact"] .prose {
				max-width: 1400px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				align-items: start;
			}

			body[data-recipe-layout="compact"] .prose .recipe-meta {
				grid-column: 1 / -1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-text {
				grid-column: 1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images {
				grid-column: 2;
				position: sticky;
				top: 100px;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images img {
				margin: 0;
				width: 100%;
			}

			@media (max-width: 900px) {
				body[data-recipe-layout="compact"] .prose {
					display: block;
					max-width: 100ch;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images {
					position: static;
					margin-top: 2rem;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images img {
					margin: 1rem auto;
				}
			}

		/* Article Footer Section */
		.article-footer {
			max-width: 100ch;
			margin: 0 auto;
			padding: 3rem 2em;
		}

		.tags-section {
			margin-bottom: 2rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid var(--text-muted);
		}

		.tags-section h3 {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.article-meta {
			margin-bottom: 3rem;
			padding-top: 2rem;
		}

		.meta-section h3 {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.meta-grid {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0;
		}

		.meta-grid .meta-item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.meta-grid .meta-divider {
			color: var(--text-muted);
			font-size: 0.75rem;
			margin: 0 0.25rem;
			opacity: 0.5;
		}

		.meta-grid .meta-label {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.meta-grid .meta-value {
			color: var(--text-secondary);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			font-weight: 500;
		}

		.post-navigation h3 {
			color: var(--purple);
			font-family: 'JetBrains Mono', monospace;
			font-size: 1.2rem;
			margin-bottom: 1.5rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.nav-link {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.5rem;
			background: var(--terminal-black);
			border: 2px solid var(--text-muted);
			border-radius: 8px;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.nav-link:hover {
			border-color: var(--cyan);
			background: var(--editor-bg-dark);
			transform: translateY(-2px);
		}

		.nav-link.prev:hover {
			border-color: var(--purple);
		}

		.nav-link.next:hover {
			border-color: var(--accent-green);
		}

		.nav-direction {
			color: var(--cyan);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-link.prev .nav-direction {
			color: var(--purple);
		}

		.nav-link.next .nav-direction {
			color: var(--accent-green);
		}

		.nav-title {
			color: var(--text-primary);
			font-family: 'Space Grotesk', sans-serif;
			font-size: 1.1rem;
			font-weight: 600;
			line-height: 1.3;
		}

		.nav-date {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
		}

		@media (max-width: 720px) {
			.article-footer {
				padding: 2rem 1em;
			}

			.nav-links {
				grid-template-columns: 1fr;
			}

			.meta-grid {
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.meta-grid .meta-label,
			.meta-grid .meta-value {
				font-size: 0.7rem;
			}

			.sticky-content {
				padding: 0.6rem 1rem;
				gap: 0.5rem;
				grid-template-columns: auto 1fr auto;
			}

			.sticky-left {
				gap: 0.5rem;
			}

			.sticky-category {
				font-size: 1rem;
			}

			.sticky-logo {
				font-size: 0.75rem;
			}

			.sticky-title {
				font-size: 0.75rem;
			}

			.scroll-to-top {
				padding: 0.3rem 0.6rem;
				font-size: 0.85rem;
			}
		}
		/* ── Reading Progress Bar ─────────────────────────────── */
		.reading-progress {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			z-index: 9999;
			background: rgba(255,255,255,0.05);
			pointer-events: none;
		}
		.reading-progress-fill {
			height: 100%;
			width: 0%;
			background: linear-gradient(to right, #a371f7, #58a6ff);
			transition: width 80ms linear;
			transform-origin: left;
		}
		body[data-category="food"] .reading-progress-fill {
			background: linear-gradient(to right, #f97316, #fbbf24);
		}
		body[data-category="life"] .reading-progress-fill {
			background: linear-gradient(to right, #10b981, #34d399);
		}

		/* ── Reading Time Badge ───────────────────────────────── */
		.reading-time-badge {
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8em;
			font-weight: 500;
			opacity: 0.6;
			margin-left: 0.75rem;
			padding-left: 0.75rem;
			border-left: 1px solid currentColor;
		}
		.reading-time-badge:empty { display: none; }

		/* ── Dot-grid background (code posts only) ────────────── */
		body[data-category="code"] .prose {
			background-image: radial-gradient(rgba(163,113,247,0.07) 1px, transparent 1px);
			background-size: 22px 22px;
		}

		/* ── Heading prefix in prose (code posts) ────────────── */
		body[data-category="code"] .prose h2 {
			position: relative;
		}
		body[data-category="code"] .prose h2::before {
			content: '// ';
			color: rgba(163,113,247,0.45);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8em;
			font-weight: 400;
			letter-spacing: 0;
		}
		body[data-category="code"] .prose h3::before {
			content: '— ';
			color: rgba(88,166,255,0.45);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85em;
			font-weight: 400;
		}

		/* ── Copy button on code blocks ──────────────────────── */
		.prose pre {
			position: relative;
		}
		.copy-code-btn {
			position: absolute;
			top: 2.4rem; /* below the ● ● ● dots line */
			right: 0.75rem;
			background: rgba(22,27,34,0.9);
			border: 1px solid rgba(255,255,255,0.1);
			color: rgba(180,195,220,0.55);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.62rem;
			letter-spacing: 0.04em;
			text-transform: uppercase;
			padding: 0.22rem 0.55rem;
			border-radius: 4px;
			cursor: pointer;
			opacity: 0;
			transition: opacity 0.2s ease, color 0.2s ease, border-color 0.2s ease;
			line-height: 1.4;
		}
		.prose pre:hover .copy-code-btn {
			opacity: 1;
		}
		.copy-code-btn:hover {
			color: rgba(220,235,255,0.9);
			border-color: rgba(255,255,255,0.25);
		}
		.copy-code-btn.copied {
			color: #3fb950;
			border-color: rgba(63,185,80,0.4);
		}

		/* ── HR glow for code posts ───────────────────────────── */
		body[data-category="code"] .prose hr {
			border: none;
			height: 1px;
			background: linear-gradient(to right, transparent, rgba(163,113,247,0.5), rgba(88,166,255,0.5), transparent);
			margin: 3rem 0;
			position: relative;
		}
		body[data-category="code"] .prose hr::after {
			content: '◆';
			position: absolute;
			left: 50%;
			top: 50%;
			transform: translate(-50%, -50%);
			background: var(--editor-bg);
			color: rgba(163,113,247,0.5);
			font-size: 0.7rem;
			padding: 0 0.5rem;
			line-height: 1;
		}
		</style>
	</head>

	<body data-category={category?.toLowerCase() || undefined} data-recipe-layout={recipeLayout || undefined}>
		<!-- Reading progress bar (code posts get purple→blue, others get a neutral) -->
		<div class="reading-progress" aria-hidden="true">
			<div class="reading-progress-fill"></div>
		</div>
		<Header />
		<div class="sticky-header">
			<div class="sticky-content">
				<div class="sticky-left">
					{categoryBadge && <span class="sticky-category">{categoryBadge.split(' ')[0]}</span>}
					<a href="https://www.mager.co" class="sticky-logo">&lt;mager.co /&gt;</a>
				</div>
				<span class="sticky-title">{displayTitle}</span>
				<button class="scroll-to-top" aria-label="Scroll to top">⬆️</button>
			</div>
		</div>
		<main>
			<article class={draft ? 'draft' : ''}>
				<div class="hero" data-has-image={heroImage ? "true" : "false"}>
					{heroImage && (
						<div class="hero-image">
							<img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
						</div>
					)}

					<div class="title">
						<div class="date">
							<a href="https://www.mager.co" class="hero-home-link">← mager.co</a>
							<span>/</span>
							<FormattedDate date={updatedDate || pubDate} />
							<span class="reading-time-badge" aria-label="Estimated reading time"></span>
						</div>
						<h1>{displayTitle}</h1>
					</div>
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>

			<section class="article-footer">
				{tags && tags.length > 0 && (
					<div class="tags-section">
						<h3>Tags</h3>
						<Tags tags={tags} />
					</div>
				)}
				<div class="article-meta">
					<div class="meta-section">
						<h3>Article Info</h3>
						<div class="meta-grid">
							{categoryBadge && (
								<>
									<div class="meta-item">
										<span class="meta-label">Category:</span>
										<span class="meta-value">{categoryBadge}</span>
									</div>
									<span class="meta-divider">|</span>
								</>
							)}
							<div class="meta-item">
								<span class="meta-label">Published:</span>
								<span class="meta-value"><FormattedDate date={pubDate} /></span>
							</div>
							{updatedDate && (
								<>
									<span class="meta-divider">|</span>
									<div class="meta-item">
										<span class="meta-label">Updated:</span>
										<span class="meta-value"><FormattedDate date={updatedDate} /></span>
									</div>
								</>
							)}
						</div>
					</div>
				</div>

				{(prevPost || nextPost) && (
					<nav class="post-navigation">
						<h3>More in {categoryBadge}</h3>
						<div class="nav-links">
							{prevPost && (
								<a href={`/blog/${prevPost.id}`} class="nav-link prev">
									<span class="nav-direction">← Previous</span>
									<span class="nav-title">{prevPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
								</a>
							)}
							{nextPost && (
								<a href={`/blog/${nextPost.id}`} class="nav-link next">
									<span class="nav-direction">Next →</span>
									<span class="nav-title">{nextPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
								</a>
							)}
						</div>
					</nav>
				)}
			</section>
		</main>
		<Footer />
		<script>
			// ── Sticky header ────────────────────────────────────
			const stickyHeader = document.querySelector('.sticky-header');
			const scrollToTopBtn = document.querySelector('.scroll-to-top');

			window.addEventListener('scroll', () => {
				const currentScroll = window.pageYOffset;
				if (currentScroll > 300) {
					stickyHeader?.classList.add('visible');
				} else {
					stickyHeader?.classList.remove('visible');
				}
			});

			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// ── Reading progress bar ─────────────────────────────
			const progressFill = document.querySelector('.reading-progress-fill') as HTMLElement | null;
			const article = document.querySelector('article');
			if (progressFill && article) {
				const updateProgress = () => {
					const articleTop = article.offsetTop;
					const articleH   = article.offsetHeight;
					const scrolled   = window.scrollY - articleTop;
					const total      = articleH - window.innerHeight;
					const pct        = Math.min(100, Math.max(0, (scrolled / total) * 100));
					progressFill.style.width = pct + '%';
				};
				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress();
			}

			// ── Reading time ─────────────────────────────────────
			const prose = document.querySelector('.prose');
			const readingTimeBadge = document.querySelector('.reading-time-badge');
			if (prose && readingTimeBadge) {
				const words   = (prose as HTMLElement).innerText.trim().split(/\s+/).length;
				const minutes = Math.max(1, Math.ceil(words / 220));
				readingTimeBadge.textContent = `${minutes} min read`;
			}

			// ── Copy buttons on code blocks ──────────────────────
			document.querySelectorAll<HTMLElement>('.prose pre').forEach(pre => {
				const btn = document.createElement('button');
				btn.className = 'copy-code-btn';
				btn.textContent = 'copy';
				btn.setAttribute('aria-label', 'Copy code');
				btn.addEventListener('click', () => {
					const code = pre.querySelector('code');
					const text = code?.innerText || pre.innerText;
					navigator.clipboard.writeText(text).then(() => {
						btn.textContent = '✓ copied';
						btn.classList.add('copied');
						setTimeout(() => {
							btn.textContent = 'copy';
							btn.classList.remove('copied');
						}, 2000);
					}).catch(() => {
						btn.textContent = 'error';
						setTimeout(() => { btn.textContent = 'copy'; }, 2000);
					});
				});
				pre.appendChild(btn);
			});
		</script>
		<SecretSearch posts={allPosts} />
	</body>
</html>