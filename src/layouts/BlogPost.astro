---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime, category } = Astro.props;

// Map category to display name for breadcrumb
const getCategoryName = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: 'code',
		food: 'recipes',
		life: 'life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

// Map category to emoji + label for badge
const getCategoryBadge = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: '💻 Code',
		food: '🍳 Recipes',
		life: '🌆 Life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

const categoryName = getCategoryName(category);
const categoryBadge = getCategoryBadge(category);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.hero {
				padding: 3rem 2em 0;
				text-align: center;
				background: linear-gradient(180deg, var(--terminal-black) 0%, var(--editor-bg-dark) 40%, var(--editor-bg) 100%);
				position: relative;
				overflow: hidden;
			}

			.hero::before {
				content: '';
				position: absolute;
				top: -300px;
				right: -300px;
				width: 800px;
				height: 800px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(136, 192, 208, 0.08), transparent 70%);
				z-index: 0;
			}

			.hero::after {
				content: '';
				position: absolute;
				bottom: -200px;
				left: -200px;
				width: 600px;
				height: 600px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(167, 139, 250, 0.1), transparent 70%);
				z-index: 0;
			}

			.hero-image {
				width: 100%;
				max-width: 1400px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
				padding: 0 2rem 5rem;
				overflow: visible;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow:
					0 0 0 2px var(--purple),
					0 0 0 4px var(--terminal-black),
					0 0 0 6px var(--cyan),
					0 30px 60px -12px rgba(0, 0, 0, 0.8),
					0 0 100px rgba(167, 139, 250, 0.3);
				transform: translateY(40px);
				border: 1px solid var(--terminal-black);
				transition: all 0.3s ease;
				max-height: 600px;
				width: auto;
				object-fit: contain;
			}

			.hero-image img:hover {
				box-shadow:
					0 0 0 2px var(--cyan),
					0 0 0 4px var(--terminal-black),
					0 0 0 6px var(--purple),
					0 35px 70px -12px rgba(0, 0, 0, 0.9),
					0 0 120px rgba(167, 139, 250, 0.5);
				transform: translateY(35px) scale(1.01);
			}

			.hero-image-placeholder {
				width: 100%;
				max-width: 1400px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
				padding: 0 2rem 3rem;
			}

			.terminal-window {
				background: var(--terminal-black);
				border-radius: 12px;
				border: 2px solid var(--text-muted);
				box-shadow:
					0 0 0 1px rgba(136, 192, 208, 0.2),
					0 25px 50px -12px rgba(0, 0, 0, 0.6);
				overflow: hidden;
				transform: translateY(50px);
			}

			.terminal-header {
				background: var(--editor-bg-dark);
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--text-muted);
				display: flex;
				gap: 0.5rem;
			}

			.dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
			}

			.dot.red {
				background: #ff5f56;
			}

			.dot.yellow {
				background: #ffbd2e;
			}

			.dot.green {
				background: #27c93f;
			}

			.terminal-body {
				padding: 2rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 1.2rem;
				color: var(--text-primary);
			}

			.terminal-body .prompt {
				color: var(--accent-green);
				font-weight: 700;
				margin-right: 0.75rem;
			}

			.terminal-body .command {
				color: var(--cyan);
			}

			.terminal-body .cursor {
				color: var(--purple);
				animation: blink 1s infinite;
				margin-left: 0.5rem;
			}

			@keyframes blink {
				0%, 50% { opacity: 1; }
				51%, 100% { opacity: 0; }
			}

			.prose {
				width: 100%;
				max-width: 75ch;
				margin: 6rem auto 2rem;
				padding: 2em;
				color: var(--text-primary);
			}

			.title {
				margin-bottom: 2rem;
				line-height: 1.2;
				position: relative;
				z-index: 1;
			}

			.tag-badge {
				display: inline-block;
				padding: 0.5rem 1rem;
				margin-top: 1rem;
				background: var(--terminal-black);
				border: 2px solid var(--cyan);
				border-radius: 6px;
				color: var(--text-primary);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				font-weight: 600;
				box-shadow: 0 0 20px rgba(136, 192, 208, 0.3);
			}

			.title h1 {
				font-size: 3.5em;
				margin: 0.5em 0;
				color: var(--text-primary);
				text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8), 0 0 40px rgba(136, 192, 208, 0.2);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}

			.date {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.75rem;
				margin-bottom: 1em;
				color: var(--cyan);
				font-size: 0.85em;
				font-family: 'JetBrains Mono', monospace;
				letter-spacing: 0.5px;
				font-weight: 500;
			}

			.date .prompt {
				color: var(--accent-green);
				margin-right: 0.5rem;
			}

			.date > span {
				display: flex;
				align-items: center;
				gap: 0.25rem;
			}

			.last-updated-on {
				font-style: normal;
				padding-left: 1rem;
				margin-left: 1rem;
				border-left: 2px solid var(--purple);
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--text-primary);
			}
			.prose p {
				margin-bottom: 1.5rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem auto;
				border-radius: 8px;
				display: block;
				box-shadow:
					0 0 0 1px var(--purple),
					0 0 0 2px var(--terminal-black),
					0 0 0 3px var(--cyan),
					0 10px 30px rgba(0, 0, 0, 0.6),
					0 0 60px rgba(167, 139, 250, 0.2);
				transition: all 0.3s ease;
				border: 1px solid var(--terminal-black);
			}

			.prose img:hover {
				box-shadow:
					0 0 0 1px var(--cyan),
					0 0 0 2px var(--terminal-black),
					0 0 0 3px var(--purple),
					0 15px 40px rgba(0, 0, 0, 0.7),
					0 0 80px rgba(167, 139, 250, 0.4);
				transform: scale(1.02);
			}
			.prose hr {
				margin: 3rem 0;
			}

			.prose .recipe-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 0 auto 3rem;
				padding: 1rem;
				font-family: 'JetBrains Mono', monospace;
			}

			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.meta-icon {
				font-size: 1.2rem;
			}

			.meta-label {
				color: var(--cyan);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.meta-value {
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.95rem;
			}

			.meta-divider {
				color: var(--text-muted);
				font-size: 1.2rem;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 2rem 1em 0;
				}
				.title h1 {
					font-size: 2.5em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
				}
				.hero-image {
					padding: 0 1rem 3rem;
				}
				.hero-image img {
					transform: translateY(20px);
					max-height: 400px;
				}
				.terminal-window {
					transform: translateY(20px);
				}
				.terminal-body {
					padding: 1.5rem;
					font-size: 0.95rem;
				}
				.hero-image-placeholder {
					padding: 0 1rem 2rem;
				}
				.recipe-meta {
					flex-direction: column;
					gap: 1rem;
				}
				.meta-divider {
					display: none;
				}
			}
		</style>
	</head>

	<body>
		<Header breadcrumb={{ show: true, tag: categoryName }} />
		<main>
			<article>
				<div class="hero">
					<div class="title">
						<div class="date">
							<span><span class="prompt">$</span> cat metadata.json</span>
							<span class="published">Published: <FormattedDate date={pubDate} /></span>
							{
								updatedDate && (
									<span class="last-updated-on">
										Updated: <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
						{categoryBadge && (
							<div class="tag-badge">{categoryBadge}</div>
						)}
					</div>

					{heroImage ? (
						<div class="hero-image">
							<img width={1200} height={600} src={heroImage} alt="" />
						</div>
					) : (
						<div class="hero-image-placeholder">
							<div class="terminal-window">
								<div class="terminal-header">
									<span class="dot red"></span>
									<span class="dot yellow"></span>
									<span class="dot green"></span>
								</div>
								<div class="terminal-body">
									<span class="prompt">$</span>
									<span class="command">head {title}.md</span>
									<span class="cursor">█</span>
								</div>
							</div>
						</div>
					)}
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>