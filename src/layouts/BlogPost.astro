			body[data-category="tech"] .prose .code-panel.is-collapsible.is-expanded pre {
				max-height: var(--code-expanded-max);
				overflow: auto;
			}

			body[data-category="tech"] .prose .code-panel.is-collapsible:not(.is-expanded)::after {
				content: '';
				position: absolute;
				left: 0;
				right: 0;
				bottom: 0;
				height: 7rem;
				background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.94) 78%);
				pointer-events: none;
			}

			body[data-category="tech"] .prose .code-panel.is-expanded {
				box-shadow:
					0 0 0 1px rgba(88, 166, 255, 0.16),
					0 24px 90px rgba(0, 0, 0, 0.42),
					0 0 54px rgba(88, 166, 255, 0.16);
			}

			body[data-category="tech"] .prose .code-panel:fullscreen,
			body[data-category="tech"] .prose .code-panel.is-fullscreen-fallback {
				width: 100vw;
				height: 100vh;
				margin: 0;
				transform: none;
				border: 0;
				border-radius: 0;
				display: flex;
				flex-direction: column;
				background: #03050a;
				z-index: 2000;
			}

			body[data-category="tech"] .prose .code-panel.is-fullscreen-fallback {
				position: fixed;
				inset: 0;
			}

			body[data-category="tech"] .prose .code-panel:fullscreen .code-panel-toolbar,
			body[data-category="tech"] .prose .code-panel.is-fullscreen-fallback .code-panel-toolbar {
				position: sticky;
				top: 0;
				z-index: 1;
			}

			body[data-category="tech"] .prose .code-panel:fullscreen pre,
			body[data-category="tech"] .prose .code-panel.is-fullscreen-fallback pre {
				flex: 1;
				height: 100%;
				max-height: none !important;
				overflow: auto !important;
			}

			body.code-panel-open {
				overflow: hidden;
			}

			@media (max-width: 720px) {
				body[data-category="tech"] .prose .code-panel {
					--code-preview-max: min(56vh, 26rem);
					width: calc(100% - 1rem);
					margin: 1.5rem auto;
					border-radius: 12px;
				}

				body[data-category="tech"] .prose .code-panel.is-short {
					width: fit-content;
					min-width: min(calc(100% - 1rem), 24rem);
					max-width: calc(100% - 1rem);
				}

				body[data-category="tech"] .prose .code-panel-toolbar {
					align-items: flex-start;
					flex-direction: column;
					gap: 0.65rem;
					padding: 0.75rem;
				}

				body[data-category="tech"] .prose .code-panel-actions {
					justify-content: flex-start;
					width: 100%;
				}

				body[data-category="tech"] .prose .code-panel-btn {
					font-size: 0.58rem;
					padding: 0.52rem 0.62rem;
				}

				body[data-category="tech"] .prose .code-panel pre {
					border-radius: 0;
					font-size: 0.78rem;
					padding: 1em 0.875em;
				}
			}
		</style>
	</head>

	<body data-category={category?.toLowerCase() || undefined} data-recipe-layout={recipeLayout || undefined}>
		<!-- Reading progress bar (tech posts get purple→blue, others get a neutral) -->
		<div class="reading-progress" aria-hidden="true">
			<div class="reading-progress-fill"></div>
		</div>
		<Header />
		<div class="sticky-header">
			<div class="sticky-content">
				<div class="sticky-left">
					{categoryBadge && <span class="sticky-category">{categoryBadge.split(' ')[0]}</span>}
					<a href="https://www.mager.co" class="sticky-logo">&lt;mager.co /&gt;</a>
				</div>
				<span class="sticky-title">{displayTitle}</span>
				<button class="scroll-to-top" aria-label="Scroll to top">⬆️</button>
			</div>
		</div>
		<main>
			<article class={draft ? 'draft' : ''}>
				<div class="hero" data-has-image={heroImage ? "true" : "false"}>
					{heroImage && (
						<div class="hero-image">
							<img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
						</div>
					)}

					<div class="title">
						<div class="title-main">
							{category?.toLowerCase() === 'tech' && <div class="tech-kicker">~/mager.co/tech $ cat article.md</div>}
							<div class="date">
								<a href="https://www.mager.co" class="hero-home-link">← mager.co</a>
								<span>/</span>
								<FormattedDate date={updatedDate || pubDate} />
								<span class="reading-time-badge" aria-label="Estimated reading time"></span>
							</div>
							<h1>{displayTitle}</h1>
							{category?.toLowerCase() === 'tech' && description && <p class="title-dek">{description}</p>}
							{category?.toLowerCase() === 'tech' && tags && tags.length > 0 && (
								<div class="title-tags"><Tags tags={tags} /></div>
							)}
						</div>
					</div>
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>

			<section class="article-footer">
				{category?.toLowerCase() === 'tech' ? (
					<div class="tech-footer-terminal" aria-label="Article footer">
						<div class="tech-footer-panel tech-footer-meta">
							<div class="terminal-command">$ stat article.md</div>
							<div class="terminal-lines">
								{categoryBadge && <div><span>category</span><strong>{categoryBadge}</strong></div>}
								<div><span>published</span><strong><FormattedDate date={pubDate} /></strong></div>
								{updatedDate && <div><span>updated</span><strong><FormattedDate date={updatedDate} /></strong></div>}
								{tags && tags.length > 0 && <div class="terminal-tags"><span>tags</span><strong>{tags.join(' / ')}</strong></div>}
							</div>
						</div>

						{(prevPost || nextPost) && (
							<nav class="tech-footer-panel tech-footer-related" aria-label="More tech posts">
								<div class="terminal-command">$ ls ../tech</div>
								<div class="terminal-related-list">
									{prevPost && (
										<a href={`/blog/${prevPost.id}`} class="terminal-related-link">
											<span class="terminal-related-direction">← previous</span>
											<span class="terminal-related-title">{prevPost.data.title}</span>
											<span class="terminal-related-date"><FormattedDate date={prevPost.data.pubDate} /></span>
										</a>
									)}
									{nextPost && (
										<a href={`/blog/${nextPost.id}`} class="terminal-related-link">
											<span class="terminal-related-direction">next →</span>
											<span class="terminal-related-title">{nextPost.data.title}</span>
											<span class="terminal-related-date"><FormattedDate date={nextPost.data.pubDate} /></span>
										</a>
									)}
								</div>
							</nav>
						)}
					</div>
				) : (
					<>
						{tags && tags.length > 0 && (
							<div class="tags-section">
								<h3>Tags</h3>
								<Tags tags={tags} />
							</div>
						)}
						<div class="article-meta">
							<div class="meta-section">
								<h3>Article Info</h3>
								<div class="meta-grid">
									{categoryBadge && (
										<>
											<div class="meta-item">
												<span class="meta-label">Category:</span>
												<span class="meta-value">{categoryBadge}</span>
											</div>
											<span class="meta-divider">|</span>
										</>
									)}
									<div class="meta-item">
										<span class="meta-label">Published:</span>
										<span class="meta-value"><FormattedDate date={pubDate} /></span>
									</div>
									{updatedDate && (
										<>
											<span class="meta-divider">|</span>
											<div class="meta-item">
												<span class="meta-label">Updated:</span>
												<span class="meta-value"><FormattedDate date={updatedDate} /></span>
											</div>
										</>
									)}
								</div>
							</div>
						</div>

						{(prevPost || nextPost) && (
							<nav class="post-navigation">
								<h3>More in {categoryBadge}</h3>
								<div class="nav-links">
									{prevPost && (
										<a href={`/blog/${prevPost.id}`} class="nav-link prev">
											<span class="nav-direction">← Previous</span>
											<span class="nav-title">{prevPost.data.title}</span>
											<span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
										</a>
									)}
									{nextPost && (
										<a href={`/blog/${nextPost.id}`} class="nav-link next">
											<span class="nav-direction">Next →</span>
											<span class="nav-title">{nextPost.data.title}</span>
											<span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
										</a>
									)}
								</div>
							</nav>
						)}
					</>
				)}
			</section>
		</main>
		<Footer />
		<script>
			// ── Sticky header ────────────────────────────────────
			const stickyHeader = document.querySelector('.sticky-header');
			const scrollToTopBtn = document.querySelector('.scroll-to-top');

			window.addEventListener('scroll', () => {
				const currentScroll = window.pageYOffset;
				if (currentScroll > 300) {
					stickyHeader?.classList.add('visible');
				} else {
					stickyHeader?.classList.remove('visible');
				}
			});

			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// ── Reading progress bar ─────────────────────────────
			const progressFill = document.querySelector('.reading-progress-fill') as HTMLElement | null;
			const article = document.querySelector('article');
			if (progressFill && article) {
				const updateProgress = () => {
					const articleTop = article.offsetTop;
					const articleH   = article.offsetHeight;
					const scrolled   = window.scrollY - articleTop;
					const total      = articleH - window.innerHeight;
					const pct        = Math.min(100, Math.max(0, (scrolled / total) * 100));
					progressFill.style.width = pct + '%';
				};
				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress();
			}

			// ── Reading time ─────────────────────────────────────
			const prose = document.querySelector('.prose');
			const readingTimeBadge = document.querySelector('.reading-time-badge');
			if (prose && readingTimeBadge) {
				const words   = (prose as HTMLElement).innerText.trim().split(/\s+/).length;
				const minutes = Math.max(1, Math.ceil(words / 220));
				readingTimeBadge.textContent = `${minutes} min read`;
			}

			// ── Code post panels: collapse, copy, fullscreen ─────
			if (document.body.dataset.category === 'tech') {
				const getLanguage = (pre: HTMLElement, code: HTMLElement | null) => {
					const languageClass = Array.from(code?.classList || [])
						.find(className => className.startsWith('language-'));
					return pre.dataset.language || languageClass?.replace('language-', '') || 'code';
				};

				const closeFullscreenFallback = () => {
					document.querySelectorAll<HTMLElement>('.code-panel.is-fullscreen-fallback').forEach(panel => {
						panel.classList.remove('is-fullscreen-fallback');
					});
					document.querySelectorAll<HTMLButtonElement>('.code-panel [aria-label="View code fullscreen"]').forEach(button => {
						button.textContent = 'fullscreen';
					});
					document.body.classList.remove('code-panel-open');
				};

				document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre, index) => {
					if (pre.closest('.code-panel')) return;

					const code = pre.querySelector<HTMLElement>('code');
					const rawText = code?.innerText || pre.innerText || '';
					const lineCount = Math.max(1, rawText.replace(/\r?\n$/, '').split(/\r\n|\r|\n/).length);
					const language = getLanguage(pre, code);
					const panel = document.createElement('section');
					const toolbar = document.createElement('div');
					const meta = document.createElement('div');
					const lights = document.createElement('span');
					const title = document.createElement('span');
					const actions = document.createElement('div');
					const copyBtn = document.createElement('button');
					const toggleBtn = document.createElement('button');
					const fullscreenBtn = document.createElement('button');
					const isLong = lineCount > 20;

					panel.className = `code-panel ${isLong ? 'is-collapsible' : 'is-short'}`;
					panel.setAttribute('aria-label', `Code snippet ${index + 1}`);

					toolbar.className = 'code-panel-toolbar';
					meta.className = 'code-panel-meta';
					lights.className = 'code-panel-lights';
					lights.setAttribute('aria-hidden', 'true');
					lights.innerHTML = '<span></span><span></span><span></span>';
					title.className = 'code-panel-title';
					title.textContent = `${language} · ${lineCount} ${lineCount === 1 ? 'line' : 'lines'}`;

					actions.className = 'code-panel-actions';
					copyBtn.className = 'code-panel-btn';
					copyBtn.type = 'button';
					copyBtn.textContent = 'copy';
					copyBtn.setAttribute('aria-label', 'Copy code');

					toggleBtn.className = 'code-panel-btn code-panel-toggle';
					toggleBtn.type = 'button';
					toggleBtn.textContent = 'show more';
					toggleBtn.setAttribute('aria-expanded', 'false');

					fullscreenBtn.className = 'code-panel-btn';
					fullscreenBtn.type = 'button';
					fullscreenBtn.textContent = 'fullscreen';
					fullscreenBtn.setAttribute('aria-label', 'View code fullscreen');

					meta.append(lights, title);
					if (isLong) actions.append(toggleBtn);
					actions.append(fullscreenBtn, copyBtn);
					toolbar.append(meta, actions);
					pre.parentNode?.insertBefore(panel, pre);
					panel.append(toolbar, pre);

					toggleBtn.addEventListener('click', () => {
						const isExpanded = panel.classList.toggle('is-expanded');
						toggleBtn.textContent = isExpanded ? 'show less' : 'show more';
						toggleBtn.setAttribute('aria-expanded', String(isExpanded));
					});

					fullscreenBtn.addEventListener('click', async () => {
						if (document.fullscreenElement === panel) {
							await document.exitFullscreen();
							return;
						}

						if (panel.classList.contains('is-fullscreen-fallback')) {
							closeFullscreenFallback();
							return;
						}

						panel.classList.add('is-expanded');
						toggleBtn.textContent = 'collapse';
						toggleBtn.setAttribute('aria-expanded', 'true');

						try {
							await panel.requestFullscreen();
						} catch {
							closeFullscreenFallback();
							panel.classList.add('is-fullscreen-fallback');
							fullscreenBtn.textContent = 'exit';
							document.body.classList.add('code-panel-open');
						}
					});

					copyBtn.addEventListener('click', () => {
						navigator.clipboard.writeText(rawText).then(() => {
							copyBtn.textContent = 'copied';
							copyBtn.classList.add('copied');
							setTimeout(() => {
								copyBtn.textContent = 'copy';
								copyBtn.classList.remove('copied');
							}, 1800);
						}).catch(() => {
							copyBtn.textContent = 'error';
							setTimeout(() => { copyBtn.textContent = 'copy'; }, 1800);
						});
					});
				});

				document.addEventListener('fullscreenchange', () => {
					const fullscreenPanel = document.fullscreenElement?.classList.contains('code-panel')
						? document.fullscreenElement as HTMLElement
						: null;
					document.querySelectorAll<HTMLButtonElement>('.code-panel [aria-label="View code fullscreen"]').forEach(button => {
						const panel = button.closest('.code-panel');
						button.textContent = panel === fullscreenPanel ? 'exit' : 'fullscreen';
					});
				});

				document.addEventListener('keydown', event => {
					if (event.key === 'Escape') closeFullscreenFallback();
				});
			}
		</script>
		<SecretSearch posts={allPosts} />
	</body>
</html>
