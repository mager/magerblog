---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0; /* Remove padding to allow hero to span full-width */
			}

			.hero {
				padding: 4rem 2em 0; /* Add padding top and sides, but not bottom */
				text-align: center;
				background-color: #f8f9fa; /* A very light, clean gray */
				/* Decorative dot-grid background */
				background-image: radial-gradient(circle at 1px 1px, rgba(var(--gray), 0.2) 1px, transparent 0);
				background-size: 2rem 2rem;
				position: relative;
				overflow: hidden; /* Hide the overflow from our decorative circle */
			}

			/* Decorative "golden circle" element */
			.hero::before {
				content: '';
				position: absolute;
				top: -250px;
				right: -250px;
				width: 600px;
				height: 600px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(var(--accent), 0.05), rgba(var(--accent), 0) 70%);
				z-index: 0;
			}

			.hero-image {
				width: 100%;
				max-width: 1200px; /* Make the hero image substantially wider */
				margin: 0 auto; /* Keep it centered */
				position: relative;
				z-index: 1; /* Ensure image is above the decorative circle */
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				/* A subtle lift-off-the-page effect */
				transform: translateY(40px);
			}

			.prose {
				width: 100%;
				/* Use the 'ch' unit for optimal line length and readability */
				max-width: 75ch; 
				margin: 4rem auto; /* Add vertical spacing before and after content */
				padding: 2em;
				color: rgb(var(--gray-dark));
			}

			.title {
				margin-bottom: 2rem;
				line-height: 1.2;
				position: relative;
				z-index: 1;
			}

			.title h1 {
				font-size: 3.5em; /* A more impactful title size */
				margin: 0.5em 0;
			}

			.date {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem 1rem;
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}

			.last-updated-on {
				font-style: italic;
				padding-left: 1rem;
				margin-left: 1rem;
				border-left: 1px solid rgb(var(--gray));
			}

			/* Mobile responsive adjustments */
			@media (max-width: 720px) {
				.hero {
					padding: 2rem 1em 0;
				}
				.title h1 {
					font-size: 2.5em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
				}
				.hero-image img {
					transform: translateY(20px);
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero">
					<div class="title">
						<div class="date">
							<span>Published on <FormattedDate date={pubDate} /></span>
							{
								updatedDate && (
									<span class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>
					
					{heroImage && (
						<div class="hero-image">
							<img width={1200} height={600} src={heroImage} alt="" />
						</div>
					)}
				</div>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>