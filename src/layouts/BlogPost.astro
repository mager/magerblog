---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime, category, postId } = Astro.props;

// Get all posts in the same category for prev/next navigation
const allPosts = await getCollection('blog');
const categoryPosts = allPosts
	.filter(post => post.data.category?.toLowerCase() === category?.toLowerCase())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = categoryPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < categoryPosts.length - 1 ? categoryPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : null;

// Map category to display name for breadcrumb
const getCategoryName = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: 'code',
		food: 'recipes',
		life: 'life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

// Map category to emoji + label for badge
const getCategoryBadge = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: '💻 Code',
		food: '🍳 Recipes',
		life: '🌆 Life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

const categoryName = getCategoryName(category);
const categoryBadge = getCategoryBadge(category);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.sticky-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				background: rgba(13, 17, 23, 0.95);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid var(--text-muted);
				z-index: 1000;
				transform: translateY(-100%);
				transition: transform 0.3s ease;
			}

			.sticky-header.visible {
				transform: translateY(0);
			}

			.sticky-content {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0.75rem 2rem;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
			}

			.sticky-left {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.sticky-category {
				font-size: 1.1rem;
			}

			.sticky-logo {
				font-family: 'JetBrains Mono', monospace;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--cyan);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.sticky-logo:hover {
				color: var(--accent-green);
			}

			.sticky-title {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--text-secondary);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				flex: 1;
				text-align: center;
			}

			.scroll-to-top {
				background: transparent;
				border: 2px solid var(--text-muted);
				color: var(--text-primary);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				font-weight: 700;
				padding: 0.4rem 0.8rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.2s ease;
			}

			.scroll-to-top:hover {
				border-color: var(--accent-green);
				color: var(--accent-green);
				transform: translateY(-2px);
			}

			.hero {
				padding: 0;
				text-align: center;
				background: var(--terminal-black);
				position: relative;
				overflow: hidden;
			}


			.hero-image {
				width: 100%;
				max-width: 100%;
				margin: 0;
				position: relative;
				z-index: 1;
				padding: 0;
				overflow: hidden;
			}

			.hero-image img {
				display: block;
				margin: 0;
				width: 100%;
				height: auto;
				max-height: 600px;
				object-fit: cover;
				border-radius: 0;
				border: none;
				box-shadow: none;
				transition: all 0.3s ease;
			}

			.hero-image img:hover {
				transform: scale(1.02);
			}

			.hero-image-placeholder {
				width: 100%;
				max-width: 1400px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
				padding: 0 2rem 3rem;
			}

			.terminal-window {
				background: var(--terminal-black);
				border-radius: 12px;
				border: 2px solid var(--text-muted);
				box-shadow:
					0 0 0 1px rgba(136, 192, 208, 0.2),
					0 25px 50px -12px rgba(0, 0, 0, 0.6);
				overflow: hidden;
				transform: translateY(50px);
			}

			.terminal-header {
				background: var(--editor-bg-dark);
				padding: 0.75rem 1rem;
				border-bottom: 1px solid var(--text-muted);
				display: flex;
				gap: 0.5rem;
			}

			.dot {
				width: 12px;
				height: 12px;
				border-radius: 50%;
			}

			.dot.red {
				background: #ff5f56;
			}

			.dot.yellow {
				background: #ffbd2e;
			}

			.dot.green {
				background: #27c93f;
			}

			.terminal-body {
				padding: 2rem;
				font-family: 'JetBrains Mono', monospace;
				font-size: 1.2rem;
				color: var(--text-primary);
			}

			.terminal-body .prompt {
				color: var(--accent-green);
				font-weight: 700;
				margin-right: 0.75rem;
			}

			.terminal-body .command {
				color: var(--cyan);
			}

			.terminal-body .cursor {
				color: var(--purple);
				animation: blink 1s infinite;
				margin-left: 0.5rem;
			}

			@keyframes blink {
				0%, 50% { opacity: 1; }
				51%, 100% { opacity: 0; }
			}

			.prose {
				width: 100%;
				max-width: 75ch;
				margin: 2rem auto 2rem;
				padding: 2em;
				color: var(--text-primary);
			}

			.title {
				margin: 0;
				padding: 2rem 2em;
				line-height: 1.2;
				position: relative;
				z-index: 1;
				background: linear-gradient(180deg, var(--terminal-black) 0%, var(--editor-bg-dark) 60%, var(--editor-bg) 100%);
			}

			.title h1 {
				font-size: 3.5em;
				margin: 0 0 0.3em;
				color: var(--text-primary);
				text-shadow: 0 2px 20px rgba(0, 0, 0, 0.8), 0 0 40px rgba(136, 192, 208, 0.2);
				font-weight: 800;
				letter-spacing: -0.03em;
				line-height: 1.1;
			}

			.date {
				margin-bottom: 0.5em;
				color: var(--cyan);
				font-size: 0.85em;
				font-family: 'JetBrains Mono', monospace;
				letter-spacing: 0.5px;
				font-weight: 500;
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
				font-weight: 800;
				letter-spacing: -0.02em;
				color: var(--text-primary);
			}
			.prose p {
				margin-bottom: 1.5rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem auto;
				border-radius: 8px;
				display: block;
				box-shadow:
					0 0 0 1px var(--purple),
					0 0 0 2px var(--terminal-black),
					0 0 0 3px var(--cyan),
					0 10px 30px rgba(0, 0, 0, 0.6),
					0 0 60px rgba(167, 139, 250, 0.2);
				transition: all 0.3s ease;
				border: 1px solid var(--terminal-black);
			}

			.prose img:hover {
				box-shadow:
					0 0 0 1px var(--cyan),
					0 0 0 2px var(--terminal-black),
					0 0 0 3px var(--purple),
					0 15px 40px rgba(0, 0, 0, 0.7),
					0 0 80px rgba(167, 139, 250, 0.4);
				transform: scale(1.02);
			}
			.prose hr {
				margin: 3rem 0;
			}

			.prose .recipe-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 0 auto 3rem;
				padding: 1rem;
				font-family: 'JetBrains Mono', monospace;
			}

			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.meta-icon {
				font-size: 1.2rem;
			}

			.meta-label {
				color: var(--cyan);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.meta-value {
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.95rem;
			}

			.meta-divider {
				color: var(--text-muted);
				font-size: 1.2rem;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 2rem 1em 0;
				}
				.title h1 {
					font-size: 2.5em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
				}
				.hero-image {
					padding: 0 1rem 3rem;
				}
				.hero-image img {
					transform: translateY(20px);
					max-height: 400px;
				}
				.terminal-window {
					transform: translateY(20px);
				}
				.terminal-body {
					padding: 1.5rem;
					font-size: 0.95rem;
				}
				.hero-image-placeholder {
					padding: 0 1rem 2rem;
				}
				.recipe-meta {
					flex-direction: column;
					gap: 1rem;
				}
				.meta-divider {
					display: none;
				}
			}

		/* Article Footer Section */
		.article-footer {
			max-width: 75ch;
			margin: 0 auto;
			padding: 3rem 2em;
		}

		.article-meta {
			margin-bottom: 3rem;
			padding-top: 2rem;
			border-top: 1px solid var(--text-muted);
		}

		.meta-section h3 {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.meta-grid {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0;
		}

		.meta-grid .meta-item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.meta-grid .meta-divider {
			color: var(--text-muted);
			font-size: 0.75rem;
			margin: 0 0.25rem;
			opacity: 0.5;
		}

		.meta-grid .meta-label {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.meta-grid .meta-value {
			color: var(--text-secondary);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			font-weight: 500;
		}

		.post-navigation h3 {
			color: var(--purple);
			font-family: 'JetBrains Mono', monospace;
			font-size: 1.2rem;
			margin-bottom: 1.5rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.nav-link {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.5rem;
			background: var(--terminal-black);
			border: 2px solid var(--text-muted);
			border-radius: 8px;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.nav-link:hover {
			border-color: var(--cyan);
			background: var(--editor-bg-dark);
			transform: translateY(-2px);
			box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
		}

		.nav-link.prev:hover {
			border-color: var(--purple);
			box-shadow:
				0 8px 20px rgba(0, 0, 0, 0.4),
				0 0 30px rgba(167, 139, 250, 0.3);
		}

		.nav-link.next:hover {
			border-color: var(--accent-green);
			box-shadow:
				0 8px 20px rgba(0, 0, 0, 0.4),
				0 0 30px rgba(80, 250, 123, 0.3);
		}

		.nav-direction {
			color: var(--cyan);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-link.prev .nav-direction {
			color: var(--purple);
		}

		.nav-link.next .nav-direction {
			color: var(--accent-green);
		}

		.nav-title {
			color: var(--text-primary);
			font-family: 'JetBrains Mono', monospace;
			font-size: 1.1rem;
			font-weight: 700;
			line-height: 1.3;
		}

		.nav-date {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
		}

		@media (max-width: 720px) {
			.article-footer {
				padding: 2rem 1em;
			}

			.nav-links {
				grid-template-columns: 1fr;
			}

			.meta-grid {
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.meta-grid .meta-label,
			.meta-grid .meta-value {
				font-size: 0.7rem;
			}

			.sticky-content {
				padding: 0.6rem 1rem;
				gap: 0.75rem;
			}

			.sticky-left {
				gap: 0.5rem;
			}

			.sticky-category {
				font-size: 1rem;
			}

			.sticky-logo {
				font-size: 0.75rem;
			}

			.sticky-title {
				font-size: 0.75rem;
			}

			.scroll-to-top {
				padding: 0.3rem 0.6rem;
				font-size: 0.85rem;
			}
		}
		</style>
	</head>

	<body>
		<Header activeCategory={categoryName} />
		<div class="sticky-header">
			<div class="sticky-content">
				<div class="sticky-left">
					{categoryBadge && <span class="sticky-category">{categoryBadge.split(' ')[0]}</span>}
					<a href="/" class="sticky-logo">&lt;mager.co /&gt;</a>
				</div>
				<span class="sticky-title">{title}</span>
				<button class="scroll-to-top" aria-label="Scroll to top">⬆️</button>
			</div>
		</div>
		<main>
			<article>
				<div class="hero">
					{heroImage ? (
						<div class="hero-image">
							<img width={1200} height={600} src={heroImage} alt="" />
						</div>
					) : (
						<div class="hero-image-placeholder">
							<div class="terminal-window">
								<div class="terminal-header">
									<span class="dot red"></span>
									<span class="dot yellow"></span>
									<span class="dot green"></span>
								</div>
								<div class="terminal-body">
									<span class="prompt">$</span>
									<span class="command">head {title}.md</span>
									<span class="cursor">█</span>
								</div>
							</div>
						</div>
					)}

					<div class="title">
						<div class="date">
							<FormattedDate date={updatedDate || pubDate} />
						</div>
						<h1>{title}</h1>
					</div>
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>

			<section class="article-footer">
				<div class="article-meta">
					<div class="meta-section">
						<h3>Article Info</h3>
						<div class="meta-grid">
							{categoryBadge && (
								<>
									<div class="meta-item">
										<span class="meta-label">Category:</span>
										<span class="meta-value">{categoryBadge}</span>
									</div>
									<span class="meta-divider">|</span>
								</>
							)}
							<div class="meta-item">
								<span class="meta-label">Published:</span>
								<span class="meta-value"><FormattedDate date={pubDate} /></span>
							</div>
							{updatedDate && (
								<>
									<span class="meta-divider">|</span>
									<div class="meta-item">
										<span class="meta-label">Updated:</span>
										<span class="meta-value"><FormattedDate date={updatedDate} /></span>
									</div>
								</>
							)}
						</div>
					</div>
				</div>

				{(prevPost || nextPost) && (
					<nav class="post-navigation">
						<h3>More in {categoryBadge}</h3>
						<div class="nav-links">
							{prevPost && (
								<a href={`/blog/${prevPost.id}`} class="nav-link prev">
									<span class="nav-direction">← Previous</span>
									<span class="nav-title">{prevPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
								</a>
							)}
							{nextPost && (
								<a href={`/blog/${nextPost.id}`} class="nav-link next">
									<span class="nav-direction">Next →</span>
									<span class="nav-title">{nextPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
								</a>
							)}
						</div>
					</nav>
				)}
			</section>
		</main>
		<Footer />
		<script>
			// Show/hide sticky header on scroll
			const stickyHeader = document.querySelector('.sticky-header');
			const scrollToTopBtn = document.querySelector('.scroll-to-top');
			let lastScroll = 0;

			window.addEventListener('scroll', () => {
				const currentScroll = window.pageYOffset;

				// Show header after scrolling down 300px
				if (currentScroll > 300) {
					stickyHeader?.classList.add('visible');
				} else {
					stickyHeader?.classList.remove('visible');
				}

				lastScroll = currentScroll;
			});

			// Scroll to top button
			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		</script>
	</body>
</html>