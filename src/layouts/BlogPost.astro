---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Tags from '../components/Tags.astro';
import SecretSearch from '../components/SecretSearch.astro';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime, category, tags, postId, draft, recipeLayout } = Astro.props;

// Prepend [DRAFT] to title if draft
const displayTitle = draft ? `[DRAFT] ${title}` : title;

// Get all posts for terminal search and category navigation
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const categoryPosts = allPosts
	.filter(post => post.data.category?.toLowerCase() === category?.toLowerCase())
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = categoryPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < categoryPosts.length - 1 ? categoryPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? categoryPosts[currentIndex - 1] : null;

// Map category to display name for breadcrumb
const getCategoryName = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: 'code',
		food: 'recipes',
		life: 'life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

// Map category to emoji + label for badge
const getCategoryBadge = (cat: string | undefined) => {
	if (!cat) return null;
	const categoryMap: Record<string, string> = {
		code: '💻 Code',
		food: '🍳 Recipes',
		life: '🌆 Life'
	};
	return categoryMap[cat.toLowerCase()] || null;
};

const categoryName = getCategoryName(category);
const categoryBadge = getCategoryBadge(category);
---

<html lang="en">
	<head>
		<BaseHead title={displayTitle} description={description} image={heroImage} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.sticky-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				background: var(--editor-bg);
				border-bottom: 1px solid var(--terminal-border);
				z-index: 1000;
				transform: translateY(-100%);
				transition: transform 0.3s ease;
			}

			.sticky-header.visible {
				transform: translateY(0);
			}

			.sticky-content {
				max-width: 1400px;
				margin: 0 auto;
				padding: 0.75rem 2rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1.5rem;
			}

			.sticky-left {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				justify-content: flex-start;
			}

			.sticky-category {
				font-size: 1.1rem;
			}

			.sticky-logo {
				font-family: 'JetBrains Mono', monospace;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--cyan);
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.sticky-logo:hover {
				color: var(--accent-green);
			}

			.sticky-title {
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				color: var(--text-secondary);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				text-align: center;
			}

			.scroll-to-top {
				background: transparent;
				border: 2px solid var(--text-muted);
				color: var(--text-primary);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.9rem;
				font-weight: 700;
				padding: 0.4rem 0.8rem;
				border-radius: 6px;
				cursor: pointer;
				transition: all 0.2s ease;
				justify-self: flex-end;
			}

			.scroll-to-top:hover {
				border-color: var(--accent-green);
				color: var(--accent-green);
				transform: translateY(-2px);
			}

			.hero {
				padding: 0;
				text-align: center;
				background: var(--editor-bg);
				position: relative;
				overflow: hidden;
				min-height: 100svh;
				display: flex;
				flex-direction: column;
			}

			.hero[data-has-image="false"] {
				min-height: auto;
			}


			.hero-image {
				width: 100%;
				max-width: 100%;
				margin: 0;
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				bottom: 0;
				z-index: 1;
				padding: 0;
				overflow: hidden;
			}

			.hero-image::after {
				content: '';
				position: absolute;
				bottom: 0;
				left: 0;
				right: 0;
				height: 60%;
				background: linear-gradient(to top, var(--editor-bg) 0%, var(--editor-bg) 20%, transparent 100%);
				pointer-events: none;
				z-index: 2;
			}

			.hero-image img {
				display: block;
				margin: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center;
				border-radius: 0;
				border: none;
				box-shadow: none;
				transition: all 0.5s ease;
				image-rendering: -webkit-optimize-contrast;
			}

			.hero-image img:hover {
				transform: scale(1.01);
			}

			/* Draft styling */
			article.draft {
				position: relative;
				border: 2px dashed var(--status-amber);
				border-radius: 8px;
				margin: 1rem;
				background: linear-gradient(
					135deg,
					rgba(210, 153, 34, 0.05) 0%,
					transparent 50%,
					rgba(210, 153, 34, 0.05) 100%
				);
			}

			article.draft::before {
				content: 'DRAFT';
				position: absolute;
				top: 1rem;
				right: 1rem;
				padding: 0.4rem 0.8rem;
				background: var(--status-amber);
				color: var(--terminal-black);
				font-family: 'JetBrains Mono', monospace;
				font-size: 0.7rem;
				font-weight: 700;
				letter-spacing: 0.1em;
				text-transform: uppercase;
				border-radius: 4px;
				z-index: 10;
				box-shadow: 0 2px 8px rgba(210, 153, 34, 0.3);
			}

			article.draft .hero {
				border-radius: 6px 6px 0 0;
			}

			article.draft .prose {
				border-radius: 0 0 6px 6px;
			}

			.prose {
				width: 100%;
				max-width: 100ch;
				margin: 2rem auto 2rem;
				padding: 2em;
				color: #b8c4ce;
				font-size: 1.125rem;
				line-height: 1.9;
				letter-spacing: 0.01em;
			}

			.title {
				margin: 0;
				padding: 3rem 2em 4rem;
				line-height: 1.2;
				position: relative;
				z-index: 10;
				background: transparent;
				margin-top: auto;
				text-align: left;
				max-width: 1200px;
			}

			.hero[data-has-image="false"] .title {
				padding-top: 6rem;
			}

			.title h1 {
				font-size: clamp(2.5rem, 8vw, 5rem);
				margin: 0;
				color: var(--text-primary);
				text-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
				font-weight: 900;
				letter-spacing: -0.04em;
				line-height: 1.05;
			}

			.date {
				margin-bottom: 0.75em;
				color: var(--cyan);
				font-size: 0.9em;
				font-family: 'JetBrains Mono', monospace;
				letter-spacing: 0.5px;
				font-weight: 600;
			}

			body[data-category="food"] .date {
				color: #ffa500;
			}

			body[data-category="life"] .date {
				color: #50fa7b;
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
				font-weight: 700;
				letter-spacing: -0.02em;
				color: #e2e8f0;
			}
			.prose p {
				margin-bottom: 1.75rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem auto;
				border-radius: 8px;
				display: block;
				transition: all 0.3s ease;
			}

			/* Code category - Purple */
			body[data-category="code"] .prose img {
				border: 1px solid var(--purple);
			}

			body[data-category="code"] .prose img:hover {
				border-color: var(--cyan);
				transform: scale(1.01);
			}

			/* Food category - Orange */
			body[data-category="food"] .prose img {
				border: 1px solid #ff6b35;
			}

			body[data-category="food"] .prose img:hover {
				border-color: #ffa500;
				transform: scale(1.01);
			}

			/* Life category - Green */
			body[data-category="life"] .prose img {
				border: 1px solid var(--accent-green);
			}

			body[data-category="life"] .prose img:hover {
				border-color: #50fa7b;
				transform: scale(1.01);
			}
			.prose hr {
				margin: 3rem 0;
			}

			.prose .recipe-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				margin: 0 auto 3rem;
				padding: 1rem;
				font-family: 'JetBrains Mono', monospace;
			}

			.meta-item {
				display: flex;
				align-items: center;
				gap: 0.5rem;
			}

			.meta-icon {
				font-size: 1.2rem;
			}

			.meta-label {
				color: var(--cyan);
				font-weight: 600;
				font-size: 0.95rem;
			}

			.meta-value {
				color: var(--text-primary);
				font-weight: 700;
				font-size: 0.95rem;
			}

			.meta-divider {
				color: var(--text-muted);
				font-size: 1.2rem;
			}

			@media (max-width: 720px) {
				.hero {
					padding: 0;
					min-height: 100svh;
				}
				.hero[data-has-image="false"] {
					min-height: auto;
				}
				.title {
					padding: 2rem 1.25rem 3rem;
				}
				.title h1 {
					font-size: clamp(2.2rem, 10vw, 3.5rem);
					letter-spacing: -0.03em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
					font-size: 1.05rem;
				}
				.hero-image {
					padding: 0;
				}
				.hero-image::after {
					height: 70%;
				}
				.hero-image img {
					transform: none;
					height: 100%;
					object-fit: cover;
				}
				.recipe-meta {
					flex-direction: column;
					gap: 1rem;
				}
				.meta-divider {
					display: none;
				}
			}

			/* Compact Recipe Layout */
			body[data-recipe-layout="compact"] .prose {
				max-width: 1400px;
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 3rem;
				align-items: start;
			}

			body[data-recipe-layout="compact"] .prose .recipe-meta {
				grid-column: 1 / -1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-text {
				grid-column: 1;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images {
				grid-column: 2;
				position: sticky;
				top: 100px;
				display: flex;
				flex-direction: column;
				gap: 2rem;
			}

			body[data-recipe-layout="compact"] .prose .recipe-images img {
				margin: 0;
				width: 100%;
			}

			@media (max-width: 900px) {
				body[data-recipe-layout="compact"] .prose {
					display: block;
					max-width: 100ch;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images {
					position: static;
					margin-top: 2rem;
				}

				body[data-recipe-layout="compact"] .prose .recipe-images img {
					margin: 1rem auto;
				}
			}

		/* Article Footer Section */
		.article-footer {
			max-width: 100ch;
			margin: 0 auto;
			padding: 3rem 2em;
		}

		.tags-section {
			margin-bottom: 2rem;
			padding-bottom: 2rem;
			border-bottom: 1px solid var(--text-muted);
		}

		.tags-section h3 {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.article-meta {
			margin-bottom: 3rem;
			padding-top: 2rem;
		}

		.meta-section h3 {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			margin-bottom: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			font-weight: 500;
		}

		.meta-grid {
			display: flex;
			align-items: center;
			gap: 1rem;
			padding: 0;
		}

		.meta-grid .meta-item {
			display: flex;
			align-items: center;
			gap: 0.5rem;
		}

		.meta-grid .meta-divider {
			color: var(--text-muted);
			font-size: 0.75rem;
			margin: 0 0.25rem;
			opacity: 0.5;
		}

		.meta-grid .meta-label {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.75rem;
			text-transform: uppercase;
			letter-spacing: 0.05em;
		}

		.meta-grid .meta-value {
			color: var(--text-secondary);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.8rem;
			font-weight: 500;
		}

		.post-navigation h3 {
			color: var(--purple);
			font-family: 'JetBrains Mono', monospace;
			font-size: 1.2rem;
			margin-bottom: 1.5rem;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-links {
			display: grid;
			grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
			gap: 1.5rem;
		}

		.nav-link {
			display: flex;
			flex-direction: column;
			gap: 0.75rem;
			padding: 1.5rem;
			background: var(--terminal-black);
			border: 2px solid var(--text-muted);
			border-radius: 8px;
			text-decoration: none;
			transition: all 0.3s ease;
		}

		.nav-link:hover {
			border-color: var(--cyan);
			background: var(--editor-bg-dark);
			transform: translateY(-2px);
		}

		.nav-link.prev:hover {
			border-color: var(--purple);
		}

		.nav-link.next:hover {
			border-color: var(--accent-green);
		}

		.nav-direction {
			color: var(--cyan);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
		}

		.nav-link.prev .nav-direction {
			color: var(--purple);
		}

		.nav-link.next .nav-direction {
			color: var(--accent-green);
		}

		.nav-title {
			color: var(--text-primary);
			font-family: 'JetBrains Mono', monospace;
			font-size: 1.1rem;
			font-weight: 700;
			line-height: 1.3;
		}

		.nav-date {
			color: var(--text-muted);
			font-family: 'JetBrains Mono', monospace;
			font-size: 0.85rem;
		}

		@media (max-width: 720px) {
			.article-footer {
				padding: 2rem 1em;
			}

			.nav-links {
				grid-template-columns: 1fr;
			}

			.meta-grid {
				flex-wrap: wrap;
				gap: 0.5rem;
			}

			.meta-grid .meta-label,
			.meta-grid .meta-value {
				font-size: 0.7rem;
			}

			.sticky-content {
				padding: 0.6rem 1rem;
				gap: 0.5rem;
				grid-template-columns: auto 1fr auto;
			}

			.sticky-left {
				gap: 0.5rem;
			}

			.sticky-category {
				font-size: 1rem;
			}

			.sticky-logo {
				font-size: 0.75rem;
			}

			.sticky-title {
				font-size: 0.75rem;
			}

			.scroll-to-top {
				padding: 0.3rem 0.6rem;
				font-size: 0.85rem;
			}
		}
		</style>
	</head>

	<body data-category={category?.toLowerCase() || undefined} data-recipe-layout={recipeLayout || undefined}>
		<Header activeCategory={categoryName || undefined} />
		<div class="sticky-header">
			<div class="sticky-content">
				<div class="sticky-left">
					{categoryBadge && <span class="sticky-category">{categoryBadge.split(' ')[0]}</span>}
					<a href="/" class="sticky-logo">&lt;mager.co /&gt;</a>
				</div>
				<span class="sticky-title">{displayTitle}</span>
				<button class="scroll-to-top" aria-label="Scroll to top">⬆️</button>
			</div>
		</div>
		<main>
			<article class={draft ? 'draft' : ''}>
				<div class="hero" data-has-image={heroImage ? "true" : "false"}>
					{heroImage && (
						<div class="hero-image">
							<img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
						</div>
					)}

					<div class="title">
						<div class="date">
							<FormattedDate date={updatedDate || pubDate} />
						</div>
						<h1>{displayTitle}</h1>
					</div>
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>

			<section class="article-footer">
				{tags && tags.length > 0 && (
					<div class="tags-section">
						<h3>Tags</h3>
						<Tags tags={tags} />
					</div>
				)}
				<div class="article-meta">
					<div class="meta-section">
						<h3>Article Info</h3>
						<div class="meta-grid">
							{categoryBadge && (
								<>
									<div class="meta-item">
										<span class="meta-label">Category:</span>
										<span class="meta-value">{categoryBadge}</span>
									</div>
									<span class="meta-divider">|</span>
								</>
							)}
							<div class="meta-item">
								<span class="meta-label">Published:</span>
								<span class="meta-value"><FormattedDate date={pubDate} /></span>
							</div>
							{updatedDate && (
								<>
									<span class="meta-divider">|</span>
									<div class="meta-item">
										<span class="meta-label">Updated:</span>
										<span class="meta-value"><FormattedDate date={updatedDate} /></span>
									</div>
								</>
							)}
						</div>
					</div>
				</div>

				{(prevPost || nextPost) && (
					<nav class="post-navigation">
						<h3>More in {categoryBadge}</h3>
						<div class="nav-links">
							{prevPost && (
								<a href={`/blog/${prevPost.id}`} class="nav-link prev">
									<span class="nav-direction">← Previous</span>
									<span class="nav-title">{prevPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
								</a>
							)}
							{nextPost && (
								<a href={`/blog/${nextPost.id}`} class="nav-link next">
									<span class="nav-direction">Next →</span>
									<span class="nav-title">{nextPost.data.title}</span>
									<span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
								</a>
							)}
						</div>
					</nav>
				)}
			</section>
		</main>
		<Footer />
		<script>
			// Show/hide sticky header on scroll
			const stickyHeader = document.querySelector('.sticky-header');
			const scrollToTopBtn = document.querySelector('.scroll-to-top');
			let lastScroll = 0;

			window.addEventListener('scroll', () => {
				const currentScroll = window.pageYOffset;

				// Show header after scrolling down 300px
				if (currentScroll > 300) {
					stickyHeader?.classList.add('visible');
				} else {
					stickyHeader?.classList.remove('visible');
				}

				lastScroll = currentScroll;
			});

			// Scroll to top button
			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
		</script>
		<SecretSearch posts={allPosts} />
	</body>
</html>