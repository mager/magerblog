				font-size: 0.9rem;
				line-height: 1.65;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				scrollbar-color: rgba(139, 148, 158, 0.45) transparent;
			}

			/* Pad the right so the corner copy button never covers code */
			body[data-category="tech"] .prose .code-panel pre code {
				padding-right: 2.25rem;
			}

			body[data-category="tech"] .prose .code-panel pre::before {
				content: none;
				display: none;
			}

			/* Corner copy button — quiet icon, appears on hover/focus */
			body[data-category="tech"] .prose .code-panel-copy {
				position: absolute;
				top: 0.5rem;
				right: 0.5rem;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 1.85rem;
				height: 1.85rem;
				padding: 0;
				appearance: none;
				cursor: pointer;
				border: 1px solid rgba(139, 148, 158, 0.2);
				border-radius: 6px;
				background: rgba(22, 27, 34, 0.85);
				color: rgba(205, 218, 232, 0.7);
				opacity: 0;
				backdrop-filter: blur(6px);
				transition: opacity 0.18s ease, color 0.18s ease, border-color 0.18s ease;
			}

			body[data-category="tech"] .prose .code-panel:hover .code-panel-copy,
			body[data-category="tech"] .prose .code-panel:focus-within .code-panel-copy {
				opacity: 1;
			}

			body[data-category="tech"] .prose .code-panel-copy:hover,
			body[data-category="tech"] .prose .code-panel-copy:focus-visible {
				color: var(--cyan);
				border-color: rgba(88, 166, 255, 0.5);
				outline: none;
			}

			body[data-category="tech"] .prose .code-panel-copy .icon-check { display: none; }
			body[data-category="tech"] .prose .code-panel-copy.copied {
				color: var(--accent-green);
				border-color: rgba(80, 250, 123, 0.45);
				opacity: 1;
			}
			body[data-category="tech"] .prose .code-panel-copy.copied .icon-copy { display: none; }
			body[data-category="tech"] .prose .code-panel-copy.copied .icon-check { display: inline; }

			@media (max-width: 720px) {
				body[data-category="tech"] .prose .code-panel {
					width: 100%;
					margin: 1.35rem 0;
					border-radius: 8px;
				}

				body[data-category="tech"] .prose .code-panel pre {
					font-size: 0.8rem;
					padding: 0.85rem 0.95rem;
				}

				/* On touch there is no hover — keep the copy button visible but subtle */
				body[data-category="tech"] .prose .code-panel-copy {
					opacity: 0.65;
				}
			}
		</style>
	</head>

	<body data-category={category?.toLowerCase() || undefined} data-recipe-layout={recipeLayout || undefined}>
		<!-- Reading progress bar (tech posts get purple→blue, others get a neutral) -->
		<div class="reading-progress" aria-hidden="true">
			<div class="reading-progress-fill"></div>
		</div>
		<Header />
		<div class="sticky-header">
			<div class="sticky-content">
				<div class="sticky-left">
					{categoryBadge && <span class="sticky-category">{categoryBadge.split(' ')[0]}</span>}
					<a href="https://www.mager.co" class="sticky-logo">&lt;mager.co /&gt;</a>
				</div>
				<span class="sticky-title">{displayTitle}</span>
				<button class="scroll-to-top" aria-label="Scroll to top">⬆️</button>
			</div>
		</div>
		<main>
			<article class={draft ? 'draft' : ''}>
				<div class="hero" data-has-image={heroImage ? "true" : "false"}>
					{category?.toLowerCase() === 'tech' && <canvas id="tech-particles" aria-hidden="true"></canvas>}
					{category?.toLowerCase() === 'tech' && <div class="tech-cursor-glow" aria-hidden="true"></div>}
					{heroImage && (
						<div class="hero-image">
							<img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
						</div>
					)}

					<div class="title">
						<div class="title-main">
							{category?.toLowerCase() === 'tech' && <div class="tech-kicker">~/mager.co/tech $ cat article.md</div>}
							<div class="date">
								<a href="https://www.mager.co" class="hero-home-link">← mager.co</a>
								<span>/</span>
								<FormattedDate date={updatedDate || pubDate} />
								<span class="reading-time-badge" aria-label="Estimated reading time"></span>
							</div>
							<h1>{displayTitle}</h1>
							{category?.toLowerCase() === 'tech' && description && <p class="title-dek">{description}</p>}
							{category?.toLowerCase() === 'tech' && tags && tags.length > 0 && (
								<div class="title-tags"><Tags tags={tags} /></div>
							)}
						</div>
					</div>
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<div class="recipe-meta">
								<div class="meta-item">
									<span class="meta-icon">⏱</span>
									<span class="meta-label">Prep:</span>
									<span class="meta-value">{prepTime} min</span>
								</div>
								<div class="meta-divider">|</div>
								<div class="meta-item">
									<span class="meta-icon">🔥</span>
									<span class="meta-label">Cook:</span>
									<span class="meta-value">{cookTime} min</span>
								</div>
							</div>
						)
					}
					<slot />
				</div>
			</article>

			<section class="article-footer">
				{category?.toLowerCase() === 'tech' ? (
					<div class="tech-footer-terminal" aria-label="Article footer">
						<div class="tech-footer-panel tech-footer-meta">
							<div class="terminal-command">$ stat article.md</div>
							<div class="terminal-lines">
								{categoryBadge && <div><span>category</span><strong>{categoryBadge}</strong></div>}
								<div><span>published</span><strong><FormattedDate date={pubDate} /></strong></div>
								{updatedDate && <div><span>updated</span><strong><FormattedDate date={updatedDate} /></strong></div>}
								{tags && tags.length > 0 && <div class="terminal-tags"><span>tags</span><strong>{tags.join(' / ')}</strong></div>}
							</div>
						</div>

						{(prevPost || nextPost) && (
							<nav class="tech-footer-panel tech-footer-related" aria-label="More tech posts">
								<div class="terminal-command">$ ls ../tech</div>
								<div class="terminal-related-list">
									{prevPost && (
										<a href={`/blog/${prevPost.id}`} class="terminal-related-link">
											<span class="terminal-related-direction">← previous</span>
											<span class="terminal-related-title">{prevPost.data.title}</span>
											<span class="terminal-related-date"><FormattedDate date={prevPost.data.pubDate} /></span>
										</a>
									)}
									{nextPost && (
										<a href={`/blog/${nextPost.id}`} class="terminal-related-link">
											<span class="terminal-related-direction">next →</span>
											<span class="terminal-related-title">{nextPost.data.title}</span>
											<span class="terminal-related-date"><FormattedDate date={nextPost.data.pubDate} /></span>
										</a>
									)}
								</div>
							</nav>
						)}
					</div>
				) : (
					<>
						{tags && tags.length > 0 && (
							<div class="tags-section">
								<h3>Tags</h3>
								<Tags tags={tags} />
							</div>
						)}
						<div class="article-meta">
							<div class="meta-section">
								<h3>Article Info</h3>
								<div class="meta-grid">
									{categoryBadge && (
										<>
											<div class="meta-item">
												<span class="meta-label">Category:</span>
												<span class="meta-value">{categoryBadge}</span>
											</div>
											<span class="meta-divider">|</span>
										</>
									)}
									<div class="meta-item">
										<span class="meta-label">Published:</span>
										<span class="meta-value"><FormattedDate date={pubDate} /></span>
									</div>
									{updatedDate && (
										<>
											<span class="meta-divider">|</span>
											<div class="meta-item">
												<span class="meta-label">Updated:</span>
												<span class="meta-value"><FormattedDate date={updatedDate} /></span>
											</div>
										</>
									)}
								</div>
							</div>
						</div>

						{(prevPost || nextPost) && (
							<nav class="post-navigation">
								<h3>More in {categoryBadge}</h3>
								<div class="nav-links">
									{prevPost && (
										<a href={`/blog/${prevPost.id}`} class="nav-link prev">
											<span class="nav-direction">← Previous</span>
											<span class="nav-title">{prevPost.data.title}</span>
											<span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
										</a>
									)}
									{nextPost && (
										<a href={`/blog/${nextPost.id}`} class="nav-link next">
											<span class="nav-direction">Next →</span>
											<span class="nav-title">{nextPost.data.title}</span>
											<span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
										</a>
									)}
								</div>
							</nav>
						)}
					</>
				)}
			</section>
		</main>
		<Footer />
		<script>
			// ── Sticky header ────────────────────────────────────
			const stickyHeader = document.querySelector('.sticky-header');
			const scrollToTopBtn = document.querySelector('.scroll-to-top');

			window.addEventListener('scroll', () => {
				const currentScroll = window.pageYOffset;
				if (currentScroll > 300) {
					stickyHeader?.classList.add('visible');
				} else {
					stickyHeader?.classList.remove('visible');
				}
			});

			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({ top: 0, behavior: 'smooth' });
			});

			// ── Reading progress bar ─────────────────────────────
			const progressFill = document.querySelector('.reading-progress-fill') as HTMLElement | null;
			const article = document.querySelector('article');
			if (progressFill && article) {
				const updateProgress = () => {
					const articleTop = article.offsetTop;
					const articleH   = article.offsetHeight;
					const scrolled   = window.scrollY - articleTop;
					const total      = articleH - window.innerHeight;
					const pct        = Math.min(100, Math.max(0, (scrolled / total) * 100));
					progressFill.style.width = pct + '%';
				};
				window.addEventListener('scroll', updateProgress, { passive: true });
				updateProgress();
			}

			// ── Reading time ─────────────────────────────────────
			const prose = document.querySelector('.prose');
			const readingTimeBadge = document.querySelector('.reading-time-badge');
			if (prose && readingTimeBadge) {
				const words   = (prose as HTMLElement).innerText.trim().split(/\s+/).length;
				const minutes = Math.max(1, Math.ceil(words / 220));
				readingTimeBadge.textContent = `${minutes} min read`;
			}

			// ── Code panels: quiet wrapper + corner copy button ──
			if (document.body.dataset.category === 'tech') {
				document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre, index) => {
					if (pre.closest('.code-panel')) return;

					const code = pre.querySelector<HTMLElement>('code');
					const rawText = code?.innerText || pre.innerText || '';
					const panel = document.createElement('section');
					const copyBtn = document.createElement('button');

					panel.className = 'code-panel';
					panel.setAttribute('aria-label', `Code snippet ${index + 1}`);

					copyBtn.className = 'code-panel-copy';
					copyBtn.type = 'button';
					copyBtn.setAttribute('aria-label', 'Copy code');
					copyBtn.innerHTML = `
						<svg class="icon-copy" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M5 2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-1v-1h1a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1v1H5V2Z"/>
							<path fill="currentColor" d="M3 4a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H3Zm0 1h6a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z"/>
						</svg>
						<svg class="icon-check" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
							<path fill="currentColor" d="M13.78 4.22a.75.75 0 0 1 0 1.06l-6.5 6.5a.75.75 0 0 1-1.06 0l-3-3a.75.75 0 1 1 1.06-1.06l2.47 2.47 5.97-5.97a.75.75 0 0 1 1.06 0Z"/>
						</svg>`;

					pre.parentNode?.insertBefore(panel, pre);
					panel.append(pre, copyBtn);

					copyBtn.addEventListener('click', () => {
						navigator.clipboard.writeText(rawText).then(() => {
							copyBtn.classList.add('copied');
							copyBtn.setAttribute('aria-label', 'Copied');
							setTimeout(() => {
								copyBtn.classList.remove('copied');
								copyBtn.setAttribute('aria-label', 'Copy code');
							}, 1600);
						}).catch(() => {});
					});
				});
			}

			// ── Skip all motion effects if reduced-motion ────────
			const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			// ── Canvas particle field (tech hero) ────────────────
			if (!noMotion && document.body.dataset.category === 'tech') {
				const canvas = document.querySelector('#tech-particles') as HTMLCanvasElement | null;
				if (canvas) {
					const ctx = canvas.getContext('2d')!;
					const colors = [
						'rgba(163,113,247,',
						'rgba(88,166,255,',
						'rgba(121,192,255,',
						'rgba(200,150,255,'
					];

					let W = 0, H = 0, rafId = 0, active = false;

					type Particle = { x: number; y: number; vx: number; vy: number; r: number; color: string; a: number; da: number };
					const particles: Particle[] = [];

					function resize() {
						W = canvas!.offsetWidth;
						H = canvas!.offsetHeight;
						canvas!.width = W;
						canvas!.height = H;
					}

					function makeParticle(): Particle {
						return {
							x: Math.random() * W,
							y: Math.random() * H,
							vx: (Math.random() - 0.5) * 0.28,
							vy: (Math.random() - 0.5) * 0.28,
							r: Math.random() * 1.6 + 0.4,
							color: colors[Math.floor(Math.random() * colors.length)],
							a: Math.random() * 0.45 + 0.08,
							da: (Math.random() - 0.5) * 0.003
						};
					}

					function draw() {
						ctx.clearRect(0, 0, W, H);
						for (const p of particles) {
							p.x += p.vx;
							p.y += p.vy;
							p.a = Math.max(0.05, Math.min(0.6, p.a + p.da));
							if (p.a <= 0.05 || p.a >= 0.6) p.da *= -1;
							if (p.x < -8) p.x = W + 8;
							if (p.x > W + 8) p.x = -8;
							if (p.y < -8) p.y = H + 8;
							if (p.y > H + 8) p.y = -8;
							ctx.beginPath();
							ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
							ctx.fillStyle = p.color + p.a.toFixed(2) + ')';
							ctx.fill();
						}
						rafId = requestAnimationFrame(draw);
					}

					resize();
					window.addEventListener('resize', resize, { passive: true });
					for (let i = 0; i < 72; i++) particles.push(makeParticle());

					const io = new IntersectionObserver(entries => {
						if (entries[0].isIntersecting) {
							if (!active) { active = true; draw(); }
						} else {
							active = false;
							cancelAnimationFrame(rafId);
						}
					});
					io.observe(canvas);
				}
			}

			// ── Typing kicker animation ──────────────────────────
			if (!noMotion && document.body.dataset.category === 'tech') {
				const kicker = document.querySelector('.tech-kicker') as HTMLElement | null;
				if (kicker) {
					const full = (kicker.textContent || '').trim();
					kicker.textContent = '';
					const cursor = document.createElement('span');
					cursor.className = 'kicker-cursor';
					cursor.setAttribute('aria-hidden', 'true');
					cursor.textContent = '▋';
					kicker.appendChild(cursor);
					let i = 0;
					function typeNext() {
						if (i < full.length) {
							kicker!.insertBefore(document.createTextNode(full[i++]), cursor);
							setTimeout(typeNext, 28 + Math.random() * 22);
						}
					}
					setTimeout(typeNext, 500);
				}
			}

			// ── Cursor glow tracking ─────────────────────────────
			if (!noMotion && document.body.dataset.category === 'tech') {
				const hero = document.querySelector('.hero') as HTMLElement | null;
				const glow = document.querySelector('.tech-cursor-glow') as HTMLElement | null;
				if (hero && glow) {
					hero.addEventListener('mousemove', (e) => {
						const rect = hero.getBoundingClientRect();
						glow.style.left = (e.clientX - rect.left) + 'px';
						glow.style.top  = (e.clientY - rect.top) + 'px';
					}, { passive: true });
				}
			}
		</script>
		<SecretSearch posts={allPosts} />
	</body>
</html>
