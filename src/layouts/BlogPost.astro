---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

// We are now reading prepTime and cookTime from the frontmatter props!
const { title, description, pubDate, updatedDate, heroImage, prepTime, cookTime } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			/* --- All of your existing CSS is perfect. No changes needed here. --- */
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
				padding: 0;
			}

			.hero {
				padding: 4rem 2em 0;
				text-align: center;
				background-color: #f8f9fa;
				background-image: radial-gradient(circle at 1px 1px, rgba(var(--gray), 0.2) 1px, transparent 0);
				background-size: 2rem 2rem;
				position: relative;
				overflow: hidden;
			}

			.hero::before {
				content: '';
				position: absolute;
				top: -250px;
				right: -250px;
				width: 600px;
				height: 600px;
				border-radius: 50%;
				background: radial-gradient(circle, rgba(var(--accent), 0.05), rgba(var(--accent), 0) 70%);
				z-index: 0;
			}

			.hero-image {
				width: 100%;
				max-width: 1200px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}

			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 16px;
				box-shadow: var(--box-shadow);
				transform: translateY(40px);
			}

			.prose {
				width: 100%;
				max-width: 75ch;
				margin: 4rem auto 2rem;
				padding: 2em;
				color: rgb(var(--gray-dark));
			}

			.title {
				margin-bottom: 2rem;
				line-height: 1.2;
				position: relative;
				z-index: 1;
			}

			.title h1 {
				font-size: 3.5em;
				margin: 0.5em 0;
			}

			.date {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5rem 1rem;
				margin-bottom: 1em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}

			.last-updated-on {
				font-style: italic;
				padding-left: 1rem;
				margin-left: 1rem;
				border-left: 1px solid rgb(var(--gray));
			}

			.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
				margin: 2.5rem 0 1rem;
			}
			.prose p {
				margin-bottom: 1.5rem;
			}
			.prose ul, .prose ol {
				padding-left: 1.5em;
				margin-bottom: 1.5rem;
			}
			.prose li {
				margin-bottom: 0.5rem;
			}
			.prose img {
				margin: 2rem 0;
				border-radius: 12px;
			}
			.prose hr {
				margin: 3rem 0;
			}

			.prose .recipe-meta {
				list-style-type: none;
				padding: 0;
				display: flex;
				justify-content: center;
				gap: 1.5rem;
				flex-wrap: wrap;
				margin: 0 auto 2rem; /* Center and give space below */
				color: rgb(var(--gray));
				font-size: 1em;
			}

			.prose .recipe-meta li {
				position: relative;
				margin-bottom: 0;
			}

			.prose .recipe-meta li + li::before {
				content: '|';
				position: absolute;
				left: -0.75rem;
				color: rgb(var(--gray-light));
			}

			@media (max-width: 720px) {
				.hero {
					padding: 2rem 1em 0;
				}
				.title h1 {
					font-size: 2.5em;
				}
				.prose {
					margin: 2rem auto;
					padding: 1em;
				}
				.hero-image img {
					transform: translateY(20px);
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero">
					<div class="title">
						<div class="date">
							<span>Published on <FormattedDate date={pubDate} /></span>
							{
								updatedDate && (
									<span class="last-updated-on">
										Updated <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</div>
						<h1>{title}</h1>
					</div>

					{heroImage && (
						<div class="hero-image">
							<img width={1200} height={600} src={heroImage} alt="" />
						</div>
					)}
				</div>
				<div class="prose">
					{
						prepTime && cookTime && (
							<ul class="recipe-meta">
								<li>Prep time: {prepTime} min</li>
								<li>Cook time: {cookTime} min</li>
							</ul>
						)
					}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>