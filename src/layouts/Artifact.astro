---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/reading.css';
import '../styles/artifact.css';
import { parse, renderSync, h } from 'ultrahtml';
import { querySelectorAll } from 'ultrahtml/selector';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  filename: string;
  markdownHref: string;
  headings: { depth: number; slug: string; text: string }[];
  previous?: { title: string; href: string };
  next?: { title: string; href: string };
}
const { title, description, pubDate, updatedDate, filename, markdownHref, headings, previous, next } = Astro.props;
const sections = headings.filter(heading => heading.depth === 2);
// Keep native table layout inside a keyboard-accessible scroll container.
const document = parse(await Astro.slots.render('default'));
for (const [index, table] of querySelectorAll(document, 'table').entries()) {
  const parent = table.parent;
  const position = parent.children.indexOf(table);
  delete table.attributes.tabindex;
  delete table.attributes.tabIndex;
  parent.children[position] = h('div', {
    class: 'artifact-table', tabindex: '0', role: 'region',
    'aria-label': `Table ${index + 1}, scroll horizontally if needed`,
  }, table);
}
const content = renderSync(document);
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`${title} — Artifact — mager.co`} description={description} /></head>
  <body class="publication reading-page artifact-page">
    <a class="skip-link" href="#main-content">Skip to document</a>
    <Header homepage themeToggle activeSection="/artifacts/" />
    <main id="main-content" class="artifact-layout">
      <div class="artifact-toolbar">
        <a href="/artifacts/">← All artifacts</a>
        <a href={markdownHref} download={filename}>Download .md <span aria-hidden="true">↓</span></a>
      </div>
      <article aria-labelledby="artifact-title">
        <header class="artifact-heading">
          <div class="artifact-file"><span>Artifact</span><span aria-hidden="true">/</span><span>{filename}</span></div>
          <h1 id="artifact-title">{title}</h1>
          <p class="artifact-description">{description}</p>
          <div class="artifact-meta">
            <span>Published <FormattedDate date={pubDate} /></span>
            {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
            <span>Markdown document</span>
          </div>
        </header>
        {sections.length > 1 && <details class="artifact-contents">
          <summary>In this document <span>{sections.length} sections</span></summary>
          <nav aria-label="Document contents">
          <ol>{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol>
          </nav>
        </details>}
        <div class="reading-prose artifact-prose" set:html={content} />
        <footer class="artifact-end">
          <a href={markdownHref} download={filename}>Download Markdown <span aria-hidden="true">↓</span></a>
          <a href="#artifact-title">Back to top ↑</a>
        </footer>
        {(previous || next) && <nav class="artifact-related" aria-label="More artifacts">
          {previous && <a href={previous.href}><span>← Older artifact</span>{previous.title}</a>}
          {next && <a href={next.href}><span>Newer artifact →</span>{next.title}</a>}
        </nav>}
      </article>
    </main>
    <Footer homepage />
  </body>
</html>
<script>
  import '../scripts/reading';
</script>
