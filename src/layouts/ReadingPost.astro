---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import '../styles/reading.css';

interface RelatedPost { title: string; href: string; }
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage?: string;
  tags?: string[];
  kind: 'Note' | 'Tech';
  minutes: number;
  headings?: { depth: number; slug: string; text: string }[];
  source?: { url: string; label: string };
  previous?: RelatedPost;
  next?: RelatedPost;
  draft?: boolean;
}
const { title, description, pubDate, updatedDate, heroImage, kind, minutes, headings = [], source, previous, next, draft } = Astro.props;
const sectionHref = kind === 'Note' ? '/notes/' : '/tech/';
const sections = headings.filter(heading => heading.depth === 2);
const contents = sections.length > 1;
const displayTitle = draft ? `[Draft] ${title}` : title;
---
<!doctype html>
<html lang="en" data-theme="light">
  <head><BaseHead title={`${displayTitle} — mager.co`} description={description} image={heroImage} /></head>
  <body class="publication reading-page" data-category="tech">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>
    <Header homepage themeToggle activeSection={sectionHref} />
    <main id="main-content" class:list={['reading-layout', { 'has-contents': contents, 'has-hero': !!heroImage }]}>
      <article class="reading-article">
        <header class="reading-heading" id="article-top">
          <a class="reading-back" href="/">← Back to the feed</a>
          <div class="reading-opening">
          <div class="reading-title">
          <div class="reading-meta"><a class="reading-kind" href={sectionHref}>{kind}</a><FormattedDate date={pubDate} /><span>{minutes} min read</span></div>
          <h1>{displayTitle}</h1>
          </div>
          {heroImage && <figure class="reading-hero"><img src={heroImage} alt="" width="1000" height="600" loading="eager" fetchpriority="high" decoding="async" /></figure>}
          <div class="reading-summary">
          {description && description !== title && <p class="reading-dek">{description}</p>}
          {source && <a class="reading-source" href={source.url} target="_blank" rel="noopener noreferrer"><span>Source</span> {source.label} <span aria-hidden="true">↗</span></a>}
          {updatedDate && <p class="reading-updated">Updated <FormattedDate date={updatedDate} /></p>}
          </div>
          </div>
        </header>
        <div class="reading-body">
        {contents && <details class="mobile-contents"><summary>On this page <span>{sections.length} sections</span></summary><nav aria-label="Page sections">{sections.map(section => <a href={`#${section.slug}`}>{section.text}</a>)}</nav></details>}
        <div class="reading-prose"><slot /></div>
        <footer class="reading-footer">
          {(previous || next) && <nav class="reading-related" aria-label="More posts">
            {previous && <a href={previous.href}><span>← Older</span><strong>{previous.title}</strong></a>}
            {next && <a href={next.href}><span>Newer →</span><strong>{next.title}</strong></a>}
          </nav>}
          <a class="reading-top" href="#article-top">Top ↑</a>
        </footer>
        </div>
      {contents && <aside class="reading-contents" aria-label="On this page"><p>On this page</p><nav aria-label="Page sections">{sections.map(section => <a href={`#${section.slug}`}>{section.text}</a>)}</nav></aside>}
      </article>
    </main>
    <Footer homepage />
    <slot name="search" />
  </body>
</html>
<script>
  import '../scripts/reading';
</script>
