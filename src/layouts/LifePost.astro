---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SecretSearch from '../components/SecretSearch.astro';
import '../styles/life.css';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const {
  title, description, pubDate, updatedDate, heroImage,
  tags, postId
} = Astro.props;

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const lifePosts = allPosts
  .filter(post => post.data.category === 'life')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = lifePosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < lifePosts.length - 1 ? lifePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? lifePosts[currentIndex - 1] : null;
---

<html lang="en" data-life>
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
    <style>
      .life-post-page {
        --post-bg: #f7f3ec;
        --post-surface: rgba(255, 252, 248, 0.82);
        --post-surface-strong: rgba(255, 253, 250, 0.96);
        --post-border: rgba(64, 52, 39, 0.12);
        --post-border-strong: rgba(64, 52, 39, 0.18);
        --post-text: #1f1a16;
        --post-text-soft: #5d554d;
        --post-text-muted: #80776e;
        --post-accent: #58677d;
        --post-accent-soft: rgba(88, 103, 125, 0.12);
        --post-shadow: 0 22px 50px rgba(66, 48, 30, 0.08);
        min-height: 100vh;
        background:
          radial-gradient(circle at top left, rgba(255,255,255,0.72), transparent 24%),
          linear-gradient(180deg, #f9f5ef 0%, var(--post-bg) 100%);
        color: var(--post-text);
      }

      .life-post-shell {
        width: min(100%, 1180px);
        margin: 0 auto;
        padding: 3.75rem 1.4rem 5rem;
      }

      .life-post-intro {
        display: grid;
        grid-template-columns: minmax(0, 720px) minmax(0, 320px);
        gap: 2rem;
        align-items: start;
      }

      .intro-copy {
        padding-top: 0.8rem;
      }

      .intro-meta,
      .tag,
      .nav-label,
      .footer-link,
      .eyebrow,
      .updated-label {
        font-family: 'IBM Plex Mono', monospace;
        text-transform: uppercase;
        letter-spacing: 0.12em;
      }

      .eyebrow {
        display: inline-block;
        margin-bottom: 1rem;
        font-size: 0.64rem;
        color: var(--post-accent);
      }

      .post-title {
        margin: 0;
        font-family: 'Instrument Serif', serif;
        font-size: clamp(3.1rem, 7vw, 5.4rem);
        line-height: 0.92;
        letter-spacing: -0.055em;
        text-wrap: balance;
      }

      .post-description {
        max-width: 42rem;
        margin: 1rem 0 0;
        font-family: 'Newsreader', serif;
        font-size: 1.24rem;
        line-height: 1.65;
        color: var(--post-text-soft);
      }

      .intro-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.35rem;
        font-size: 0.67rem;
        color: var(--post-text-muted);
      }

      .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        padding: 0.62rem 0.84rem;
        border-radius: 999px;
        background: rgba(255,255,255,0.68);
        border: 1px solid var(--post-border);
      }

      .meta-dot {
        width: 0.48rem;
        height: 0.48rem;
        border-radius: 999px;
        background: var(--post-accent);
      }

      .intro-note {
        padding: 1.1rem 1.15rem;
        border-radius: 1.3rem;
        background: var(--post-surface);
        border: 1px solid var(--post-border);
        box-shadow: var(--post-shadow);
      }

      .intro-note p {
        margin: 0.55rem 0 0;
        font-family: 'Newsreader', serif;
        font-size: 1rem;
        line-height: 1.65;
        color: var(--post-text-soft);
      }

      .hero-figure {
        margin: 2.4rem 0 0;
        border-radius: 1.8rem;
        overflow: hidden;
        background: var(--post-surface-strong);
        border: 1px solid var(--post-border);
        box-shadow: var(--post-shadow);
      }

      .hero-figure img {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        object-fit: cover;
      }

      .hero-caption {
        padding: 0.85rem 1rem 0.95rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.64rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--post-text-muted);
        border-top: 1px solid var(--post-border);
        background: rgba(255,255,255,0.54);
      }

      .life-content {
        max-width: 740px;
        margin: 3rem auto 0;
        padding: 0;
        font-family: 'Newsreader', serif;
        font-size: 1.28rem;
        line-height: 1.8;
        color: var(--post-text);
      }

      .life-content :global(p) {
        margin: 0 0 1.55rem;
      }

      .life-content :global(h2) {
        margin: 3.1rem 0 1rem;
        font-family: 'Instrument Serif', serif;
        font-size: 2.35rem;
        line-height: 0.98;
        letter-spacing: -0.04em;
        color: var(--post-text);
      }

      .life-content :global(h3) {
        margin: 2.3rem 0 0.85rem;
        font-family: 'Instrument Serif', serif;
        font-size: 1.7rem;
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .life-content :global(h4) {
        margin: 2rem 0 0.7rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--post-accent);
      }

      .life-content :global(a) {
        color: var(--post-text);
        text-decoration: underline;
        text-decoration-color: rgba(88, 103, 125, 0.34);
        text-underline-offset: 0.16em;
        text-decoration-thickness: 1px;
      }

      .life-content :global(a:hover) {
        text-decoration-color: var(--post-accent);
      }

      .life-content :global(strong) {
        font-weight: 600;
        color: var(--post-text);
      }

      .life-content :global(ul),
      .life-content :global(ol) {
        margin: 0 0 1.65rem;
        padding-left: 1.3em;
      }

      .life-content :global(li) {
        margin-bottom: 0.45rem;
      }

      .life-content :global(blockquote) {
        margin: 2.1rem 0;
        padding: 1.1rem 1.25rem;
        border-left: 3px solid var(--post-accent);
        background: var(--post-accent-soft);
        border-radius: 0 14px 14px 0;
        color: var(--post-text-soft);
      }

      .life-content :global(hr) {
        margin: 3rem 0;
        border: 0;
        border-top: 1px solid var(--post-border-strong);
      }

      .life-content :global(img) {
        width: 100%;
        height: auto;
        display: block;
        margin: 2rem 0;
        border-radius: 1rem;
        border: 1px solid var(--post-border);
        box-shadow: var(--post-shadow);
      }

      .life-content :global(iframe) {
        width: 100%;
        margin: 2rem 0;
        border-radius: 1rem;
        border: 1px solid var(--post-border);
      }

      .life-content :global(code:not(pre code)) {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.83em;
        padding: 0.16em 0.42em;
        border-radius: 0.4rem;
        color: #33455f;
        background: rgba(88, 103, 125, 0.08);
        border: 1px solid rgba(88, 103, 125, 0.16);
      }

      .life-content :global(pre),
      .life-content :global(.astro-code) {
        margin: 2.25rem 0 !important;
        padding: 1.2rem 1.3rem !important;
        border-radius: 1rem !important;
        border: 1px solid rgba(28, 34, 43, 0.12) !important;
        background: #faf7f2 !important;
        box-shadow: inset 0 1px 0 rgba(255,255,255,0.6);
        overflow-x: auto;
      }

      .life-content :global(pre > code) {
        font-family: 'IBM Plex Mono', monospace !important;
        font-size: 0.88rem !important;
        line-height: 1.7 !important;
        white-space: pre !important;
      }

      .post-tags {
        max-width: 740px;
        margin: 2.75rem auto 0;
        padding-top: 1.2rem;
        border-top: 1px solid var(--post-border);
        display: flex;
        flex-wrap: wrap;
        gap: 0.65rem;
        align-items: center;
      }

      .tag-label {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.66rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--post-text-muted);
      }

      .tag {
        display: inline-flex;
        align-items: center;
        padding: 0.46rem 0.72rem;
        border-radius: 999px;
        font-size: 0.67rem;
        color: var(--post-accent);
        background: rgba(88, 103, 125, 0.08);
        border: 1px solid rgba(88, 103, 125, 0.12);
      }

      .post-nav {
        max-width: 980px;
        margin: 4rem auto 0;
        padding-top: 1.6rem;
        border-top: 1px solid var(--post-border);
      }

      .nav-header {
        margin-bottom: 1rem;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.68rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--post-text-muted);
      }

      .nav-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
      }

      .nav-card {
        display: flex;
        flex-direction: column;
        gap: 0.45rem;
        padding: 1.15rem 1.2rem;
        border-radius: 1rem;
        background: var(--post-surface);
        border: 1px solid var(--post-border);
        box-shadow: var(--post-shadow);
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }

      .nav-card:hover {
        transform: translateY(-2px);
        border-color: var(--post-border-strong);
      }

      .nav-label {
        font-size: 0.64rem;
        color: var(--post-accent);
      }

      .nav-title {
        font-family: 'Instrument Serif', serif;
        font-size: 1.4rem;
        line-height: 1.02;
        letter-spacing: -0.03em;
        color: var(--post-text);
      }

      .nav-date {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 0.68rem;
        color: var(--post-text-muted);
      }

      .life-footer {
        max-width: 980px;
        margin: 4rem auto 0;
        padding: 1.6rem 0 0;
        border-top: 1px solid var(--post-border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
      }

      .footer-copy {
        font-family: 'Newsreader', serif;
        font-size: 1rem;
        color: var(--post-text-soft);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }

      .footer-link {
        font-size: 0.66rem;
        color: var(--post-text-muted) !important;
        text-decoration: none !important;
      }

      .footer-link:hover {
        color: var(--post-accent) !important;
      }

      @media (max-width: 900px) {
        .life-post-intro,
        .nav-grid,
        .life-footer {
          grid-template-columns: 1fr;
          flex-direction: column;
          align-items: flex-start;
        }

        .life-post-shell {
          padding-top: 2.8rem;
        }

        .post-title {
          font-size: clamp(2.6rem, 12vw, 4rem);
        }

        .life-content {
          font-size: 1.18rem;
        }
      }

      @media (max-width: 720px) {
        .life-post-shell {
          padding-left: 1rem;
          padding-right: 1rem;
          padding-bottom: 3.2rem;
        }

        .post-description,
        .life-content {
          font-size: 1.08rem;
        }

        .life-content :global(h2) {
          font-size: 1.95rem;
        }

        .life-content :global(h3) {
          font-size: 1.45rem;
        }
      }
    </style>
  </head>

  <body>
    <div class="life-post-page">
      <Header homepage={true} />

      <main class="life-post-shell">
        <section class="life-post-intro">
          <div class="intro-copy">
            <div class="eyebrow">Life</div>
            <h1 class="post-title">{title}</h1>
            <p class="post-description">{description}</p>
            <div class="intro-meta">
              <span class="meta-pill"><span class="meta-dot"></span><FormattedDate date={pubDate} /></span>
              {updatedDate && <span class="meta-pill"><span class="updated-label">Updated</span><FormattedDate date={updatedDate} /></span>}
              <span class="meta-pill">Chicago and beyond</span>
            </div>
          </div>

          <aside class="intro-note">
            <div class="eyebrow">Reading mode</div>
            <p>Cleaner typography, calmer color, and a little less visual theater. The writing should carry this page, not fight it.</p>
          </aside>
        </section>

        {heroImage && (
          <figure class="hero-figure">
            <img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
            <figcaption class="hero-caption">Field photo</figcaption>
          </figure>
        )}

        <article class="life-content">
          <slot />
        </article>

        {tags && tags.length > 0 && (
          <div class="post-tags">
            <span class="tag-label">Tags</span>
            {tags.map(tag => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}

        {(prevPost || nextPost) && (
          <nav class="post-nav">
            <div class="nav-header">More from life</div>
            <div class="nav-grid">
              {prevPost && (
                <a href={`/blog/${prevPost.id}/`} class="nav-card">
                  <span class="nav-label">Previous</span>
                  <span class="nav-title">{prevPost.data.title}</span>
                  <span class="nav-date"><FormattedDate date={prevPost.data.pubDate} /></span>
                </a>
              )}
              {nextPost && (
                <a href={`/blog/${nextPost.id}/`} class="nav-card">
                  <span class="nav-label">Next</span>
                  <span class="nav-title">{nextPost.data.title}</span>
                  <span class="nav-date"><FormattedDate date={nextPost.data.pubDate} /></span>
                </a>
              )}
            </div>
          </nav>
        )}

        <footer class="life-footer">
          <div class="footer-copy">Stories from Chicago and beyond.</div>
          <div class="footer-links">
            <a href="/life" class="footer-link">All life posts</a>
            <a href="/" class="footer-link">mager.co</a>
            <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
          </div>
        </footer>
      </main>

      <SecretSearch posts={allPosts} />
    </div>
  </body>
</html>
