---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SecretSearch from '../components/SecretSearch.astro';
import '../styles/life.css';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const {
  title, description, pubDate, updatedDate, heroImage,
  category, tags, postId, draft
} = Astro.props;

// Get related posts for navigation
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const lifePosts = allPosts
  .filter(post => post.data.category === 'life')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = lifePosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < lifePosts.length - 1 ? lifePosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? lifePosts[currentIndex - 1] : null;
---

<html lang="en" data-life>
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      /* ── Hero ── */
      .life-hero {
        position: relative;
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
        background: var(--lf-bg-alt);
      }

      .hero-image-wrapper {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .hero-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        border-radius: 0;
        transition: transform 8s ease;
      }

      .life-hero:hover .hero-image-wrapper img {
        transform: scale(1.03);
      }

      .hero-gradient {
        position: absolute;
        inset: 0;
        z-index: 2;
        background:
          linear-gradient(to top, var(--lf-bg) 0%, transparent 40%),
          linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
        pointer-events: none;
      }

      .hero-content {
        position: relative;
        z-index: 3;
        max-width: 900px;
        padding: 0 3rem 4rem;
        animation: lf-fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
      }

      .hero-date {
        display: inline-block;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-green);
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(8px);
        border: 1px solid var(--lf-border-green);
        padding: 0.35rem 1rem;
        border-radius: 100px;
        margin-bottom: 1.25rem;
      }

      .hero-title {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-weight: 700;
        font-size: clamp(3rem, 8vw, 5rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: #FFFFFF;
        margin: 0 0 1.25rem;
        text-shadow:
          0 2px 8px rgba(0, 0, 0, 0.5),
          0 8px 30px rgba(0, 0, 0, 0.3);
      }

      .hero-description {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.15rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.85);
        margin: 0;
        max-width: 600px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
      }

      /* ── No-image hero ── */
      .life-hero.no-image {
        min-height: auto;
        padding-top: 8rem;
        background: var(--lf-bg);
      }

      .life-hero.no-image .hero-content {
        padding-bottom: 3rem;
      }

      .life-hero.no-image .hero-title {
        color: var(--lf-text);
        text-shadow: none;
      }

      .life-hero.no-image .hero-description {
        color: var(--lf-text-secondary);
        text-shadow: none;
      }

      /* ── Content ── */
      .life-content {
        max-width: 800px;
        margin: 0 auto;
        padding: 4rem 2rem 2rem;
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.1rem;
        line-height: 1.85;
        color: var(--lf-text);
      }

      .life-content :global(p) {
        margin-bottom: 1.75rem;
      }

      .life-content :global(h2) {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--lf-text);
        margin: 3rem 0 1.25rem;
        letter-spacing: -0.02em;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--lf-divider);
      }

      .life-content :global(h3) {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--lf-text);
        margin: 2.5rem 0 1rem;
        letter-spacing: -0.01em;
      }

      .life-content :global(h4) {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-green);
        margin: 2rem 0 0.75rem;
      }

      .life-content :global(a) {
        color: var(--lf-green);
        text-decoration: underline;
        text-decoration-color: var(--lf-border-green);
        text-underline-offset: 3px;
        transition: all 0.2s ease;
      }

      .life-content :global(a:hover) {
        color: var(--lf-green-bright);
        text-decoration-color: var(--lf-green);
      }

      .life-content :global(strong) {
        color: var(--lf-text);
        font-weight: 600;
      }

      .life-content :global(ul),
      .life-content :global(ol) {
        padding-left: 1.5em;
        margin-bottom: 1.75rem;
      }

      .life-content :global(li) {
        margin-bottom: 0.5rem;
        color: var(--lf-text);
      }

      .life-content :global(li::marker) {
        color: var(--lf-green);
      }

      .life-content :global(blockquote) {
        border-left: 3px solid var(--lf-green);
        background: var(--lf-bg-surface);
        padding: 1rem 1.5rem;
        margin: 2rem 0;
        border-radius: 0 8px 8px 0;
        font-style: italic;
        color: var(--lf-text-secondary);
      }

      .life-content :global(hr) {
        border: none;
        border-top: 1px solid var(--lf-divider);
        margin: 3rem 0;
      }

      /* ── Images ── */
      .life-content :global(img) {
        width: 100%;
        margin: 2rem 0;
        border-radius: 12px;
        border: 1px solid var(--lf-border);
        box-shadow: var(--lf-shadow);
        transition: all 0.4s ease;
      }

      .life-content :global(img:hover) {
        border-color: var(--lf-border-green);
        box-shadow: var(--lf-shadow-lg);
        transform: scale(1.01);
      }

      /* ── Embeds ── */
      .life-content :global(iframe) {
        width: 100%;
        border-radius: 12px;
        border: 1px solid var(--lf-border);
        margin: 2rem 0;
      }

      .life-content :global(.twitter-tweet) {
        margin: 2rem auto !important;
      }

      /* ── Tags ── */
      .life-tags {
        max-width: 800px;
        margin: 3rem auto 0;
        padding: 2rem 2rem 0;
        border-top: 1px solid var(--lf-divider);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .life-tags .tag-label {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-text-muted);
      }

      .life-tags .tag {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--lf-green);
        background: var(--lf-badge-bg);
        border: 1px solid var(--lf-badge-border);
        padding: 0.25rem 0.65rem;
        border-radius: 100px;
        text-decoration: none;
      }

      /* ── Navigation ── */
      .life-navigation {
        max-width: 800px;
        margin: 4rem auto 0;
        padding: 3rem 2rem;
        border-top: 1px solid var(--lf-divider);
      }

      .nav-header {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--lf-green);
        margin-bottom: 1.5rem;
      }

      .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .nav-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.5rem;
        background: var(--lf-bg-card);
        border: 1px solid var(--lf-border);
        border-radius: 12px;
        text-decoration: none !important;
        transition: all 0.3s ease;
        box-shadow: var(--lf-shadow-card);
      }

      .nav-card:hover {
        border-color: var(--lf-border-green);
        transform: translateY(-3px);
        box-shadow: var(--lf-shadow-lg);
      }

      .nav-direction {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--lf-green);
      }

      .nav-card-title {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--lf-text);
        line-height: 1.3;
      }

      .nav-card-date {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.75rem;
        color: var(--lf-text-muted);
      }

      /* ── Footer ── */
      .life-footer {
        margin-top: 4rem;
        padding: 3rem 2rem;
        background: var(--lf-bg-alt);
        border-top: 1px solid var(--lf-border);
        text-align: center;
      }

      .footer-brand {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--lf-green);
        letter-spacing: 0.2em;
        margin-bottom: 0.5rem;
      }

      .footer-tagline {
        font-family: 'Space Grotesk', -apple-system, sans-serif;
        font-size: 0.85rem;
        color: var(--lf-text-muted);
        font-style: italic;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .footer-link {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.8rem;
        color: var(--lf-text-muted) !important;
        text-decoration: none !important;
        transition: color 0.2s ease !important;
      }

      .footer-link:hover {
        color: var(--lf-green) !important;
      }

      .footer-copy {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.72rem;
        color: var(--lf-text-muted);
        margin-top: 1.5rem;
        opacity: 0.6;
      }

      /* ── Keyboard Hints ── */
      .keyboard-hints {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        gap: 0.75rem;
        z-index: 50;
        opacity: 0.5;
        transition: opacity 0.2s ease;
      }

      .keyboard-hints:hover {
        opacity: 1;
      }

      .kbd-hint {
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.65rem;
        color: var(--lf-text-muted);
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      .kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 4px;
        font-family: 'JetBrains Mono', 'Fira Code', monospace;
        font-size: 0.6rem;
        font-weight: 600;
        color: var(--lf-text-muted);
        background: var(--lf-bg-surface);
        border: 1px solid var(--lf-border);
        border-radius: 4px;
        box-shadow: 0 1px 0 var(--lf-border);
      }

      /* ── Mobile ── */
      @media (max-width: 900px) {
        .life-hero {
          min-height: 70vh;
        }

        .hero-content {
          padding: 0 1.5rem 3rem;
        }

        .hero-title {
          font-size: clamp(2.5rem, 10vw, 3.5rem);
        }

        .life-content {
          padding: 2.5rem 1.25rem 1.5rem;
        }

        .life-navigation {
          padding: 2rem 1.25rem;
        }

        .nav-grid {
          grid-template-columns: 1fr;
        }

        .life-tags {
          padding: 1.5rem 1.25rem 0;
        }

        .keyboard-hints {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- Hero -->
    <header class:list={["life-hero", { "no-image": !heroImage }]}>
      {heroImage && (
        <div class="hero-image-wrapper">
          <img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
        </div>
      )}
      {heroImage && <div class="hero-gradient"></div>}

      <div class="hero-content">
        <span class="hero-date">
          <FormattedDate date={updatedDate || pubDate} />
        </span>
        <h1 class="hero-title">{title}</h1>
        <p class="hero-description">{description}</p>
      </div>
    </header>

    <!-- Content -->
    <article class="life-content">
      <slot />
    </article>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="life-tags">
        <span class="tag-label">Tags</span>
        {tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <!-- Navigation -->
    {(prevPost || nextPost) && (
      <nav class="life-navigation">
        <div class="nav-header">More from Life</div>
        <div class="nav-grid">
          {prevPost && (
            <a href={`/blog/${prevPost.id}/`} class="nav-card">
              <span class="nav-direction">&larr; Previous</span>
              <span class="nav-card-title">{prevPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={prevPost.data.pubDate} /></span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="nav-card">
              <span class="nav-direction">Next &rarr;</span>
              <span class="nav-card-title">{nextPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={nextPost.data.pubDate} /></span>
            </a>
          )}
        </div>
      </nav>
    )}

    <!-- Keyboard Hints (desktop only) -->
    <div class="keyboard-hints">
      <span class="kbd-hint"><span class="kbd">J</span><span class="kbd">K</span> nav</span>
    </div>

    <!-- Footer -->
    <footer class="life-footer">
      <div class="footer-brand">LIFE</div>
      <p class="footer-tagline">Stories from Chicago & beyond</p>
      <div class="footer-links">
        <a href="/life" class="footer-link">All Posts</a>
        <a href="/" class="footer-link">mager.co</a>
        <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} &middot; Built with <a href="https://astro.build" target="_blank" class="footer-link" style="display:inline">Astro</a></p>
    </footer>

    <!-- Keyboard Shortcuts -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          const prev = document.querySelector('.nav-card:first-child') as HTMLAnchorElement;
          const next = document.querySelector('.nav-card:last-child') as HTMLAnchorElement;

          switch(e.key) {
            case 'j': if (next?.href) window.location.href = next.href; break;
            case 'k': if (prev?.href) window.location.href = prev.href; break;
          }
        });
      });
    </script>

    <SecretSearch posts={allPosts} />
  </body>
</html>
