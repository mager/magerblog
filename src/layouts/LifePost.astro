---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { parse, renderSync, ELEMENT_NODE } from 'ultrahtml';
import { querySelectorAll } from 'ultrahtml/selector';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SecretSearch from '../components/SecretSearch.astro';
import { getLifeTheme } from '../lib/life-themes';
import '../styles/reading.css';
import '../styles/life-story.css';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };
const { title, description, pubDate, updatedDate, heroImage, heroImageAlt, tags, postId, locale, translationKey, draft } = Astro.props;
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const currentLocale = locale ?? 'en';
const translation = translationKey
  ? allPosts.find(post => post.data.translationKey === translationKey && (post.data.locale ?? 'en') !== currentLocale)
  : null;
const lifePosts = allPosts
  .filter(post => post.data.category === 'life' && (post.data.locale ?? 'en') === 'en')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// Translations navigate from their English counterpart's place in publication order.
const navigationId = currentLocale === 'en' ? postId : translation?.id ?? postId;
const currentIndex = lifePosts.findIndex(post => post.id === navigationId);
const previous = currentIndex >= 0 && currentIndex < lifePosts.length - 1 ? lifePosts[currentIndex + 1] : null;
const next = currentIndex > 0 ? lifePosts[currentIndex - 1] : null;
// Keep the opening photo first in the network queue on photo-heavy stories.
const content = parse(await Astro.slots.render('default'));
for (const image of querySelectorAll(content, 'img')) {
  if (image.type !== ELEMENT_NODE) continue;
  image.attributes.loading ??= 'lazy';
  image.attributes.decoding ??= 'async';
}
const contentHtml = renderSync(content);
const theme = getLifeTheme(postId);
const themeStyle = `--story-accent-light:${theme.accent};--story-accent-dark:${theme.accentDark};--story-paper:${theme.paper ?? 'var(--news-paper)'};--story-image-position:${theme.heroPosition ?? 'center'};`;
---
<!doctype html>
<html lang={currentLocale}>
  <head><BaseHead title={title} description={description} image={heroImage || undefined} /></head>
  <body class="publication reading-page life-story" data-story-kind={theme.kind} data-story-theme={theme.id} data-story-display={theme.display} style={themeStyle}>
    <a class="story-skip" href="#main-content">Skip to story</a>
    <Header homepage themeToggle activeSection="/life/" />
    <main id="main-content" class="story-main">
      <article>
        <header class:list={['story-opening', { 'has-image': Boolean(heroImage) }]}>
          <div class="story-title-block">
            <div class="story-eyebrow"><a href="/life/">Life</a><span aria-hidden="true">/</span><span>{theme.label}</span></div>
            {draft && <p class="story-draft">Draft</p>}
            <h1>{title}</h1>
            {description !== title && <p class="story-description">{description}</p>}
            <div class="story-meta">
              <FormattedDate date={pubDate} />
              {updatedDate && updatedDate.valueOf() !== pubDate.valueOf() && <span>Updated <FormattedDate date={updatedDate} /></span>}
            </div>
            {translation && (
              <nav class="story-languages" aria-label="Story language">
                <a href={currentLocale === 'en' ? `/blog/${postId}/` : `/blog/${translation.id}/`} lang="en" aria-current={currentLocale === 'en' ? 'page' : undefined}>English</a>
                <a href={currentLocale === 'ja' ? `/blog/${postId}/` : `/blog/${translation.id}/`} lang="ja" aria-current={currentLocale === 'ja' ? 'page' : undefined}>日本語</a>
              </nav>
            )}
          </div>
          {heroImage && (
            <figure class="story-image">
              <img src={heroImage} alt={heroImageAlt ?? ''} width="1200" height="900" loading="eager" decoding="async" fetchpriority="high" />
            </figure>
          )}
        </header>
        <div class="story-reading">
          <div class="story-margin" aria-hidden="true"><span>{theme.label}</span><span>{pubDate.getUTCFullYear()}</span></div>
          <div class="reading-prose story-prose" set:html={contentHtml} />
        </div>
        {tags && tags.length > 0 && <div class="story-tags" aria-label="Topics">{tags.map(tag => <span>{tag}</span>)}</div>}
        {(previous || next) && (
          <nav class="story-navigation" aria-label="More Life stories">
            <div class="story-navigation-heading"><span>Keep reading</span><a href="/life/">All Life stories <span aria-hidden="true">↗</span></a></div>
            <div class="story-navigation-links">
              {previous && <a href={`/blog/${previous.id}/`}><span class="story-nav-direction">← Older story</span><strong>{previous.data.title}</strong></a>}
              {next && <a href={`/blog/${next.id}/`}><span class="story-nav-direction">Newer story →</span><strong>{next.data.title}</strong></a>}
            </div>
          </nav>
        )}
      </article>
    </main>
    <Footer homepage />
    <SecretSearch posts={allPosts} />
  </body>
</html>
<script>
  import '../scripts/reading';
  document.querySelectorAll<HTMLImageElement>('.story-image img').forEach(image => {
    const hideUnavailable = () => {
      image.closest('figure')?.setAttribute('hidden', '');
      image.closest('.story-opening')?.classList.remove('has-image');
    };
    if (image.complete && image.naturalWidth === 0) hideUnavailable();
    image.addEventListener('error', hideUnavailable, { once: true });
  });
</script>
