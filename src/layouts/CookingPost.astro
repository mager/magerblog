---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SecretSearch from '../components/SecretSearch.astro';
import '../styles/cooking.css';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const {
  title, description, pubDate, heroImage, keyword,
  prepTime, cookTime, subcategory, postId, draft, tags
} = Astro.props;

const totalTime = (prepTime || 0) + (cookTime || 0);

// Build Recipe schema for structured data
const siteUrl = 'https://mager.co';
const postUrl = `${siteUrl}/blog/${postId}`;
const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  description: description,
  image: heroImage,
  author: {
    '@type': 'Person',
    name: 'Mager'
  },
  datePublished: pubDate?.toISOString?.() || pubDate,
  recipeCategory: subcategory || 'Main Course',
  keywords: tags?.join(', ') || keyword,
  ...(prepTime && { prepTime: `PT${prepTime}M` }),
  ...(cookTime && { cookTime: `PT${cookTime}M` }),
  ...(totalTime > 0 && { totalTime: `PT${totalTime}M` }),
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cooking',
      item: `${siteUrl}/cooking`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: postUrl
    }
  ]
};

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const foodPosts = allPosts
  .filter(post => post.data.category === 'food')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = foodPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < foodPosts.length - 1 ? foodPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? foodPosts[currentIndex - 1] : null;
---

<html lang="en" data-cooking>
  <head>
    <BaseHead title={title} description={description} image={heroImage} keywords={tags?.join(', ')} />
    <script type="application/ld+json" set:html={JSON.stringify(recipeSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <style>
      /* ── Hero Photo ── */
      .recipe-photo-wrap {
        width: 100%;
        max-height: 500px;
        overflow: hidden;
        background: var(--ck-bg-surface);
      }

      .recipe-photo-wrap img {
        width: 100%;
        height: 100%;
        max-height: 500px;
        object-fit: cover;
        display: block;
        border-radius: 0;
      }

      /* ── Recipe Header (title below photo) ── */
      .recipe-header {
        background: var(--ck-bg);
        border-bottom: 1px solid var(--ck-border);
        padding: 2.5rem 2rem 2rem;
      }

      .recipe-header-inner {
        max-width: 800px;
        margin: 0 auto;
      }

      .recipe-breadcrumb {
        display: inline-block;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.78rem;
        font-weight: 500;
        color: var(--ck-gold) !important;
        margin-bottom: 1.5rem;
        letter-spacing: 0.04em;
        text-decoration: none !important;
        transition: color 0.2s ease !important;
      }

      .recipe-breadcrumb:hover {
        color: var(--ck-gold-light) !important;
      }

      .recipe-cat-label {
        display: block;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--ck-gold);
        margin-bottom: 0.6rem;
      }

      .recipe-title-main {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: clamp(2rem, 6vw, 3rem);
        font-weight: 900;
        color: var(--ck-text);
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 0 0 1rem;
      }

      .recipe-desc-main {
        font-family: Georgia, "Times New Roman", serif;
        font-size: 1.1rem;
        color: var(--ck-text-secondary);
        line-height: 1.75;
        font-style: italic;
        margin: 0 0 1.5rem;
        max-width: 680px;
      }

      .recipe-meta-strip {
        display: flex;
        gap: 2.5rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--ck-border);
        flex-wrap: wrap;
      }

      .meta-chip {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
      }

      .meta-chip-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.6rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--ck-text-muted);
        font-weight: 700;
      }

      .meta-chip-val {
        font-family: 'DM Sans', sans-serif;
        font-size: 1rem;
        font-weight: 700;
        color: var(--ck-text);
      }

      /* ── Content Layout ── */
      .cooking-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 2rem;
      }

      /* ── Intro ── */
      .cooking-content :global(.recipe-intro) {
        max-width: 700px;
        margin: 0 auto 3rem;
        text-align: center;
        font-family: Georgia, serif;
        font-size: 1.1rem;
        line-height: 1.85;
        color: var(--ck-text-secondary);
        font-style: italic;
      }

      .cooking-content :global(.recipe-intro p) {
        margin: 0;
      }

      /* ── Two Column ── */
      .cooking-content :global(.recipe-body) {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 4rem;
        align-items: start;
      }

      /* ── Ingredients ── */
      .cooking-content :global(.recipe-ingredients) {
        position: sticky;
        top: 80px;
        background: var(--ck-bg-ingredients);
        border: 1px solid var(--ck-border);
        border-radius: 4px;
        padding: 1.75rem;
      }

      .cooking-content :global(.recipe-ingredients h4) {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 1.75rem 0 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-ingredients h4:first-child) {
        margin-top: 0;
      }

      .cooking-content :global(.recipe-ingredients ul) {
        list-style: none;
        padding: 0;
        margin: 0 0 0.5rem;
      }

      .cooking-content :global(.recipe-ingredients li) {
        font-family: Georgia, serif;
        font-size: 0.9rem;
        line-height: 1.6;
        color: var(--ck-text);
        padding: 0.3rem 0 0.3rem 1.1rem;
        position: relative;
        border-bottom: 1px solid var(--ck-divider);
        cursor: pointer;
        user-select: none;
        transition: opacity 0.2s ease;
      }

      .cooking-content :global(.recipe-ingredients li:last-child) {
        border-bottom: none;
      }

      .cooking-content :global(.recipe-ingredients li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      .cooking-content :global(.recipe-ingredients li.checked) {
        opacity: 0.4;
        text-decoration: line-through;
        text-decoration-color: var(--ck-gold);
      }

      /* ── Instructions ── */
      .cooking-content :global(.recipe-instructions) {
        font-family: Georgia, serif;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--ck-text);
        counter-reset: step-counter;
      }

      .cooking-content :global(.recipe-instructions p) {
        position: relative;
        margin-bottom: 2rem;
        padding-left: 3rem;
        counter-increment: step-counter;
      }

      .cooking-content :global(.recipe-instructions p)::before {
        content: counter(step-counter);
        position: absolute;
        left: 0;
        top: -0.1rem;
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.5rem;
        font-weight: 900;
        color: var(--ck-gold);
        opacity: 0.5;
        line-height: 1;
        width: 2rem;
        text-align: center;
      }

      .cooking-content :global(.recipe-instructions p:has(> img:only-child)) {
        counter-increment: none;
        padding-left: 0;
      }

      .cooking-content :global(.recipe-instructions p:has(> img:only-child))::before {
        display: none;
      }

      .cooking-content :global(.recipe-instructions img) {
        width: 100%;
        margin: 1rem 0 2rem;
        border-radius: 4px;
        border: 1px solid var(--ck-img-border);
      }

      /* ── Gallery ── */
      .cooking-content :global(.recipe-gallery) {
        margin-top: 3rem;
        padding-top: 2.5rem;
        border-top: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-gallery p) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1rem;
      }

      .cooking-content :global(.recipe-gallery img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--ck-img-border);
        margin: 0;
        transition: opacity 0.2s ease;
      }

      .cooking-content :global(.recipe-gallery img:hover) {
        opacity: 0.9;
      }

      /* ── Fallback: old recipe-text format ── */
      .cooking-content :global(.recipe-text) {
        font-family: Georgia, serif;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--ck-text);
      }

      .cooking-content :global(.recipe-text h4) {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-text ul) {
        list-style: none;
        padding: 0;
      }

      .cooking-content :global(.recipe-text li) {
        font-size: 0.95rem;
        padding: 0.3rem 0 0.3rem 1.1rem;
        position: relative;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-text li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      .cooking-content :global(.recipe-text strong) {
        color: var(--ck-gold);
        font-weight: 700;
      }

      /* Old h3 headings fallback */
      .cooking-content :global(h3) {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      /* Generic fallback paragraphs */
      .cooking-content :global(> p) {
        font-family: Georgia, serif;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--ck-text);
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
      }

      /* Generic lists */
      .cooking-content :global(> ul),
      .cooking-content :global(> ol) {
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
        list-style: none;
        padding: 0;
      }

      .cooking-content :global(> ul li),
      .cooking-content :global(> ol li) {
        font-family: Georgia, serif;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--ck-text);
        padding: 0.3rem 0 0.3rem 1.1rem;
        position: relative;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(> ul li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 4px;
        height: 4px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      /* Generic images */
      .cooking-content :global(> p img),
      .cooking-content :global(img) {
        border-radius: 4px;
        border: 1px solid var(--ck-img-border);
      }

      .cooking-content :global(.recipe-images) {
        margin-top: 2.5rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .cooking-content :global(.recipe-images p) {
        margin: 0;
      }

      .cooking-content :global(.recipe-images img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--ck-img-border);
        margin: 0;
      }

      /* ── Ingredients Toolbar ── */
      .cooking-content :global(.ingredients-toolbar) {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding-bottom: 0.75rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.ingredients-action) {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        color: var(--ck-text-muted);
        background: transparent;
        border: 1px solid var(--ck-border);
        padding: 0.3rem 0.65rem;
        border-radius: 3px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .cooking-content :global(.ingredients-action:hover) {
        color: var(--ck-gold);
        border-color: var(--ck-border-gold);
      }

      /* ── Ingredient Checkboxes ── */
      .cooking-content :global(.recipe-ingredients li .ingredient-check) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 14px;
        height: 14px;
        border: 1.5px solid var(--ck-border);
        border-radius: 2px;
        margin-right: 0.4rem;
        vertical-align: middle;
        position: relative;
        top: -1px;
        flex-shrink: 0;
        transition: all 0.2s ease;
        cursor: pointer;
      }

      .cooking-content :global(.recipe-ingredients li.checked .ingredient-check) {
        background: var(--ck-gold);
        border-color: var(--ck-gold);
      }

      .cooking-content :global(.recipe-ingredients li.checked .ingredient-check)::after {
        content: '✓';
        color: white;
        font-size: 9px;
        font-weight: 700;
        line-height: 1;
      }

      .cooking-content :global(.recipe-ingredients li:has(.ingredient-check))::before {
        display: none;
      }

      /* ── Tags ── */
      .recipe-tags {
        max-width: 1200px;
        margin: 3rem auto 0;
        padding: 1.5rem 2rem 0;
        border-top: 1px solid var(--ck-divider);
        display: flex;
        align-items: center;
        gap: 0.6rem;
        flex-wrap: wrap;
      }

      .recipe-tags .tag-label {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ck-text-muted);
      }

      .recipe-tags .tag {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--ck-gold);
        background: var(--ck-badge-bg);
        border: 1px solid var(--ck-badge-border);
        padding: 0.2rem 0.6rem;
        border-radius: 2px;
        text-decoration: none;
      }

      /* ── Navigation ── */
      .recipe-navigation {
        max-width: 1200px;
        margin: 3rem auto 0;
        padding: 2.5rem 2rem;
        border-top: 1px solid var(--ck-divider);
      }

      .nav-header {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ck-text-muted);
        margin-bottom: 1.25rem;
      }

      .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 1rem;
      }

      .nav-card {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.25rem;
        background: var(--ck-bg-card);
        border: 1px solid var(--ck-border);
        border-radius: 4px;
        text-decoration: none !important;
        transition: border-color 0.2s ease;
      }

      .nav-card:hover {
        border-color: var(--ck-gold);
      }

      .nav-direction {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ck-gold);
      }

      .nav-card-title {
        font-family: 'Playfair Display', Georgia, serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--ck-text);
        line-height: 1.3;
      }

      .nav-card-date {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        color: var(--ck-text-muted);
      }

      /* ── Footer ── */
      .cooking-footer {
        margin-top: 4rem;
        padding: 2rem 2rem;
        border-top: 1px solid var(--ck-border);
        text-align: center;
      }

      .footer-text {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.8rem;
        color: var(--ck-text-muted);
        margin: 0;
      }

      .footer-text a {
        color: var(--ck-text-muted);
        text-decoration: none;
      }

      .footer-text a:hover {
        color: var(--ck-gold);
      }

      /* ── Keyboard Hints ── */
      .keyboard-hints {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        gap: 0.75rem;
        z-index: 50;
        opacity: 0.4;
        transition: opacity 0.2s ease;
      }

      .keyboard-hints:hover {
        opacity: 1;
      }

      .kbd-hint {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.65rem;
        color: var(--ck-text-muted);
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      .kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 18px;
        height: 18px;
        padding: 0 3px;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.6rem;
        font-weight: 600;
        color: var(--ck-text-muted);
        background: var(--ck-bg-surface);
        border: 1px solid var(--ck-border);
        border-radius: 3px;
      }

      /* ══════════════════════════════════════════
         COOK MODE — large text for kitchen use
         ══════════════════════════════════════════ */
      html[data-cooking].cook-mode body {
        background: #fff;
      }

      html[data-cooking].cook-mode .recipe-photo-wrap {
        display: none;
      }

      html[data-cooking].cook-mode .recipe-header {
        padding: 1.5rem 1.5rem 1rem;
      }

      html[data-cooking].cook-mode .recipe-title-main {
        font-size: clamp(1.6rem, 4vw, 2.2rem);
      }

      html[data-cooking].cook-mode .recipe-desc-main {
        display: none;
      }

      html[data-cooking].cook-mode .recipe-meta-strip {
        display: none;
      }

      html[data-cooking].cook-mode .recipe-breadcrumb {
        display: none;
      }

      html[data-cooking].cook-mode .recipe-cat-label {
        display: none;
      }

      html[data-cooking].cook-mode .cooking-content {
        max-width: 100%;
        padding: 1.5rem;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-intro) {
        display: none;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-body) {
        display: block;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-ingredients) {
        position: static;
        margin-bottom: 2rem;
        font-size: 1.15rem;
        padding: 1.5rem;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-ingredients li) {
        font-size: 1.2rem;
        line-height: 1.7;
        padding: 0.5rem 0 0.5rem 1.3rem;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions) {
        font-size: 1.4rem;
        line-height: 1.8;
        max-width: 100%;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions p) {
        padding-left: 3.5rem;
        margin-bottom: 2.5rem;
        font-size: 1.4rem;
        line-height: 1.8;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions p)::before {
        font-size: 2rem;
        width: 2.5rem;
      }

      /* Fallback for non-recipe-body layouts */
      html[data-cooking].cook-mode .cooking-content :global(.recipe-text) {
        font-size: 1.4rem;
        line-height: 1.8;
      }

      html[data-cooking].cook-mode .cooking-content :global(.recipe-text li) {
        font-size: 1.2rem;
        line-height: 1.7;
        padding: 0.5rem 0 0.5rem 1.3rem;
      }

      html[data-cooking].cook-mode .cooking-content :global(> p) {
        font-size: 1.4rem;
        line-height: 1.8;
        max-width: 100%;
      }

      html[data-cooking].cook-mode .cooking-content :global(> ul li),
      html[data-cooking].cook-mode .cooking-content :global(> ol li) {
        font-size: 1.2rem;
        line-height: 1.7;
        padding: 0.5rem 0 0.5rem 1.3rem;
      }

      html[data-cooking].cook-mode .cooking-content :global(strong) {
        color: var(--ck-gold);
        font-weight: 700;
      }

      html[data-cooking].cook-mode .recipe-tags,
      html[data-cooking].cook-mode .recipe-navigation,
      html[data-cooking].cook-mode .cooking-footer,
      html[data-cooking].cook-mode .keyboard-hints {
        display: none;
      }

      /* Cook mode toggle button */
      .cook-mode-toggle {
        position: fixed;
        bottom: 1.5rem;
        left: 1.5rem;
        z-index: 60;
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--ck-text-muted);
        background: var(--ck-bg-card, #fff);
        border: 1px solid var(--ck-border);
        border-radius: 8px;
        padding: 0.55rem 1rem;
        cursor: pointer;
        transition: all 0.2s ease;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      }

      .cook-mode-toggle:hover {
        color: var(--ck-gold);
        border-color: var(--ck-border-gold);
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
      }

      .cook-mode-toggle .toggle-icon {
        font-size: 1.1rem;
        line-height: 1;
      }

      html[data-cooking].cook-mode .cook-mode-toggle {
        color: #fff;
        background: var(--ck-gold);
        border-color: var(--ck-gold);
      }

      html[data-cooking].cook-mode .cook-mode-toggle:hover {
        opacity: 0.9;
        color: #fff;
      }

      /* Keep screen awake hint in cook mode */
      .cook-mode-hint {
        display: none;
        position: fixed;
        top: 1rem;
        right: 1rem;
        z-index: 60;
        font-family: 'DM Sans', sans-serif;
        font-size: 0.7rem;
        font-weight: 500;
        color: var(--ck-gold);
        background: var(--ck-badge-bg);
        border: 1px solid var(--ck-badge-border);
        border-radius: 4px;
        padding: 0.35rem 0.7rem;
      }

      html[data-cooking].cook-mode .cook-mode-hint {
        display: block;
      }

      @media (max-width: 900px) {
        html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions) {
          font-size: 1.3rem;
        }
        html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions p) {
          font-size: 1.3rem;
          padding-left: 3rem;
        }
        html[data-cooking].cook-mode .cooking-content :global(.recipe-instructions p)::before {
          font-size: 1.75rem;
          width: 2rem;
        }
        .cook-mode-toggle {
          bottom: 1rem;
          left: 1rem;
        }
      }

      /* ── Print ── */
      @media print {
        .recipe-navigation, .cooking-footer, .recipe-tags,
        .keyboard-hints, .ingredients-toolbar, .ingredient-check,
        #theme-toggle, .secret-search { display: none !important; }
        html[data-cooking] body { background: white !important; color: #1a1a1a !important; }
        .recipe-photo-wrap { max-height: 300px !important; }
        .recipe-header { border: none !important; }
      }

      /* ── Mobile ── */
      @media (max-width: 900px) {
        .recipe-photo-wrap { max-height: 350px; }

        .recipe-header {
          padding: 2rem 1.25rem 1.5rem;
        }

        .cooking-content {
          padding: 2.5rem 1.25rem 1.5rem;
        }

        .cooking-content :global(.recipe-body) {
          display: block;
        }

        .cooking-content :global(.recipe-ingredients) {
          position: static;
          margin-bottom: 2.5rem;
        }

        .cooking-content :global(.recipe-instructions p) {
          padding-left: 2.5rem;
        }

        .recipe-navigation {
          padding: 2rem 1.25rem;
        }

        .nav-grid {
          grid-template-columns: 1fr;
        }

        .recipe-tags {
          padding: 1.25rem 1.25rem 0;
        }

        .keyboard-hints { display: none; }
      }
    </style>
  </head>

  <body>
    <Header />

    <!-- Hero Photo (no text overlay) -->
    {heroImage && (
      <div class="recipe-photo-wrap">
        <img src={heroImage} alt={`${title} - finished dish`} loading="eager" decoding="async" fetchpriority="high" />
      </div>
    )}

    <!-- Recipe Header below photo -->
    <div class="recipe-header">
      <div class="recipe-header-inner">
        <a href="/cooking" class="recipe-breadcrumb">← All Recipes</a>
        {subcategory && <span class="recipe-cat-label">{subcategory}</span>}
        <h1 class="recipe-title-main">{title}</h1>
        {description && <p class="recipe-desc-main">{description}</p>}
        {totalTime > 0 && (
          <div class="recipe-meta-strip">
            {prepTime && (
              <div class="meta-chip">
                <span class="meta-chip-label">Prep</span>
                <span class="meta-chip-val">{prepTime} min</span>
              </div>
            )}
            {cookTime && (
              <div class="meta-chip">
                <span class="meta-chip-label">Cook</span>
                <span class="meta-chip-val">{cookTime} min</span>
              </div>
            )}
            <div class="meta-chip">
              <span class="meta-chip-label">Total</span>
              <span class="meta-chip-val">{totalTime} min</span>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Recipe Content -->
    <article class="cooking-content">
      <slot />
    </article>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="recipe-tags">
        <span class="tag-label">Tags</span>
        {tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <!-- Navigation -->
    {(prevPost || nextPost) && (
      <nav class="recipe-navigation">
        <div class="nav-header">More Recipes</div>
        <div class="nav-grid">
          {prevPost && (
            <a href={`/blog/${prevPost.id}/`} class="nav-card">
              <span class="nav-direction">← Previous</span>
              <span class="nav-card-title">{prevPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={prevPost.data.pubDate} /></span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="nav-card">
              <span class="nav-direction">Next →</span>
              <span class="nav-card-title">{nextPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={nextPost.data.pubDate} /></span>
            </a>
          )}
        </div>
      </nav>
    )}

    <!-- Keyboard Hints -->
    <div class="keyboard-hints">
      <span class="kbd-hint"><span class="kbd">J</span><span class="kbd">K</span> nav</span>
      <span class="kbd-hint"><span class="kbd">P</span> print</span>
      <span class="kbd-hint"><span class="kbd">/</span> search</span>
    </div>

    <!-- Footer -->
    <footer class="cooking-footer">
      <p class="footer-text">
        <a href="/cooking">All Recipes</a> · <a href="/">mager.co</a> · Chicago
      </p>
    </footer>

    <!-- Cook Mode Toggle -->
    <button class="cook-mode-toggle" id="cook-mode-btn" aria-label="Toggle cook mode">
      <span class="toggle-icon">🍳</span>
      <span class="toggle-label">Cook Mode</span>
    </button>
    <div class="cook-mode-hint" id="cook-mode-hint">🍳 Cook Mode — large text, less clutter</div>

    <!-- Theme restore (light is default now) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('cooking-theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <!-- Cook Mode Script -->
    <script is:inline>
      (function() {
        const btn = document.getElementById('cook-mode-btn');
        const label = btn?.querySelector('.toggle-label');
        const key = 'cook-mode';
        const html = document.documentElement;

        // Restore saved state
        if (localStorage.getItem(key) === 'on') {
          html.classList.add('cook-mode');
          if (label) label.textContent = 'Exit Cook Mode';
        }

        btn?.addEventListener('click', () => {
          const active = html.classList.toggle('cook-mode');
          localStorage.setItem(key, active ? 'on' : 'off');
          if (label) label.textContent = active ? 'Exit Cook Mode' : 'Cook Mode';

          // Try to keep screen awake in cook mode
          if (active && 'wakeLock' in navigator) {
            navigator.wakeLock.request('screen').catch(() => {});
          }

          // Scroll to instructions in cook mode
          if (active) {
            const instructions = document.querySelector('.recipe-instructions') || document.querySelector('.recipe-text');
            if (instructions) {
              setTimeout(() => instructions.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
            }
          }
        });
      })();
    </script>

    <!-- Interactive Recipe Features -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const recipeKey = `recipe-checked-${window.location.pathname}`;

        // ── Ingredient Checkboxes ──
        const ingredients = document.querySelectorAll('.recipe-ingredients li');
        const saved = JSON.parse(localStorage.getItem(recipeKey) || '{}');

        ingredients.forEach((li, i) => {
          const checkbox = document.createElement('span');
          checkbox.className = 'ingredient-check';
          checkbox.setAttribute('role', 'checkbox');
          checkbox.setAttribute('aria-checked', saved[i] ? 'true' : 'false');
          checkbox.setAttribute('tabindex', '0');
          li.prepend(checkbox);

          if (saved[i]) li.classList.add('checked');

          const toggle = () => {
            const isChecked = li.classList.toggle('checked');
            checkbox.setAttribute('aria-checked', String(isChecked));
            saved[i] = isChecked;
            localStorage.setItem(recipeKey, JSON.stringify(saved));
          };

          li.addEventListener('click', toggle);
          checkbox.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
          });
        });

        // ── Ingredients Toolbar ──
        const ingredientsSection = document.querySelector('.recipe-ingredients');
        if (ingredientsSection) {
          const toolbar = document.createElement('div');
          toolbar.className = 'ingredients-toolbar';

          const copyBtn = document.createElement('button');
          copyBtn.className = 'ingredients-action';
          copyBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy</span>`;
          copyBtn.addEventListener('click', () => {
            const items = Array.from(ingredientsSection.querySelectorAll('li'))
              .map(li => li.textContent?.trim())
              .filter(Boolean);
            navigator.clipboard.writeText(items.join('\n')).then(() => {
              const span = copyBtn.querySelector('span');
              if (span) { span.textContent = 'Copied!'; setTimeout(() => span.textContent = 'Copy', 1500); }
            });
          });

          const clearBtn = document.createElement('button');
          clearBtn.className = 'ingredients-action';
          clearBtn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg><span>Clear</span>`;
          clearBtn.addEventListener('click', () => {
            ingredients.forEach(li => {
              li.classList.remove('checked');
              const cb = li.querySelector('.ingredient-check');
              if (cb) cb.setAttribute('aria-checked', 'false');
            });
            localStorage.removeItem(recipeKey);
          });

          toolbar.appendChild(copyBtn);
          toolbar.appendChild(clearBtn);
          ingredientsSection.prepend(toolbar);
        }

        // ── Keyboard Shortcuts ──
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          const prev = document.querySelector('.nav-card:first-child') as HTMLAnchorElement;
          const next = document.querySelector('.nav-card:last-child') as HTMLAnchorElement;

          switch(e.key) {
            case 'j': if (next?.href) window.location.href = next.href; break;
            case 'k': if (prev?.href) window.location.href = prev.href; break;
            case 'p':
              if (!e.metaKey && !e.ctrlKey) { e.preventDefault(); window.print(); }
              break;
          }
        });
      });
    </script>

    <SecretSearch posts={allPosts} />
  </body>
</html>
