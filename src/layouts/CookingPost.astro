---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SecretSearch from '../components/SecretSearch.astro';
import PhotoViewer from '../components/cooking/PhotoViewer.astro';
import '../styles/recipe.css';
import { prepareRecipe } from '../lib/recipe';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const {
  title, description, pubDate, heroImage, keyword,
  prepTime, cookTime, subcategory, postId, draft, tags, recipeYield
} = Astro.props;

const recipe = prepareRecipe(await Astro.slots.render('default'));
const totalTime = (prepTime || 0) + (cookTime || 0);

// Build Recipe schema for structured data
const siteUrl = 'https://mager.co';
const postUrl = `${siteUrl}/blog/${postId}`;
const recipeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: title,
  ...(recipeYield && { recipeYield }),
  description: description,
  image: heroImage,
  author: {
    '@type': 'Person',
    name: 'Mager'
  },
  datePublished: pubDate?.toISOString?.() || pubDate,
  recipeCategory: subcategory || 'Main Course',
  keywords: tags?.join(', ') || keyword,
  ...(prepTime && { prepTime: `PT${prepTime}M` }),
  ...(cookTime && { cookTime: `PT${cookTime}M` }),
  ...(totalTime > 0 && { totalTime: `PT${totalTime}M` }),
};

// Breadcrumb schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteUrl
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Cooking',
      item: `${siteUrl}/cooking`
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: title,
      item: postUrl
    }
  ]
};

const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const foodPosts = allPosts
  .filter(post => post.data.category === 'food')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = foodPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex >= 0 && currentIndex < foodPosts.length - 1 ? foodPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? foodPosts[currentIndex - 1] : null;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={draft ? `[Draft] ${title}` : title} description={description} image={heroImage} keywords={tags?.join(', ')} />
    {draft && <meta name="robots" content="noindex, nofollow" />}
    <script type="application/ld+json" set:html={JSON.stringify(recipeSchema).replace(/</g, '\\u003c')} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema).replace(/</g, '\\u003c')} />
  </head>
  <body class="publication recipe-page" data-category="food">
    <a class="skip-link" href={recipe.hasIngredients ? '#ingredients' : '#recipe-content'}>Skip to recipe</a>
    <Header homepage themeToggle activeSection="/cooking/" />
    <main id="recipe-content" class="recipe-main">
      <header class:list={['recipe-opening', { 'has-photo': !!heroImage }]}>
        <div class="recipe-heading">
          <a class="recipe-back" href="/cooking/">← All recipes</a>
          {subcategory && <p class="recipe-eyebrow">{subcategory}</p>}
          {draft && <p class="recipe-draft">Draft recipe · not yet kitchen-tested</p>}
          <h1>{title}</h1>
          <p class="recipe-description">{description}</p>
          <dl class="recipe-meta">
            {recipeYield && <div><dt>Makes</dt><dd>{recipeYield}</dd></div>}
            {prepTime && <div><dt>Prep</dt><dd>{prepTime} min</dd></div>}
            {cookTime !== undefined && cookTime > 0 && <div><dt>Cook</dt><dd>{cookTime} min</dd></div>}
            {totalTime > 0 && <div><dt>Total</dt><dd>{totalTime} min</dd></div>}
          </dl>
        </div>
        {heroImage && <figure class="recipe-photo"><img src={heroImage} alt={`${title}, ready to serve`} width="800" height="600" loading="eager" fetchpriority="high" decoding="async" /></figure>}
      </header>
      <nav class="recipe-jumps" aria-label="Recipe sections">
        <div>
          {recipe.hasIngredients && <a href="#ingredients">Ingredients <span aria-hidden="true">↓</span></a>}
          {recipe.hasMethod && <a href="#method">Method <span aria-hidden="true">↓</span></a>}
          <button type="button" data-recipe-print hidden>Print</button>
        </div>
        <span class="recipe-jump-title" aria-hidden="true">{title}</span>
      </nav>
      <article class="cooking-content" set:html={recipe.html} />
      {(prevPost || nextPost) && <nav class="recipe-navigation" aria-label="More recipes">
        <h2>Next time, try…</h2>
        <div>
          {prevPost && <a href={`/blog/${prevPost.id}/`} rel="prev">{prevPost.data.title}<span aria-hidden="true">↗</span></a>}
          {nextPost && <a href={`/blog/${nextPost.id}/`} rel="next">{nextPost.data.title}<span aria-hidden="true">↗</span></a>}
        </div>
      </nav>}

    </main>
    <Footer homepage />
    <PhotoViewer />
    <script>import '../scripts/recipe';</script>
    <SecretSearch posts={allPosts} />
  </body>
</html>
