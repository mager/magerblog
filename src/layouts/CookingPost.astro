---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SecretSearch from '../components/SecretSearch.astro';
import '../styles/cooking.css';

type Props = CollectionEntry<'blog'>['data'] & { postId: string };

const {
  title, description, pubDate, updatedDate, heroImage,
  prepTime, cookTime, category, tags, subcategory, postId, draft
} = Astro.props;

const totalTime = (prepTime || 0) + (cookTime || 0);

// Get related posts for navigation
const allPosts = (await getCollection('blog')).filter(post => !post.data.draft);
const foodPosts = allPosts
  .filter(post => post.data.category === 'food')
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const currentIndex = foodPosts.findIndex(post => post.id === postId);
const prevPost = currentIndex < foodPosts.length - 1 ? foodPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? foodPosts[currentIndex - 1] : null;
---

<html lang="en" data-cooking>
  <head>
    <BaseHead title={title} description={description} image={heroImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;0,900;1,400;1,700&family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400&family=DM+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <style>
      /* ── Hero ── */
      .recipe-hero {
        position: relative;
        min-height: 85vh;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        overflow: hidden;
        background: var(--ck-bg-alt);
      }

      .hero-image-wrapper {
        position: absolute;
        inset: 0;
        z-index: 1;
      }

      .hero-image-wrapper img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        border-radius: 0;
        transition: transform 8s ease;
      }

      .recipe-hero:hover .hero-image-wrapper img {
        transform: scale(1.03);
      }

      .hero-gradient {
        position: absolute;
        inset: 0;
        z-index: 2;
        background:
          linear-gradient(to top, var(--ck-bg) 0%, transparent 40%),
          linear-gradient(to top, rgba(0,0,0,0.4) 0%, transparent 60%);
        pointer-events: none;
      }

      .hero-content {
        position: relative;
        z-index: 3;
        max-width: 900px;
        padding: 0 3rem 4rem;
        animation: ck-fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s both;
      }

      .hero-category-badge {
        display: inline-block;
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ck-gold-bright);
        background: rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(218, 165, 32, 0.3);
        padding: 0.35rem 1rem;
        border-radius: 100px;
        margin-bottom: 1.25rem;
      }

      .hero-title {
        font-family: 'Playfair Display', 'Georgia', serif;
        font-weight: 900;
        font-size: clamp(3rem, 8vw, 5.5rem);
        line-height: 1.0;
        letter-spacing: -0.03em;
        color: #FFFFFF;
        margin: 0 0 1.25rem;
        text-shadow:
          0 2px 8px rgba(0, 0, 0, 0.5),
          0 8px 30px rgba(0, 0, 0, 0.3);
      }

      .hero-description {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 1.15rem;
        line-height: 1.7;
        color: rgba(255, 255, 255, 0.85);
        margin: 0 0 1.5rem;
        max-width: 600px;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.4);
      }

      .hero-meta {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
      }

      .hero-meta-item {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.8);
        display: flex;
        align-items: center;
        gap: 0.4rem;
        letter-spacing: 0.02em;
      }

      .hero-meta-item .meta-label {
        color: var(--ck-gold-bright);
        font-weight: 600;
        text-transform: uppercase;
        font-size: 0.7rem;
        letter-spacing: 0.08em;
      }

      .hero-meta-divider {
        width: 1px;
        height: 16px;
        background: rgba(255, 255, 255, 0.25);
      }

      /* ── Content Layout ── */
      .cooking-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 4rem 2rem 2rem;
      }

      /* ── Intro Section ── */
      .cooking-content :global(.recipe-intro) {
        max-width: 700px;
        margin: 0 auto 3rem;
        text-align: center;
        font-family: 'Lora', 'Georgia', serif;
        font-size: 1.15rem;
        line-height: 1.85;
        color: var(--ck-text-secondary);
        font-style: italic;
      }

      .cooking-content :global(.recipe-intro p) {
        margin: 0;
      }

      /* ── Two Column Grid ── */
      .cooking-content :global(.recipe-body) {
        display: grid;
        grid-template-columns: 340px 1fr;
        gap: 4rem;
        align-items: start;
      }

      /* ── Ingredients ── */
      .cooking-content :global(.recipe-ingredients) {
        position: sticky;
        top: 90px;
        background: var(--ck-bg-ingredients);
        border: 1px solid var(--ck-border);
        border-radius: 16px;
        padding: 2rem;
        box-shadow: var(--ck-shadow-card);
      }

      .cooking-content :global(.recipe-ingredients)::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, var(--ck-gold), var(--ck-gold-bright), var(--ck-gold));
        border-radius: 16px 16px 0 0;
      }

      .cooking-content :global(.recipe-ingredients h4) {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 2rem 0 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-ingredients h4:first-child) {
        margin-top: 0;
      }

      .cooking-content :global(.recipe-ingredients ul) {
        list-style: none;
        padding: 0;
        margin: 0 0 0.5rem;
      }

      .cooking-content :global(.recipe-ingredients li) {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 0.92rem;
        line-height: 1.6;
        color: var(--ck-text);
        padding: 0.3rem 0 0.3rem 1.25rem;
        position: relative;
        border-bottom: 1px solid var(--ck-gold-subtle);
      }

      .cooking-content :global(.recipe-ingredients li:last-child) {
        border-bottom: none;
      }

      .cooking-content :global(.recipe-ingredients li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      /* ── Instructions ── */
      .cooking-content :global(.recipe-instructions) {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 1.08rem;
        line-height: 1.85;
        color: var(--ck-text);
        counter-reset: step-counter;
      }

      .cooking-content :global(.recipe-instructions p) {
        position: relative;
        margin-bottom: 2rem;
        padding-left: 3.5rem;
        counter-increment: step-counter;
      }

      .cooking-content :global(.recipe-instructions p)::before {
        content: counter(step-counter);
        position: absolute;
        left: 0;
        top: -0.15rem;
        font-family: 'Playfair Display', 'Georgia', serif;
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--ck-gold);
        opacity: 0.35;
        line-height: 1;
        width: 2.5rem;
        text-align: center;
      }

      /* Paragraphs containing only an image should not be numbered */
      .cooking-content :global(.recipe-instructions p:has(> img:only-child)) {
        counter-increment: none;
        padding-left: 0;
      }

      .cooking-content :global(.recipe-instructions p:has(> img:only-child))::before {
        display: none;
      }

      .cooking-content :global(.recipe-instructions img) {
        width: 100%;
        margin: 1.5rem 0 2.5rem;
        border-radius: 12px;
        border: 1px solid var(--ck-img-border);
        box-shadow: var(--ck-shadow);
      }

      /* ── Gallery ── */
      .cooking-content :global(.recipe-gallery) {
        margin-top: 4rem;
        padding-top: 3rem;
        border-top: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-gallery p) {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .cooking-content :global(.recipe-gallery img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--ck-img-border);
        box-shadow: var(--ck-shadow);
        transition: transform 0.4s ease, box-shadow 0.4s ease;
        margin: 0;
      }

      .cooking-content :global(.recipe-gallery img:hover) {
        transform: scale(1.02);
        box-shadow: var(--ck-shadow-lg);
      }

      /* ── Fallback: Old recipe format (recipe-text + recipe-images) ── */
      .cooking-content :global(.recipe-text) {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--ck-text);
      }

      .cooking-content :global(.recipe-text h4) {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.recipe-text ul) {
        list-style: none;
        padding: 0;
      }

      .cooking-content :global(.recipe-text li) {
        font-size: 0.95rem;
        padding: 0.3rem 0 0.3rem 1.25rem;
        position: relative;
        border-bottom: 1px solid var(--ck-gold-subtle);
      }

      .cooking-content :global(.recipe-text li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      .cooking-content :global(.recipe-text strong) {
        color: var(--ck-gold);
        font-weight: 700;
      }

      /* Old format recipes that use h3 headings */
      .cooking-content :global(h3) {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin: 2.5rem 0 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      /* Generic content paragraphs (fallback for unstructured recipes) */
      .cooking-content :global(> p) {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 1.05rem;
        line-height: 1.85;
        color: var(--ck-text);
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
      }

      /* Generic content lists (fallback) */
      .cooking-content :global(> ul),
      .cooking-content :global(> ol) {
        max-width: 760px;
        margin-left: auto;
        margin-right: auto;
        list-style: none;
        padding: 0;
      }

      .cooking-content :global(> ul li),
      .cooking-content :global(> ol li) {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 0.95rem;
        line-height: 1.6;
        color: var(--ck-text);
        padding: 0.3rem 0 0.3rem 1.25rem;
        position: relative;
        border-bottom: 1px solid var(--ck-gold-subtle);
      }

      .cooking-content :global(> ul li)::before {
        content: '';
        position: absolute;
        left: 0;
        top: 50%;
        transform: translateY(-50%);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--ck-gold);
        opacity: 0.5;
      }

      /* Generic content images (fallback) */
      .cooking-content :global(> p img),
      .cooking-content :global(img) {
        border-radius: 12px;
        border: 1px solid var(--ck-img-border);
        box-shadow: var(--ck-shadow);
      }

      .cooking-content :global(.recipe-images) {
        margin-top: 3rem;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .cooking-content :global(.recipe-images p) {
        margin: 0;
      }

      .cooking-content :global(.recipe-images img) {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid var(--ck-img-border);
        box-shadow: var(--ck-shadow);
        margin: 0;
      }

      /* ── Tags Section ── */
      .recipe-tags {
        max-width: 1200px;
        margin: 3rem auto 0;
        padding: 2rem 2rem 0;
        border-top: 1px solid var(--ck-divider);
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .recipe-tags .tag-label {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ck-text-muted);
      }

      .recipe-tags .tag {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--ck-gold);
        background: var(--ck-badge-bg);
        border: 1px solid var(--ck-badge-border);
        padding: 0.25rem 0.65rem;
        border-radius: 100px;
        text-decoration: none;
      }

      /* ── Navigation ── */
      .recipe-navigation {
        max-width: 1200px;
        margin: 4rem auto 0;
        padding: 3rem 2rem;
        border-top: 1px solid var(--ck-divider);
      }

      .nav-header {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: var(--ck-gold);
        margin-bottom: 1.5rem;
      }

      .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 1.5rem;
      }

      .nav-card {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1.5rem;
        background: var(--ck-bg-card);
        border: 1px solid var(--ck-border);
        border-radius: 12px;
        text-decoration: none !important;
        transition: all 0.3s ease;
        box-shadow: var(--ck-shadow);
      }

      .nav-card:hover {
        border-color: var(--ck-border-gold);
        transform: translateY(-3px);
        box-shadow: var(--ck-shadow-lg);
      }

      .nav-direction {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--ck-gold);
      }

      .nav-card-title {
        font-family: 'Playfair Display', 'Georgia', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ck-text);
        line-height: 1.3;
      }

      .nav-card-date {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.75rem;
        color: var(--ck-text-muted);
      }

      /* ── Footer ── */
      .cooking-footer {
        margin-top: 4rem;
        padding: 3rem 2rem;
        background: var(--ck-bg-alt);
        border-top: 1px solid var(--ck-border);
        text-align: center;
      }

      .footer-brand {
        font-family: 'Playfair Display', 'Georgia', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: var(--ck-gold);
        letter-spacing: 0.1em;
        margin-bottom: 0.5rem;
      }

      .footer-tagline {
        font-family: 'Lora', 'Georgia', serif;
        font-size: 0.85rem;
        color: var(--ck-text-muted);
        font-style: italic;
      }

      .footer-links {
        display: flex;
        justify-content: center;
        gap: 1.5rem;
        margin-top: 1.5rem;
      }

      .footer-link {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.8rem;
        color: var(--ck-text-muted) !important;
        text-decoration: none !important;
        transition: color 0.2s ease !important;
      }

      .footer-link:hover {
        color: var(--ck-gold) !important;
      }

      .footer-copy {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.72rem;
        color: var(--ck-text-muted);
        margin-top: 1.5rem;
        opacity: 0.6;
      }

      /* ── Ingredient Checkboxes ── */
      .cooking-content :global(.recipe-ingredients li) {
        cursor: pointer;
        user-select: none;
        transition: opacity 0.2s ease;
      }

      .cooking-content :global(.recipe-ingredients li.checked) {
        opacity: 0.4;
        text-decoration: line-through;
        text-decoration-color: var(--ck-gold);
      }

      .cooking-content :global(.recipe-ingredients li .ingredient-check) {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        border: 1.5px solid var(--ck-border-gold);
        border-radius: 3px;
        margin-right: 0.5rem;
        vertical-align: middle;
        position: relative;
        top: -1px;
        flex-shrink: 0;
        transition: all 0.2s ease;
        cursor: pointer;
      }

      .cooking-content :global(.recipe-ingredients li.checked .ingredient-check) {
        background: var(--ck-gold);
        border-color: var(--ck-gold);
      }

      .cooking-content :global(.recipe-ingredients li.checked .ingredient-check)::after {
        content: '✓';
        color: white;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
      }

      /* Hide the default gold dot when checkboxes are active */
      .cooking-content :global(.recipe-ingredients li .ingredient-check + *),
      .cooking-content :global(.recipe-ingredients li:has(.ingredient-check))::before {
        display: none;
      }

      /* ── Ingredients Toolbar ── */
      .cooking-content :global(.ingredients-toolbar) {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.25rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--ck-divider);
      }

      .cooking-content :global(.ingredients-action) {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.68rem;
        font-weight: 500;
        letter-spacing: 0.03em;
        color: var(--ck-text-muted);
        background: transparent;
        border: 1px solid var(--ck-border);
        padding: 0.35rem 0.7rem;
        border-radius: 6px;
        cursor: pointer;
        transition: all 0.2s ease;
      }

      .cooking-content :global(.ingredients-action:hover) {
        color: var(--ck-gold);
        border-color: var(--ck-border-gold);
        background: var(--ck-gold-subtle);
      }

      /* ── Keyboard Hints (shown on recipe pages) ── */
      .keyboard-hints {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        display: flex;
        gap: 0.75rem;
        z-index: 50;
        opacity: 0.5;
        transition: opacity 0.2s ease;
      }

      .keyboard-hints:hover {
        opacity: 1;
      }

      .kbd-hint {
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.65rem;
        color: var(--ck-text-muted);
        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      .kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 4px;
        font-family: 'DM Sans', -apple-system, sans-serif;
        font-size: 0.6rem;
        font-weight: 600;
        color: var(--ck-text-muted);
        background: var(--ck-bg-surface);
        border: 1px solid var(--ck-border);
        border-radius: 4px;
        box-shadow: 0 1px 0 var(--ck-border);
      }

      /* ── Print Styles ── */
      @media print {
        .cooking-nav,
        .recipe-navigation,
        .cooking-footer,
        .recipe-tags,
        .keyboard-hints,
        .ingredients-toolbar,
        .ingredient-check,
        .hero-gradient,
        #theme-toggle,
        .secret-search {
          display: none !important;
        }

        html[data-cooking] body {
          background: white !important;
          color: #1a1a1a !important;
        }

        .recipe-hero {
          min-height: auto !important;
          padding: 2rem 0 !important;
          background: white !important;
        }

        .hero-image-wrapper { display: none !important; }

        .hero-content {
          position: static !important;
          padding: 0 !important;
        }

        .hero-title {
          color: #1a1a1a !important;
          text-shadow: none !important;
          font-size: 2.5rem !important;
        }

        .hero-description {
          color: #333 !important;
          text-shadow: none !important;
        }

        .hero-category-badge {
          background: #f0f0f0 !important;
          color: #666 !important;
          border: 1px solid #ccc !important;
        }

        .hero-meta-item {
          color: #333 !important;
        }

        .hero-meta-item .meta-label {
          color: #666 !important;
        }

        .cooking-content {
          padding: 1rem 0 !important;
        }

        .cooking-content :global(.recipe-ingredients) {
          position: static !important;
          background: #f9f9f9 !important;
          border: 1px solid #ddd !important;
          break-inside: avoid;
        }

        .cooking-content :global(.recipe-ingredients li) {
          text-decoration: none !important;
          opacity: 1 !important;
        }

        .cooking-content :global(.recipe-gallery) {
          display: none !important;
        }

        .cooking-content :global(.recipe-instructions img) {
          max-width: 300px !important;
          margin: 0.5rem 0 !important;
        }
      }

      /* ── Mobile ── */
      @media (max-width: 900px) {
        .recipe-hero {
          min-height: 70vh;
        }

        .hero-content {
          padding: 0 1.5rem 3rem;
        }

        .hero-title {
          font-size: clamp(2.5rem, 10vw, 3.5rem);
        }

        .cooking-content {
          padding: 2.5rem 1.25rem 1.5rem;
        }

        .cooking-content :global(.recipe-body) {
          display: block;
        }

        .cooking-content :global(.recipe-ingredients) {
          position: static;
          margin-bottom: 3rem;
        }

        .cooking-content :global(.recipe-instructions p) {
          padding-left: 2.75rem;
        }

        .recipe-navigation {
          padding: 2rem 1.25rem;
        }

        .nav-grid {
          grid-template-columns: 1fr;
        }

        .recipe-tags {
          padding: 1.5rem 1.25rem 0;
        }

        .keyboard-hints {
          display: none;
        }

        .cooking-content :global(.recipe-gallery p) {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <Header activeCategory="recipes" />

    <!-- Hero -->
    <header class="recipe-hero">
      {heroImage && (
        <div class="hero-image-wrapper">
          <img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
        </div>
      )}
      <div class="hero-gradient"></div>

      <div class="hero-content">
        {subcategory && (
          <span class="hero-category-badge">{subcategory}</span>
        )}
        <h1 class="hero-title">{title}</h1>
        <p class="hero-description">{description}</p>

        <div class="hero-meta">
          {prepTime && (
            <div class="hero-meta-item">
              <span class="meta-label">Prep</span>
              <span>{prepTime} min</span>
            </div>
          )}
          {prepTime && cookTime && <div class="hero-meta-divider"></div>}
          {cookTime && (
            <div class="hero-meta-item">
              <span class="meta-label">Cook</span>
              <span>{cookTime} min</span>
            </div>
          )}
          {totalTime > 0 && (
            <>
              <div class="hero-meta-divider"></div>
              <div class="hero-meta-item">
                <span class="meta-label">Total</span>
                <span>{totalTime} min</span>
              </div>
            </>
          )}
        </div>
      </div>
    </header>

    <!-- Content -->
    <article class="cooking-content">
      <slot />
    </article>

    <!-- Tags -->
    {tags && tags.length > 0 && (
      <div class="recipe-tags">
        <span class="tag-label">Tags</span>
        {tags.map(tag => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}

    <!-- Navigation -->
    {(prevPost || nextPost) && (
      <nav class="recipe-navigation">
        <div class="nav-header">More Recipes</div>
        <div class="nav-grid">
          {prevPost && (
            <a href={`/blog/${prevPost.id}/`} class="nav-card">
              <span class="nav-direction">← Previous</span>
              <span class="nav-card-title">{prevPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={prevPost.data.pubDate} /></span>
            </a>
          )}
          {nextPost && (
            <a href={`/blog/${nextPost.id}/`} class="nav-card">
              <span class="nav-direction">Next →</span>
              <span class="nav-card-title">{nextPost.data.title}</span>
              <span class="nav-card-date"><FormattedDate date={nextPost.data.pubDate} /></span>
            </a>
          )}
        </div>
      </nav>
    )}

    <!-- Keyboard Hints (desktop only) -->
    <div class="keyboard-hints">
      <span class="kbd-hint"><span class="kbd">J</span><span class="kbd">K</span> nav</span>
      <span class="kbd-hint"><span class="kbd">P</span> print</span>
      <span class="kbd-hint"><span class="kbd">/</span> search</span>
    </div>

    <!-- Footer -->
    <footer class="cooking-footer">
      <div class="footer-brand">COOKING</div>
      <p class="footer-tagline">Recipes from the Mager kitchen — Chicago, IL</p>
      <div class="footer-links">
        <a href="/cooking" class="footer-link">All Recipes</a>
        <a href="/" class="footer-link">mager.co</a>
        <a href="https://x.com/mager" target="_blank" class="footer-link">@mager</a>
      </div>
      <p class="footer-copy">&copy; {new Date().getFullYear()} · Built with <a href="https://astro.build" target="_blank" class="footer-link" style="display:inline">Astro</a></p>
    </footer>

    <!-- Theme restore (dark is default) -->
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('cooking-theme');
        if (saved === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <!-- Interactive Recipe Features -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const recipeKey = `recipe-checked-${window.location.pathname}`;

        // ── Ingredient Checkboxes ──
        const ingredients = document.querySelectorAll('.recipe-ingredients li');
        const saved = JSON.parse(localStorage.getItem(recipeKey) || '{}');

        ingredients.forEach((li, i) => {
          const checkbox = document.createElement('span');
          checkbox.className = 'ingredient-check';
          checkbox.setAttribute('role', 'checkbox');
          checkbox.setAttribute('aria-checked', saved[i] ? 'true' : 'false');
          checkbox.setAttribute('tabindex', '0');
          li.prepend(checkbox);

          if (saved[i]) li.classList.add('checked');

          const toggle = () => {
            const isChecked = li.classList.toggle('checked');
            checkbox.setAttribute('aria-checked', String(isChecked));
            saved[i] = isChecked;
            localStorage.setItem(recipeKey, JSON.stringify(saved));
          };

          li.addEventListener('click', toggle);
          checkbox.addEventListener('keydown', (e: KeyboardEvent) => {
            if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); toggle(); }
          });
        });

        // ── Copy Ingredients Button ──
        const ingredientsSection = document.querySelector('.recipe-ingredients');
        if (ingredientsSection) {
          const toolbar = document.createElement('div');
          toolbar.className = 'ingredients-toolbar';

          // Copy button
          const copyBtn = document.createElement('button');
          copyBtn.className = 'ingredients-action';
          copyBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg><span>Copy list</span>`;
          copyBtn.addEventListener('click', () => {
            const items = Array.from(ingredientsSection.querySelectorAll('li'))
              .map(li => li.textContent?.trim().replace(/^\s+/, ''))
              .filter(Boolean);
            navigator.clipboard.writeText(items.join('\n')).then(() => {
              const span = copyBtn.querySelector('span');
              if (span) { span.textContent = 'Copied!'; setTimeout(() => span.textContent = 'Copy list', 1500); }
            });
          });

          // Clear checks button
          const clearBtn = document.createElement('button');
          clearBtn.className = 'ingredients-action';
          clearBtn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M8 6V4h8v2"></path><path d="M19 6l-1 14H6L5 6"></path></svg><span>Clear checks</span>`;
          clearBtn.addEventListener('click', () => {
            ingredients.forEach(li => {
              li.classList.remove('checked');
              const cb = li.querySelector('.ingredient-check');
              if (cb) cb.setAttribute('aria-checked', 'false');
            });
            localStorage.removeItem(recipeKey);
          });

          toolbar.appendChild(copyBtn);
          toolbar.appendChild(clearBtn);
          ingredientsSection.prepend(toolbar);
        }

        // ── Keyboard Shortcuts ──
        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
          const prev = document.querySelector('.nav-card:first-child') as HTMLAnchorElement;
          const next = document.querySelector('.nav-card:last-child') as HTMLAnchorElement;

          switch(e.key) {
            case 'j': if (next?.href) window.location.href = next.href; break;
            case 'k': if (prev?.href) window.location.href = prev.href; break;
            case 'p':
              if (!e.metaKey && !e.ctrlKey) { e.preventDefault(); window.print(); }
              break;
          }
        });
      });
    </script>

    <SecretSearch posts={allPosts} />
  </body>
</html>
